@*
    Họ và tên: Ngọc Tùng Lâm
    Mã sinh viên: 23103100098
    Nội dung thực hiện: Module 3 - Giao diện Chỉnh sửa Hồ sơ Học viên
*@

@model HeThongQuanLyKhoaHocVaDangKy_3_UNETI3_TIN17A2HN.ViewModels.HocVienFormViewModel
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Chỉnh sửa học viên - " + Model.HoTen;
}

<div class="container-fluid py-3 px-4">
    <!-- Breadcrumb & Tiêu đề -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h3 class="fw-bold mb-1 text-dark">
                <i class="bi bi-pencil-square me-2" style="color: var(--uneti-primary);"></i>CHỈNH SỬA HỒ SƠ HỌC VIÊN
            </h3>
            <p class="text-muted mb-0 small">Cập nhật thông tin lý lịch cá nhân và trạng thái hoạt động hồ sơ học viên</p>
        </div>
        <div class="mt-2 mt-md-0 d-flex gap-2">
            <a asp-action="Details" asp-route-id="@Model.MaHocVien" class="btn uneti-btn-outline shadow-sm text-decoration-none d-flex align-items-center gap-1">
                <i class="bi bi-eye"></i>
                <span>Xem chi tiết</span>
            </a>
            <a asp-action="Index" class="btn btn-light border shadow-sm text-decoration-none d-flex align-items-center gap-1">
                <i class="bi bi-arrow-left"></i>
                <span>Danh sách</span>
            </a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="uneti-card p-4 shadow-sm mb-4">
                <form asp-action="Edit" asp-route-id="@Model.MaHocVien" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="MaHocVien" />
                    <input type="hidden" asp-for="MaTaiKhoan" />
                    <input type="hidden" asp-for="TenDangNhap" />
                    <input type="hidden" asp-for="HinhAnh" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-4" role="alert"></div>

                    @if (!string.IsNullOrEmpty(Model.TenDangNhap))
                    {
                        <div class="alert alert-info py-2.5 px-3 small rounded-3 mb-4 d-flex align-items-center gap-2">
                            <i class="bi bi-info-circle-fill fs-5 text-primary"></i>
                            <div>
                                Hồ sơ này đang liên kết với tài khoản: <strong>@@@Model.TenDangNhap</strong>. Khi cập nhật họ tên và email, tài khoản đăng nhập tương ứng cũng sẽ được tự động đồng bộ.
                            </div>
                        </div>
                    }

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="HoTen" class="form-label small fw-semibold text-secondary">Họ và tên học viên <span class="text-danger">*</span></label>
                            <input asp-for="HoTen" class="form-control" />
                            <span asp-validation-for="HoTen" class="text-danger small"></span>
                        </div>

                        <div class="col-md-3">
                            <label asp-for="NgaySinh" class="form-label small fw-semibold text-secondary">Ngày sinh</label>
                            <input asp-for="NgaySinh" type="date" class="form-control" />
                            <span asp-validation-for="NgaySinh" class="text-danger small"></span>
                        </div>

                        <div class="col-md-3">
                            <label asp-for="GioiTinh" class="form-label small fw-semibold text-secondary">Giới tính</label>
                            <select asp-for="GioiTinh" class="form-select">
                                <option value="Nam">Nam</option>
                                <option value="Nữ">Nữ</option>
                                <option value="Khác">Khác</option>
                            </select>
                            <span asp-validation-for="GioiTinh" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="SoDienThoai" class="form-label small fw-semibold text-secondary">Số điện thoại <span class="text-danger">*</span></label>
                            <input asp-for="SoDienThoai" class="form-control" />
                            <span asp-validation-for="SoDienThoai" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label small fw-semibold text-secondary">Địa chỉ Email <span class="text-danger">*</span></label>
                            <input asp-for="Email" type="email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-8">
                            <label asp-for="DiaChi" class="form-label small fw-semibold text-secondary">Địa chỉ cư trú</label>
                            <input asp-for="DiaChi" class="form-control" />
                            <span asp-validation-for="DiaChi" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="TrinhDo" class="form-label small fw-semibold text-secondary">Trình độ học vấn</label>
                            <select asp-for="TrinhDo" class="form-select">
                                <option value="Đại học">Đại học</option>
                                <option value="Cao đẳng">Cao đẳng</option>
                                <option value="Cử nhân">Cử nhân</option>
                                <option value="Kỹ sư">Kỹ sư</option>
                                <option value="Thạc sĩ">Thạc sĩ</option>
                                <option value="Khác">Khác</option>
                            </select>
                            <span asp-validation-for="TrinhDo" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="FileAnh" class="form-label small fw-semibold text-secondary">
                                <i class="bi bi-image me-1 text-primary"></i>Ảnh đại diện học viên
                            </label>
                            <div class="d-flex align-items-center gap-3 p-2.5 bg-light rounded border">
                                @{
                                    var avatarUrl = !string.IsNullOrEmpty(Model.HinhAnh) 
                                        ? Model.HinhAnh 
                                        : "/images/avatars/default.svg";
                                }
                                <img src="@avatarUrl" alt="@Model.HoTen" class="rounded-circle shadow-sm object-fit-cover flex-shrink-0" style="width: 52px; height: 52px;" />
                                <div class="flex-grow-1">
                                    <input asp-for="FileAnh" type="file" class="form-control form-control-sm" accept="image/*" />
                                    <small class="text-muted uneti-fs-xs">Chọn ảnh chân dung mới nếu muốn thay đổi ảnh đại diện (.jpg, .png, .webp)</small>
                                </div>
                            </div>
                        </div>

                        <div class="col-12">
                            <label asp-for="GhiChu" class="form-label small fw-semibold text-secondary">Ghi chú thêm</label>
                            <textarea asp-for="GhiChu" class="form-control" rows="2"></textarea>
                            <span asp-validation-for="GhiChu" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" asp-for="TrangThai" id="swTrangThaiEdit" />
                                <label class="form-check-label fw-semibold small" for="swTrangThaiEdit">
                                    Hồ sơ đang ở trạng thái Hoạt động (Bật: Cho phép đăng ký & học tập, Tắt: Tạm khóa hồ sơ)
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Nút thao tác -->
                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a asp-action="Details" asp-route-id="@Model.MaHocVien" class="btn btn-light border px-4">Hủy bỏ</a>
                        <button type="submit" class="btn uneti-btn-primary px-4 fw-semibold shadow-sm">
                            <i class="bi bi-save me-1"></i>Cập nhật hồ sơ
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

