@*
    Họ và tên: Ngọc Tùng Lâm
    Mã sinh viên: 23103100098
    Nội dung thực hiện: Module 3 - Giao diện Chi tiết Hồ sơ Học viên và Lịch sử Đào tạo
*@

@model HeThongQuanLyKhoaHocVaDangKy_3_UNETI3_TIN17A2HN.ViewModels.HocVienDetailsViewModel
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Hồ sơ học viên - " + Model.HocVien.HoTen;
}

<div class="container-fluid py-3 px-4">
    <!-- Breadcrumb & Tiêu đề -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-controller="QuanTri" asp-action="Dashboard" class="text-decoration-none" style="color: var(--uneti-primary);">Quản trị</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none" style="color: var(--uneti-primary);">Quản lý học viên</a></li>
                    <li class="breadcrumb-item active" aria-current="page">#HV@(Model.HocVien.MaHocVien.ToString("D3"))</li>
                </ol>
            </nav>
            <h3 class="fw-bold mb-1 text-dark">
                <i class="bi bi-person-badge-fill me-2" style="color: var(--uneti-primary);"></i>CHI TIẾT HỒ SƠ HỌC VIÊN
            </h3>
            <p class="text-muted mb-0 small">Thông tin lý lịch cá nhân, tài khoản truy cập và tổng hợp lịch sử tham gia khóa học</p>
        </div>
        <div class="mt-2 mt-md-0 d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.HocVien.MaHocVien" class="btn uneti-btn-primary shadow-sm text-decoration-none d-flex align-items-center gap-1">
                <i class="bi bi-pencil-square"></i>
                <span>Chỉnh sửa hồ sơ</span>
            </a>
            <a asp-action="Index" class="btn uneti-btn-outline shadow-sm text-decoration-none d-flex align-items-center gap-1">
                <i class="bi bi-arrow-left"></i>
                <span>Quay lại</span>
            </a>
        </div>
    </div>

    <!-- Thông báo TempData -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show uneti-card border-success-subtle mb-4 py-3" role="alert">
            <i class="bi bi-check-circle-fill text-success me-2 fs-5 align-middle"></i>
            <span class="align-middle fw-semibold text-dark">@TempData["SuccessMessage"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show uneti-card border-danger-subtle mb-4 py-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill text-danger me-2 fs-5 align-middle"></i>
            <span class="align-middle fw-semibold text-dark">@TempData["ErrorMessage"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- CỘT TRÁI: THÔNG TIN HỌC VIÊN & TÀI KHOẢN -->
        <div class="col-lg-4">
            <!-- Thẻ lý lịch học viên -->
            <div class="uneti-card p-4 shadow-sm mb-4">
                <div class="text-center pb-3 border-bottom mb-3">
                    <div class="text-white rounded-circle uneti-icon-box-64 fw-bold mx-auto mb-3 shadow"
                         style="background: linear-gradient(135deg, #1d4ed8, #2563eb); font-size: 24px;">
                        @(string.IsNullOrEmpty(Model.HocVien.HoTen) ? "H" : Model.HocVien.HoTen.Substring(0, 1).ToUpper())
                    </div>
                    <h5 class="fw-bold text-dark mb-1">@Model.HocVien.HoTen</h5>
                    <span class="badge bg-light text-secondary border px-2 py-1 mb-2">Mã HV: #HV@(Model.HocVien.MaHocVien.ToString("D3"))</span>
                    <div>
                        @if (Model.HocVien.TrangThai)
                        {
                            <span class="uneti-badge-success px-3 py-1">
                                <i class="bi bi-check-circle me-1"></i>Hồ sơ hoạt động
                            </span>
                        }
                        else
                        {
                            <span class="uneti-badge-danger px-3 py-1">
                                <i class="bi bi-lock me-1"></i>Đang tạm khóa
                            </span>
                        }
                    </div>
                </div>

                <div class="d-flex flex-column gap-2.5 small">
                    <div class="d-flex justify-content-between py-1 border-bottom">
                        <span class="text-muted"><i class="bi bi-gender-ambiguous me-1.5 text-primary"></i>Giới tính:</span>
                        <strong class="text-dark">@(Model.HocVien.GioiTinh ?? "Nam")</strong>
                    </div>

                    <div class="d-flex justify-content-between py-1 border-bottom">
                        <span class="text-muted"><i class="bi bi-calendar-event me-1.5 text-primary"></i>Ngày sinh:</span>
                        <strong class="text-dark">@(Model.HocVien.NgaySinh.HasValue ? Model.HocVien.NgaySinh.Value.ToString("dd/MM/yyyy") : "Chưa cập nhật")</strong>
                    </div>

                    <div class="d-flex justify-content-between py-1 border-bottom">
                        <span class="text-muted"><i class="bi bi-telephone me-1.5 text-primary"></i>Số điện thoại:</span>
                        <a href="tel:@Model.HocVien.SoDienThoai" class="fw-semibold text-primary text-decoration-none">@Model.HocVien.SoDienThoai</a>
                    </div>

                    <div class="d-flex justify-content-between py-1 border-bottom">
                        <span class="text-muted"><i class="bi bi-envelope me-1.5 text-primary"></i>Email:</span>
                        <a href="mailto:@Model.HocVien.Email" class="fw-semibold text-dark text-decoration-none text-truncate" style="max-width: 170px;" title="@Model.HocVien.Email">@Model.HocVien.Email</a>
                    </div>

                    <div class="d-flex justify-content-between py-1 border-bottom">
                        <span class="text-muted"><i class="bi bi-mortarboard me-1.5 text-primary"></i>Trình độ:</span>
                        <span class="badge bg-light text-dark border">@(Model.HocVien.TrinhDo ?? "Đại học")</span>
                    </div>

                    <div class="d-flex justify-content-between py-1 border-bottom">
                        <span class="text-muted"><i class="bi bi-geo-alt me-1.5 text-primary"></i>Địa chỉ:</span>
                        <strong class="text-dark text-end">@(string.IsNullOrEmpty(Model.HocVien.DiaChi) ? "Chưa cập nhật" : Model.HocVien.DiaChi)</strong>
                    </div>

                    <div class="d-flex justify-content-between py-1 border-bottom">
                        <span class="text-muted"><i class="bi bi-clock-history me-1.5 text-primary"></i>Ngày tham gia:</span>
                        <strong class="text-dark">@Model.HocVien.NgayDangKy.ToString("dd/MM/yyyy")</strong>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.HocVien.GhiChu))
                    {
                        <div class="pt-2">
                            <span class="text-muted d-block mb-1"><i class="bi bi-info-circle me-1 text-primary"></i>Ghi chú:</span>
                            <div class="p-2.5 bg-light rounded border text-secondary" style="font-size: 12.5px;">@Model.HocVien.GhiChu</div>
                        </div>
                    }
                </div>
            </div>

            <!-- Thẻ tài khoản liên kết -->
            <div class="uneti-card p-4 shadow-sm mb-4">
                <h6 class="fw-bold text-dark mb-3 pb-2 border-bottom">
                    <i class="bi bi-shield-lock me-2 text-primary"></i>Tài khoản hệ thống
                </h6>
                @if (Model.TaiKhoan != null)
                {
                    <div class="d-flex flex-column gap-2 small">
                        <div class="d-flex justify-content-between py-1 border-bottom">
                            <span class="text-muted">Tên đăng nhập:</span>
                            <span class="fw-bold text-primary">@@@Model.TaiKhoan.TenDangNhap</span>
                        </div>
                        <div class="d-flex justify-content-between py-1 border-bottom">
                            <span class="text-muted">Vai trò:</span>
                            <span class="badge bg-success-subtle text-success border border-success-subtle">Học viên</span>
                        </div>
                        <div class="d-flex justify-content-between py-1 border-bottom">
                            <span class="text-muted">Trạng thái:</span>
                            <span>@(Model.TaiKhoan.TrangThai ? "Hoạt động" : "Bị khóa")</span>
                        </div>
                        <div class="d-flex justify-content-between py-1">
                            <span class="text-muted">Ngày tạo:</span>
                            <span class="text-dark">@Model.TaiKhoan.NgayTao.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning py-2 px-3 small mb-0 rounded-3">
                        <i class="bi bi-exclamation-triangle me-1"></i>Học viên này chưa được cấp tài khoản đăng nhập.
                    </div>
                }
            </div>
        </div>

        <!-- CỘT PHẢI: THỐNG KÊ & LỊCH SỬ KHÓA HỌC -->
        <div class="col-lg-8">
            <!-- 3 Thẻ thống kê tài chính & học tập -->
            <div class="row g-3 mb-4">
                <div class="col-sm-4">
                    <div class="uneti-card p-3 shadow-sm h-100 border-start border-4 border-primary">
                        <span class="text-muted small fw-medium text-uppercase d-block">Tổng khóa đăng ký</span>
                        <h4 class="fw-bold text-primary mt-1 mb-0">@Model.TongKhoaDaDangKy khóa</h4>
                        <small class="text-muted uneti-fs-xs">@Model.SoKhoaHoanThanh hoàn thành | @Model.SoKhoaChoXuLy chờ duyệt@(Model.SoKhoaBiHuy > 0 ? $" | {Model.SoKhoaBiHuy} đã hủy" : "")</small>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="uneti-card p-3 shadow-sm h-100 border-start border-4 border-success">
                        <span class="text-muted small fw-medium text-uppercase d-block">Học phí đã đóng</span>
                        <h4 class="fw-bold text-success mt-1 mb-0">@Model.TongHocPhiDaDong.ToString("N0") đ</h4>
                        <small class="text-muted uneti-fs-xs">Đã thanh toán thực tế</small>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="uneti-card p-3 shadow-sm h-100 border-start border-4 border-danger">
                        <span class="text-muted small fw-medium text-uppercase d-block">Học phí còn lại</span>
                        <h4 class="fw-bold text-danger mt-1 mb-0">@Model.TongCongNoConLai.ToString("N0") đ</h4>
                        <small class="text-muted uneti-fs-xs">Công nợ cần nộp</small>
                    </div>
                </div>
            </div>

            <!-- BẢNG LỊCH SỬ ĐĂNG KÝ KHÓA HỌC -->
            <div class="uneti-card shadow-sm overflow-hidden mb-4">
                <div class="p-3 bg-white border-bottom d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="bi bi-journal-bookmark-fill me-2 text-primary"></i>Lịch sử đăng ký & Kết quả học tập
                    </h6>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                        @Model.LịchSuDangKy.Count bản ghi
                    </span>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light border-bottom">
                            <tr class="small text-secondary text-uppercase fw-semibold" style="letter-spacing: 0.03em;">
                                <th class="ps-3" style="width: 70px;">Mã ĐK</th>
                                <th>Khóa học / Môn học</th>
                                <th>Ngày đăng ký</th>
                                <th>Trạng thái</th>
                                <th class="text-end">Đã đóng</th>
                                <th class="text-end">Còn lại</th>
                                <th class="text-center">Kết quả</th>
                                <th class="text-end pe-3" style="width: 80px;">Chi tiết</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.LịchSuDangKy.Any())
                            {
                                foreach (var dk in Model.LịchSuDangKy)
                                {
                                    <tr>
                                        <td class="ps-3 fw-bold text-muted small">#@dk.MaDangKy</td>
                                        <td>
                                            <strong class="text-dark d-block">@dk.TenKhoaHoc</strong>
                                            <small class="text-muted uneti-fs-xs">
                                                <i class="bi bi-book me-1"></i>@dk.TenMonHoc (@dk.SoTinChi TC)
                                                @if (!string.IsNullOrEmpty(dk.TenGiangVien))
                                                {
                                                    <span> &bull; GV: @dk.TenGiangVien</span>
                                                }
                                            </small>
                                        </td>
                                        <td class="small text-secondary">
                                            @dk.NgayDangKy.ToString("dd/MM/yyyy HH:mm")
                                        </td>
                                        <td>
                                            @switch (dk.TrangThai)
                                            {
                                                case "ChoXuLy":
                                                    <span class="uneti-badge-warning px-2 py-0.5 small">Chờ xử lý</span>
                                                    break;
                                                case "DangXuLy":
                                                    <span class="uneti-badge-primary px-2 py-0.5 small">Đang xử lý</span>
                                                    break;
                                                case "HoanThanh":
                                                    <span class="uneti-badge-success px-2 py-0.5 small">Hoàn thành</span>
                                                    break;
                                                case "BiHuy":
                                                    <span class="uneti-badge-danger px-2 py-0.5 small">Đã hủy</span>
                                                    break;
                                                default:
                                                    <span class="badge bg-secondary">@dk.TrangThai</span>
                                                    break;
                                            }
                                        </td>
                                        <td class="text-end fw-semibold text-success small">
                                            @dk.SoTienDaDong.ToString("N0") đ
                                        </td>
                                        <td class="text-end fw-semibold @(dk.TrangThai != "BiHuy" && dk.SoTienConLai > 0 ? "text-danger" : "text-muted") small">
                                            @(dk.TrangThai == "BiHuy" ? "0 đ" : dk.SoTienConLai.ToString("N0") + " đ")
                                        </td>
                                        <td class="text-center small">
                                            @if (dk.DiemTongKet.HasValue)
                                            {
                                                <span class="badge @(dk.DiemTongKet >= 5.0m ? "bg-success" : "bg-danger")">
                                                    @dk.DiemTongKet.Value.ToString("0.0")đ - @dk.XepLoai
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted uneti-fs-xs">Chưa có điểm</span>
                                            }
                                        </td>
                                        <td class="text-end pe-3">
                                            <a asp-controller="TiepNhanDangKy" asp-action="Details" asp-route-id="@dk.MaDangKy" 
                                               class="btn btn-sm btn-outline-primary" title="Xem chi tiết đơn này">
                                                <i class="bi bi-arrow-right"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-4 text-muted small">
                                        <i class="bi bi-journal-x fs-2 d-block mb-1 text-muted"></i>
                                        Học viên chưa đăng ký khóa học nào.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
