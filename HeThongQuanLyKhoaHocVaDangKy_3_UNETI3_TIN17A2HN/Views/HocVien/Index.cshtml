@*
    Họ và tên: Ngọc Tùng Lâm
    Mã sinh viên: 23103100098
    Nội dung thực hiện: Module 3 - Giao diện Quản lý Danh sách Học viên
*@

@model HeThongQuanLyKhoaHocVaDangKy_3_UNETI3_TIN17A2HN.ViewModels.HocVienFilterViewModel
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Quản lý Hồ sơ Học viên";
}

<div class="container-fluid py-3 px-4">
    <!-- Breadcrumb & Tiêu đề -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2">
        <div>
            <h3 class="fw-bold mb-1 text-dark">
                <i class="bi bi-people-fill me-2" style="color: var(--uneti-primary);"></i>QUẢN LÝ HỒ SƠ HỌC VIÊN
            </h3>
            <p class="text-muted mb-0 small">Quản lý lý lịch cá nhân, thông tin liên lạc, trạng thái hoạt động và lịch sử đăng ký học tập</p>
        </div>
        <div class="mt-2 mt-md-0 d-flex gap-2">
            <a asp-action="Create" class="btn uneti-btn-primary shadow-sm text-decoration-none d-flex align-items-center gap-1">
                <i class="bi bi-person-plus-fill"></i>
                <span>Thêm mới học viên</span>
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary shadow-sm text-decoration-none d-flex align-items-center gap-1">
                <i class="bi bi-arrow-clockwise"></i>
                <span>Tải lại</span>
            </a>
        </div>
    </div>

    <!-- Thông báo TempData -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show uneti-card border-success-subtle mb-4 py-3" role="alert">
            <i class="bi bi-check-circle-fill text-success me-2 fs-5 align-middle"></i>
            <span class="align-middle fw-semibold text-dark">@TempData["SuccessMessage"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show uneti-card border-danger-subtle mb-4 py-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill text-danger me-2 fs-5 align-middle"></i>
            <span class="align-middle fw-semibold text-dark">@TempData["ErrorMessage"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- 4 THẺ THỐNG KÊ (STAT CARDS) -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="uneti-card p-3 shadow-sm h-100 border-0">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-medium text-uppercase">Tổng số học viên</span>
                        <h3 class="fw-bold text-dark mt-1 mb-0">@Model.TongSoHocVien</h3>
                        <small class="text-primary uneti-fs-xs"><i class="bi bi-person-badge me-1"></i>Hồ sơ lưu trữ</small>
                    </div>
                    <div class="uneti-icon-box-48 bg-primary-subtle text-primary rounded-3">
                        <i class="bi bi-people fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="uneti-card p-3 shadow-sm h-100 border-0">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-medium text-uppercase">Đang hoạt động</span>
                        <h3 class="fw-bold text-success mt-1 mb-0">@Model.SoHocVienHoatDong</h3>
                        <small class="text-muted uneti-fs-xs">Tài khoản hợp lệ</small>
                    </div>
                    <div class="uneti-icon-box-48 bg-success-subtle text-success rounded-3">
                        <i class="bi bi-check-circle fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="uneti-card p-3 shadow-sm h-100 border-0">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-medium text-uppercase">Đang bị khóa</span>
                        <h3 class="fw-bold text-danger mt-1 mb-0">@Model.SoHocVienBiKhoa</h3>
                        <small class="text-muted uneti-fs-xs">Tạm ngừng giao dịch</small>
                    </div>
                    <div class="uneti-icon-box-48 bg-danger-subtle text-danger rounded-3">
                        <i class="bi bi-lock fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="uneti-card p-3 shadow-sm h-100 border-0">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-medium text-uppercase">Đã đăng ký khóa</span>
                        <h3 class="fw-bold text-warning-emphasis mt-1 mb-0">@Model.SoHocVienCoDangKy</h3>
                        <small class="text-muted uneti-fs-xs">Có dữ liệu học tập</small>
                    </div>
                    <div class="uneti-icon-box-48 bg-warning-subtle text-warning-emphasis rounded-3">
                        <i class="bi bi-mortarboard fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- KHỐI BỘ LỌC VÀ TÌM KIẾM -->
    <div class="uneti-card p-4 shadow-sm mb-4">
        <form method="get" asp-action="Index" class="row g-3 align-items-end">
            <!-- Tìm kiếm từ khóa -->
            <div class="col-lg-3 col-md-6">
                <label asp-for="SearchString" class="form-label small fw-semibold text-secondary">Tìm kiếm học viên</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" asp-for="SearchString" class="form-control border-start-0" placeholder="Tên, SĐT, email, mã HV..." />
                </div>
            </div>

            <!-- Lọc trạng thái -->
            <div class="col-lg-2 col-md-3 col-sm-6">
                <label asp-for="TrangThai" class="form-label small fw-semibold text-secondary">Trạng thái hồ sơ</label>
                <select asp-for="TrangThai" class="form-select">
                    <option value="TatCa">Tất cả trạng thái</option>
                    <option value="HoatDong">Đang hoạt động</option>
                    <option value="BiKhoa">Đang bị khóa</option>
                </select>
            </div>

            <!-- Lọc trình độ -->
            <div class="col-lg-2 col-md-3 col-sm-6">
                <label asp-for="TrinhDo" class="form-label small fw-semibold text-secondary">Trình độ học vấn</label>
                <select asp-for="TrinhDo" class="form-select">
                    <option value="TatCa">Tất cả trình độ</option>
                    <option value="Đại học">Đại học</option>
                    <option value="Cao đẳng">Cao đẳng</option>
                    <option value="Cử nhân">Cử nhân</option>
                    <option value="Kỹ sư">Kỹ sư</option>
                    <option value="Thạc sĩ">Thạc sĩ</option>
                </select>
            </div>

            <!-- Sắp xếp -->
            <div class="col-lg-3 col-md-6 col-sm-6">
                <label asp-for="SortBy" class="form-label small fw-semibold text-secondary">Sắp xếp theo</label>
                <select asp-for="SortBy" class="form-select">
                    <option value="ngay_desc">Ngày tham gia mới nhất</option>
                    <option value="ngay_asc">Ngày tham gia cũ nhất</option>
                    <option value="ten_asc">Tên học viên: A &rarr; Z</option>
                    <option value="ten_desc">Tên học viên: Z &rarr; A</option>
                </select>
            </div>

            <!-- Nút bấm -->
            <div class="col-lg-2 col-md-6 col-sm-6 d-flex gap-2">
                <button type="submit" class="btn uneti-btn-primary w-100 fw-semibold">
                    <i class="bi bi-filter me-1"></i>Lọc
                </button>
                <a asp-action="Index" class="btn btn-light border text-muted" title="Xóa bộ lọc">
                    <i class="bi bi-x-circle"></i>
                </a>
            </div>
        </form>
    </div>

    <!-- BẢNG DANH SÁCH HỌC VIÊN -->
    <div class="uneti-card shadow-sm overflow-hidden mb-4">
        <!-- Thanh tiêu đề bảng -->
        <div class="px-3 py-2.5 bg-white border-bottom d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div class="d-flex align-items-center gap-2">
                <span class="d-inline-flex align-items-center justify-content-center bg-primary-subtle text-primary rounded-2" style="width: 32px; height: 32px;">
                    <i class="bi bi-people-fill fs-6"></i>
                </span>
                <span class="fw-bold text-dark small text-uppercase" style="letter-spacing: 0.03em;">Danh sách hồ sơ học viên</span>
                <span class="badge bg-primary-subtle text-primary rounded-pill px-2.5 py-1 fw-semibold" style="font-size: 11px;">
                    @Model.TotalItems hồ sơ
                </span>
            </div>
            <div class="small text-muted">
                Trang <strong class="text-dark">@Model.PageIndex</strong> / @Math.Max(1, Model.TotalPages)
            </div>
        </div>

        <div class="w-100" style="overflow: visible;">
            <table class="table table-hover align-middle mb-0 uneti-table w-100" style="table-layout: auto;">
                <thead class="table-light border-bottom">
                    <tr class="small text-secondary text-uppercase fw-semibold" style="letter-spacing: 0.02em; font-size: 11px;">
                        <th class="ps-3 text-center" style="width: 7%;">Mã HV</th>
                        <th style="width: 24%;">Học viên</th>
                        <th style="width: 14%;">Ngày sinh / GT</th>
                        <th style="width: 20%;">Liên hệ</th>
                        <th class="text-center" style="width: 10%;">Trình độ</th>
                        <th class="text-center" style="width: 8%;">Khóa học</th>
                        <th class="text-center" style="width: 9%;">Trạng thái</th>
                        <th class="text-center" style="width: 8%;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.DanhSachHocVien.Any())
                    {
                        foreach (var item in Model.DanhSachHocVien)
                        {
                            <tr>
                                <td class="ps-3 text-center">
                                    <span class="badge bg-light text-secondary border font-monospace fw-semibold px-2 py-1" style="font-size: 11.5px;">
                                        #HV@(item.MaHocVien.ToString("D3"))
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2.5">
                                        @{
                                            var avatarUrl = !string.IsNullOrEmpty(item.HinhAnh) 
                                                ? item.HinhAnh 
                                                : "/images/avatars/default.svg";
                                        }
                                        <img src="@avatarUrl" alt="@item.HoTen" class="rounded-circle border border-2 border-white shadow-sm object-fit-cover flex-shrink-0" style="width: 34px; height: 34px;" />
                                        <div class="min-w-0">
                                            <a asp-action="Details" asp-route-id="@item.MaHocVien" class="fw-bold text-dark text-decoration-none d-block lh-sm mb-1 text-truncate" title="@item.HoTen" style="font-size: 0.92rem;">
                                                @item.HoTen
                                            </a>
                                            @if (!string.IsNullOrEmpty(item.TenDangNhap))
                                            {
                                                <span class="text-muted uneti-fs-xs font-monospace">
                                                    <i class="bi bi-at text-secondary opacity-75"></i>@item.TenDangNhap
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle" style="font-size: 10px; padding: 1px 6px;">
                                                    Chưa có tài khoản
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="small text-dark mb-1 d-flex align-items-center">
                                        <i class="bi bi-calendar3 me-1.5 text-primary opacity-75" style="font-size: 11px;"></i>
                                        <span class="fw-medium">@(item.NgaySinh.HasValue ? item.NgaySinh.Value.ToString("dd/MM/yyyy") : "Chưa cập nhật")</span>
                                    </div>
                                    <div>
                                        @if (item.GioiTinh == "Nữ")
                                        {
                                            <span class="badge rounded-pill bg-danger-subtle text-danger border border-danger-subtle fw-medium" style="font-size: 11px; padding: 2px 8px;">
                                                <i class="bi bi-gender-female me-1"></i>Nữ
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill bg-primary-subtle text-primary border border-primary-subtle fw-medium" style="font-size: 11px; padding: 2px 8px;">
                                                <i class="bi bi-gender-male me-1"></i>@(item.GioiTinh ?? "Nam")
                                            </span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <div class="small mb-1">
                                        <a href="tel:@item.SoDienThoai" class="text-decoration-none text-dark fw-medium d-inline-flex align-items-center">
                                            <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary-subtle text-primary me-1.5 flex-shrink-0" style="width: 22px; height: 22px; font-size: 11px;">
                                                <i class="bi bi-telephone-fill"></i>
                                            </span>
                                            <span>@item.SoDienThoai</span>
                                        </a>
                                    </div>
                                    <div class="small">
                                        <a href="mailto:@item.Email" class="text-decoration-none text-muted d-inline-flex align-items-center text-truncate" style="max-width: 180px;" title="@item.Email">
                                            <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-secondary-subtle text-secondary me-1.5 flex-shrink-0" style="width: 22px; height: 22px; font-size: 11px;">
                                                <i class="bi bi-envelope-fill"></i>
                                            </span>
                                            <span class="text-truncate">@item.Email</span>
                                        </a>
                                    </div>
                                </td>
                                <td class="text-center">
                                    @{
                                        var trinhDoBadge = (item.TrinhDo ?? "Đại học") switch
                                        {
                                            "Thạc sĩ" => "bg-indigo-subtle text-primary border-primary-subtle",
                                            "Kỹ sư" => "bg-info-subtle text-info-emphasis border-info-subtle",
                                            "Cử nhân" => "bg-teal-subtle text-success border-success-subtle",
                                            "Cao đẳng" => "bg-warning-subtle text-warning-emphasis border-warning-subtle",
                                            "Đại học" => "bg-primary-subtle text-primary border-primary-subtle",
                                            _ => "bg-light text-secondary border"
                                        };
                                    }
                                    <span class="badge @trinhDoBadge border px-2.5 py-1 small fw-medium rounded-pill">
                                        <i class="bi bi-mortarboard me-1"></i>@(item.TrinhDo ?? "Đại học")
                                    </span>
                                </td>
                                <td class="text-center">
                                    @if (item.SoKhoaHocDaDangKy > 0)
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2.5 py-1 rounded-pill fw-semibold">
                                            <i class="bi bi-book-half me-1"></i>@item.SoKhoaHocDaDangKy khóa
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border px-2.5 py-1 rounded-pill fw-normal">
                                            0 khóa
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (item.TrangThai)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1 rounded-pill fw-medium d-inline-flex align-items-center gap-1">
                                            <span class="rounded-circle bg-success d-inline-block" style="width: 6px; height: 6px;"></span>
                                            <span>Hoạt động</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2.5 py-1 rounded-pill fw-medium d-inline-flex align-items-center gap-1">
                                            <i class="bi bi-lock-fill" style="font-size: 11px;"></i>
                                            <span>Bị khóa</span>
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="d-flex align-items-center justify-content-center gap-1">
                                        <!-- Xem chi tiết -->
                                        <a asp-action="Details" asp-route-id="@item.MaHocVien" 
                                           class="btn-action-icon btn-action-primary" 
                                           title="Xem chi tiết hồ sơ">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <!-- Chỉnh sửa -->
                                        <a asp-action="Edit" asp-route-id="@item.MaHocVien" 
                                           class="btn-action-icon btn-action-edit" 
                                           title="Chỉnh sửa thông tin">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <!-- Khóa / Mở khóa -->
                                        <form asp-action="ToggleTrangThai" asp-route-id="@item.MaHocVien" method="post" class="d-inline m-0 p-0">
                                            @Html.AntiForgeryToken()
                                            @if (item.TrangThai)
                                            {
                                                <button type="submit" class="btn-action-icon btn-action-lock" 
                                                        title="Khóa hồ sơ học viên"
                                                        onclick="return confirm('Bạn có chắc chắn muốn KHÓA tài khoản học viên @item.HoTen?');">
                                                    <i class="bi bi-lock-fill"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn-action-icon btn-action-unlock" 
                                                        title="Mở khóa hồ sơ học viên"
                                                        onclick="return confirm('Bạn có chắc chắn muốn MỞ KHÓA tài khoản học viên @item.HoTen?');">
                                                    <i class="bi bi-unlock-fill"></i>
                                                </button>
                                            }
                                        </form>

                                        <!-- Xóa -->
                                        <a asp-action="Delete" asp-route-id="@item.MaHocVien" 
                                           class="btn-action-icon btn-action-delete" 
                                           title="Xóa hồ sơ học viên"
                                           onclick="return confirm('Bạn có chắc chắn muốn xóa hồ sơ học viên @item.HoTen?');">
                                            <i class="bi bi-trash3"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <div class="py-4">
                                    <div class="d-inline-flex align-items-center justify-content-center bg-light rounded-circle mb-3 text-muted" style="width: 56px; height: 56px;">
                                        <i class="bi bi-person-x fs-2"></i>
                                    </div>
                                    <p class="mb-1 fw-semibold text-secondary">Không tìm thấy học viên nào phù hợp với điều kiện tìm kiếm.</p>
                                    <small class="text-muted">Thử thay đổi từ khóa hoặc thiết lập lại bộ lọc để tra cứu lại.</small>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- PHÂN TRANG THEO CHUẨN LINQ SKIP() & TAKE() -->
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-white border-top py-3 px-4 d-flex flex-wrap align-items-center justify-content-between gap-2">
                <div class="small text-muted">
                    Hiển thị <strong>@(((Model.PageIndex - 1) * Model.PageSize) + 1)</strong> - <strong>@(Math.Min(Model.PageIndex * Model.PageSize, Model.TotalItems))</strong> trong tổng số <strong>@Model.TotalItems</strong> học viên
                </div>
                <nav aria-label="Page navigation">
                    <ul class="pagination pagination-sm mb-0">
                        <!-- Trang đầu -->
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Index"
                               asp-route-pageIndex="1"
                               asp-route-pageSize="@Model.PageSize"
                               asp-route-searchString="@Model.SearchString"
                               asp-route-trangThai="@Model.TrangThai"
                               asp-route-trinhDo="@Model.TrinhDo"
                               asp-route-sortBy="@Model.SortBy">
                                <i class="bi bi-chevron-double-left"></i>
                            </a>
                        </li>
                        <!-- Trang trước -->
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Index"
                               asp-route-pageIndex="@(Model.PageIndex - 1)"
                               asp-route-pageSize="@Model.PageSize"
                               asp-route-searchString="@Model.SearchString"
                               asp-route-trangThai="@Model.TrangThai"
                               asp-route-trinhDo="@Model.TrinhDo"
                               asp-route-sortBy="@Model.SortBy">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>

                        @for (int p = Math.Max(1, Model.PageIndex - 2); p <= Math.Min(Model.TotalPages, Model.PageIndex + 2); p++)
                        {
                            <li class="page-item @(p == Model.PageIndex ? "active" : "")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-pageIndex="@p"
                                   asp-route-pageSize="@Model.PageSize"
                                   asp-route-searchString="@Model.SearchString"
                                   asp-route-trangThai="@Model.TrangThai"
                                   asp-route-trinhDo="@Model.TrinhDo"
                                   asp-route-sortBy="@Model.SortBy">@p</a>
                            </li>
                        }

                        <!-- Trang sau -->
                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Index"
                               asp-route-pageIndex="@(Model.PageIndex + 1)"
                               asp-route-pageSize="@Model.PageSize"
                               asp-route-searchString="@Model.SearchString"
                               asp-route-trangThai="@Model.TrangThai"
                               asp-route-trinhDo="@Model.TrinhDo"
                               asp-route-sortBy="@Model.SortBy">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                        <!-- Trang cuối -->
                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Index"
                               asp-route-pageIndex="@Model.TotalPages"
                               asp-route-pageSize="@Model.PageSize"
                               asp-route-searchString="@Model.SearchString"
                               asp-route-trangThai="@Model.TrangThai"
                               asp-route-trinhDo="@Model.TrinhDo"
                               asp-route-sortBy="@Model.SortBy">
                                <i class="bi bi-chevron-double-right"></i>
                            </a>
