@*
    Họ và tên: Trần Văn Thành
    Mã sinh viên: 23103100076
    Nội dung: Trang chủ hệ thống
*@

@model IEnumerable<HeThongQuanLyKhoaHocVaDangKy_3_UNETI3_TIN17A2HN.Models.MonHoc>
@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Trang chủ";
    var maTaiKhoan = Context.Session.GetInt32("MaTaiKhoan");
    var hoTen = Context.Session.GetString("HoTen");
    var tenDangNhap = Context.Session.GetString("TenDangNhap");
    var vaiTro = Context.Session.GetString("VaiTro");
    var isLoggedIn = maTaiKhoan != null;
}

<div class="container py-4">
    <!-- Thông báo TempData -->
    <noscript>
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show uneti-card border-success-subtle mb-4 py-3" role="alert">
                <i class="bi bi-check-circle-fill text-success me-2 fs-5 align-middle"></i>
                <span class="align-middle fw-semibold text-dark">@TempData["SuccessMessage"]</span>
            </div>
        }
    </noscript>

    <!-- Hero Banner -->
    <div class="uneti-hero-banner mb-4 position-relative">
        <!-- Floating Micro-Decorations -->
        <div class="uneti-hero-floating-badge fx-float-slow d-none d-lg-flex" data-parallax="14">
            <i class="bi bi-patch-check-fill text-primary"></i>
            <span>Chuẩn Đào Tạo Tín Chỉ</span>
        </div>
        <div class="uneti-hero-floating-badge-2 fx-float-reverse d-none d-xl-flex" data-parallax="-12">
            <i class="bi bi-shield-lock-fill text-success"></i>
            <span>Hệ Thống Quản Lý Khóa Học Trực Tuyến</span>
        </div>

        <div class="uneti-banner-content">
            <!-- Badge nhận diện -->
            <div class="uneti-banner-badge">
                <i class="bi bi-mortarboard-fill"></i>
                <span>Cổng đào tạo trực tuyến UNETI</span>
            </div>
            
            <!-- Tiêu đề lớn chuẩn mẫu -->
            <h1 class="uneti-banner-title">
                HỆ THỐNG QUẢN LÝ KHÓA HỌC <br />
                &amp; ĐĂNG KÝ HỌC TẬP
            </h1>
            
            <!-- Mô tả ngắn gọn, tinh tế chuẩn mẫu -->
            <p class="uneti-banner-desc">
                Học tập linh hoạt, nâng cao tri thức, phát triển bản thân<br class="d-none d-md-inline" />
                cùng hệ thống đào tạo trực tuyến hiện đại.
            </p>

            <!-- Nút hành động -->
            <div class="uneti-banner-actions d-flex flex-wrap align-items-center gap-3">
                @if (isLoggedIn)
                {
                    @if (vaiTro == "Admin" || vaiTro == "NhanVien")
                    {
                        <a asp-controller="QuanTri" asp-action="Dashboard" class="uneti-btn-banner-primary">
                            <i class="bi bi-speedometer2 fs-5"></i>
                            <span>Quản trị</span>
                        </a>
                        <a asp-controller="MonHoc" asp-action="Index" class="uneti-btn-banner-secondary">
                            <i class="bi bi-search fs-5"></i>
                            <span>Tra cứu môn học</span>
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    }
                    else
                    {
                        <!-- Nút chức năng học viên -->
                        <a asp-controller="MonHoc" asp-action="Index" class="uneti-btn-banner-primary">
                            <i class="bi bi-search fs-5"></i>
                            <span>Tra cứu môn học</span>
                        </a>
                        <a href="#lo-trinh-dao-tao" class="uneti-btn-banner-secondary">
                            <i class="bi bi-diagram-3 fs-5"></i>
                            <span>Lộ trình đào tạo</span>
                            <i class="bi bi-arrow-down-short fs-5"></i>
                        </a>
                    }
                }
                else
                {
                    <!-- Khách chưa đăng nhập: Chuẩn 100% mẫu Ảnh 2 -->
                    <a asp-controller="TaiKhoan" asp-action="Login" class="uneti-btn-banner-primary">
                        <i class="bi bi-box-arrow-in-right fs-5"></i>
                        <span>Đăng nhập</span>
                    </a>
                    <a asp-controller="MonHoc" asp-action="Index" class="uneti-btn-banner-secondary">
                        <i class="bi bi-list-task fs-5"></i>
                        <span>Xem danh mục môn học</span>
                        <i class="bi bi-arrow-right"></i>
                    </a>
                }
            </div>
        </div>
    </div>

    @{
        var tongMon = ViewBag.TongMon != null ? (int)ViewBag.TongMon : 0;
        var tongTinChi = ViewBag.TongTinChi != null ? (int)ViewBag.TongTinChi : 0;
        var hocPhiTb = ViewBag.HocPhiTb != null ? Convert.ToDecimal(ViewBag.HocPhiTb) : 0m;
        var hocPhiThapNhat = ViewBag.HocPhiThapNhat != null ? Convert.ToDecimal(ViewBag.HocPhiThapNhat) : 0m;

        // Làm tròn học phí trung bình
        var hocPhiTbTron = Math.Floor(hocPhiTb / 1000m) * 1000m;
        var hocPhiTbCount = (long)hocPhiTbTron;
        var hocPhiThapNhatCount = (long)Math.Round(hocPhiThapNhat);
    }
    <!-- 2. DẢI SỐ LIỆU THỐNG KÊ NHANH (HERO STAT STRIP) -->
    <div class="uneti-stat-strip mb-5 reveal">
        <div class="row g-3 text-center text-md-start">
            <div class="col-6 col-lg-3">
                <div class="uneti-stat-strip-item justify-content-center justify-content-md-start">
                    <div class="uneti-stat-strip-icon bg-primary-subtle text-primary">
                        <i class="bi bi-book-half"></i>
                    </div>
                    <div>
                        <div class="fs-4 fw-bold text-dark lh-1">
                            <span data-count-to="@tongMon" data-format="number">@tongMon</span>
                        </div>
                        <div class="small text-muted mt-1">Môn học đang mở</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="uneti-stat-strip-item justify-content-center justify-content-md-start">
                    <div class="uneti-stat-strip-icon bg-success-subtle text-success">
                        <i class="bi bi-award"></i>
                    </div>
                    <div>
                        <div class="fs-4 fw-bold text-dark lh-1">
                            <span data-count-to="@tongTinChi" data-format="number">@tongTinChi</span>
                        </div>
                        <div class="small text-muted mt-1">Tổng số tín chỉ</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="uneti-stat-strip-item justify-content-center justify-content-md-start">
                    <div class="uneti-stat-strip-icon bg-warning-subtle text-warning">
                        <i class="bi bi-cash-stack"></i>
                    </div>
                    <div>
                        <div class="fs-4 fw-bold text-dark lh-1">
                            <span data-count-to="@hocPhiTbCount" data-format="currency">@hocPhiTbTron.ToString("N0") đ</span>
                        </div>
                        <div class="small text-muted mt-1">Học phí trung bình mỗi môn</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="uneti-stat-strip-item justify-content-center justify-content-md-start">
                    <div class="uneti-stat-strip-icon bg-info-subtle text-info">
                        <i class="bi bi-tag-fill"></i>
                    </div>
                    <div>
                        <div class="fs-4 fw-bold text-dark lh-1">
                            <small class="fs-6 fw-normal text-muted me-1" style="display: inline-block; margin-right: 5px;">Từ</small><span data-count-to="@hocPhiThapNhatCount" data-format="currency">@hocPhiThapNhat.ToString("N0") đ</span>
                        </div>
                        <div class="small text-muted mt-1">Học phí thấp nhất</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. MÔN HỌC TIÊU BIỂU - LIVE TỪ CSDL -->
    <div class="mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3 reveal">
            <div>
                <h5 class="fw-bold text-dark mb-0">
                    <i class="bi bi-stars text-warning me-1"></i>Môn Học Tiêu Biểu Trong Chương Trình
                </h5>
                <small class="text-muted">Dữ liệu thực tế được cập nhật trực tiếp từ Cơ sở dữ liệu đào tạo</small>
            </div>
            <a asp-controller="MonHoc" asp-action="Index" class="btn uneti-btn-outline btn-sm py-1 px-3 text-decoration-none">
                Xem toàn bộ <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>

        <div class="row g-3">
            @if (Model != null && Model.Any())
            {
                var cardIdx = 0;
                @foreach (var mon in Model)
                {
                    <div class="col-md-4 reveal" style="--i: @cardIdx;">
                        <div class="uneti-card uneti-card-hover h-100 p-4 d-flex flex-column" data-tilt>
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-light text-secondary border px-2 py-1">#MH@(mon.MaMonHoc.ToString("D3"))</span>
                                <span class="uneti-badge-success">
                                    <i class="bi bi-check-circle me-1"></i>Đang mở
                                </span>
                            </div>

                            <h6 class="fw-bold text-dark mb-2">@mon.TenMonHoc</h6>
                            <p class="text-muted small flex-grow-1 mb-3">
                                @(string.IsNullOrEmpty(mon.MoTa) ? "Môn học thuộc chương trình đào tạo theo hệ thống tín chỉ." : mon.MoTa)
                            </p>

                            <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                <span class="uneti-badge-primary">
                                    <span data-count-to="@mon.SoTinChi" data-format="number">@mon.SoTinChi</span> Tín chỉ
                                </span>
                                <span class="fw-bold text-primary" data-count-to="@mon.HocPhi" data-format="currency">
                                    @mon.HocPhi.ToString("N0") đ
                                </span>
                            </div>

                            <a asp-controller="MonHoc" asp-action="Details" asp-route-id="@mon.MaMonHoc" class="btn uneti-btn-outline btn-sm w-100 mt-3 text-decoration-none">
                                Xem chi tiết môn học <i class="bi bi-chevron-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                    cardIdx++;
                }
            }
        </div>
    </div>

    <!-- Quy trình đăng ký và học tập -->
    <div class="mt-5 mb-4" id="lo-trinh-dao-tao">
        <div class="text-center mb-4 reveal">
            <span class="badge px-3 py-1 rounded-pill fw-semibold text-uppercase small mb-2" 
                  style="background-color: var(--uneti-primary-light); color: var(--uneti-primary); border: 1px solid var(--uneti-primary-border);">
                <i class="bi bi-diagram-3-fill me-1"></i>LỘ TRÌNH ĐÀO TẠO THEO TÍN CHỈ
            </span>
            <h4 class="fw-bold text-dark mb-1">Quy Trình Đăng Ký & Học Tập</h4>
            <p class="text-muted small mb-0">3 bước chuẩn mực giúp sinh viên chủ động xây dựng kế hoạch và hoàn thành chương trình học tập</p>
        </div>

        <div class="row g-4 uneti-timeline-steps">
            <!-- Bước 1: Tra cứu môn học -->
            <div class="col-lg-4 col-md-6 reveal" style="--i: 0;">
                <div class="uneti-card uneti-card-hover h-100 p-4 d-flex flex-column position-relative shadow-sm rounded-4" data-tilt>
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="d-inline-flex align-items-center justify-content-center rounded-3 fs-4" 
                              style="width: 52px; height: 52px; background-color: #eff6ff; color: #1d4ed8; border: 1.5px solid #bfdbfe;">
                            <i class="bi bi-journal-bookmark-fill"></i>
                        </div>
                        <div class="text-end">
                            <span class="badge rounded-pill fw-bold" style="background-color: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; font-size: 12px; padding: 6px 14px;">
                                BƯỚC 01
                            </span>
                        </div>
                    </div>

                    <h5 class="fw-bold text-dark mb-2">Tra Cứu Môn Học & CTĐT</h5>
                    <p class="text-muted small mb-3">
                        Tra cứu danh mục môn học thuộc chương trình khung đào tạo, tìm hiểu số tín chỉ, định mức học phí và thông tin học phần.
                    </p>

                    <div class="p-3 rounded-3 mb-3 small" style="background-color: #f8fafc; border: 1px solid #e2e8f0;">
                        <div class="mb-1 text-secondary"><i class="bi bi-check2-circle text-primary me-2"></i>Tra cứu số tín chỉ & định mức học phí</div>
                        <div class="text-secondary"><i class="bi bi-check2-circle text-primary me-2"></i>Xem mô tả chi tiết & chuẩn học phần</div>
                    </div>

                    <a asp-controller="MonHoc" asp-action="Index" class="btn uneti-btn-outline btn-sm w-100 mt-auto rounded-3">
                        <i class="bi bi-search me-1"></i>Tra cứu danh mục môn học
                    </a>
                </div>
            </div>

            <!-- Bước 2: Chọn khóa học -->
            <div class="col-lg-4 col-md-6 reveal" style="--i: 1;">
                <div class="uneti-card uneti-card-hover h-100 p-4 d-flex flex-column position-relative shadow-sm rounded-4" data-tilt>
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="d-inline-flex align-items-center justify-content-center rounded-3 fs-4" 
                              style="width: 52px; height: 52px; background-color: #f0fdf4; color: #16a34a; border: 1.5px solid #bbf7d0;">
                            <i class="bi bi-calendar2-week-fill"></i>
                        </div>
                        <div class="text-end">
                            <span class="badge rounded-pill fw-bold" style="background-color: #f0fdf4; color: #16a34a; border: 1px solid #bbf7d0; font-size: 12px; padding: 6px 14px;">
                                BƯỚC 02
                            </span>
                        </div>
                    </div>

                    <h5 class="fw-bold text-dark mb-2">Lựa Chọn Khóa Học Phù Hợp</h5>
                    <p class="text-muted small mb-3">
                        Khám phá các lớp khóa học phù hợp với kế hoạch cá nhân, chuẩn bị thông tin trước các đợt mở lớp học phần.
                    </p>

                    <div class="p-3 rounded-3 mb-3 small" style="background-color: #f8fafc; border: 1px solid #e2e8f0;">
                        <div class="mb-1 text-secondary"><i class="bi bi-clock-history text-success me-2"></i>Kế hoạch mở lớp dự kiến <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle ms-1" style="font-size: 10px;">Sắp ra mắt</span></div>
                        <div class="text-secondary"><i class="bi bi-clock-history text-success me-2"></i>Thông tin lớp học phần & giảng viên <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle ms-1" style="font-size: 10px;">Sắp ra mắt</span></div>
                    </div>

                    <button type="button" class="btn uneti-btn-outline btn-sm w-100 mt-auto rounded-3" 
                            onclick="thongBaoModule(2)">
                        <i class="bi bi-calendar-check me-1"></i>Xem kế hoạch mở lớp
                    </button>
                </div>
            </div>

            <!-- Bước 3: Đăng ký trực tuyến -->
            <div class="col-lg-4 col-md-12 reveal" style="--i: 2;">
                <div class="uneti-card uneti-card-hover h-100 p-4 d-flex flex-column position-relative shadow-sm rounded-4" data-tilt>
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="d-inline-flex align-items-center justify-content-center rounded-3 fs-4" 
                              style="width: 52px; height: 52px; background-color: #fffbeb; color: #d97706; border: 1.5px solid #fde68a;">
                            <i class="bi bi-mortarboard-fill"></i>
                        </div>
                        <div class="text-end">
                            <span class="badge rounded-pill fw-bold" style="background-color: #fffbeb; color: #d97706; border: 1px solid #fde68a; font-size: 12px; padding: 6px 14px;">
                                BƯỚC 03
                            </span>
                        </div>
                    </div>

                    <h5 class="fw-bold text-dark mb-2">Đăng Ký & Theo Dõi Tiến Độ</h5>
                    <p class="text-muted small mb-3">
                        Ghi danh học phần trực tuyến tức thì và theo dõi lịch trình đào tạo minh bạch suốt học kỳ khi cổng đăng ký mở.
                    </p>

                    <div class="p-3 rounded-3 mb-3 small bg-light border">
                        <div class="mb-1 text-secondary"><i class="bi bi-clock-history text-warning me-2"></i>Đăng ký học trực tuyến <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle ms-1" style="font-size: 10px;">Sắp ra mắt</span></div>
                        <div class="text-secondary"><i class="bi bi-clock-history text-warning me-2"></i>Theo dõi tiến độ & thời khóa biểu cá nhân <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle ms-1" style="font-size: 10px;">Sắp ra mắt</span></div>
                    </div>

                    <button type="button" class="btn uneti-btn-primary btn-sm w-100 mt-auto rounded-3" 
                            onclick="thongBaoModule(4)">
                        <i class="bi bi-arrow-right-circle me-1"></i>Đăng ký học trực tuyến
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- 5. VÌ SAO CHỌN HỆ THỐNG ĐÀO TẠO -->
    <div class="mt-5 mb-5">
        <div class="text-center mb-4 reveal">
            <span class="badge px-3 py-1 rounded-pill fw-semibold text-uppercase small mb-2" 
                  style="background-color: var(--uneti-primary-light); color: var(--uneti-primary); border: 1px solid var(--uneti-primary-border);">
                <i class="bi bi-shield-check me-1"></i>ƯU ĐIỂM VƯỢT TRỘI
            </span>
            <h4 class="fw-bold text-dark mb-1">Vì Sao Lựa Chọn Cổng Đào Tạo Trực Tuyến?</h4>
            <p class="text-muted small mb-0">Hệ sinh thái công nghệ giáo dục hiện đại, lấy sinh viên làm trọng tâm phát triển</p>
        </div>

        <div class="row g-4">
            <div class="col-md-6 col-lg-3 reveal" style="--i: 0;">
                <div class="uneti-feature-box">
                    <div class="uneti-feature-icon bg-primary-subtle text-primary">
                        <i class="bi bi-mortarboard"></i>
                    </div>
                    <h6 class="fw-bold text-dark mb-2">Chuẩn Tín Chỉ Bộ GD&ĐT</h6>
                    <p class="text-muted small mb-0">
                        Chương trình đào tạo thiết kế theo học chế tín chỉ linh hoạt, chuyển tiếp và công nhận kết quả học tập liên thông chuẩn mực.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-3 reveal" style="--i: 1;">
                <div class="uneti-feature-box">
                    <div class="uneti-feature-icon bg-success-subtle text-success">
                        <i class="bi bi-lightning-charge"></i>
                    </div>
                    <h6 class="fw-bold text-dark mb-2">Tra Cứu Nhanh Chóng & Tiện Lợi</h6>
                    <p class="text-muted small mb-0">
                        Giao diện tối ưu phản hồi nhanh, hỗ trợ sinh viên dễ dàng tìm kiếm môn học, tra cứu số tín chỉ và học phí thuận tiện.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-3 reveal" style="--i: 2;">
                <div class="uneti-feature-box">
                    <div class="uneti-feature-icon bg-warning-subtle text-warning">
                        <i class="bi bi-shield-lock"></i>
                    </div>
                    <h6 class="fw-bold text-dark mb-2">Minh Bạch Thông Tin Học Phí</h6>
                    <p class="text-muted small mb-0">
                        Định mức học phí từng môn học được công khai rõ ràng, giúp người học chủ động xây dựng kế hoạch tài chính học tập.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-3 reveal" style="--i: 3;">
                <div class="uneti-feature-box">
                    <div class="uneti-feature-icon bg-info-subtle text-info">
                        <i class="bi bi-headset"></i>
                    </div>
                    <h6 class="fw-bold text-dark mb-2">Hỗ Trợ Học Tập 24/7</h6>
                    <p class="text-muted small mb-0">
                        Đội ngũ cán bộ phòng Đào tạo và cố vấn học tập luôn sẵn sàng giải đáp thắc mắc về kế hoạch đào tạo và đăng ký học phần.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- 6. CÂU HỎI THƯỜNG GẶP (FAQ) -->
    <div class="mt-5 mb-5">
        <div class="text-center mb-4 reveal">
            <span class="badge px-3 py-1 rounded-pill fw-semibold text-uppercase small mb-2" 
                  style="background-color: var(--uneti-primary-light); color: var(--uneti-primary); border: 1px solid var(--uneti-primary-border);">
                <i class="bi bi-question-circle me-1"></i>GIẢI ĐÁP THẮC MẮC
            </span>
            <h4 class="fw-bold text-dark mb-1">Câu Hỏi Thường Gặp (FAQ)</h4>
            <p class="text-muted small mb-0">Những thông tin cần biết khi tham gia học tập và đăng ký học phần tại trường</p>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-9 reveal">
                <div class="accordion uneti-accordion" id="faqAccordion">
                    <!-- Câu 1 -->
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="headingOne">
                            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                                <i class="bi bi-person-plus text-primary me-2"></i> Làm thế nào để tạo tài khoản trên hệ thống?
                            </button>
                        </h2>
                        <div id="collapseOne" class="accordion-collapse collapse show" aria-labelledby="headingOne" data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                Bạn chỉ cần nhấn vào <strong>Đăng ký</strong> ở thanh menu hoặc trang chủ, điền họ tên, email, tên đăng nhập, mật khẩu và đồng ý với điều khoản sử dụng. Tài khoản học viên sẽ được tạo thành công ngay sau khi hoàn tất để bạn có thể đăng nhập.
                            </div>
                        </div>
                    </div>

                    <!-- Câu 2 -->
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="headingTwo">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                                <i class="bi bi-key text-primary me-2"></i> Tôi quên mật khẩu thì xử lý thế nào?
                            </button>
                        </h2>
                        <div id="collapseTwo" class="accordion-collapse collapse" aria-labelledby="headingTwo" data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                Tại màn hình đăng nhập, bạn chọn <strong>Quên mật khẩu?</strong> và nhập đúng địa chỉ email đã đăng ký. Hệ thống sẽ tạo liên kết đặt lại mật khẩu an toàn (có hiệu lực trong vòng 15 phút) hiển thị trực tiếp trên giao diện để bạn thiết lập lại mật khẩu mới.
                            </div>
                        </div>
                    </div>

                    <!-- Câu 3 -->
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="headingThree">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
                                <i class="bi bi-cash-coin text-primary me-2"></i> Học phí môn học được hiển thị ở đâu?
                            </button>
                        </h2>
                        <div id="collapseThree" class="accordion-collapse collapse" aria-labelledby="headingThree" data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                Định mức học phí của từng môn học được niêm yết công khai, minh bạch ngay trên từng thẻ môn học ở trang chủ, danh mục tra cứu môn học và trang chi tiết học phần để người học dễ dàng theo dõi.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- CTA Banner -->
    <div class="row justify-content-center mb-5 reveal">
        <div class="col-lg-9">
            <div class="uneti-cta-card">
                <div class="row align-items-center position-relative" style="z-index: 1;">
                    <div class="col-lg-7 col-xl-8">
                        <span class="badge bg-white bg-opacity-25 text-white px-3 py-1 rounded-pill small fw-semibold mb-2">
                            <i class="bi bi-mortarboard-fill me-1"></i>HỆ THỐNG ĐÀO TẠO 2026
                        </span>
                        @if (isLoggedIn)
                        {
                            @if (vaiTro == "Admin" || vaiTro == "NhanVien")
                            {
                                <h3 class="fw-bold mb-2">Xin chào, @hoTen!</h3>
                                <p class="mb-4" style="color: rgba(255,255,255,.88); max-width: 520px;">
                                    Chào mừng bạn trở lại bảng điều khiển. Quản lý danh mục môn học, giám sát học viên và theo dõi tiến độ đào tạo của toàn hệ thống.
                                </p>
                                <div>
                                    <a asp-controller="QuanTri" asp-action="Dashboard" class="btn btn-light fw-bold px-4 py-2 rounded-pill shadow">
                                        <i class="bi bi-speedometer2 me-1"></i>Vào bảng điều khiển
                                    </a>
                                </div>
                            }
                            else
                            {
                                <h3 class="fw-bold mb-2">Sẵn sàng cho kỳ học mới, @hoTen?</h3>
                                <p class="mb-4" style="color: rgba(255,255,255,.88); max-width: 520px;">
                                    Tra cứu danh mục môn học, xem số tín chỉ và học phí để chuẩn bị cho kỳ học mới.
                                </p>
                                <div>
                                    <a asp-controller="MonHoc" asp-action="Index" class="btn btn-light fw-bold px-4 py-2 rounded-pill shadow">
                                        <i class="bi bi-search me-1"></i>Tra cứu môn học ngay
                                    </a>
                                </div>
                            }
                        }
                        else
                        {
                            <h3 class="fw-bold mb-2">Khởi đầu hành trình học tập cùng UNETI</h3>
                            <p class="mb-4" style="color: rgba(255,255,255,.88); max-width: 520px;">
                                Tra cứu danh mục môn học, xem số tín chỉ và học phí để chuẩn bị cho kỳ học mới.
                            </p>
                            <div class="d-flex flex-wrap gap-2">
                                <a asp-controller="TaiKhoan" asp-action="Login" class="btn btn-light fw-bold px-4 py-2 rounded-pill shadow">
                                    <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập
                                </a>
                                <a asp-controller="TaiKhoan" asp-action="Register" class="btn btn-outline-light fw-bold px-4 py-2 rounded-pill">
                                    Đăng ký tài khoản
                                </a>
                            </div>
                        }
                    </div>
                    <div class="col-lg-5 col-xl-4 d-none d-lg-block">
                        <!-- Hình minh họa 3D -->
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
