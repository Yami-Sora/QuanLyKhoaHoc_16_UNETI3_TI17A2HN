@*
    Họ và tên: Trần Văn Thành
    Mã sinh viên: 23103100076
    Nội dung: Trang chủ hệ thống - Thiết kế lại giao diện (phong cách sáng, hiện đại, tối ưu trải nghiệm)
    Ghi chú: Có sử dụng AI hỗ trợ thiết kế giao diện (theo mục 20 của đề tài).
*@

@model IEnumerable<HeThongQuanLyKhoaHocVaDangKy_3_UNETI3_TIN17A2HN.Models.MonHoc>
@using HeThongQuanLyKhoaHocVaDangKy_3_UNETI3_TIN17A2HN.Helpers
@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Trang chủ - Cổng đào tạo & Đăng ký học tập";
    var maTaiKhoan = Context.Session.GetInt32("MaTaiKhoan");
    var hoTen = Context.Session.GetString("HoTen");
    var vaiTro = Context.Session.GetString("VaiTro");
    var isLoggedIn = maTaiKhoan != null;

    var tongSoMon = ViewBag.TongSoMon != null ? (int)ViewBag.TongSoMon : 12;
    var soMonDangMo = ViewBag.TongMonDangMo != null ? (int)ViewBag.TongMonDangMo : 10;
    var tongTinChi = ViewBag.TongTinChi != null ? (int)ViewBag.TongTinChi : 33;
    var hocPhiTb = ViewBag.HocPhiTb != null ? Convert.ToDecimal(ViewBag.HocPhiTb) : 3263000m;
    var hocPhiThapNhat = ViewBag.HocPhiThapNhat != null ? Convert.ToDecimal(ViewBag.HocPhiThapNhat) : 3000000m;
    var hocPhiTbTron = Math.Floor(hocPhiTb / 1000m) * 1000m;
    var hocPhiTbCount = (long)hocPhiTbTron;
    var hocPhiThapNhatCount = (long)Math.Round(hocPhiThapNhat);

    var tongHocVien = ViewBag.TongHocVien != null ? (int)ViewBag.TongHocVien : 1200;
}
<link rel="stylesheet" href="~/css/home-v2.css" asp-append-version="true" />

<div class="container py-3 py-md-4">
    <!-- Thông báo TempData -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            <span class="fw-semibold">@TempData["SuccessMessage"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    <!-- 1. HERO BANNER - HEADLINE MẠNH MẼ, ĐỊNH VỊ SẢN PHẨM -->
    <div class="uneti-hero-banner mb-4 position-relative" style="border-radius: 24px; min-height: 270px; padding: clamp(1.75rem, 3.2vw, 2.5rem) clamp(1.5rem, 3.5vw, 3rem) !important;">
        <div class="uneti-banner-content">
            <!-- Badge nhận diện dịch vụ -->
            <div class="uneti-banner-badge" style="background: rgba(255, 255, 255, 0.18); backdrop-filter: blur(8px); border-radius: 9999px; padding: 5px 16px; color: #ffffff; font-size: 12.5px; font-weight: 500; display: inline-flex; align-items: center; gap: 8px; margin-bottom: 1rem; border: 1px solid rgba(255,255,255,0.25);">
                <i class="bi bi-mortarboard-fill"></i>
                <span>Cổng đào tạo trực tuyến</span>
            </div>
            
            <!-- Headline mạnh mẽ, truyền cảm hứng hành động -->
            <h1 class="uneti-banner-title text-white fw-bold mb-3" style="font-size: clamp(2rem, 3.2vw, 2.85rem); line-height: 1.2; letter-spacing: -0.02em;">
                Học tập chủ động.<br />
                Đăng ký dễ dàng.
            </h1>
            
            <!-- Mô tả sản phẩm súc tích -->
            <p class="uneti-banner-desc mb-3" style="color: rgba(255, 255, 255, 0.95); font-size: 0.98rem; line-height: 1.6; max-width: 520px;">
                Quản lý khóa học, đăng ký môn học và theo dõi lộ trình học tập trên một nền tảng số đồng bộ, hiện đại của UNETI.
            </p>

            <!-- Nút hành động tinh tế (CTA) - Tương phản cao -->
            <div class="uneti-banner-actions d-flex flex-wrap align-items-center gap-3 mb-3">
                @if (isLoggedIn)
                {
                    @if (vaiTro == "Admin" || vaiTro == "NhanVien")
                    {
                        <a asp-controller="QuanTri" asp-action="Dashboard" class="btn text-white rounded-pill px-4 py-2 fw-bold shadow-sm d-inline-flex align-items-center gap-2" style="background-color: #06b6d4; border: none; font-size: 0.925rem; box-shadow: 0 4px 14px rgba(6, 182, 212, 0.45);">
                            <i class="bi bi-speedometer2"></i>
                            <span>Bảng điều khiển</span>
                        </a>
                        <a asp-controller="MonHoc" asp-action="Index" class="btn rounded-pill px-4 py-2 fw-bold d-inline-flex align-items-center gap-2 text-white shadow-sm" style="border: 2px solid #ffffff; background: rgba(255, 255, 255, 0.22); backdrop-filter: blur(8px); font-size: 0.925rem;">
                            <i class="bi bi-list-ul"></i>
                            <span>Danh mục môn học</span>
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    }
                    else
                    {
                        <a asp-controller="MonHoc" asp-action="Index" class="btn text-white rounded-pill px-4 py-2 fw-bold shadow-sm d-inline-flex align-items-center gap-2" style="background-color: #06b6d4; border: none; font-size: 0.925rem; box-shadow: 0 4px 14px rgba(6, 182, 212, 0.45);">
                            <i class="bi bi-search"></i>
                            <span>Khám phá môn học</span>
                        </a>
                        <a href="#lo-trinh-dao-tao" class="btn rounded-pill px-4 py-2 fw-bold d-inline-flex align-items-center gap-2 text-white shadow-sm" style="border: 2px solid #ffffff; background: rgba(255, 255, 255, 0.22); backdrop-filter: blur(8px); font-size: 0.925rem;">
                            <span>Xem lộ trình</span>
                            <i class="bi bi-arrow-down-short fs-5"></i>
                        </a>
                    }
                }
                else
                {
                    <a asp-controller="TaiKhoan" asp-action="Login" class="btn text-white rounded-pill px-4 py-2 fw-bold shadow-sm d-inline-flex align-items-center gap-2" style="background-color: #06b6d4; border: none; font-size: 0.925rem; box-shadow: 0 4px 14px rgba(6, 182, 212, 0.45);">
                        <i class="bi bi-box-arrow-in-right"></i>
                        <span>Đăng nhập ngay</span>
                    </a>
                    <a asp-controller="MonHoc" asp-action="Index" class="btn rounded-pill px-4 py-2 fw-bold d-inline-flex align-items-center gap-2 text-white shadow-sm" style="border: 2px solid #ffffff; background: rgba(255, 255, 255, 0.22); backdrop-filter: blur(8px); font-size: 0.925rem;">
                        <i class="bi bi-compass"></i>
                        <span>Khám phá môn học</span>
                        <i class="bi bi-arrow-right"></i>
                    </a>
                }
            </div>

            <!-- Số liệu thuyết phục đầu trang (Trust Indicators) -->
            <div class="d-flex flex-wrap align-items-center gap-3 mt-3 pt-3 border-top border-white border-opacity-25" style="max-width: 520px;">
                <div class="d-flex align-items-center gap-2 text-white">
                    <i class="bi bi-people-fill text-warning fs-6"></i>
                    <span style="font-size: 0.85rem;"><strong class="fw-bold">@tongHocVien+</strong> Học viên</span>
                </div>
                <div class="text-white-50">•</div>
                <div class="d-flex align-items-center gap-2 text-white">
                    <i class="bi bi-mortarboard-fill text-info fs-6"></i>
                    <span style="font-size: 0.85rem;"><strong class="fw-bold">@tongTinChi+</strong> Tín chỉ đào tạo</span>
                </div>
                <div class="text-white-50">•</div>
                <div class="d-flex align-items-center gap-2 text-white">
                    <i class="bi bi-award-fill text-success fs-6"></i>
                    <span style="font-size: 0.85rem;"><strong class="fw-bold">100%</strong> Chuẩn tín chỉ</span>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. DẢI THỐNG KÊ (DỮ LIỆU ĐỒNG BỘ MINH BẠCH) -->
    <div class="mb-5 reveal">
        <div class="row g-3 g-lg-4 stagger-group">
            <div class="col-6 col-lg-3">
                <div class="uh2-stat-card">
                    <div class="uh2-stat-icon uh2-stat-icon--blue"><i class="bi bi-book-half"></i></div>
                    <div>
                        <div class="uh2-stat-value">
                            <span data-count-to="@soMonDangMo" data-format="number">@soMonDangMo</span> / @tongSoMon
                        </div>
                        <div class="uh2-stat-label">Môn đang mở (Tổng @tongSoMon môn)</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="uh2-stat-card">
                    <div class="uh2-stat-icon uh2-stat-icon--green"><i class="bi bi-mortarboard-fill"></i></div>
                    <div>
                        <div class="uh2-stat-value"><span data-count-to="@tongTinChi" data-format="number">@tongTinChi</span></div>
                        <div class="uh2-stat-label">Tổng số tín chỉ đào tạo</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="uh2-stat-card">
                    <div class="uh2-stat-icon uh2-stat-icon--amber"><i class="bi bi-credit-card-2-front-fill"></i></div>
                    <div>
                        <div class="uh2-stat-value"><span data-count-to="@hocPhiTbCount" data-format="currency">@hocPhiTbTron.ToString("N0") đ</span></div>
                        <div class="uh2-stat-label">Học phí trung bình</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="uh2-stat-card">
                    <div class="uh2-stat-icon uh2-stat-icon--cyan"><i class="bi bi-tag-fill"></i></div>
                    <div>
                        <div class="uh2-stat-value"><span data-count-to="@hocPhiThapNhatCount" data-format="currency">@hocPhiThapNhat.ToString("N0") đ</span></div>
                        <div class="uh2-stat-label">Học phí thấp nhất</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. MÔN HỌC NỔI BẬT -->
    <div class="mb-5">
        <div class="uh2-section-head reveal">
            <div>
                <span class="uh2-kicker">🔥 Tuyển chọn</span>
                <h2 class="uh2-section-title">Môn Học Nổi Bật</h2>
                <p class="uh2-section-sub">Các học phần tiêu biểu trong chương trình đào tạo tín chỉ</p>
            </div>
            <a asp-controller="MonHoc" asp-action="Index" class="uh2-link-pill">
                Xem tất cả @tongSoMon môn học <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        <div class="row g-3 g-lg-4 stagger-group">
            @if (Model != null && Model.Any())
            {
                @foreach (var mon in Model.Take(4))
                {
                    // Màu sắc & logo theo đúng chuyên ngành của môn học
                    var profile = MonHocProfileHelper.GetProfile(mon);

                    <div class="col-12 col-sm-6 col-lg-3 reveal">
                        <div class="uh2-course">
                            <div class="uh2-course-top">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="uh2-course-icon" style="background: @profile.BrandBoxBg; box-shadow: 0 8px 18px -8px @profile.BrandBoxShadow;">
                                        <span class="uh2-course-logo">@Html.Raw(profile.BrandLogoSvg)</span>
                                    </div>
                                    <span class="uh2-code-badge">#MH@(mon.MaMonHoc.ToString("D3"))</span>
                                </div>
                                <span class="uh2-status-badge"><i class="bi bi-check-circle-fill"></i> Đang mở</span>
                            </div>
                            <h3 class="uh2-course-title">@mon.TenMonHoc</h3>
                            <div class="uh2-course-meta">
                                <span><i class="bi bi-journal-bookmark"></i> @mon.SoTinChi tín chỉ</span>
                                <span>•</span>
                                <span class="text-success fw-bold">Đào tạo chuẩn</span>
                            </div>
                            <div class="uh2-course-price">
                                <small>Học phí môn</small>
                                <strong data-count-to="@mon.HocPhi" data-format="currency" style="color: @profile.ThemePrimaryColor">@mon.HocPhi.ToString("N0") đ</strong>
                            </div>
                            <a asp-controller="MonHoc" asp-action="Details" asp-route-id="@mon.MaMonHoc" class="uh2-course-btn">
                                Xem môn học <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <!-- 4. QUY TRÌNH HỌC TẬP -->
    <div class="mb-5" id="lo-trinh-dao-tao">
        <div class="uh2-section-head reveal">
            <div>
                <span class="uh2-kicker">🧭 Lộ trình</span>
                <h2 class="uh2-section-title">Quy Trình Học Tập</h2>
                <p class="uh2-section-sub">3 bước đơn giản để bắt đầu hành trình học tập tại nhà trường</p>
            </div>
        </div>

        <div class="row g-3 g-lg-4 stagger-group">
            <div class="col-lg-4 col-md-6 reveal">
                <div class="uh2-step">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="uh2-step-num uh2-step-num--1">1</div>
                        <span class="uh2-step-tag uh2-step-tag--1">Khám phá</span>
                    </div>
                    <h6>Chọn môn học phù hợp</h6>
                    <p>Tra cứu danh mục môn học trong học kỳ, xem thông tin số tín chỉ, định mức học phí và lộ trình đào tạo chuẩn.</p>
                    <a asp-controller="MonHoc" asp-action="Index" class="uh2-step-btn uh2-step-btn--1">
                        <i class="bi bi-search me-1"></i>Tìm môn học ngay
                    </a>
                </div>
            </div>
            <div class="col-lg-4 col-md-6 reveal">
                <div class="uh2-step">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="uh2-step-num uh2-step-num--2">2</div>
                        <span class="uh2-step-tag uh2-step-tag--2">Đăng ký</span>
                    </div>
                    <h6>Đăng ký &amp; Xếp lớp</h6>
                    <p>Chọn lớp học phần phù hợp với thời khóa biểu cá nhân, xác nhận đăng ký trực tuyến an toàn và nhanh chóng.</p>
                    <a asp-controller="TaiKhoan" asp-action="Register" class="uh2-step-btn uh2-step-btn--2">
                        <i class="bi bi-person-plus me-1"></i>Đăng ký tài khoản
                    </a>
                </div>
            </div>
            <div class="col-lg-4 col-md-12 reveal">
                <div class="uh2-step">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="uh2-step-num uh2-step-num--3">3</div>
                        <span class="uh2-step-tag uh2-step-tag--3">Học tập ngay</span>
                    </div>
                    <h6>Vào học &amp; Theo dõi tiến độ</h6>
                    <p>Truy cập tài liệu môn học, tham gia lớp học phần, kiểm tra định kỳ và nhận kết quả đánh giá học tập.</p>
                    <a asp-controller="KhoaHoc" asp-action="Index" class="uh2-step-btn uh2-step-btn--3">
                        <i class="bi bi-calendar2-check me-1"></i>Xem lớp mở ngay <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- 5. ƯU ĐIỂM HỆ THỐNG -->
    <div class="mb-5">
        <div class="reveal mb-4">
            <span class="uh2-kicker">✨ Điểm nổi bật</span>
            <h2 class="uh2-section-title">Mọi thứ bạn cần cho hành trình học tập</h2>
            <p class="uh2-section-sub">Hệ thống học tập hiện đại, linh hoạt, đồng hành cùng bạn trên mọi lộ trình</p>
        </div>

        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-5 g-3 stagger-group">
            <div class="col reveal">
                <div class="uh2-feature">
                    <div class="uh2-feature-icon uh2-stat-icon--blue"><i class="bi bi-display"></i></div>
                    <h6>Chủ động thời gian</h6>
                    <p>Học mọi lúc, mọi nơi trên mọi thiết bị.</p>
                </div>
            </div>
            <div class="col reveal">
                <div class="uh2-feature">
                    <div class="uh2-feature-icon uh2-stat-icon--amber"><i class="bi bi-lightning-charge-fill"></i></div>
                    <h6>Truy cập nhanh chóng</h6>
                    <p>Giao diện thân thiện, dễ tra cứu.</p>
                </div>
            </div>
            <div class="col reveal">
                <div class="uh2-feature">
                    <div class="uh2-feature-icon uh2-course-icon--purple"><i class="bi bi-people-fill"></i></div>
                    <h6>Giảng viên chất lượng</h6>
                    <p>Đội ngũ giàu kinh nghiệm, tận tâm.</p>
                </div>
            </div>
            <div class="col reveal">
                <div class="uh2-feature">
                    <div class="uh2-feature-icon uh2-stat-icon--green"><i class="bi bi-shield-check"></i></div>
                    <h6>Hệ thống ổn định</h6>
                    <p>Bảo mật và an toàn dữ liệu học tập.</p>
                </div>
            </div>
            <div class="col reveal">
                <div class="uh2-feature">
                    <div class="uh2-feature-icon uh2-stat-icon--cyan"><i class="bi bi-headset"></i></div>
                    <h6>Hỗ trợ 24/7</h6>
                    <p>Luôn sẵn sàng giải đáp thắc mắc.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- 6. CÂU HỎI THƯỜNG GẶP -->
    <div class="mb-5">
        <div class="uh2-section-head reveal">
            <div>
                <span class="uh2-kicker">💬 Giải đáp</span>
                <h2 class="uh2-section-title">Câu hỏi thường gặp</h2>
                <p class="uh2-section-sub">Những thắc mắc phổ biến của học viên trong quá trình đăng ký học tập</p>
            </div>
            <a href="mailto:support@uneti.edu.vn" class="uh2-link-pill">
                Cần hỗ trợ thêm <i class="bi bi-envelope-heart"></i>
            </a>
        </div>

        <div class="reveal">
            <div class="accordion uh2-faq" id="faqAccordion">
                <div class="accordion-item">
                    <h2 class="accordion-header" id="headingOne">
                        <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                            <span class="uh2-faq-num uh2-stat-icon--blue"><i class="bi bi-person-plus-fill"></i></span>
                            Làm thế nào để tạo tài khoản trên hệ thống?
                        </button>
                    </h2>
                    <div id="collapseOne" class="accordion-collapse collapse show" aria-labelledby="headingOne" data-bs-parent="#faqAccordion">
                        <div class="accordion-body">
                            Bạn nhấn vào mục <strong>Đăng ký</strong> ở thanh menu, nhập họ tên, email, tên đăng nhập và mật khẩu. Tài khoản học viên sẽ được kích hoạt ngay lập tức để bạn bắt đầu tra cứu và đăng ký học phần.
                        </div>
                    </div>
                </div>
                <div class="accordion-item">
                    <h2 class="accordion-header" id="headingTwo">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                            <span class="uh2-faq-num uh2-stat-icon--amber"><i class="bi bi-key-fill"></i></span>
                            Tôi quên mật khẩu thì xử lý thế nào?
                        </button>
                    </h2>
                    <div id="collapseTwo" class="accordion-collapse collapse" aria-labelledby="headingTwo" data-bs-parent="#faqAccordion">
                        <div class="accordion-body">
                            Tại trang Đăng nhập, chọn <strong>Quên mật khẩu?</strong> và điền email đã đăng ký. Hệ thống sẽ tạo liên kết khôi phục mật khẩu bảo mật (hiệu lực 15 phút) để bạn thiết lập lại mật khẩu mới.
                        </div>
                    </div>
                </div>
                <div class="accordion-item">
                    <h2 class="accordion-header" id="headingThree">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
                            <span class="uh2-faq-num uh2-stat-icon--green"><i class="bi bi-cash-coin"></i></span>
                            Học phí môn học được niêm yết và tính như thế nào?
                        </button>
                    </h2>
                    <div id="collapseThree" class="accordion-collapse collapse" aria-labelledby="headingThree" data-bs-parent="#faqAccordion">
                        <div class="accordion-body">
                            Học phí được tính dựa trên số tín chỉ của từng môn học theo quy định của nhà trường và được công khai minh bạch ngay tại từng thẻ môn học và trang chi tiết học phần.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 7. CTA BANNER -->
    <div class="mb-4 reveal">
        <div class="uh2-cta">
            <div class="row align-items-center position-relative g-4" style="z-index:1">
                <div class="col-lg-9">
                    <span class="uh2-cta-badge">Bắt đầu hành trình của bạn ngay hôm nay</span>

                    @if (isLoggedIn)
                {
                    @if (vaiTro == "Admin" || vaiTro == "NhanVien")
                    {
                        <h3>Xin chào, @hoTen!</h3>
                        <p>Chào mừng bạn trở lại bảng điều khiển. Quản lý danh mục môn học, giám sát học viên và theo dõi tiến độ đào tạo của toàn hệ thống.</p>
                        <div class="d-flex flex-wrap gap-3">
                            <a asp-controller="QuanTri" asp-action="Dashboard" class="uh2-cta-btn-w">
                                <i class="bi bi-speedometer2"></i>Vào bảng điều khiển
                            </a>
                        </div>
                    }
                    else
                    {
                        <h3>Sẵn sàng cho kỳ học mới, @hoTen?</h3>
                        <p>Tra cứu danh mục môn học, xem số tín chỉ và học phí để chuẩn bị cho kỳ học mới.</p>
                        <div class="d-flex flex-wrap gap-3">
                            <a asp-controller="MonHoc" asp-action="Index" class="uh2-cta-btn-w">
                                <i class="bi bi-search"></i>Tra cứu môn học ngay
                            </a>
                        </div>
                    }
                }
                else
                {
                    <h3>Khởi đầu hành trình học tập ngay hôm nay!</h3>
                    <p>Tạo tài khoản, khám phá các môn học chất lượng và chinh phục tri thức cùng chúng tôi.</p>
                    <div class="d-flex flex-wrap gap-3">
                        <a asp-controller="TaiKhoan" asp-action="Login" class="uh2-cta-btn-w">
                            <i class="bi bi-person"></i>Đăng nhập
                        </a>
                        <a asp-controller="TaiKhoan" asp-action="Register" class="uh2-cta-btn-o">
                            <i class="bi bi-person-plus"></i>Đăng ký tài khoản
                        </a>
                    </div>
                }
                </div>
            </div>
        </div>
    </div>
</div>
