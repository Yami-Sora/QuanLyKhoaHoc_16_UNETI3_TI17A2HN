                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.DoanhThuTheoKhoa)
                    {
                        var pct = Model.TongDoanhThu > 0 ? Math.Round((double)item.DoanhThu / (double)Model.TongDoanhThu * 100, 1) : 0;
                        var pctCss = pct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
                        <tr>
                            <td>
                                <div class="fw-bold text-dark">@item.TenKhoaHoc</div>
                                <small class="text-muted">#KH@(item.MaKhoaHoc.ToString("D2"))</small>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@(item.TenMonHoc ?? "--")</span>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1 rounded-pill fw-bold">
                                    <i class="bi bi-check2-all me-1"></i>@item.SoHocVienDaDong HV
                                </span>
                            </td>
                            <td class="text-end fw-bold text-success fs-6">
                                @item.DoanhThu.ToString("N0") <small class="text-muted">đ</small>
                            </td>
