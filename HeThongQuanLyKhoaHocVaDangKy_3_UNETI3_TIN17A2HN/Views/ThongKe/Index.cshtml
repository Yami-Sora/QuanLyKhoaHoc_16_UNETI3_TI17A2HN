    <!-- ===================================================================== -->
    <!-- SECTION 5: TỔNG CÔNG NỢ HỌC PHÍ CÒN PHẢI THU -->
    <!-- ===================================================================== -->
    <div class="m5-card mb-4" id="sec5">
        <div class="m5-card-header">
            <div class="d-flex align-items-center gap-3">
