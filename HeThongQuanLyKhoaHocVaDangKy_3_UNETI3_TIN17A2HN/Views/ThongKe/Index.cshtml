@*
    Họ và tên: Nguyễn Công Thành
    Mã sinh viên: 23103100102
    Nội dung thực hiện: Module 5 - Giao diện Báo cáo & Thống kê tổng hợp
*@

@model HeThongQuanLyKhoaHocVaDangKy_3_UNETI3_TIN17A2HN.ViewModels.ThongKeViewModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Báo cáo & Thống kê Đào tạo";
}

<div class="container-fluid px-0">
    <!-- Tiêu đề trang & Thanh tác vụ -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h3 class="fw-bold mb-1 text-dark">
                <i class="bi bi-bar-chart-line-fill me-2 text-primary"></i>BÁO CÁO &amp; THỐNG KÊ TOÀN DIỆN
            </h3>
            <p class="text-muted mb-0 small">
                Tổng hợp 8 chuyên đề thống kê nghiệp vụ đào tạo: Phân tích số liệu, doanh thu, công nợ và kết quả đào tạo
            </p>
        </div>
        <div class="d-flex gap-2 mt-2 mt-sm-0">
            <button type="button" class="btn btn-outline-secondary btn-sm shadow-sm d-flex align-items-center gap-1" onclick="window.print()">
                <i class="bi bi-printer"></i>
                <span>In báo cáo</span>
            </button>
            <a asp-controller="QuanTri" asp-action="Dashboard" class="btn btn-outline-primary btn-sm shadow-sm d-flex align-items-center gap-1">
                <i class="bi bi-speedometer2"></i>
                <span>Về Dashboard</span>
            </a>
        </div>
    </div>

    <!-- THANH MENU ĐIỀU HƯỚNG NHANH 8 CHUYÊN ĐỀ (JUMP TO SECTION) -->
    <div class="uneti-card p-2.5 mb-4 bg-white rounded-3 border shadow-sm">
        <div class="d-flex flex-wrap gap-1 align-items-center small">
            <span class="text-muted fw-bold me-2"><i class="bi bi-list-ol text-primary me-1"></i>Mục lục thống kê:</span>
            <a href="#sec1" class="btn btn-sm btn-light border py-1 px-2.5">1. Khóa theo môn</a>
            <a href="#sec2" class="btn btn-sm btn-light border py-1 px-2.5">2. Học viên theo khóa</a>
            <a href="#sec3" class="btn btn-sm btn-light border py-1 px-2.5">3. Top khóa học hot</a>
            <a href="#sec4" class="btn btn-sm btn-light border py-1 px-2.5">4. Doanh thu học phí</a>
            <a href="#sec5" class="btn btn-sm btn-light border py-1 px-2.5">5. Công nợ học phí</a>
            <a href="#sec6" class="btn btn-sm btn-light border py-1 px-2.5">6. Điểm TB theo khóa</a>
            <a href="#sec7" class="btn btn-sm btn-light border py-1 px-2.5">7. Tỷ lệ Đạt/Hỏng</a>
            <a href="#sec8" class="btn btn-sm btn-light border py-1 px-2.5">8. Đăng ký theo tháng</a>
        </div>
    </div>

    <!-- ===================================================================== -->
    <!-- SECTION 1: SỐ KHÓA HỌC THEO MÔN HỌC -->
    <!-- ===================================================================== -->
    <div class="uneti-card p-4 mb-4 bg-white rounded-3 border shadow-sm" id="sec1">
        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
            <div>
                <h5 class="fw-bold text-dark mb-0">
                    <span class="badge bg-primary me-2">1</span>Số khóa học theo từng môn học
                </h5>
                <small class="text-muted">Thống kê cơ cấu và số lượng lớp học được tổ chức cho từng chương trình môn học</small>
            </div>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                Tổng @Model.KhoaHocTheoMon.Count môn học
            </span>
        </div>

        <div class="row g-4 align-items-center">
            <div class="col-lg-7">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 small">
                        <thead class="table-light text-secondary">
                            <tr>
                                <th style="width: 70px;">Mã môn</th>
                                <th>Tên môn học</th>
                                <th class="text-center">Số tín chỉ</th>
                                <th class="text-center">Số khóa đang mở</th>
                                <th style="width: 150px;">Tỷ trọng</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var maxKhoa = Model.KhoaHocTheoMon.Any() ? Math.Max(1, Model.KhoaHocTheoMon.Max(x => x.SoKhoaHoc)) : 1;
                            }
                            @foreach (var item in Model.KhoaHocTheoMon)
                            {
                                var pct = Math.Round((double)item.SoKhoaHoc / maxKhoa * 100);
                                <tr>
                                    <td class="text-muted fw-bold">#MH@(item.MaMonHoc.ToString("D2"))</td>
                                    <td class="fw-semibold text-dark">@item.TenMonHoc</td>
                                    <td class="text-center">@item.SoTinChi TC</td>
                                    <td class="text-center fw-bold text-primary">@item.SoKhoaHoc</td>
                                    <td>
                                        <div class="progress" style="height: 6px;">
                                            <div class="progress-bar bg-primary" style="width: @pct%;"></div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="col-lg-5">
                <div style="position: relative; height: 260px;">
                    <canvas id="chartKhoaTheoMon"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- ===================================================================== -->
    <!-- SECTION 2: SỐ HỌC VIÊN ĐĂNG KÝ THEO KHÓA & TỶ LỆ LẤP ĐẦY -->
    <!-- ===================================================================== -->
    <div class="uneti-card p-4 mb-4 bg-white rounded-3 border shadow-sm" id="sec2">
        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
            <div>
                <h5 class="fw-bold text-dark mb-0">
                    <span class="badge bg-primary me-2">2</span>Số học viên đăng ký theo từng khóa học
                </h5>
                <small class="text-muted">Theo dõi quy mô tuyển sinh, số lượng học viên ghi danh và tỷ lệ lấp đầy sĩ số</small>
            </div>
            <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">
                Sĩ số &amp; Tỷ lệ lấp đầy
            </span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 small">
                <thead class="table-light text-secondary">
                    <tr>
                        <th>Tên khóa học</th>
                        <th>Môn học</th>
                        <th class="text-center">Đã đăng ký</th>
                        <th class="text-center">Sĩ số tối đa</th>
                        <th style="min-width: 180px;">Tỷ lệ lấp đầy</th>
                        <th class="text-center">Tình trạng chỗ</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.HocVienTheoKhoa)
                    {
                        var isFull = item.SoHocVienDangKy >= item.SoLuongToiDa;
                        <tr>
                            <td class="fw-bold text-dark">@item.TenKhoaHoc</td>
                            <td class="text-muted">@(item.TenMonHoc ?? "--")</td>
                            <td class="text-center fw-bold fs-6 text-primary">@item.SoHocVienDangKy</td>
                            <td class="text-center text-muted">@item.SoLuongToiDa</td>
                            <td>
                                <div class="d-flex justify-content-between mb-1" style="font-size: 11px;">
                                    <span>@item.SoHocVienDangKy/@item.SoLuongToiDa HV</span>
                                    <span class="fw-bold @(isFull ? "text-danger" : "text-primary")">@item.TyLeLapDay%</span>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar @(isFull ? "bg-danger" : "bg-primary")" style="width: @Math.Min(100, item.TyLeLapDay)%;"></div>
                                </div>
                            </td>
                            <td class="text-center">
                                @if (isFull)
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Hết chỗ</span>
                                }
                                else
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Còn @(item.SoLuongToiDa - item.SoHocVienDangKy) chỗ</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- ===================================================================== -->
    <!-- SECTION 3: TOP KHÓA HỌC NHIỀU HỌC VIÊN NHẤT -->
    <!-- ===================================================================== -->
    <div class="uneti-card p-4 mb-4 bg-white rounded-3 border shadow-sm" id="sec3">
        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
            <div>
                <h5 class="fw-bold text-dark mb-0">
                    <span class="badge bg-primary me-2">3</span>Top khóa học thu hút nhiều học viên nhất
                </h5>
                <small class="text-muted">Danh sách các lớp học có số lượng người học đăng ký đông đảo nhất</small>
            </div>
            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                <i class="bi bi-fire me-1"></i>Top 5 khóa học tiêu biểu
            </span>
        </div>

        <div class="row g-3">
            @for (int i = 0; i < Model.TopKhoaHocNhieuHocVien.Count; i++)
            {
                var top = Model.TopKhoaHocNhieuHocVien[i];
                <div class="col-md">
                    <div class="p-3 rounded-3 border h-100 bg-light position-relative">
                        <div class="position-absolute top-0 end-0 p-2">
                            <span class="badge @(i == 0 ? "bg-danger" : (i == 1 ? "bg-warning text-dark" : "bg-primary")) rounded-circle px-2 py-1">
                                #@(i + 1)
                            </span>
                        </div>
                        <div class="fw-bold text-dark text-truncate pe-4 small mb-1" title="@top.TenKhoaHoc">@top.TenKhoaHoc</div>
                        <div class="text-muted uneti-fs-xs mb-2">@top.TenGiangVien</div>
                        <div class="fs-4 fw-bold text-primary">@top.SoHocVien <small class="fs-6 text-muted">HV</small></div>
                        <small class="text-muted" style="font-size: 11px;">Học phí: @top.HocPhi.ToString("N0") đ</small>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- ===================================================================== -->
    <!-- SECTION 4: DOANH THU HỌC PHÍ -->
    <!-- ===================================================================== -->
    <div class="uneti-card p-4 mb-4 bg-white rounded-3 border shadow-sm" id="sec4">
        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
            <div>
                <h5 class="fw-bold text-dark mb-0">
                    <span class="badge bg-primary me-2">4</span>Doanh thu học phí theo khóa học
                </h5>
                <small class="text-muted">Tổng hợp dòng tiền thực thu từ học phí theo từng lớp đào tạo</small>
            </div>
            <div class="fs-5 fw-bold text-success">
                Tổng doanh thu: @Model.TongDoanhThu.ToString("N0") VNĐ
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 small">
                <thead class="table-light text-secondary">
                    <tr>
                        <th>Khóa học</th>
                        <th>Môn học</th>
                        <th class="text-center">Số học viên đã nộp</th>
                        <th class="text-end">Doanh thu thực thu</th>
                        <th style="width: 200px;">Tỷ trọng doanh thu</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.DoanhThuTheoKhoa)
                    {
                        var pct = Model.TongDoanhThu > 0 ? Math.Round((double)item.DoanhThu / (double)Model.TongDoanhThu * 100, 1) : 0;
                        <tr>
                            <td class="fw-bold text-dark">@item.TenKhoaHoc</td>
                            <td class="text-muted">@(item.TenMonHoc ?? "--")</td>
                            <td class="text-center">@item.SoHocVienDaDong HV</td>
                            <td class="text-end fw-bold text-success fs-6">@item.DoanhThu.ToString("N0") đ</td>
                            <td>
                                <div class="d-flex justify-content-between mb-1" style="font-size: 11px;">
                                    <span>Tỷ trọng</span>
                                    <span class="fw-bold text-success">@pct%</span>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar bg-success" style="width: @pct%;"></div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- ===================================================================== -->
    <!-- SECTION 5: TỔNG CÔNG NỢ HỌC PHÍ CẦN THU -->
    <!-- ===================================================================== -->
    <div class="uneti-card p-4 mb-4 bg-white rounded-3 border shadow-sm" id="sec5">
        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
            <div>
                <h5 class="fw-bold text-dark mb-0">
                    <span class="badge bg-primary me-2">5</span>Tổng công nợ học phí còn phải thu
                </h5>
                <small class="text-muted">Kiểm soát các khoản học phí còn tồn đọng cần đôn đốc học viên hoàn thành</small>
            </div>
            <div class="fs-5 fw-bold text-warning-emphasis">
                Tổng công nợ: @Model.TongCongNo.ToString("N0") VNĐ
            </div>
        </div>

        @if (Model.CongNoTheoKhoa != null && Model.CongNoTheoKhoa.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 small">
                    <thead class="table-light text-secondary">
                        <tr>
                            <th>Khóa học có công nợ</th>
                            <th class="text-center">Số học viên còn thiếu tiền</th>
                            <th class="text-end">Công nợ còn lại</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.CongNoTheoKhoa)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@item.TenKhoaHoc</td>
                                <td class="text-center fw-semibold text-danger">@item.SoHocVienConNo học viên</td>
                                <td class="text-end fw-bold text-danger fs-6">@item.CongNo.ToString("N0") đ</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-success mb-0 small d-flex align-items-center gap-2">
                <i class="bi bi-check-circle-fill fs-5"></i>
                <span>Tất cả học viên trong hệ thống đã hoàn thành 100% nghĩa vụ học phí. Không có công nợ tồn đọng!</span>
            </div>
        }
    </div>

    <!-- ===================================================================== -->
    <!-- SECTION 6: ĐIỂM TRUNG BÌNH THEO KHÓA -->
    <!-- ===================================================================== -->
    <div class="uneti-card p-4 mb-4 bg-white rounded-3 border shadow-sm" id="sec6">
        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
            <div>
                <h5 class="fw-bold text-dark mb-0">
                    <span class="badge bg-primary me-2">6</span>Điểm trung bình theo từng khóa học
                </h5>
                <small class="text-muted">Đánh giá chất lượng đào tạo, học lực trung bình và tỷ lệ đạt chuẩn của từng khóa</small>
            </div>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                Chất lượng đào tạo
            </span>
        </div>

        @if (Model.DiemTBTheoKhoa != null && Model.DiemTBTheoKhoa.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 small">
                    <thead class="table-light text-secondary">
                        <tr>
                            <th>Khóa học</th>
                            <th>Môn học</th>
                            <th class="text-center">Số HV có điểm</th>
                            <th class="text-center">Điểm TB</th>
                            <th class="text-center">Số Đạt</th>
                            <th class="text-center">Số Hỏng</th>
                            <th style="min-width: 160px;">Tỷ lệ Đạt</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.DiemTBTheoKhoa)
                        {
                            var tyLe = item.SoHocVienCoKetQua > 0 ? Math.Round((double)item.SoDat / item.SoHocVienCoKetQua * 100, 1) : 0;
                            <tr>
                                <td class="fw-bold text-dark">@item.TenKhoaHoc</td>
                                <td class="text-muted">@(item.TenMonHoc ?? "--")</td>
                                <td class="text-center">@item.SoHocVienCoKetQua</td>
                                <td class="text-center fw-bold fs-6 @(item.DiemTB >= 8.0m ? "text-success" : (item.DiemTB >= 5.0m ? "text-primary" : "text-danger"))">
                                    @item.DiemTB.ToString("0.00")
                                </td>
                                <td class="text-center text-success fw-semibold">@item.SoDat</td>
                                <td class="text-center text-danger fw-semibold">@item.SoKhongDat</td>
                                <td>
                                    <div class="d-flex justify-content-between mb-1" style="font-size: 11px;">
                                        <span>Đạt chuẩn</span>
                                        <span class="fw-bold text-success">@tyLe%</span>
                                    </div>
                                    <div class="progress" style="height: 6px;">
                                        <div class="progress-bar bg-success" style="width: @tyLe%;"></div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-light border mb-0 small text-muted">
                <i class="bi bi-info-circle me-1"></i>Chưa có khóa học nào được nhập điểm trong hệ thống.
            </div>
        }
    </div>

    <!-- ===================================================================== -->
    <!-- SECTION 7 & 8: TỶ LỆ ĐẠT/HỎNG & SỐ ĐĂNG KÝ THEO THÁNG -->
    <!-- ===================================================================== -->
    <div class="row g-4 mb-4">
        <!-- Section 7: Tỷ lệ Đạt / Không đạt -->
        <div class="col-lg-5" id="sec7">
            <div class="uneti-card p-4 bg-white rounded-3 border shadow-sm h-100">
                <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                    <div>
                        <h5 class="fw-bold text-dark mb-0">
                            <span class="badge bg-primary me-2">7</span>Tỷ lệ Đạt / Không đạt
                        </h5>
                        <small class="text-muted">Tỷ lệ học viên đạt yêu cầu tốt nghiệp khóa học</small>
                    </div>
                </div>

                <div class="text-center mb-3">
                    <div class="row g-2">
                        <div class="col-6">
                            <div class="p-2.5 bg-success-subtle text-success rounded-3 border border-success-subtle">
                                <div class="fs-4 fw-bold">@Model.SoDat</div>
                                <small class="fw-semibold">ĐẠT (@Model.TyLeDat%)</small>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-2.5 bg-danger-subtle text-danger rounded-3 border border-danger-subtle">
                                <div class="fs-4 fw-bold">@Model.SoKhongDat</div>
                                <small class="fw-semibold">KHÔNG ĐẠT (@Model.TyLeKhongDat%)</small>
                            </div>
                        </div>
                    </div>
                </div>

                <div style="position: relative; height: 220px;">
                    <canvas id="chartDatKhongDat"></canvas>
                </div>
            </div>
        </div>

        <!-- Section 8: Số đăng ký theo tháng -->
        <div class="col-lg-7" id="sec8">
            <div class="uneti-card p-4 bg-white rounded-3 border shadow-sm h-100">
                <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                    <div>
                        <h5 class="fw-bold text-dark mb-0">
                            <span class="badge bg-primary me-2">8</span>Số đăng ký theo tháng
                        </h5>
                        <small class="text-muted">Biến động số lượng hồ sơ đăng ký qua từng chu kỳ tháng</small>
                    </div>
                </div>

                <div style="position: relative; height: 220px;" class="mb-3">
                    <canvas id="chartDangKyThang"></canvas>
                </div>

                <div class="table-responsive">
                    <table class="table table-sm table-bordered align-middle mb-0 text-center small">
                        <thead class="table-light">
                            <tr>
                                @foreach (var item in Model.DangKyTheoThang)
                                {
                                    <th>@item.NhanThang</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                @foreach (var item in Model.DangKyTheoThang)
                                {
                                    <td class="fw-bold text-primary">@item.SoDangKy</td>
                                }
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        (function () {
            if (typeof Chart === 'undefined') return;

            // Biểu đồ 1: Khóa theo môn
            const ctxKhoaTheoMon = document.getElementById('chartKhoaTheoMon');
            if (ctxKhoaTheoMon) {
                new Chart(ctxKhoaTheoMon, {
                    type: 'pie',
                    data: {
                        labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.KhoaHocTheoMon.Take(6).Select(x => x.TenMonHoc))),
                        datasets: [{
                            data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.KhoaHocTheoMon.Take(6).Select(x => x.SoKhoaHoc))),
                            backgroundColor: ['#2563eb', '#10b981', '#f59e0b', '#8b5cf6', '#ec4899', '#06b6d4'],
                            borderWidth: 2,
                            borderColor: '#ffffff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { position: 'bottom' } }
                    }
                });
            }

            // Biểu đồ 7: Đạt / Không đạt
            const ctxDatKhongDat = document.getElementById('chartDatKhongDat');
            if (ctxDatKhongDat) {
                new Chart(ctxDatKhongDat, {
                    type: 'doughnut',
                    data: {
                        labels: ['Đạt yêu cầu', 'Không đạt'],
                        datasets: [{
                            data: [@Model.SoDat, @Model.SoKhongDat],
                            backgroundColor: ['#10b981', '#ef4444'],
                            borderWidth: 2,
                            borderColor: '#ffffff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { position: 'bottom' } }
                    }
                });
            }

            // Biểu đồ 8: Đăng ký theo tháng
            const ctxDangKyThang = document.getElementById('chartDangKyThang');
            if (ctxDangKyThang) {
                new Chart(ctxDangKyThang, {
                    type: 'bar',
                    data: {
                        labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DangKyTheoThang.Select(x => x.NhanThang))),
                        datasets: [{
                            label: 'Lượt đăng ký',
                            data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DangKyTheoThang.Select(x => x.SoDangKy))),
                            backgroundColor: '#2563eb',
                            borderRadius: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: { y: { beginAtZero: true, ticks: { precision: 0 } } },
                        plugins: { legend: { display: false } }
                    }
                });
            }
        })();
    </script>
}
