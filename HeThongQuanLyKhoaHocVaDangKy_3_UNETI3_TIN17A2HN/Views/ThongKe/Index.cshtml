@*
    Họ và tên: Nguyễn Công Thành
    Mã sinh viên: 23103100102
    Nội dung thực hiện: Module 5 - Giao diện Báo cáo & Thống kê tổng hợp toàn diện (Analytics Suite V2)
*@

@model HeThongQuanLyKhoaHocVaDangKy_3_UNETI3_TIN17A2HN.ViewModels.ThongKeViewModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Báo cáo & Thống kê Đào tạo";
    var tongKhoaHoc = Model.HocVienTheoKhoa.Count;
    var tongHocVien = Model.HocVienTheoKhoa.Sum(x => x.SoHocVienDangKy);
}

<link rel="stylesheet" href="~/css/module5-v2.css" asp-append-version="true" />

<!-- HEADER BÁO CÁO IN ẤN — Chỉ hiển thị khi Print / Xuất PDF -->
<div class="print-report-header">
    <table style="width: 100%; border: none; margin-bottom: 1rem;">
        <tr>
            <td style="width: 50%; text-align: center; vertical-align: top; font-size: 12px; border: none;">
                <div>BỘ CÔNG THƯƠNG</div>
                <div style="font-weight: bold;">TRƯỜNG ĐẠI HỌC KINH TẾ - KỸ THUẬT CÔNG NGHIỆP</div>
                <div style="width: 60px; border-bottom: 1.5px solid #000; margin: 4px auto;"></div>
            </td>
            <td style="width: 50%; text-align: center; vertical-align: top; font-size: 12px; border: none;">
                <div style="font-weight: bold;">CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM</div>
                <div style="font-weight: bold;">Độc lập — Tự do — Hạnh phúc</div>
                <div style="width: 100px; border-bottom: 1.5px solid #000; margin: 4px auto;"></div>
            </td>
        </tr>
    </table>
    <div style="text-align: center; margin-bottom: 0.75rem;">
        <h2 style="font-size: 16px; font-weight: bold; text-transform: uppercase; margin: 0;">
            BÁO CÁO THỐNG KÊ TỔNG HỢP ĐÀO TẠO & TÀI CHÍNH HỌC PHÍ
        </h2>
        <p style="font-size: 11px; color: #555; margin: 4px 0 0;">
            Thời điểm kết xuất: @DateTime.Now.ToString("HH:mm, 'ngày' dd 'tháng' MM 'năm' yyyy")
            &bull; Người lập: Nguyễn Công Thành — MSV: 23103100102 — Lớp: TIN17A2HN
        </p>
    </div>
</div>

<div class="container-fluid px-0 pb-5">
    <!-- ===================================================================== -->
    <!-- 1. HERO BANNER CHUẨN MONHOC V2 -->
    <!-- ===================================================================== -->
    <div class="m5-hero-banner mb-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 position-relative" style="z-index: 2;">
            <div class="d-flex align-items-center gap-3">
                <div class="m5-banner-icon">
                    <i class="bi bi-bar-chart-line-fill"></i>
                </div>
                <div>
                    <h1 class="m5-banner-title">BÁO CÁO &amp; THỐNG KÊ TOÀN DIỆN</h1>
                    <p class="m5-banner-sub">
                        Hệ thống phân tích dữ liệu đa chiều &bull; Đào tạo, Tuyển sinh, Dòng tiền học phí &amp; Chất lượng đầu ra
                    </p>
                </div>
            </div>

            <!-- Cụm nút tác vụ phía trên -->
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="m5-banner-btn" onclick="window.print()">
                    <i class="bi bi-printer-fill"></i>
                    <span>In báo cáo</span>
                </button>
                <a asp-controller="QuanTri" asp-action="Dashboard" class="m5-banner-btn-white">
                    <i class="bi bi-speedometer2"></i>
                    <span>Về Dashboard</span>
                </a>
            </div>
        </div>
    </div>

    <!-- ===================================================================== -->
    <!-- 2. KPI QUICK-STATS RIBBON (TỔNG QUAN CHỈ SỐ VĨ MÔ) -->
    <!-- ===================================================================== -->
    <div class="row g-3 mb-4">
        <!-- Thẻ 1: Doanh thu thực thu -->
        <div class="col-sm-6 col-xl-3">
            <div class="m5-kpi-card" style="border-left: 4px solid #10b981; cursor: help;"
                 data-bs-toggle="tooltip" data-bs-html="true" data-bs-placement="top"
                 title="<b>Tổng doanh thu thực tế:</b><br/>Tổng số tiền học phí thực tế đã thu thành công và ghi nhận vào quỹ từ các học viên đã hoàn tất đóng học phí.">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase tracking-wider d-flex align-items-center gap-1">
                            <span>Doanh thu thực thu</span>
                            <i class="bi bi-info-circle text-muted" style="font-size: 0.8rem;"></i>
                        </div>
                        <div class="fs-4 fw-bold text-success mt-1">@Model.TongDoanhThu.ToString("N0") <small class="fs-6">đ</small></div>
                        <div class="small text-muted mt-1">
                            <i class="bi bi-check2-circle text-success me-1"></i>Học phí đã vào quỹ thực tế
                        </div>
                    </div>
                    <div class="m5-finance-icon green" style="width: 44px; height: 44px; font-size: 1.25rem;">
                        <i class="bi bi-cash-stack"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Thẻ 2: Công nợ học phí -->
        <div class="col-sm-6 col-xl-3">
            <div class="m5-kpi-card" style="border-left: 4px solid #f59e0b; cursor: help;"
                 data-bs-toggle="tooltip" data-bs-html="true" data-bs-placement="top"
                 title="<b>Tổng công nợ học phí:</b><br/>Tổng số tiền học phí còn tồn đọng mà học viên chưa thanh toán đủ, cần phòng đào tạo tiếp tục theo dõi và đôn đốc thu hồi.">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase tracking-wider d-flex align-items-center gap-1">
                            <span>Công nợ học phí</span>
                            <i class="bi bi-info-circle text-muted" style="font-size: 0.8rem;"></i>
                        </div>
                        <div class="fs-4 fw-bold text-warning-emphasis mt-1">@Model.TongCongNo.ToString("N0") <small class="fs-6">đ</small></div>
                        <div class="small text-muted mt-1">
                            <i class="bi bi-clock-history text-warning me-1"></i>Chờ học viên hoàn tất
                        </div>
                    </div>
                    <div class="m5-finance-icon amber" style="width: 44px; height: 44px; font-size: 1.25rem;">
                        <i class="bi bi-exclamation-octagon-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Thẻ 3: Tỷ lệ học viên đạt chuẩn -->
        <div class="col-sm-6 col-xl-3">
            <div class="m5-kpi-card" style="border-left: 4px solid #6366f1; cursor: help;"
                 data-bs-toggle="tooltip" data-bs-html="true" data-bs-placement="top"
                 title="<b>Tỷ lệ đạt chuẩn tốt nghiệp (@Model.TyLeDat%):</b><br/>Tỷ lệ học viên đạt điều kiện tốt nghiệp (Điểm tổng kết &ge; 5.0) trên tổng số @Model.TongSoKetQua học viên đã có điểm kết thúc khóa.<br/>&bull; Đạt: <b>@Model.SoDat</b> học viên (&ge; 5.0 điểm)<br/>&bull; Chưa đạt: <b>@Model.SoKhongDat</b> học viên (&lt; 5.0 điểm)">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase tracking-wider d-flex align-items-center gap-1">
                            <span>Tỷ lệ đạt chuẩn (&ge; 5.0đ)</span>
                            <i class="bi bi-info-circle text-muted" style="font-size: 0.8rem;"></i>
                        </div>
                        <div class="fs-4 fw-bold text-primary mt-1">@Model.TyLeDat%</div>
                        <div class="small text-muted mt-1">
                            <span class="text-success fw-semibold">@Model.SoDat đạt</span> / @Model.TongSoKetQua HV đã có điểm
                        </div>
                    </div>
                    <div class="m5-stat-icon theme-indigo" style="width: 44px; height: 44px; font-size: 1.25rem; background: linear-gradient(135deg, #6366f1, #4338ca); color: #fff;">
                        <i class="bi bi-mortarboard-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Thẻ 4: Tổng số lượt học viên ghi danh -->
        <div class="col-sm-6 col-xl-3">
            <div class="m5-kpi-card" style="border-left: 4px solid #0ea5e9; cursor: help;"
                 data-bs-toggle="tooltip" data-bs-html="true" data-bs-placement="top"
                 title="<b>Tổng quy mô tuyển sinh:</b><br/>Tổng cộng có <b>@tongHocVien</b> lượt học viên đã ghi danh tham gia học tập trên toàn hệ thống, hiện đang phân bổ tại <b>@tongKhoaHoc</b> lớp khóa học thuộc <b>@Model.KhoaHocTheoMon.Count</b> chuyên đề môn học khác nhau.">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase tracking-wider d-flex align-items-center gap-1">
                            <span>Lượt học viên ghi danh</span>
                            <i class="bi bi-info-circle text-muted" style="font-size: 0.8rem;"></i>
                        </div>
                        <div class="fs-4 fw-bold text-dark mt-1">@tongHocVien.ToString("N0") <small class="fs-6 fw-normal text-muted">lượt HV</small></div>
                        <div class="small text-muted mt-1">
                            Tại <span class="fw-semibold text-primary">@tongKhoaHoc lớp học</span> (@Model.KhoaHocTheoMon.Count môn)
                        </div>
                    </div>
                    <div class="m5-stat-icon" style="width: 44px; height: 44px; font-size: 1.25rem; background: linear-gradient(135deg, #0ea5e9, #0284c7); color: #fff;">
                        <i class="bi bi-people-fill"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ===================================================================== -->
    <!-- 3. THANH ĐIỀU HƯỚNG MỤC LỤC NHANH 8 CHUYÊN ĐỀ (JUMP-TO PILL BAR) -->
    <!-- ===================================================================== -->
    <div class="m5-filter-card py-2.5 px-3 mb-4">
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <span class="text-dark fw-bold me-1 small">
                <i class="bi bi-compass-fill text-primary me-1"></i>Điều hướng chuyên đề:
            </span>
            <a href="#sec1" class="m5-toc-pill">
                <span class="badge bg-primary text-white rounded-pill px-1.5 py-0.5">1</span> Khóa theo môn
            </a>
            <a href="#sec2" class="m5-toc-pill">
                <span class="badge bg-info text-white rounded-pill px-1.5 py-0.5">2</span> Học viên &amp; Sĩ số
            </a>
            <a href="#sec3" class="m5-toc-pill">
                <span class="badge bg-warning text-dark rounded-pill px-1.5 py-0.5">3</span> Top khóa hot
            </a>
            <a href="#sec4" class="m5-toc-pill">
                <span class="badge bg-success text-white rounded-pill px-1.5 py-0.5">4</span> Doanh thu học phí
            </a>
            <a href="#sec5" class="m5-toc-pill">
                <span class="badge bg-danger text-white rounded-pill px-1.5 py-0.5">5</span> Công nợ học phí
            </a>
            <a href="#sec6" class="m5-toc-pill">
                <span class="badge bg-purple text-white rounded-pill px-1.5 py-0.5" style="background-color: #8b5cf6;">6</span> Điểm TB khóa
            </a>
            <a href="#sec7" class="m5-toc-pill">
                <span class="badge bg-teal text-white rounded-pill px-1.5 py-0.5" style="background-color: #06b6d4;">7</span> Tỷ lệ Đạt / Không đạt
            </a>
            <a href="#sec8" class="m5-toc-pill">
                <span class="badge bg-indigo text-white rounded-pill px-1.5 py-0.5" style="background-color: #6366f1;">8</span> Đăng ký theo tháng
            </a>
        </div>
    </div>

    <!-- ===================================================================== -->
    <!-- SECTION 1: SỐ KHÓA HỌC THEO MÔN HỌC -->
    <!-- ===================================================================== -->
    <div class="m5-card mb-4" id="sec1">
        <div class="m5-card-header">
            <div class="d-flex align-items-center gap-3">
                <span class="m5-section-badge sec-1">1</span>
                <div>
                    <h5 class="fw-bold text-dark mb-0">Cơ cấu số khóa học theo từng môn học</h5>
                    <small class="text-muted">Phân bổ số lượng lớp học được tổ chức cho các chương trình môn học đào tạo</small>
                </div>
            </div>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill fw-bold">
                <i class="bi bi-book-half me-1"></i>Tổng @Model.KhoaHocTheoMon.Count môn học
            </span>
        </div>

        <div class="row g-4 align-items-center sec1-row">
            <div class="col-7 sec1-table-col">
                <div class="table-responsive">
                    <table class="m5-table-clean">
                        <thead>
                            <tr>
                                <th style="width: 90px;">Mã môn</th>
                                <th>Tên môn học</th>
                                <th class="text-center" style="width: 100px;">Tín chỉ</th>
                                <th class="text-center" style="width: 120px;">Số lớp mở</th>
                                <th style="width: 160px;">Tỷ trọng</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var maxKhoa = Model.KhoaHocTheoMon.Any() ? Math.Max(1, Model.KhoaHocTheoMon.Max(x => x.SoKhoaHoc)) : 1;
                            }
                            @foreach (var item in Model.KhoaHocTheoMon)
                            {
                                var pct = Math.Round((double)item.SoKhoaHoc / maxKhoa * 100);
                                var pctCss = pct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
                                <tr>
                                    <td>
                                        <span class="badge bg-light text-primary border px-2 py-1 fw-bold">#MH@(item.MaMonHoc.ToString("D2"))</span>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark">@item.TenMonHoc</div>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-slate text-secondary border rounded-pill px-2.5 py-1">@item.SoTinChi TC</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="fs-6 fw-bold text-primary">@item.SoKhoaHoc</span>
                                        <small class="text-muted d-block" style="font-size: 11px;">khóa học</small>
                                    </td>
                                    <td>
                                        <div class="d-flex justify-content-between align-items-center mb-1" style="font-size: 11px;">
                                            <span class="text-muted">Quy mô</span>
                                            <span class="fw-bold text-primary">@pct%</span>
                                        </div>
                                        <div class="progress" style="height: 6px; border-radius: 999px;">
                                            <div class="progress-bar bg-primary" style="width: @pctCss%; border-radius: 999px;"></div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="col-5 sec1-chart-col">
                <div class="p-3 bg-light rounded-4 border text-center sec1-chart-box">
                    <div class="text-muted small fw-semibold mb-2 sec1-chart-title">Biểu đồ phân bổ khóa học theo môn</div>
                    <div style="position: relative; height: 260px;" class="sec1-chart-canvas-wrap">
                        <canvas id="chartKhoaTheoMon"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ===================================================================== -->
    <!-- SECTION 2: SỐ HỌC VIÊN ĐĂNG KÝ THEO KHÓA & TỶ LỆ LẤP ĐẦY -->
    <!-- ===================================================================== -->
    <div class="m5-card mb-4" id="sec2">
        <div class="m5-card-header">
            <div class="d-flex align-items-center gap-3">
                <span class="m5-section-badge sec-2">2</span>
                <div>
                    <h5 class="fw-bold text-dark mb-0">Số học viên đăng ký theo từng khóa học &amp; Tỷ lệ lấp đầy</h5>
                    <small class="text-muted">Theo dõi quy mô tuyển sinh, sĩ số ghi danh thực tế so với giới hạn của từng lớp</small>
                </div>
            </div>
            <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle px-3 py-2 rounded-pill fw-bold">
                <i class="bi bi-people-fill me-1"></i>Sĩ số &amp; Tỷ lệ lấp đầy
            </span>
        </div>

        <div class="table-responsive">
            <table class="m5-table-clean">
                <thead>
                    <tr>
                        <th>Tên khóa học</th>
                        <th>Chương trình môn</th>
                        <th class="text-center" style="width: 140px;">Sĩ số đăng ký</th>
                        <th class="text-center" style="width: 120px;">Chỉ tiêu tối đa</th>
                        <th style="min-width: 200px;">Tỷ lệ lấp đầy lớp</th>
                        <th class="text-center" style="width: 140px;">Trạng thái tuyển sinh</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.HocVienTheoKhoa)
                    {
                        var isFull = item.SoHocVienDangKy >= item.SoLuongToiDa;
                        var isNearlyFull = !isFull && item.TyLeLapDay >= 80;
                        var lapDayCss = Math.Min(100, item.TyLeLapDay).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
                        <tr>
                            <td>
                                <div class="fw-bold text-dark">@item.TenKhoaHoc</div>
                                <small class="text-muted">Mã lớp: #KH@(item.MaKhoaHoc.ToString("D2"))</small>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@(item.TenMonHoc ?? "--")</span>
                            </td>
                            <td class="text-center">
                                <span class="fs-6 fw-bold text-primary">@item.SoHocVienDangKy</span>
                                <small class="text-muted"> HV</small>
                            </td>
                            <td class="text-center text-muted fw-semibold">
                                @item.SoLuongToiDa HV
                            </td>
                            <td>
                                <div class="d-flex justify-content-between mb-1" style="font-size: 11px;">
                                    <span class="text-muted">@item.SoHocVienDangKy / @item.SoLuongToiDa HV</span>
                                    <span class="fw-bold @(isFull ? "text-danger" : (isNearlyFull ? "text-warning" : "text-primary"))">@item.TyLeLapDay%</span>
                                </div>
                                <div class="progress" style="height: 7px; border-radius: 999px;">
                                    <div class="progress-bar @(isFull ? "bg-danger" : (isNearlyFull ? "bg-warning" : "bg-primary"))"
                                         style="width: @lapDayCss%; border-radius: 999px;"></div>
                                </div>
                            </td>
                            <td class="text-center">
                                @if (isFull)
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2.5 py-1.5 rounded-pill fw-bold">
                                        <i class="bi bi-slash-circle me-1"></i>Hết chỗ
                                    </span>
                                }
                                else if (isNearlyFull)
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2.5 py-1.5 rounded-pill fw-bold">
                                        <i class="bi bi-exclamation-circle me-1"></i>Còn @(item.SoLuongToiDa - item.SoHocVienDangKy) chỗ
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1.5 rounded-pill fw-bold">
                                        <i class="bi bi-check-circle me-1"></i>Còn @(item.SoLuongToiDa - item.SoHocVienDangKy) chỗ
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- ===================================================================== -->
    <!-- SECTION 3: TOP KHÓA HỌC NHIỀU HỌC VIÊN NHẤT -->
    <!-- ===================================================================== -->
    <div class="m5-card mb-4" id="sec3">
        <div class="m5-card-header">
            <div class="d-flex align-items-center gap-3">
                <span class="m5-section-badge sec-3">3</span>
                <div>
                    <h5 class="fw-bold text-dark mb-0">Top 5 khóa học có số lượng học viên đăng ký nhiều nhất</h5>
                    <small class="text-muted">Thống kê 5 lớp học có quy mô tuyển sinh và số lượng người học ghi danh đông nhất toàn hệ thống</small>
                </div>
            </div>
            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-2 rounded-pill fw-bold">
                <i class="bi bi-bar-chart-fill text-warning me-1"></i>Top 5 quy mô lớn nhất
            </span>
        </div>

        <div class="row g-3">
            @for (int i = 0; i < Model.TopKhoaHocNhieuHocVien.Count; i++)
            {
                var top = Model.TopKhoaHocNhieuHocVien[i];
                var rankClass = i == 0 ? "rank-1" : (i == 1 ? "rank-2" : (i == 2 ? "rank-3" : "rank-normal"));
                var badgeClass = i == 0 ? "gold" : (i == 1 ? "silver" : (i == 2 ? "bronze" : "normal"));
                var rankLabel = $"Top {i + 1}";
                var rankNumber = $"#{i + 1}";
                var colClass = i < 3 ? "col-md-4 col-4" : "col-md-6 col-6";

                <div class="@colClass">
                    <div class="m5-podium-card @rankClass" 
                         style="cursor: help;"
                         data-bs-toggle="tooltip" data-bs-html="true" data-bs-placement="top"
                         title="<b>@rankLabel: @top.TenKhoaHoc</b><br/>&bull; Sĩ số: <b>@top.SoHocVien / @top.SoLuongToiDa</b> học viên<br/>&bull; Môn: @top.TenMonHoc<br/>&bull; Giảng viên: @(top.TenGiangVien ?? "Chưa phân công")<br/>&bull; Học phí: @top.HocPhi.ToString("N0") VNĐ">
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="m5-podium-badge @badgeClass" style="font-size: 0.8rem; font-weight: 800;">@rankNumber</span>
                                <span class="badge bg-light text-dark border small">@top.TenMonHoc</span>
                            </div>

                            <div class="fw-bold text-dark fs-6 text-truncate mb-1" title="@top.TenKhoaHoc">
                                @top.TenKhoaHoc
                            </div>

                            <div class="text-muted small mb-3">
                                <i class="bi bi-person-badge me-1"></i>GV: @(top.TenGiangVien ?? "Đang cập nhật")
                            </div>
                        </div>

                        <div class="pt-2 border-top">
                            <div class="d-flex justify-content-between align-items-end">
                                <div>
                                    <div class="text-muted" style="font-size: 11px;">Học viên đăng ký</div>
                                    <div class="fs-4 fw-bold text-primary">@top.SoHocVien <small class="fs-6 text-muted">/ @top.SoLuongToiDa</small></div>
                                </div>
                                <div class="text-end">
                                    <div class="text-muted" style="font-size: 11px;">Học phí</div>
                                    <div class="fw-bold text-success small">@top.HocPhi.ToString("N0") đ</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- ===================================================================== -->
    <!-- SECTION 4: DOANH THU HỌC PHÍ THEO KHÓA HỌC -->
    <!-- ===================================================================== -->
    <div class="m5-card mb-4" id="sec4">
        <div class="m5-card-header">
            <div class="d-flex align-items-center gap-3">
                <span class="m5-section-badge sec-4">4</span>
                <div>
                    <h5 class="fw-bold text-dark mb-0">Báo cáo doanh thu học phí theo từng khóa học</h5>
                    <small class="text-muted">Tổng hợp dòng tiền thực thu từ học phí theo từng lớp đào tạo chuyên đề</small>
                </div>
            </div>
            <div class="text-end">
                <span class="text-muted small d-block">Tổng dòng tiền thực thu</span>
                <span class="fs-5 fw-bold text-success">@Model.TongDoanhThu.ToString("N0") VNĐ</span>
            </div>
        </div>

        <div class="table-responsive">
            <table class="m5-table-clean">
                <thead>
                    <tr>
                        <th>Khóa học</th>
                        <th>Chuyên đề môn học</th>
                        <th class="text-center" style="width: 170px;">Học viên đã hoàn thành HP</th>
                        <th class="text-end" style="width: 180px;">Doanh thu thực thu</th>
