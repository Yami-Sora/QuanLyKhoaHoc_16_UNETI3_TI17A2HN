@*
    Họ và tên: Trần Văn Thành
    Mã sinh viên: 23103100076
    Nội dung: Bố cục trang quản trị
*@

@using Microsoft.AspNetCore.Http
@{
    var userRole = Context.Session.GetString("VaiTro");
    var hoTen = Context.Session.GetString("HoTen") ?? "Quản trị viên";
    var tenDangNhap = Context.Session.GetString("TenDangNhap") ?? "admin";
    var isAdmin = userRole == "Admin";
    var isStaffOrAdmin = isAdmin || userRole == "NhanVien";

    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <partial name="_Head" />
</head>
<body class="bg-light">
    <!-- Phím tắt điều hướng nhanh -->
    <a href="#adminMain" class="uneti-skip-link">Chuyển đến nội dung chính</a>

    <div class="admin-wrapper">
        <!-- SIDEBAR DỌC BÊN TRÁI DÀNH CHO ADMIN & NHÂN VIÊN -->
        <aside class="admin-sidebar" id="adminSidebar">
            <!-- Brand / Logo -->
            <div class="admin-sidebar-brand">
                <span class="uneti-icon-box-38 bg-primary text-white shadow-sm">
                    <i class="bi bi-shield-lock-fill fs-5"></i>
                </span>
                <div>
                    <span class="d-block fw-bold text-dark lh-1" style="font-size: 1rem; letter-spacing: -0.01em;">UNETI CONSOLE</span>
                    <span class="d-block uneti-fs-xs text-muted">Quản trị Đào tạo & Khóa học</span>
                </div>
            </div>

            <!-- Khối thông tin Cán bộ đang trực -->
            <div class="admin-sidebar-user">
                <div class="d-flex align-items-center gap-3">
                    <div class="position-relative">
                        <div class="text-white rounded-circle uneti-icon-box-42 fw-bold shadow-sm" 
                             style="background: linear-gradient(135deg, #2563eb, #1d4ed8);">
                            @(string.IsNullOrEmpty(hoTen) ? "A" : hoTen.Substring(0, 1).ToUpper())
                        </div>
                        <span class="position-absolute bottom-0 end-0 p-1 bg-success border border-2 border-white rounded-circle" title="Đang trực tuyến"></span>
                    </div>
                    <div class="overflow-hidden">
                        <div class="fw-bold text-dark text-truncate small">@hoTen</div>
                        <div class="d-flex align-items-center gap-1 mt-1">
                            @if (isAdmin)
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle fw-semibold uneti-fs-xs">Quản trị viên</span>
                            }
                            else
                            {
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-semibold uneti-fs-xs">Nhân viên</span>
                            }
                            <small class="text-muted uneti-fs-xs">@@@tenDangNhap</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Menu Điều hướng Quản trị -->
            <div class="admin-sidebar-menu">
                <!-- 1. TỔNG QUAN HỆ THỐNG -->
                <div class="admin-menu-header">Tổng quan hệ thống</div>

                <a asp-controller="QuanTri" asp-action="Dashboard" class="admin-nav-item @(currentController == "QuanTri" && currentAction == "Dashboard" ? "active" : "")" title="Bảng điều khiển">
                    <i class="bi bi-speedometer2"></i>
                    <span>Bảng điều khiển</span>
                </a>

                <!-- 2. MÔN HỌC & TÀI KHOẢN -->
                <div class="admin-menu-header mt-2">Môn học & Tài khoản</div>

                <a asp-controller="MonHoc" asp-action="QuanLy" class="admin-nav-item @(currentController == "MonHoc" && currentAction == "QuanLy" ? "active" : "")" title="Quản lý môn học">
                    <i class="bi bi-book-half"></i>
                    <span>Quản lý môn học</span>
                </a>

                <a asp-controller="TaiKhoan" asp-action="QuanLy" class="admin-nav-item @(currentController == "TaiKhoan" && (currentAction == "QuanLy" || currentAction == "Index") ? "active" : "")" title="Quản lý tài khoản">
                    <i class="bi bi-people-fill"></i>
                    <span>Quản lý tài khoản</span>
                </a>

                <!-- 3. QUẢN TRỊ KHÓA HỌC -->
                <div class="admin-menu-header mt-2">Quản trị khóa học</div>

                <a asp-controller="KhoaHoc" asp-action="QuanLy" class="admin-nav-item @(currentController == "KhoaHoc" && currentAction == "QuanLy" ? "active" : "")">
                    <i class="bi bi-mortarboard-fill"></i>
                    <span>Quản lý khóa học</span>
                </a>

                <!-- 4. QUẢN TRỊ HỌC VIÊN (Module 3 - Ngọc Tùng Lâm - 23103100098) -->
                <div class="admin-menu-header mt-2">Quản trị học viên</div>

                <a asp-controller="HocVien" asp-action="Index" class="admin-nav-item @(currentController == "HocVien" ? "active" : "")" title="Quản lý hồ sơ học viên">
                    <i class="bi bi-person-lines-fill"></i>
                    <span>Quản lý hồ sơ học viên</span>
                </a>

                <!-- 5. TIẾP NHẬN & ĐĂNG KÝ (Module 4 - Bạch Đức Sự - 23103100063) -->
                <div class="admin-menu-header mt-2">Tiếp nhận & Đăng ký</div>

                <a asp-controller="TiepNhanDangKy" asp-action="Index" class="admin-nav-item @(currentController == "TiepNhanDangKy" && (currentAction == "Index" || currentAction == "Details" || currentAction == "CapNhatTrangThai") ? "active" : "")" title="Tiếp nhận & Duyệt đăng ký">
                    <i class="bi bi-card-checklist"></i>
                    <span>Tiếp nhận & Duyệt đăng ký</span>
                </a>

                <a asp-controller="TiepNhanDangKy" asp-action="Create" class="admin-nav-item @(currentController == "TiepNhanDangKy" && currentAction == "Create" ? "active" : "")" title="Ghi danh tại quầy">
                    <i class="bi bi-person-plus-fill"></i>
                    <span>Ghi danh tại quầy</span>
                </a>

                <!-- 6. KẾT QUẢ ĐÀO TẠO -->
                <div class="admin-menu-header mt-2">Kết quả đào tạo</div>

                <a href="#module-pending" role="button" class="admin-nav-item module-placeholder-link"
                   title="Quản lý kết quả học tập"
                   data-module="Module 5 (Kết quả, Dashboard & Thống kê)"
                   data-feature="Quản lý kết quả học tập & Điểm số"
                   data-desc="Bao gồm: Cập nhật điểm chuyên cần, giữa kỳ, cuối kỳ, tự động tính điểm tổng kết và xếp loại học lực học viên theo Mục 9.1 - 9.2 Đề tài 16.">
                    <i class="bi bi-award-fill"></i>
                    <span>Quản lý kết quả học tập</span>
                </a>

            </div>

            <!-- Footer Sidebar: Nút Đăng xuất -->
            <div class="admin-sidebar-footer">
                <form asp-controller="TaiKhoan" asp-action="Logout" method="post" class="w-100 m-0 p-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="admin-logout-btn w-100 fw-semibold d-flex align-items-center justify-content-center gap-2 border-0" title="Đăng xuất hệ thống">
                        <i class="bi bi-box-arrow-right"></i>
                        <span>Đăng xuất hệ thống</span>
                    </button>
                </form>
            </div>
        </aside>

        <!-- Backdrop khi mở Sidebar trên Mobile -->
        <div class="admin-sidebar-backdrop d-lg-none" id="sidebarBackdrop"></div>

        <!-- KHU VỰC NỘI DUNG CHÍNH (CONTENT AREA) -->
        <div class="admin-content-area">
            <!-- Topbar thanh công cụ quản trị phía trên -->
            <header class="admin-topbar">
                <div class="d-flex align-items-center gap-3">
                    <button class="btn btn-light d-lg-none border shadow-none" type="button" id="sidebarToggle" aria-label="Toggle sidebar">
                        <i class="bi bi-list fs-5"></i>
                    </button>
                    <button class="btn btn-light d-none d-lg-inline-flex align-items-center justify-content-center border shadow-none rounded-3 px-2 py-1 text-secondary" type="button" id="sidebarCollapseToggle" aria-label="Thu gọn / Mở rộng sidebar" title="Thu gọn / Mở rộng sidebar">
                        <i class="bi bi-layout-sidebar-inset fs-5"></i>
                    </button>
                    <div>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1.5 rounded-pill small fw-semibold">
                            <i class="bi bi-shield-check me-1"></i>Trung tâm Quản trị Hệ thống
                        </span>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-sm uneti-btn-outline rounded-3 px-3 d-none d-sm-inline-flex align-items-center gap-1">
                        <i class="bi bi-house"></i>
                        <span>Trang chủ</span>
                    </a>
                    <!-- Dropdown Hồ sơ cá nhân mini chuẩn Enterprise -->
                    <div class="dropdown">
                        <button class="btn btn-light border dropdown-toggle py-1 px-2.5 d-flex align-items-center gap-2 rounded-3 shadow-none bg-white" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="text-white rounded-circle d-inline-flex align-items-center justify-content-center fw-bold" 
                                  style="width: 28px; height: 28px; font-size: 12px; background: linear-gradient(135deg, #2563eb, #1d4ed8);">
                                @(string.IsNullOrEmpty(hoTen) ? "A" : hoTen.Substring(0, 1).ToUpper())
                            </span>
                            <span class="small fw-semibold text-dark">@hoTen</span>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end shadow-lg border p-3" style="border-radius: 14px; min-width: 270px;">
                            <!-- Header Thông tin tài khoản -->
                            <div class="d-flex align-items-center gap-3 pb-3 mb-2 border-bottom">
                                <div class="text-white rounded-circle d-flex align-items-center justify-content-center fw-bold shadow-sm flex-shrink-0" 
                                     style="width: 44px; height: 44px; font-size: 16px; background: linear-gradient(135deg, #2563eb, #1d4ed8);">
                                    @(string.IsNullOrEmpty(hoTen) ? "A" : hoTen.Substring(0, 1).ToUpper())
                                </div>
                                <div class="overflow-hidden">
                                    <div class="fw-bold text-dark text-truncate" style="font-size: 13.5px;" title="@hoTen">@hoTen</div>
                                    <div class="text-muted small text-truncate" style="font-size: 12px;">@@@tenDangNhap</div>
                                    <div class="mt-1">
                                        @if (isAdmin)
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-0.5 rounded-pill" style="font-size: 12px; font-weight: 600;">
                                                <i class="bi bi-shield-lock-fill me-1"></i>Quản trị viên
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-0.5 rounded-pill" style="font-size: 12px; font-weight: 600;">
                                                <i class="bi bi-person-badge-fill me-1"></i>Nhân viên Đào tạo
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- Tài khoản & bảo mật -->
                            <div class="d-flex flex-column gap-1">
                                <a class="dropdown-item py-2 px-2.5 rounded-2 small d-flex align-items-center gap-2 text-dark" asp-controller="TaiKhoan" asp-action="ChangePassword">
                                    <i class="bi bi-shield-lock text-warning fs-6"></i>
                                    <span class="fw-medium">Đổi mật khẩu tài khoản</span>
                                </a>
                                <form asp-controller="TaiKhoan" asp-action="Logout" method="post" class="w-100 m-0 p-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item py-2 px-2.5 rounded-2 small d-flex align-items-center gap-2 text-danger fw-semibold w-100 text-start border-0 bg-transparent">
                                        <i class="bi bi-box-arrow-right fs-6"></i>
                                        <span>Đăng xuất hệ thống</span>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Thân nội dung view render -->
            <main class="admin-main-body" id="adminMain" tabindex="-1">
                @RenderBody()
            </main>

            <!-- Chân trang Admin Footer -->
            <footer class="admin-footer">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div>
                        <strong>© 2026 Đề tài 16: Hệ thống Quản lý Khóa học và Đăng ký học</strong> — Khoa Công nghệ Thông tin.
                    </div>
                    <div>
                        <span class="badge bg-light text-muted border">
                            Cổng thông tin Quản trị Đào tạo
                        </span>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <!-- Nút cuộn lên đầu trang (Back to top) -->
    <button type="button" class="fx-back-to-top" id="btnBackToTop" aria-label="Lên đầu trang" title="Lên đầu trang">
        <i class="bi bi-chevron-up fs-5"></i>
    </button>

    <!-- Scripts -->
    <partial name="_Scripts" />
    <script>
        (function () {
            const sidebar = document.getElementById('adminSidebar');
            const toggleBtn = document.getElementById('sidebarToggle');
            const collapseBtn = document.getElementById('sidebarCollapseToggle');
            const backdrop = document.getElementById('sidebarBackdrop');

            // 1. Khôi phục trạng thái thu gọn từ localStorage an toàn
            try {
                const isCollapsed = localStorage.getItem('uneti_admin_sidebar_collapsed') === '1';
                if (isCollapsed && sidebar) {
                    sidebar.classList.add('collapsed');
                }
            } catch (e) {}

            // 2. Quản lý Tooltips khi sidebar thu gọn
            let tooltips = [];
            function updateTooltips() {
                tooltips.forEach(function (t) { t.dispose(); });
                tooltips = [];
                if (sidebar && sidebar.classList.contains('collapsed') && window.bootstrap && typeof window.bootstrap.Tooltip === 'function') {
                    sidebar.querySelectorAll('.admin-nav-item, .admin-logout-btn').forEach(function (el) {
                        const title = el.getAttribute('title');
                        if (title) {
                            tooltips.push(new bootstrap.Tooltip(el, {
                                placement: 'right',
                                trigger: 'hover',
                                fallbackPlacements: ['bottom']
                            }));
                        }
                    });
                }
            }
            updateTooltips();

            // 3. Toggle thu gọn trên Desktop
            collapseBtn?.addEventListener('click', function () {
                if (!sidebar) return;
                const willCollapse = !sidebar.classList.contains('collapsed');
                sidebar.classList.toggle('collapsed');
                try {
                    localStorage.setItem('uneti_admin_sidebar_collapsed', willCollapse ? '1' : '0');
                } catch (e) {}
                updateTooltips();
            });

            // 4. Toggle Offcanvas trên Mobile
            function openMobileSidebar() {
                sidebar?.classList.add('show');
                backdrop?.classList.add('show');
                document.body.classList.add('overflow-hidden');
            }
            function closeMobileSidebar() {
                sidebar?.classList.remove('show');
                backdrop?.classList.remove('show');
                document.body.classList.remove('overflow-hidden');
            }

            toggleBtn?.addEventListener('click', function () {
                if (sidebar?.classList.contains('show')) {
                    closeMobileSidebar();
                } else {
                    openMobileSidebar();
                }
            });

            backdrop?.addEventListener('click', closeMobileSidebar);

            // Thông báo chức năng đang phát triển
            document.querySelectorAll('.module-placeholder-link').forEach(function (item) {
                item.addEventListener('click', function (e) {
                    e.preventDefault();
                    var moduleName = this.getAttribute('data-module') || 'Module';
                    var featureName = this.getAttribute('data-feature') || '';
                    var desc = this.getAttribute('data-desc') || '';

                    if (window.UnetiUI && typeof window.UnetiUI.showModulePending === 'function') {
                        window.UnetiUI.showModulePending(moduleName, featureName, desc);
                    }
                });
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
