@*
    Họ và tên: Trần Văn Thành
    Mã sinh viên: 23103100076
    Nội dung thực hiện: Module 1 - Bố cục Quản trị Độc lập (Admin Console Layout) với Sidebar chuyên nghiệp
*@

@using Microsoft.AspNetCore.Http
@{
    var userRole = Context.Session.GetString("VaiTro");
    var hoTen = Context.Session.GetString("HoTen") ?? "Quản trị viên";
    var tenDangNhap = Context.Session.GetString("TenDangNhap") ?? "admin";
    var isAdmin = userRole == "Admin";
    var isStaffOrAdmin = isAdmin || userRole == "NhanVien";

    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UNETI Admin Console</title>
    
    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Site CSS (Unified Design System) -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <div class="admin-wrapper">
        <!-- SIDEBAR DỌC BÊN TRÁI DÀNH CHO ADMIN & NHÂN VIÊN -->
        <aside class="admin-sidebar" id="adminSidebar">
            <!-- Brand / Logo -->
            <div class="admin-sidebar-brand">
                <span class="d-inline-flex justify-content-center align-items-center text-white rounded-3 shadow-sm" 
                      style="width: 38px; height: 38px; background-color: var(--uneti-primary);">
                    <i class="bi bi-shield-lock-fill fs-5"></i>
                </span>
                <div>
                    <span class="d-block fw-bold text-white lh-1" style="font-size: 1rem; letter-spacing: -0.01em;">UNETI CONSOLE</span>
                    <span class="d-block small text-muted" style="font-size: 11px;">Quản trị Đào tạo & Khóa học</span>
                </div>
            </div>

            <!-- Khối thông tin Cán bộ đang trực -->
            <div class="admin-sidebar-user">
                <div class="d-flex align-items-center gap-3">
                    <div class="position-relative">
                        <div class="text-white rounded-circle d-flex align-items-center justify-content-center fw-bold shadow-sm" 
                             style="width: 42px; height: 42px; background: linear-gradient(135deg, #2563eb, #1d4ed8);">
                            @(string.IsNullOrEmpty(hoTen) ? "A" : hoTen.Substring(0, 1).ToUpper())
                        </div>
                        <span class="position-absolute bottom-0 end-0 p-1 bg-success border border-dark rounded-circle" title="Đang trực tuyến"></span>
                    </div>
                    <div class="overflow-hidden">
                        <div class="fw-bold text-white text-truncate small">@hoTen</div>
                        <div class="d-flex align-items-center gap-1 mt-1">
                            @if (isAdmin)
                            {
                                <span class="badge bg-danger bg-opacity-75 text-white" style="font-size: 10px;">Quản trị viên</span>
                            }
                            else
                            {
                                <span class="badge bg-primary bg-opacity-75 text-white" style="font-size: 10px;">Nhân viên</span>
                            }
                            <small class="text-muted" style="font-size: 10.5px;">@@@tenDangNhap</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Menu Điều hướng Quản trị -->
            <div class="admin-sidebar-menu">
                <!-- Nhóm 1: Module 1 - Quản lý Cốt lõi (Trần Văn Thành) -->
                <div class="admin-menu-header">Module 1 - Cán bộ Quản trị</div>
                
                <a asp-controller="Home" asp-action="Index" class="admin-nav-item @(currentController == "Home" ? "active" : "")">
                    <i class="bi bi-speedometer2"></i>
                    <span>Trang chủ Dashboard</span>
                </a>

                @if (isAdmin)
                {
                    <a asp-controller="TaiKhoan" asp-action="Index" class="admin-nav-item @(currentController == "TaiKhoan" && currentAction == "Index" ? "active" : "")">
                        <i class="bi bi-people-fill"></i>
                        <span>Quản lý tài khoản</span>
                    </a>
                }

                <a asp-controller="MonHoc" asp-action="QuanLy" class="admin-nav-item @(currentController == "MonHoc" && currentAction == "QuanLy" ? "active" : "")">
                    <i class="bi bi-book-half"></i>
                    <span>Quản lý môn học (CRUD)</span>
                </a>

                @if (isAdmin)
                {
                    <a asp-controller="MonHoc" asp-action="Create" class="admin-nav-item @(currentController == "MonHoc" && currentAction == "Create" ? "active" : "")">
                        <i class="bi bi-plus-circle"></i>
                        <span>Thêm môn học mới</span>
                    </a>
                }

                <!-- Nhóm 2: Các phân hệ nhóm khác (Đề tài 16) -->
                <div class="admin-menu-header mt-3">Phân hệ Đào tạo nhóm</div>
                <a href="javascript:void(0)" class="admin-nav-item disabled-link" title="Thuộc Module 2 của nhóm">
                    <i class="bi bi-mortarboard"></i>
                    <span class="flex-grow-1">Quản lý khóa học</span>
                    <span class="badge bg-secondary" style="font-size: 9.5px;">Mod 2</span>
                </a>
                <a href="javascript:void(0)" class="admin-nav-item disabled-link" title="Thuộc Module 4 của nhóm">
                    <i class="bi bi-card-checklist"></i>
                    <span class="flex-grow-1">Tiếp nhận đăng ký</span>
                    <span class="badge bg-secondary" style="font-size: 9.5px;">Mod 4</span>
                </a>
                <a href="javascript:void(0)" class="admin-nav-item disabled-link" title="Thuộc Module 5 của nhóm">
                    <i class="bi bi-graph-up"></i>
                    <span class="flex-grow-1">Báo cáo & Thống kê</span>
                    <span class="badge bg-secondary" style="font-size: 9.5px;">Mod 5</span>
                </a>

                <!-- Nhóm 3: Chuyển Cổng & Tiện ích -->
                <div class="admin-menu-header mt-3">Tiện ích & Cổng Sinh viên</div>
                <a asp-controller="MonHoc" asp-action="Index" class="admin-nav-item @(currentController == "MonHoc" && currentAction == "Index" ? "active" : "")" title="Xem Cổng môn học dạng Card Grid của Sinh viên">
                    <i class="bi bi-grid-3x3-gap"></i>
                    <span>Xem Cổng Sinh viên</span>
                </a>
                <a asp-controller="TaiKhoan" asp-action="ChangePassword" class="admin-nav-item @(currentController == "TaiKhoan" && currentAction == "ChangePassword" ? "active" : "")">
                    <i class="bi bi-shield-lock"></i>
                    <span>Đổi mật khẩu cá nhân</span>
                </a>
            </div>

            <!-- Footer Sidebar: Nút Đăng xuất -->
            <div class="admin-sidebar-footer">
                <a asp-controller="TaiKhoan" asp-action="Logout" class="btn btn-outline-danger btn-sm w-100 fw-semibold d-flex align-items-center justify-content-center gap-2">
                    <i class="bi bi-box-arrow-right"></i>
                    <span>Đăng xuất hệ thống</span>
                </a>
            </div>
        </aside>

        <!-- KHU VỰC NỘI DUNG CHÍNH (CONTENT AREA) -->
        <div class="admin-content-area">
            <!-- Topbar thanh công cụ quản trị phía trên -->
            <header class="admin-topbar">
                <div class="d-flex align-items-center gap-3">
                    <button class="btn btn-light d-lg-none border shadow-none" type="button" id="sidebarToggle" aria-label="Toggle sidebar">
                        <i class="bi bi-list fs-5"></i>
                    </button>
                    <div>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 rounded-pill small fw-semibold">
                            <i class="bi bi-building me-1"></i>UNETI - CỔNG QUẢN TRỊ ĐÀO TẠO
                        </span>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <a asp-controller="MonHoc" asp-action="Index" class="btn btn-sm btn-outline-primary rounded-3 px-3 d-none d-sm-inline-flex align-items-center gap-1">
                        <i class="bi bi-eye"></i>
                        <span>Cổng Sinh viên</span>
                    </a>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-sm uneti-btn-outline rounded-3 px-3 d-none d-sm-inline-flex align-items-center gap-1">
                        <i class="bi bi-house"></i>
                        <span>Trang chủ</span>
                    </a>
                    <div class="dropdown">
                        <button class="btn btn-light border dropdown-toggle py-1 px-3 d-flex align-items-center gap-2 rounded-3" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle text-primary"></i>
                            <span class="small fw-semibold text-dark">@hoTen</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 py-2" style="border-radius: 12px; min-width: 200px;">
                            <li class="px-3 py-1">
                                <small class="text-muted text-uppercase fw-bold" style="font-size: 10px;">VAI TRÒ</small>
                                <div class="fw-bold small text-dark">@(isAdmin ? "Quản trị viên" : "Nhân viên đào tạo")</div>
                            </li>
                            <li><hr class="dropdown-divider my-2"></li>
                            <li>
                                <a class="dropdown-item py-2 small" asp-controller="TaiKhoan" asp-action="ChangePassword">
                                    <i class="bi bi-shield-lock me-2 text-warning"></i>Đổi mật khẩu
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item py-2 small text-danger fw-semibold" asp-controller="TaiKhoan" asp-action="Logout">
                                    <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <!-- Thân nội dung view render -->
            <main class="admin-main-body">
                @RenderBody()
            </main>

            <!-- Chân trang Admin Footer -->
            <footer class="admin-footer">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div>
                        <strong>© 2026 Đề tài 16: Hệ thống Quản lý Khóa học và Đăng ký học</strong> — Khoa CNTT, UNETI.
                    </div>
                    <div>
                        <span class="badge bg-light text-dark border">
                            Module 1: Trần Văn Thành - MSV: 23103100076 - Lớp: TIN17A2HN
                        </span>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Toggle Sidebar on mobile
        document.getElementById('sidebarToggle')?.addEventListener('click', function () {
            document.getElementById('adminSidebar')?.classList.toggle('show');
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
