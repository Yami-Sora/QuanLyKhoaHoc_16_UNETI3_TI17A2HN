@*
    Họ và tên: Trần Văn Thành
    Mã sinh viên: 23103100076
    Nội dung: Thanh trạng thái đăng nhập
*@

@using Microsoft.AspNetCore.Http
@{
    var maTaiKhoan = Context.Session.GetInt32("MaTaiKhoan");
    var hoTen = Context.Session.GetString("HoTen");
    var tenDangNhap = Context.Session.GetString("TenDangNhap");
    var vaiTro = Context.Session.GetString("VaiTro");
}

<ul class="navbar-nav align-items-center gap-2">
@if (maTaiKhoan != null)
{
    <!-- Dropdown thông tin tài khoản dạng Modern User Chip -->
    <li class="nav-item dropdown">
        <a class="uneti-user-chip dropdown-toggle text-decoration-none" 
           href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <span class="uneti-user-avatar">
                @(string.IsNullOrEmpty(hoTen) ? "U" : hoTen.Substring(0, 1).ToUpper())
            </span>
            <div class="uneti-user-info d-none d-md-flex">
                <span class="uneti-user-name">@hoTen</span>
                <span class="uneti-user-role">
                    @switch (vaiTro)
                    {
                        case "Admin":
                            <span class="uneti-user-role-dot admin"></span><span>Quản trị viên</span>
                            break;
                        case "NhanVien":
                            <span class="uneti-user-role-dot staff"></span><span>Nhân viên</span>
                            break;
                        case "HocVien":
                            <span class="uneti-user-role-dot student"></span><span>Học viên</span>
                            break;
                        default:
                            <span class="uneti-user-role-dot"></span><span>@vaiTro</span>
                            break;
                    }
                </span>
            </div>
            <i class="bi bi-chevron-down uneti-chevron-icon"></i>
        </a>
        <ul class="dropdown-menu dropdown-menu-end border shadow-sm mt-2 uneti-user-dropdown-menu" aria-labelledby="userDropdown">
            <!-- Khối thông tin cá nhân trên cùng -->
            <li class="uneti-user-dropdown-header mb-2">
                <div class="fw-bold text-dark lh-sm">@hoTen</div>
                <div class="text-muted small mt-1 mb-2 uneti-fs-13">@@@tenDangNhap</div>
                <div>
                    @switch (vaiTro)
                    {
                        case "Admin":
                            <span class="badge bg-danger text-white uneti-badge-status">Quản trị viên</span>
                            break;
                        case "NhanVien":
                            <span class="badge bg-primary text-white uneti-badge-status">Nhân viên</span>
                            break;
                        case "HocVien":
                            <span class="badge bg-success text-white uneti-badge-status">Học viên</span>
                            break;
                        default:
                            <span class="badge bg-secondary text-white uneti-badge-status">@vaiTro</span>
                            break;
                    }
                </div>
            </li>

            @* Nếu là Admin hoặc Nhân viên thì thêm nút Quản trị lên đầu *@
            @if (vaiTro == "Admin" || vaiTro == "NhanVien")
            {
                <li>
                    <a class="dropdown-item uneti-dropdown-item-btn uneti-dropdown-item-active fw-bold" asp-controller="QuanTri" asp-action="Dashboard">
                        <i class="bi bi-speedometer2 text-primary fs-5"></i>
                        <span>Quản trị hệ thống</span>
                    </a>
                </li>
                <li><hr class="dropdown-divider my-2"></li>
            }

            <li>
                <a class="dropdown-item uneti-dropdown-item-btn text-dark" asp-controller="TaiKhoan" asp-action="ChangePassword">
                    <i class="bi bi-shield-lock text-warning fs-5"></i>
                    <span>Đổi mật khẩu</span>
                </a>
            </li>
            <li><hr class="dropdown-divider my-2"></li>
            <li>
                <form asp-controller="TaiKhoan" asp-action="Logout" method="post" class="d-inline w-100 m-0 p-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="dropdown-item uneti-dropdown-item-btn text-danger fw-semibold w-100 text-start border-0 bg-transparent">
                        <i class="bi bi-box-arrow-right text-danger fs-5"></i>
                        <span>Đăng xuất</span>
                    </button>
                </form>
            </li>
        </ul>
    </li>
}
else
{
    <li class="nav-item">
        <a asp-controller="TaiKhoan" asp-action="Login" class="uneti-nav-login-btn">
            <i class="bi bi-box-arrow-in-right"></i>
            <span>Đăng nhập</span>
        </a>
    </li>
    <li class="nav-item">
        <a asp-controller="TaiKhoan" asp-action="Register" class="uneti-nav-register-btn">
            <i class="bi bi-person-plus-fill"></i>
            <span>Đăng ký</span>
        </a>
    </li>
}
</ul>
