<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} - Hệ Thống Quản Lý Khóa Học UNETI" : "Hệ Thống Quản Lý Khóa Học UNETI")</title>

<!-- Google Fonts: Plus Jakarta Sans -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<!-- Bootstrap CSS -->
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<!-- Site CSS (Unified Design System) -->
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
<!-- Global Effects System -->
<link rel="stylesheet" href="~/css/effects.css" asp-append-version="true" />

<!-- Hỗ trợ JavaScript Detection & Khôi phục tức thì vị trí cuộn phân trang (không bị giật lên đầu) -->
<script>
    document.documentElement.classList.add('js');
    (function () {
        try {
            var y = sessionStorage.getItem('uneti_pagination_scroll_y');
            var t = sessionStorage.getItem('uneti_pagination_scroll_time');
            if (y !== null && t !== null && (Date.now() - parseInt(t, 10) < 15000)) {
                if ('scrollRestoration' in history) {
                    history.scrollRestoration = 'manual';
                }
                window.scrollTo(0, parseInt(y, 10));
            }
        } catch (_) {}
    })();
</script>
