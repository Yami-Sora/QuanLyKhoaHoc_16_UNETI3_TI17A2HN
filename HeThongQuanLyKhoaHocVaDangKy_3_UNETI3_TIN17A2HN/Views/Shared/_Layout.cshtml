@*
    Họ và tên: Trần Văn Thành
    Mã sinh viên: 23103100076
    Nội dung: Bố cục chung hệ thống
*@

@using Microsoft.AspNetCore.Http
@{
    var userRole = Context.Session.GetString("VaiTro");
    var isLoggedIn = Context.Session.GetInt32("MaTaiKhoan") != null;
    var currentCtrl = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAct = ViewContext.RouteData.Values["action"]?.ToString();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <partial name="_Head" />
    <link rel="stylesheet" href="~/HeThongQuanLyKhoaHocVaDangKy_3_UNETI3_TIN17A2HN.styles.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <!-- Phím tắt điều hướng nhanh -->
    <a href="#main" class="uneti-skip-link">Chuyển đến nội dung chính</a>

    <header>
        <nav class="navbar navbar-expand-lg uneti-navbar sticky-top py-2">
            <div class="container-fluid px-lg-4">
                <a class="navbar-brand d-flex align-items-center gap-2 text-decoration-none" asp-controller="Home" asp-action="Index">
                    <span class="uneti-icon-box-38 bg-primary text-white shadow-sm">
                        <i class="bi bi-mortarboard-fill fs-5"></i>
                    </span>
                    <span>
                        <span class="d-block text-dark fw-bold lh-1" style="font-size: 1.05rem; letter-spacing: -0.02em;">UNETI - ĐÀO TẠO</span>
                        <span class="d-block uneti-fs-xs fw-semibold text-primary mt-1">Quản Lý Khóa Học & Đăng Ký</span>
                    </span>
                </a>
                
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" 
                        aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3 gap-1">
                        <li class="nav-item">
                            <a class="uneti-nav-link text-decoration-none @(currentCtrl == "Home" && currentAct == "Index" ? "active" : "")" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door"></i>Trang chủ
                            </a>
                        </li>
                        
                        <li class="nav-item">
                            <a class="uneti-nav-link text-decoration-none @(currentCtrl == "MonHoc" && currentAct == "Index" ? "active" : "")" asp-controller="MonHoc" asp-action="Index">
                                <i class="bi bi-mortarboard"></i>Môn học
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="uneti-nav-link text-decoration-none @(currentCtrl == "KhoaHoc" ? "active" : "")" asp-controller="KhoaHoc" asp-action="Index">
                                <i class="bi bi-journal-album"></i>Khóa học
                            </a>
                        </li>

                        @if (userRole == "Admin" || userRole == "NhanVien")
                        {
                            <li class="nav-item">
                                <a class="uneti-nav-link text-primary fw-bold text-decoration-none @(currentCtrl == "QuanTri" && currentAct == "Dashboard" ? "active" : "")" asp-controller="QuanTri" asp-action="Dashboard">
                                    <i class="bi bi-speedometer2"></i>Quản trị
                                </a>
                            </li>
                        }
                        else if (userRole == "HocVien")
                        {
                            <li class="nav-item">
                                <a class="uneti-nav-link text-decoration-none @(currentCtrl == "DangKyKhoaHoc" ? "active" : "")" asp-controller="DangKyKhoaHoc" asp-action="Index">
                                    <i class="bi bi-journal-check"></i>Khóa học của tôi
                                </a>
                            </li>
                        }
                    </ul>

                    <!-- Partial View Đăng nhập, Hồ sơ & Nút Đăng xuất -->
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="content-wrapper">
        <main role="main" id="main" tabindex="-1" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="uneti-footer py-3 mt-4">
        <div class="container-fluid px-lg-4">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start mb-2 mb-md-0">
                    <span class="fw-semibold text-dark">© 2026 Đề tài 16: Hệ thống Quản lý Khóa học và Đăng ký học</span>
                    <div class="small text-muted">Khoa Công nghệ Thông tin - Trường ĐH Kinh tế - Kỹ thuật Công nghiệp (UNETI)</div>
                </div>
                <div class="col-md-6 text-center text-md-end text-muted small">
                    <span>Hệ thống Cổng Đào tạo & Quản lý Học tập</span>
                </div>
            </div>
        </div>
    </footer>

    <!-- Nút cuộn lên đầu trang (Back to top) -->
    <button type="button" class="fx-back-to-top" id="btnBackToTop" aria-label="Lên đầu trang" title="Lên đầu trang">
        <i class="bi bi-chevron-up fs-5"></i>
    </button>

    <partial name="_Scripts" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
