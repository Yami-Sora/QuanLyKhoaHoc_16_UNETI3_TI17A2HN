@*
    Họ và tên: Trần Văn Thành
    Mã sinh viên: 23103100076
    Nội dung thực hiện: Module 1 - Bố cục chung hệ thống (Unified Layout) chuẩn UNETI
*@

@using Microsoft.AspNetCore.Http
@{
    var userRole = Context.Session.GetString("VaiTro");
    var isLoggedIn = Context.Session.GetInt32("MaTaiKhoan") != null;
    var currentCtrl = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAct = ViewContext.RouteData.Values["action"]?.ToString();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hệ Thống Quản Lý Khóa Học UNETI</title>
    
    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Site CSS (Unified Design System) -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HeThongQuanLyKhoaHocVaDangKy_3_UNETI3_TIN17A2HN.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg uneti-navbar sticky-top py-2">
            <div class="container-fluid px-lg-4">
                <a class="navbar-brand d-flex align-items-center gap-2 text-decoration-none" asp-controller="Home" asp-action="Index">
                    <span class="d-inline-flex justify-content-center align-items-center text-white rounded-3 shadow-sm" 
                          style="width: 38px; height: 38px; background-color: var(--uneti-primary);">
                        <i class="bi bi-mortarboard-fill fs-5"></i>
                    </span>
                    <span>
                        <span class="d-block text-dark fw-bold" style="font-size: 1.05rem; letter-spacing: -0.02em;">UNETI - ĐÀO TẠO</span>
                        <span class="d-block small fw-semibold" style="font-size: 11px; margin-top: -2px; color: var(--uneti-primary);">Quản Lý Khóa Học & Đăng Ký</span>
                    </span>
                </a>
                
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" 
                        aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3 gap-1">
                        <li class="nav-item">
                            <a class="uneti-nav-link text-decoration-none @(currentCtrl == "Home" && currentAct == "Index" ? "active" : "")" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door"></i>Trang chủ
                            </a>
                        </li>
                        
                        <li class="nav-item">
                            <a class="uneti-nav-link text-decoration-none @(currentCtrl == "MonHoc" && currentAct == "Index" ? "active" : "")" asp-controller="MonHoc" asp-action="Index">
                                <i class="bi bi-mortarboard"></i>Môn học
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="uneti-nav-link text-decoration-none" href="javascript:void(0)" onclick="thongBaoModule(2)">
                                <i class="bi bi-journal-album"></i>Khóa học
                            </a>
                        </li>

                        @if (userRole == "Admin" || userRole == "NhanVien")
                        {
                            <li class="nav-item">
                                <a class="uneti-nav-link text-primary fw-bold text-decoration-none @(currentCtrl == "QuanTri" && currentAct == "Dashboard" ? "active" : "")" asp-controller="QuanTri" asp-action="Dashboard">
                                    <i class="bi bi-speedometer2"></i>Quản trị
                                </a>
                            </li>
                        }
                        else if (userRole == "HocVien")
                        {
                            <li class="nav-item">
                                <a class="uneti-nav-link text-decoration-none" href="javascript:void(0)" onclick="thongBaoModule(3)">
                                    <i class="bi bi-journal-check"></i>Khóa học của tôi
                                </a>
                            </li>
                        }
                    </ul>

                    <!-- Partial View Đăng nhập, Hồ sơ & Nút Đăng xuất -->
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="content-wrapper">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="uneti-footer py-3 mt-4">
        <div class="container-fluid px-lg-4">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start mb-2 mb-md-0">
                    <span class="fw-semibold text-dark">© 2026 Đề tài 16: Hệ thống Quản lý Khóa học và Đăng ký học</span>
                    <div class="small text-muted">Khoa Công nghệ Thông tin - Trường ĐH Kinh tế - Kỹ thuật Công nghiệp (UNETI)</div>
                </div>
                <div class="col-md-6 text-center text-md-end text-muted small">
                    <span>Hệ thống Cổng Đào tạo & Quản lý Học tập</span>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
