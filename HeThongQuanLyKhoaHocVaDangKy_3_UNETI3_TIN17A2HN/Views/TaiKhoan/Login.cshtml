@*
    Họ và tên: Trần Văn Thành
    Mã sinh viên: 23103100076
    Nội dung thực hiện: Module 1 - Giao diện Đăng nhập hệ thống kèm bảng tài khoản kiểm thử
*@

@model HeThongQuanLyKhoaHocVaDangKy_3_UNETI3_TIN17A2HN.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập hệ thống";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                <div class="card-header bg-primary text-white text-center py-4">
                    <h4 class="fw-bold mb-1"><i class="bi bi-mortarboard-fill me-2"></i>HỆ THỐNG QUẢN LÝ KHÓA HỌC</h4>
                    <p class="small text-white-50 mb-0">Đăng nhập tài khoản để tiếp tục</p>
                </div>

                <div class="card-body p-4 p-md-5">
                    <form asp-action="Login" method="post" novalidate>
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ReturnUrl" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="TenDangNhap" class="form-label fw-semibold">Tên đăng nhập</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
                                <input asp-for="TenDangNhap" class="form-control" placeholder="Nhập tên đăng nhập..." autofocus />
                            </div>
                            <span asp-validation-for="TenDangNhap" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MatKhau" class="form-label fw-semibold">Mật khẩu</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-lock"></i></span>
                                <input asp-for="MatKhau" type="password" class="form-control" id="passwordInput" placeholder="Nhập mật khẩu..." />
                                <button class="btn btn-outline-secondary" type="button" onclick="togglePasswordVisibility()">
                                    <i class="bi bi-eye" id="toggleIcon"></i>
                                </button>
                            </div>
                            <span asp-validation-for="MatKhau" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="GhiNho" id="rememberMe">
                                <label class="form-check-label small text-muted" for="rememberMe">
                                    Ghi nhớ phiên
                                </label>
                            </div>
                            <a asp-action="Register" class="small text-primary text-decoration-none fw-semibold">Đăng ký học viên mới?</a>
                        </div>

                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-primary btn-lg fw-bold shadow-sm">
                                <i class="bi bi-box-arrow-in-right me-2"></i>Đăng nhập
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Bảng Tài khoản mẫu phục vụ kiểm thử theo Mục 16 Đề 16 -->
                <div class="card-footer bg-light p-3 border-top">
                    <p class="small text-muted fw-bold mb-2 text-center"><i class="bi bi-info-circle me-1"></i>Tài khoản kiểm thử nhanh (Demo):</p>
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered text-center small mb-0 bg-white">
                            <thead class="table-secondary">
                                <tr>
                                    <th>Vai trò</th>
                                    <th>Username</th>
                                    <th>Password</th>
                                    <th>Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><span class="badge bg-danger">Admin</span></td>
                                    <td><code>admin</code></td>
                                    <td><code>Admin@123</code></td>
                                    <td><span class="badge bg-success">Hoạt động</span></td>
                                </tr>
                                <tr>
                                    <td><span class="badge bg-info text-dark">Nhân viên</span></td>
                                    <td><code>nv_daotao</code></td>
                                    <td><code>Nv@123</code></td>
                                    <td><span class="badge bg-success">Hoạt động</span></td>
                                </tr>
                                <tr>
                                    <td><span class="badge bg-secondary">Học viên</span></td>
                                    <td><code>sv_nguyenvana</code></td>
                                    <td><code>Sv@123</code></td>
                                    <td><span class="badge bg-success">Hoạt động</span></td>
                                </tr>
                                <tr>
                                    <td><span class="badge bg-secondary">Học viên (Khóa)</span></td>
                                    <td><code>sv_bitaikhoa</code></td>
                                    <td><code>Sv@123</code></td>
                                    <td><span class="badge bg-danger">Bị khóa</span></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePasswordVisibility() {
            var passInput = document.getElementById("passwordInput");
            var toggleIcon = document.getElementById("toggleIcon");
            if (passInput.type === "password") {
                passInput.type = "text";
                toggleIcon.classList.remove("bi-eye");
                toggleIcon.classList.add("bi-eye-slash");
            } else {
                passInput.type = "password";
                toggleIcon.classList.remove("bi-eye-slash");
                toggleIcon.classList.add("bi-eye");
            }
        }
    </script>
}
