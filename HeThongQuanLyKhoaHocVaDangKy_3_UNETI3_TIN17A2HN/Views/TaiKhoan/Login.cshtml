@*
    Họ và tên: Trần Văn Thành
    Mã sinh viên: 23103100076
    Nội dung: Đăng nhập hệ thống
*@

@model HeThongQuanLyKhoaHocVaDangKy_3_UNETI3_TIN17A2HN.ViewModels.LoginViewModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment WebHostEnvironment
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@using Microsoft.Extensions.Hosting
@{
    Layout = null;
    ViewData["Title"] = "Đăng nhập hệ thống";
    var showDemoAccounts = WebHostEnvironment.IsDevelopment() || Configuration.GetValue<bool>("ShowDemoAccounts");
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <partial name="_Head" />
</head>
<body>
    <div class="login-card">
        <!-- Logo & Header -->
        <div class="text-center mb-4">
            <div class="uneti-logo-badge">
                <i class="bi bi-mortarboard-fill"></i>
            </div>
            <h1 class="header-title">ĐĂNG NHẬP HỆ THỐNG</h1>
            <p class="header-subtitle mb-0">Hệ thống Đào tạo & Quản lý Khóa học Trực tuyến</p>
        </div>

        <!-- Thông báo phản hồi -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show small py-2 px-3 rounded-3 mb-3 border-0 shadow-sm" role="alert" style="background-color: #ecfdf5; color: #047857;">
                <i class="bi bi-check-circle-fill me-1"></i>@TempData["SuccessMessage"]
                <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 px-3 rounded-3 mb-3 border-0 shadow-sm" role="alert" style="background-color: #fef2f2; color: #b91c1c;"></div>

        <!-- Form Đăng nhập -->
        <form asp-action="Login" method="post" id="loginForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl" />

            <!-- Tên đăng nhập -->
            <div class="mb-3">
                <label asp-for="TenDangNhap" class="form-label-custom">Tên đăng nhập</label>
                <div class="custom-input-group">
                    <i class="bi bi-person-fill input-icon-start"></i>
                    <input asp-for="TenDangNhap" id="txtUsername" class="form-control custom-input" placeholder="Nhập tên đăng nhập hoặc mã học viên" autofocus autocomplete="username" />
                </div>
                <span asp-validation-for="TenDangNhap" class="text-danger small mt-1 d-block fw-medium"></span>
            </div>

            <!-- Mật khẩu -->
            <div class="mb-3">
                <label asp-for="MatKhau" class="form-label-custom">Mật khẩu</label>
                <div class="custom-input-group">
                    <i class="bi bi-lock-fill input-icon-start"></i>
                    <input asp-for="MatKhau" type="password" id="txtPassword" class="form-control custom-input" placeholder="Nhập mật khẩu của bạn" autocomplete="current-password" />
                    <button type="button" class="btn-toggle-eye" id="btnTogglePassword" onclick="togglePasswordVisibility()" title="Hiện / Ẩn mật khẩu" aria-label="Hiện / Ẩn mật khẩu" aria-pressed="false" tabindex="-1">
                        <i class="bi bi-eye" id="toggleIcon"></i>
                    </button>
                </div>
                <span asp-validation-for="MatKhau" class="text-danger small mt-1 d-block fw-medium"></span>
            </div>

            <!-- Hàng Ghi nhớ & Quên mật khẩu cân đối -->
            <div class="d-flex justify-content-between align-items-center mb-4 pt-1">
                <div class="form-check d-flex align-items-center mb-0">
                    <input asp-for="GhiNho" class="form-check-input me-2 mt-0" type="checkbox" id="chkRemember" style="width: 17px; height: 17px; cursor: pointer; border-color: #cbd5e1;">
                    <label class="form-check-label text-muted user-select-none" for="chkRemember" style="font-size: 13px; cursor: pointer;">
                        Ghi nhớ đăng nhập
                    </label>
                </div>
                <a asp-action="ForgotPassword" class="text-decoration-none fw-semibold" style="color: #2563eb; font-size: 13px;">
                    Quên mật khẩu?
                </a>
            </div>

            <!-- Nút Đăng nhập Gradient -->
            <button type="submit" class="btn btn-submit-login mb-3">
                <span>Đăng nhập</span>
                <i class="bi bi-arrow-right"></i>
            </button>

            <!-- Lối tắt đăng ký & về trang chủ -->
            <div class="text-center small text-muted mb-2">
                Chưa có tài khoản học viên? 
                <a asp-action="Register" class="text-decoration-none fw-bold" style="color: #2563eb;">
                    Đăng ký ngay
                </a>
            </div>
            <div class="text-center">
                <a asp-controller="Home" asp-action="Index" class="text-secondary text-decoration-none small d-inline-flex align-items-center gap-1 hover-underline">
                    <i class="bi bi-arrow-left"></i> Quay lại Trang chủ
                </a>
            </div>
        </form>

        @if (showDemoAccounts)
        {
            <!-- Điền nhanh tài khoản mẫu (chỉ khi test) -->
            <div class="demo-accounts-box mt-4">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="d-flex align-items-center gap-1 fw-bold uneti-fs-12" style="color: #475569; text-transform: uppercase; letter-spacing: 0.03em;">
                        <i class="bi bi-lightning-charge-fill text-warning"></i> Tài khoản mẫu dùng thử:
                    </span>
                    <span class="badge rounded-pill bg-white text-secondary border px-2 py-0.5 uneti-fs-12" style="font-weight: 500;">
                        Bấm để điền
                    </span>
                </div>
                <div class="demo-pills-grid">
                    <button type="button" class="demo-pill demo-pill-admin" onclick="fillAccount('admin', 'Admin@123', 'Admin', this)" title="Vai trò Quản trị viên">
                        <i class="bi bi-shield-lock-fill"></i> Admin
                    </button>
                    <button type="button" class="demo-pill demo-pill-staff" onclick="fillAccount('nv_daotao', 'Nv@123', 'Nhân viên', this)" title="Vai trò Nhân viên Đào tạo">
                        <i class="bi bi-person-badge-fill"></i> Nhân viên
                    </button>
                    <button type="button" class="demo-pill demo-pill-student" onclick="fillAccount('sv_nguyenvana', 'Sv@123', 'Học viên', this)" title="Vai trò Học viên">
                        <i class="bi bi-mortarboard-fill"></i> Học viên
                    </button>
                    <button type="button" class="demo-pill demo-pill-locked" onclick="fillAccount('sv_bitaikhoa', 'Sv@123', 'Bị khóa', this)" title="Tài khoản bị khóa để test nghiệp vụ">
                        <i class="bi bi-lock-fill"></i> Bị khóa
                    </button>
                </div>
            </div>
        }
    </div>

    <!-- Scripts -->
    <partial name="_Scripts" />
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script>
        function fillAccount(username, password, roleName, el) {
            const u = document.getElementById('txtUsername');
            const p = document.getElementById('txtPassword');
            
            u.value = username;
            p.value = password;

            $(u).removeClass('input-validation-error');
            $(p).removeClass('input-validation-error');
            $('span[data-valmsg-for="TenDangNhap"]').removeClass('field-validation-error').addClass('field-validation-valid').text('');
            $('span[data-valmsg-for="MatKhau"]').removeClass('field-validation-error').addClass('field-validation-valid').text('');

            // Đánh dấu nút vừa bấm bằng class is-active
            document.querySelectorAll('.demo-pill').forEach(btn => btn.classList.remove('is-active'));
            if (el) {
                el.classList.add('is-active');
            }

            // Hiệu ứng phản hồi nhẹ
            u.classList.remove('input-flash');
            p.classList.remove('input-flash');
            void u.offsetWidth; // trigger reflow
            u.classList.add('input-flash');
            p.classList.add('input-flash');

            // Toast thông báo qua hệ thống toast hiện có
            if (window.UnetiUI && typeof window.UnetiUI.toast === 'function') {
                window.UnetiUI.toast({
                    type: 'info',
                    title: 'Bấm để điền',
                    message: 'Đã điền tài khoản ' + (roleName || username),
                    duration: 2500
                });
            }

            p.focus();
        }

        function togglePasswordVisibility() {
            const pass = document.getElementById('txtPassword');
            const icon = document.getElementById('toggleIcon');
            const btn = document.getElementById('btnTogglePassword');
            if (pass.type === 'password') {
                pass.type = 'text';
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
                if (btn) btn.setAttribute('aria-pressed', 'true');
            } else {
                pass.type = 'password';
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
                if (btn) btn.setAttribute('aria-pressed', 'false');
            }
        }

        $(function () {
            @if (!ViewData.ModelState.IsValid)
            {
                <text>
                const card = document.querySelector('.login-card');
                if (card) {
                    card.classList.add('fx-shake');
                    setTimeout(() => card.classList.remove('fx-shake'), 450);
                }
                if (window.UnetiUI && typeof window.UnetiUI.toast === 'function') {
                    window.UnetiUI.toast({
                        type: 'danger',
                        title: 'Đăng nhập không thành công',
                        message: 'Tên đăng nhập hoặc mật khẩu không chính xác. Vui lòng kiểm tra lại!'
                    });
                }
                </text>
            }

            if ($.validator) {
                $.validator.setDefaults({
                    onkeyup: false,
                    onfocusout: function (element) {
                        if ($(element).is(':checkbox') || $(element).is(':radio')) {
                            return;
                        }
                        $(element).valid();
                    }
                });
            }

            // Tự động xóa lỗi 1 lần khi người dùng bắt đầu sửa
            $('form').on('input', 'input', function () {
                var $input = $(this);
                if ($input.hasClass('input-validation-error')) {
                    $input.removeClass('input-validation-error');
                    var fieldName = $input.attr('name');
                    if (fieldName) {
                        var $err = $('span[data-valmsg-for="' + fieldName + '"]');
                        $err.removeClass('field-validation-error').addClass('field-validation-valid').text('');
                    }
                }
            });
        });
    </script>
</body>
</html>
