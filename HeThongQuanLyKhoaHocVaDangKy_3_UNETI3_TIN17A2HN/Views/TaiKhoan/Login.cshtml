@*
    Họ và tên: Trần Văn Thành
    Mã sinh viên: 23103100076
    Nội dung thực hiện: Module 1 - Giao diện Đăng nhập Hệ thống chuẩn UNETI (Đồng bộ nhận diện thương hiệu)
*@

@model HeThongQuanLyKhoaHocVaDangKy_3_UNETI3_TIN17A2HN.ViewModels.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Đăng nhập hệ thống";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UNETI Đào Tạo</title>
    
    <!-- Google Font: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap CSS & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Site CSS (Unified Design System) -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        body {
            min-height: 100vh;
            background-color: #dbeafe;
            background-image: url('/images/auth-bg.jpg');
            background-repeat: no-repeat;
            background-position: center center;
            background-size: cover;
            background-attachment: fixed;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 2rem 1.5rem;
            margin: 0;
            position: relative;
        }

        .login-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.9);
            border-radius: 20px;
            box-shadow: 0 20px 40px -10px rgba(15, 23, 42, 0.18), 0 8px 16px -4px rgba(0, 0, 0, 0.06);
            width: 100%;
            max-width: 440px;
            position: relative;
            z-index: 10;
        }
        .uneti-logo-badge {
            width: 52px;
            height: 52px;
            background: var(--uneti-primary);
            color: #ffffff;
            border-radius: 14px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 26px;
            box-shadow: 0 4px 14px rgba(29, 78, 216, 0.3);
        }

        /* Custom Modern Form Inputs (Chuẩn nhận diện & theo Mockup Ảnh 1) */
        .form-label-custom {
            color: #1e3a8a;
            font-size: 14.5px;
            font-weight: 700;
            display: flex;
            align-items: center;
            margin-bottom: 0.5rem;
        }

        .form-label-custom i {
            color: #1e3a8a;
            font-size: 1.2rem;
            margin-right: 0.5rem;
        }

        .custom-input-group {
            position: relative;
            display: flex;
            align-items: center;
            width: 100%;
        }

        .custom-input-group .input-icon-start {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: #3b82f6;
            font-size: 1.25rem;
            pointer-events: none;
            z-index: 5;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .custom-input-group .form-control.custom-input {
            width: 100%;
            height: 52px;
            padding-left: 48px;
            padding-right: 48px;
            border-radius: 12px;
            border: 1.5px solid #bfdbfe;
            background-color: #ffffff;
            font-size: 15px;
            font-family: inherit;
            color: #1e293b;
            box-shadow: none;
            transition: all 0.2s ease-in-out;
        }

        .custom-input-group .form-control.custom-input::placeholder {
            color: #94a3b8;
            font-weight: 400;
        }

        .custom-input-group .form-control.custom-input:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.18);
            background-color: #ffffff;
            color: #1e293b;
            outline: none;
        }

        .custom-input-group .form-control.custom-input.input-validation-error {
            border-color: #ef4444;
        }

        .custom-input-group .form-control.custom-input.input-validation-error:focus {
            box-shadow: 0 0 0 4px rgba(239, 68, 68, 0.18);
        }

        /* Password toggle eye button - Rõ nét, hiện đại, màu xanh chuẩn */
        .btn-toggle-eye {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            background: transparent;
            border: none;
            padding: 8px;
            color: #2563eb;
            font-size: 1.3rem;
            cursor: pointer;
            z-index: 6;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            transition: all 0.2s ease;
            line-height: 1;
        }

        .btn-toggle-eye:hover {
            color: #1d4ed8;
            background-color: rgba(37, 99, 235, 0.08);
            transform: translateY(-50%) scale(1.1);
        }

        .btn-toggle-eye:active {
            transform: translateY(-50%) scale(0.95);
        }

        .btn-toggle-eye:focus {
            outline: none;
        }
    </style>
</head>
<body>
    <div class="login-card p-4 p-md-5">
        <!-- Logo & Header -->
        <div class="text-center mb-4">
            <div class="uneti-logo-badge mb-3">
                <i class="bi bi-mortarboard-fill"></i>
            </div>
            <h4 class="fw-bold text-dark mb-1">ĐĂNG NHẬP HỆ THỐNG</h4>
            <p class="text-muted small mb-0">Đồng hành cùng hành trình học tập và phát triển của bạn</p>
        </div>

        <!-- Thông báo phản hồi -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show small py-2 px-3 rounded-3 mb-3" role="alert">
                <i class="bi bi-check-circle-fill me-1"></i>@TempData["SuccessMessage"]
                <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 px-3 rounded-3 mb-3" role="alert"></div>

        <!-- Form Đăng nhập chuẩn theo Mockup Ảnh 1 -->
        <form asp-action="Login" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl" />

            <!-- Tên đăng nhập -->
            <div class="mb-3">
                <label asp-for="TenDangNhap" class="form-label-custom">
                    <i class="bi bi-person-plus-fill"></i> Tên đăng nhập
                </label>
                <div class="custom-input-group">
                    <i class="bi bi-person-fill input-icon-start"></i>
                    <input asp-for="TenDangNhap" id="txtUsername" class="form-control custom-input" placeholder="Nhập tên đăng nhập" autofocus />
                </div>
                <span asp-validation-for="TenDangNhap" class="text-danger small mt-1 d-block"></span>
            </div>

            <!-- Mật khẩu -->
            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label asp-for="MatKhau" class="form-label-custom mb-0">
                        <i class="bi bi-lock-fill"></i> Mật khẩu
                    </label>
                    <a asp-action="ForgotPassword" class="text-decoration-none fw-semibold" style="color: #2563eb; font-size: 13px;">
                        Quên mật khẩu?
                    </a>
                </div>
                <div class="custom-input-group">
                    <i class="bi bi-lock-fill input-icon-start"></i>
                    <input asp-for="MatKhau" type="password" id="txtPassword" class="form-control custom-input" placeholder="Nhập mật khẩu" />
                    <button type="button" class="btn-toggle-eye" onclick="togglePasswordVisibility()" title="Hiện / Ẩn mật khẩu" aria-label="Hiện / Ẩn mật khẩu" tabindex="-1">
                        <i class="bi bi-eye" id="toggleIcon"></i>
                    </button>
                </div>
                <span asp-validation-for="MatKhau" class="text-danger small mt-1 d-block"></span>
            </div>

            <!-- Nút Đăng nhập -->
            <button type="submit" class="btn uneti-btn-primary w-100 py-2 fw-bold mb-3 shadow-sm" style="border-radius: 12px; height: 50px; font-size: 16px;">
                <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập
            </button>

            <!-- Lối tắt đăng ký & về trang chủ -->
            <div class="text-center small text-muted">
                Chưa có tài khoản học viên? 
                <a asp-action="Register" class="text-decoration-none fw-bold" style="color: var(--uneti-primary);">
                    Đăng ký ngay
                </a>
                <div class="mt-2">
                    <a asp-controller="Home" asp-action="Index" class="text-secondary text-decoration-none small">
                        <i class="bi bi-arrow-left me-1"></i>Quay lại Trang chủ
                    </a>
                </div>
            </div>
        </form>

        <!-- Tiện ích 1-Click tài khoản mẫu (Dành cho Giảng viên chấm bài) -->
        <div class="mt-4 pt-3 border-top text-center">
            <small class="text-muted d-block fw-semibold mb-2" style="font-size: 11px;">
                <i class="bi bi-lightning-charge text-warning me-1"></i>TÀI KHOẢN MẪU KIỂM THỬ (Click để điền nhanh):
            </small>
            <div class="d-flex flex-wrap justify-content-center gap-1">
                <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2 rounded-pill" style="font-size: 11px;" onclick="fillAccount('admin', 'Admin@123')">
                    Admin
                </button>
                <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2 rounded-pill" style="font-size: 11px;" onclick="fillAccount('nv_daotao', 'Nv@123')">
                    Nhân viên
                </button>
                <button type="button" class="btn btn-sm btn-outline-success py-0 px-2 rounded-pill" style="font-size: 11px;" onclick="fillAccount('sv_nguyenvana', 'Sv@123')">
                    Học viên
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 rounded-pill" style="font-size: 11px;" onclick="fillAccount('sv_bitaikhoa', 'Sv@123')">
                    Bị khóa
                </button>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function fillAccount(username, password) {
            document.getElementById('txtUsername').value = username;
            document.getElementById('txtPassword').value = password;
        }
        function togglePasswordVisibility() {
            const pass = document.getElementById('txtPassword');
            const icon = document.getElementById('toggleIcon');
            if (pass.type === 'password') {
                pass.type = 'text';
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
            } else {
                pass.type = 'password';
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
            }
        }
    </script>
</body>
</html>
