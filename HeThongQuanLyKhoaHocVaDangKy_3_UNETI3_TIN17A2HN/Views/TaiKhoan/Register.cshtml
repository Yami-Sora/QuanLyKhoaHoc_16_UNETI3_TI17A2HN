@*
    Họ và tên: Trần Văn Thành
    Mã sinh viên: 23103100076
    Nội dung: Đăng ký tài khoản học viên
*@

@model HeThongQuanLyKhoaHocVaDangKy_3_UNETI3_TIN17A2HN.ViewModels.RegisterViewModel
@{
    Layout = null;
    ViewData["Title"] = "Đăng ký tài khoản học viên";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <partial name="_Head" />
</head>
<body>
    <div class="register-card">
        <!-- Logo & Header -->
        <div class="text-center mb-4">
            <div class="logo-badge">
                <i class="bi bi-mortarboard-fill"></i>
            </div>
            <h1 class="header-title">ĐĂNG KÝ TÀI KHOẢN</h1>
            <p class="header-subtitle mb-0">Tạo tài khoản học viên để tham gia các khóa học trực tuyến</p>
        </div>

        <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 px-3 rounded-3 mb-3 border-0 shadow-sm" role="alert" style="background-color: #fef2f2; color: #b91c1c;"></div>

        <!-- Form Đăng ký -->
        <form asp-action="Register" method="post">
            @Html.AntiForgeryToken()

            <!-- Hàng 1: Họ tên + Số điện thoại -->
            <div class="row g-2 mb-2">
                <div class="col-md-6">
                    <label asp-for="HoTen" class="form-label-custom">
                        Họ và tên <span class="text-danger">*</span>
                    </label>
                    <div class="custom-input-group">
                        <i class="bi bi-person-fill input-icon-start"></i>
                        <input asp-for="HoTen" class="form-control custom-input no-right-icon" placeholder="Nguyễn Văn A" autofocus autocomplete="name" />
                    </div>
                    <span asp-validation-for="HoTen" class="text-danger small mt-1 d-block fw-medium"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="SoDienThoai" class="form-label-custom">
                        Số điện thoại <span class="text-danger">*</span>
                    </label>
                    <div class="custom-input-group">
                        <i class="bi bi-telephone-fill input-icon-start"></i>
                        <input asp-for="SoDienThoai" class="form-control custom-input no-right-icon" placeholder="0912 345 678" autocomplete="tel" />
                    </div>
                    <span asp-validation-for="SoDienThoai" class="text-danger small mt-1 d-block fw-medium"></span>
                </div>
            </div>

            <!-- Hàng 2: Email -->
            <div class="mb-2">
                <label asp-for="Email" class="form-label-custom">
                    Địa chỉ Email <span class="text-danger">*</span>
                </label>
                <div class="custom-input-group">
                    <i class="bi bi-envelope-fill input-icon-start"></i>
                    <input asp-for="Email" type="email" class="form-control custom-input no-right-icon" placeholder="example@email.com" autocomplete="email" />
                </div>
                <span asp-validation-for="Email" class="text-danger small mt-1 d-block fw-medium"></span>
            </div>

            <!-- Hàng 3: Tên đăng nhập -->
            <div class="mb-2">
                <label asp-for="TenDangNhap" class="form-label-custom">
                    Tên đăng nhập <span class="text-danger">*</span>
                </label>
                <div class="custom-input-group">
                    <i class="bi bi-person-badge-fill input-icon-start"></i>
                    <input asp-for="TenDangNhap" class="form-control custom-input no-right-icon" placeholder="Tối thiểu 3 ký tự (VD: nguyenvana)" autocomplete="username" />
                </div>
                <span asp-validation-for="TenDangNhap" class="text-danger small mt-1 d-block fw-medium"></span>
            </div>

            <!-- Hàng 4: Mật khẩu + Xác nhận mật khẩu -->
            <div class="row g-2 mb-3">
                <div class="col-md-6">
                    <label asp-for="MatKhau" class="form-label-custom">
                        Mật khẩu <span class="text-danger">*</span>
                    </label>
                    <div class="custom-input-group">
                        <i class="bi bi-lock-fill input-icon-start"></i>
                        <input asp-for="MatKhau" type="password" id="txtPassword" class="form-control custom-input" placeholder="Tối thiểu 6 ký tự" autocomplete="new-password" oninput="checkPasswordStrength(this.value)" />
                        <button type="button" class="btn-toggle-eye" onclick="togglePasswordVisibility('txtPassword', 'iconPass1', this)" title="Hiện / Ẩn mật khẩu" aria-label="Hiện / Ẩn mật khẩu" aria-pressed="false" tabindex="-1">
                            <i class="bi bi-eye" id="iconPass1"></i>
                        </button>
                    </div>
                    <!-- Thanh đo độ mạnh mật khẩu (Gợi ý UX) -->
                    <div class="password-strength-bar mt-1.5">
                        <div id="pwdStrengthBar" class="password-strength-progress"></div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mt-1">
                        <small id="pwdStrengthText" class="text-muted uneti-fs-12">Độ mạnh: Chưa nhập</small>
                    </div>
                    <span asp-validation-for="MatKhau" class="text-danger small mt-1 d-block fw-medium"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="XacNhanMatKhau" class="form-label-custom">
                        Xác nhận lại <span class="text-danger">*</span>
                    </label>
                    <div class="custom-input-group">
                        <i class="bi bi-shield-lock-fill input-icon-start"></i>
                        <input asp-for="XacNhanMatKhau" type="password" id="txtConfirmPassword" class="form-control custom-input" placeholder="Nhập lại mật khẩu" autocomplete="new-password" />
                        <button type="button" class="btn-toggle-eye" onclick="togglePasswordVisibility('txtConfirmPassword', 'iconPass2', this)" title="Hiện / Ẩn mật khẩu" aria-label="Hiện / Ẩn mật khẩu" aria-pressed="false" tabindex="-1">
                            <i class="bi bi-eye" id="iconPass2"></i>
                        </button>
                    </div>
                    <span asp-validation-for="XacNhanMatKhau" class="text-danger small mt-1 d-block fw-medium"></span>
                </div>
            </div>

            <!-- Checkbox điều khoản -->
            <div class="form-check mb-3">
                <input asp-for="DongYDieuKhoan" class="form-check-input me-2 mt-0" type="checkbox" id="chkTerms" style="width: 17px; height: 17px; cursor: pointer; border-color: #cbd5e1;" />
                <label class="form-check-label text-muted small user-select-none" for="chkTerms" style="font-size: 13px; cursor: pointer;">
                    Tôi đồng ý với <a href="#" class="text-decoration-none fw-semibold" style="color: #2563eb;">Quy chế đào tạo</a> và điều khoản sử dụng
                </label>
                <span asp-validation-for="DongYDieuKhoan" class="text-danger small d-block fw-medium mt-1"></span>
            </div>

            <!-- Nút Tạo tài khoản -->
            <button type="submit" class="btn btn-submit-register mb-3">
                <i class="bi bi-person-check-fill"></i>
                <span>Tạo tài khoản học viên</span>
            </button>

            <!-- Lối tắt đăng nhập & về trang chủ -->
            <div class="text-center small text-muted mb-2">
                Đã có tài khoản? 
                <a asp-action="Login" class="text-decoration-none fw-bold" style="color: #2563eb;">
                    Đăng nhập ngay
                </a>
            </div>
            <div class="text-center">
                <a asp-controller="Home" asp-action="Index" class="text-secondary text-decoration-none small d-inline-flex align-items-center gap-1 hover-underline">
                    <i class="bi bi-arrow-left"></i> Quay lại Trang chủ
                </a>
            </div>
        </form>
    </div>

    <!-- Scripts -->
    <partial name="_Scripts" />
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script>
        // Đăng ký adapter jQuery Validate Unobtrusive cho rule [MustBeTrue]
        if (window.jQuery && window.jQuery.validator) {
            if (window.jQuery.validator.unobtrusive) {
                window.jQuery.validator.addMethod("mustbetrue", function (value, element, param) {
                    return element.checked;
                });
                window.jQuery.validator.unobtrusive.adapters.addBool("mustbetrue");
            }

            // Khắc phục triệt để lỗi so sánh Range của jQuery Validate với Checkbox
            if (window.jQuery.validator.methods.range) {
                var origRange = window.jQuery.validator.methods.range;
                window.jQuery.validator.methods.range = function (value, element, param) {
                    if (element.type === 'checkbox') {
                        return element.checked;
                    }
                    return origRange.call(this, value, element, param);
                };
            }
        }

        function checkPasswordStrength(val) {
            const bar = document.getElementById('pwdStrengthBar');
            const txt = document.getElementById('pwdStrengthText');
            if (!bar || !txt) return;

            if (!val || val.length === 0) {
                bar.style.width = '0%';
                bar.style.backgroundColor = '#e2e8f0';
                txt.textContent = 'Độ mạnh: Chưa nhập';
                txt.className = 'text-muted';
                return;
            }

            let score = 0;
            if (val.length >= 6) score++;
            if (val.length >= 8) score++;
            if (/[A-Z]/.test(val) && /[a-z]/.test(val)) score++;
            if (/[0-9]/.test(val)) score++;
            if (/[^A-Za-z0-9]/.test(val)) score++;

            if (score <= 1) {
                bar.style.width = '25%';
                bar.style.backgroundColor = '#ef4444';
                txt.textContent = 'Độ mạnh: Yếu (nên thêm số, ký tự đặc biệt)';
                txt.className = 'text-danger fw-semibold';
            } else if (score === 2) {
                bar.style.width = '50%';
                bar.style.backgroundColor = '#f59e0b';
                txt.textContent = 'Độ mạnh: Trung bình';
                txt.className = 'text-warning fw-semibold';
            } else if (score === 3 || score === 4) {
                bar.style.width = '75%';
                bar.style.backgroundColor = '#3b82f6';
                txt.textContent = 'Độ mạnh: Khá an toàn';
                txt.className = 'text-primary fw-semibold';
            } else {
                bar.style.width = '100%';
                bar.style.backgroundColor = '#10b981';
                txt.textContent = 'Độ mạnh: Rất mạnh (Tối ưu)';
                txt.className = 'text-success fw-semibold';
            }
        }

        function togglePasswordVisibility(inputId, iconId, btn) {
            const pass = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (pass.type === 'password') {
                pass.type = 'text';
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
                if (btn) btn.setAttribute('aria-pressed', 'true');
            } else {
                pass.type = 'password';
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
                if (btn) btn.setAttribute('aria-pressed', 'false');
            }
        }

        // Cấu hình jQuery Validation mượt mà
        $(function () {
            @if (!ViewData.ModelState.IsValid)
            {
                <text>
                const card = document.querySelector('.register-card');
                if (card) {
                    card.classList.add('fx-shake');
                    setTimeout(() => card.classList.remove('fx-shake'), 450);
                }
                if (window.UnetiUI && typeof window.UnetiUI.toast === 'function') {
                    window.UnetiUI.toast({
                        type: 'danger',
                        title: 'Đăng ký không thành công',
                        message: 'Vui lòng kiểm tra lại các thông tin bắt buộc trong form.'
                    });
                }
                </text>
            }

            if ($.validator) {
                $.validator.setDefaults({
                    onkeyup: false,
                    onfocusout: function (element) {
                        if ($(element).is(':checkbox') || $(element).is(':radio')) {
                            return;
                        }
                        $(element).valid();
                    }
                });
            }

            // Tự động xóa trạng thái lỗi nhẹ nhàng 1 lần duy nhất
            $('form').on('input', 'input', function () {
                var $input = $(this);
                if ($input.hasClass('input-validation-error')) {
                    $input.removeClass('input-validation-error');
                    var fieldName = $input.attr('name');
                    if (fieldName) {
                        var $err = $('span[data-valmsg-for="' + fieldName + '"]');
                        $err.removeClass('field-validation-error').addClass('field-validation-valid').text('');
                    }
                }
            });

            // Tự ẩn lỗi khi đã tích đồng ý
            $('#chkTerms').on('change', function () {
                var $chk = $(this);
                if ($chk.is(':checked')) {
                    $chk.removeClass('input-validation-error');
                    $('span[data-valmsg-for="DongYDieuKhoan"]').removeClass('field-validation-error').addClass('field-validation-valid').text('');
                }
                $chk.valid();
            });
        });
    </script>
</body>
</html>
