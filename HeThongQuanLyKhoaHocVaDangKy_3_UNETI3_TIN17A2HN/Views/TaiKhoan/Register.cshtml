@*
    Họ và tên: Trần Văn Thành
    Mã sinh viên: 23103100076
    Nội dung thực hiện: Module 1 - Giao diện Đăng ký Tài khoản Học viên (Đồng bộ nhận diện UNETI)
*@

@model HeThongQuanLyKhoaHocVaDangKy_3_UNETI3_TIN17A2HN.ViewModels.RegisterViewModel
@{
    Layout = null;
    ViewData["Title"] = "Đăng ký tài khoản học viên";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UNETI Đào Tạo</title>
    
    <!-- Google Font: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap CSS & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Site CSS (Unified Design System) -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        body {
            min-height: 100vh;
            background-color: #dbeafe;
            background-image: url('/images/auth-bg.jpg');
            background-repeat: no-repeat;
            background-position: center center;
            background-size: cover;
            background-attachment: fixed;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 2rem 1.5rem;
            margin: 0;
            position: relative;
        }

        .register-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.9);
            border-radius: 20px;
            box-shadow: 0 20px 40px -10px rgba(15, 23, 42, 0.18), 0 8px 16px -4px rgba(0, 0, 0, 0.06);
            width: 100%;
            max-width: 520px;
            position: relative;
            z-index: 10;
        }
        .uneti-logo-badge {
            width: 52px;
            height: 52px;
            background: var(--uneti-primary);
            color: #ffffff;
            border-radius: 14px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 26px;
            box-shadow: 0 4px 14px rgba(29, 78, 216, 0.3);
        }
    </style>
</head>
<body>
    <div class="register-card p-4 p-md-5">
        <!-- Logo & Header -->
        <div class="text-center mb-4">
            <div class="uneti-logo-badge mb-3">
                <i class="bi bi-mortarboard-fill"></i>
            </div>
            <h4 class="fw-bold text-dark mb-1">ĐĂNG KÝ TÀI KHOẢN</h4>
            <p class="text-muted small mb-0">Tạo tài khoản học viên để tham gia các khóa học tại UNETI</p>
        </div>

        <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 px-3 rounded-3 mb-3" role="alert"></div>

        <!-- Form Đăng ký -->
        <form asp-action="Register" method="post">
            @Html.AntiForgeryToken()

            <div class="row g-2 mb-2">
                <div class="col-md-6">
                    <label asp-for="HoTen" class="form-label fw-semibold small text-secondary">
                        Họ và tên <span class="text-danger">*</span>
                    </label>
                    <input asp-for="HoTen" class="form-control" placeholder="Nguyễn Văn A" autofocus />
                    <span asp-validation-for="HoTen" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="SoDienThoai" class="form-label fw-semibold small text-secondary">
                        Số điện thoại
                    </label>
                    <input asp-for="SoDienThoai" class="form-control" placeholder="0912345678" />
                    <span asp-validation-for="SoDienThoai" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-2">
                <label asp-for="Email" class="form-label fw-semibold small text-secondary">
                    Địa chỉ Email <span class="text-danger">*</span>
                </label>
                <input asp-for="Email" type="email" class="form-control" placeholder="example@uneti.edu.vn" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-2">
                <label asp-for="TenDangNhap" class="form-label fw-semibold small text-secondary">
                    Tên đăng nhập <span class="text-danger">*</span>
                </label>
                <input asp-for="TenDangNhap" class="form-control" placeholder="Tối thiểu 4 ký tự..." />
                <span asp-validation-for="TenDangNhap" class="text-danger small"></span>
            </div>

            <div class="row g-2 mb-3">
                <div class="col-md-6">
                    <label asp-for="MatKhau" class="form-label fw-semibold small text-secondary">
                        Mật khẩu <span class="text-danger">*</span>
                    </label>
                    <input asp-for="MatKhau" type="password" class="form-control" placeholder="Tối thiểu 6 ký tự" />
                    <span asp-validation-for="MatKhau" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="XacNhanMatKhau" class="form-label fw-semibold small text-secondary">
                        Xác nhận lại <span class="text-danger">*</span>
                    </label>
                    <input asp-for="XacNhanMatKhau" type="password" class="form-control" placeholder="Nhập lại mật khẩu" />
                    <span asp-validation-for="XacNhanMatKhau" class="text-danger small"></span>
                </div>
            </div>

            <div class="form-check mb-3">
                <input asp-for="DongYDieuKhoan" class="form-check-input" type="checkbox" id="chkTerms" />
                <label class="form-check-label small text-muted" for="chkTerms">
                    Tôi đồng ý với <a href="#" class="text-decoration-none" style="color: var(--uneti-primary);">Quy chế đào tạo</a> và điều khoản UNETI
                </label>
                <span asp-validation-for="DongYDieuKhoan" class="text-danger small d-block"></span>
            </div>

            <button type="submit" class="btn uneti-btn-primary w-100 py-2 fw-bold mb-3 shadow-sm">
                <i class="bi bi-person-check me-1"></i>Tạo tài khoản học viên
            </button>

            <div class="text-center small text-muted">
                Đã có tài khoản? 
                <a asp-action="Login" class="text-decoration-none fw-bold" style="color: var(--uneti-primary);">
                    Đăng nhập ngay
                </a>
                <div class="mt-2">
                    <a asp-controller="Home" asp-action="Index" class="text-secondary text-decoration-none small">
                        <i class="bi bi-arrow-left me-1"></i>Quay lại Trang chủ
                    </a>
                </div>
            </div>
        </form>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
