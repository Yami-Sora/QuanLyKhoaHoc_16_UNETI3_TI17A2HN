@*
    Họ và tên: Trần Văn Thành
    Mã sinh viên: 23103100076
    Nội dung thực hiện: Module 1 - Giao diện Đăng ký tài khoản học viên mới
*@

@model HeThongQuanLyKhoaHocVaDangKy_3_UNETI3_TIN17A2HN.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký tài khoản học viên";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                <div class="card-header bg-success text-white text-center py-4">
                    <h4 class="fw-bold mb-1"><i class="bi bi-person-plus-fill me-2"></i>ĐĂNG KÝ HỌC VIÊN MỚI</h4>
                    <p class="small text-white-50 mb-0">Tạo tài khoản để đăng ký tham gia các khóa học chất lượng</p>
                </div>

                <div class="card-body p-4 p-md-5">
                    <form asp-action="Register" method="post" novalidate>
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="TenDangNhap" class="form-label fw-semibold">Tên đăng nhập <span class="text-danger">*</span></label>
                                <input asp-for="TenDangNhap" class="form-control" placeholder="Từ 3 đến 50 ký tự..." autofocus />
                                <span asp-validation-for="TenDangNhap" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="HoTen" class="form-label fw-semibold">Họ và tên học viên <span class="text-danger">*</span></label>
                                <input asp-for="HoTen" class="form-control" placeholder="Ví dụ: Nguyễn Văn A..." />
                                <span asp-validation-for="HoTen" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Email" class="form-label fw-semibold">Địa chỉ Email <span class="text-danger">*</span></label>
                                <input asp-for="Email" type="email" class="form-control" placeholder="name@example.com..." />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="SoDienThoai" class="form-label fw-semibold">Số điện thoại liên hệ <span class="text-danger">*</span></label>
                                <input asp-for="SoDienThoai" class="form-control" placeholder="0987xxxxxx..." />
                                <span asp-validation-for="SoDienThoai" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="MatKhau" class="form-label fw-semibold">Mật khẩu <span class="text-danger">*</span></label>
                                <input asp-for="MatKhau" type="password" class="form-control" placeholder="Tối thiểu 6 ký tự..." />
                                <span asp-validation-for="MatKhau" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label asp-for="XacNhanMatKhau" class="form-label fw-semibold">Xác nhận mật khẩu <span class="text-danger">*</span></label>
                                <input asp-for="XacNhanMatKhau" type="password" class="form-control" placeholder="Nhập lại mật khẩu..." />
                                <span asp-validation-for="XacNhanMatKhau" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-success btn-lg fw-bold shadow-sm">
                                <i class="bi bi-check-circle me-2"></i>Hoàn tất đăng ký
                            </button>
                        </div>

                        <div class="text-center mt-3">
                            <span class="text-muted">Đã có tài khoản?</span>
                            <a asp-action="Login" class="text-primary text-decoration-none fw-semibold ms-1">Đăng nhập ngay</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
