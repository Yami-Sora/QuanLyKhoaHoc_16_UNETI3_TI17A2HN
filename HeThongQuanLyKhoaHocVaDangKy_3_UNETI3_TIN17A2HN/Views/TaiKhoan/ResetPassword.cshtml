@*
    Họ và tên: Trần Văn Thành
    Mã sinh viên: 23103100076
    Nội dung thực hiện: Module 1 - Giao diện Đặt lại mật khẩu mới (Đồng bộ nhận diện UNETI)
*@

@model HeThongQuanLyKhoaHocVaDangKy_3_UNETI3_TIN17A2HN.ViewModels.ResetPasswordViewModel
@{
    Layout = null;
    ViewData["Title"] = "Đặt lại mật khẩu mới";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cổng Đào Tạo Trực Tuyến</title>
    
    <!-- Google Font: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap CSS & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: #f1f5f9;
            background-image: 
                linear-gradient(135deg, rgba(239, 246, 255, 0.45) 0%, rgba(219, 234, 254, 0.55) 100%),
                url('/images/auth-bg.jpg');
            background-repeat: no-repeat;
            background-position: center center;
            background-size: cover;
            background-attachment: fixed;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 2.5rem 1rem;
            margin: 0;
            position: relative;
        }

        /* Glassmorphism Card */
        .reset-card {
            background: rgba(255, 255, 255, 0.94);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.85);
            border-radius: 24px;
            box-shadow: 
                0 20px 40px -15px rgba(15, 23, 42, 0.16),
                0 0 0 1px rgba(255, 255, 255, 0.8) inset;
            width: 100%;
            max-width: 440px;
            padding: 2.5rem 2.25rem;
            position: relative;
            z-index: 10;
            transition: transform 0.25s ease, box-shadow 0.25s ease;
        }

        /* Logo Badge với gradient mềm mại */
        .uneti-logo-badge {
            width: 58px;
            height: 58px;
            background: linear-gradient(135deg, #1d4ed8 0%, #3b82f6 100%);
            color: #ffffff;
            border-radius: 18px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            box-shadow: 0 10px 22px -6px rgba(29, 78, 216, 0.38);
            border: 3px solid #ffffff;
            margin: 0 auto;
        }

        .header-title {
            color: #0f172a;
            font-size: 1.45rem;
            font-weight: 800;
            letter-spacing: -0.02em;
            margin-top: 0.75rem;
            margin-bottom: 0.25rem;
        }

        .header-subtitle {
            color: #64748b;
            font-size: 13.5px;
            font-weight: 500;
            line-height: 1.45;
        }

        .form-label-custom {
            color: #334155;
            font-size: 13.5px;
            font-weight: 600;
            display: block;
            margin-bottom: 0.45rem;
        }

        .custom-input-group {
            position: relative;
            display: flex;
            align-items: center;
            width: 100%;
        }

        .custom-input-group .input-icon-start {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 1.15rem;
            pointer-events: none;
            z-index: 5;
            transition: color 0.2s ease;
        }

        .custom-input-group:focus-within .input-icon-start {
            color: #2563eb;
        }

        .custom-input-group .form-control.custom-input {
            width: 100%;
            height: 48px;
            padding-left: 46px;
            padding-right: 46px;
            border-radius: 12px;
            border: 1.5px solid #e2e8f0;
            background-color: #f8fafc;
            font-size: 14.5px;
            font-family: inherit;
            color: #1e293b;
            transition: all 0.2s ease-in-out;
        }

        .custom-input-group .form-control.custom-input::placeholder {
            color: #94a3b8;
            font-size: 14px;
            font-weight: 400;
        }

        .custom-input-group .form-control.custom-input:focus {
            background-color: #ffffff;
            border-color: #3b82f6;
            box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.12);
            color: #0f172a;
            outline: none;
        }

        .btn-toggle-eye {
            position: absolute;
            right: 10px;
            top: 50%;
            transform: translateY(-50%);
            background: transparent;
            border: none;
            padding: 6px 8px;
            color: #94a3b8;
            font-size: 1.15rem;
            cursor: pointer;
            z-index: 6;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            transition: all 0.2s ease;
        }

        .btn-toggle-eye:hover {
            color: #334155;
            background-color: #e2e8f0;
        }

        .btn-submit-action {
            background: linear-gradient(135deg, #1d4ed8 0%, #2563eb 100%);
            color: #ffffff;
            border: none;
            border-radius: 12px;
            height: 48px;
            font-size: 15px;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            box-shadow: 0 8px 18px -4px rgba(29, 78, 216, 0.35);
            transition: all 0.2s ease;
            width: 100%;
            cursor: pointer;
        }

        .btn-submit-action:hover {
            background: linear-gradient(135deg, #1e40af 0%, #1d4ed8 100%);
            box-shadow: 0 10px 22px -4px rgba(29, 78, 216, 0.45);
            transform: translateY(-1px);
            color: #ffffff;
        }
    </style>
</head>
<body>
    <div class="reset-card">
        <!-- Logo & Header -->
        <div class="text-center mb-4">
            <div class="uneti-logo-badge">
                <i class="bi bi-shield-lock-fill"></i>
            </div>
            <h1 class="header-title">ĐẶT LẠI MẬT KHẨU</h1>
            <p class="header-subtitle mb-0">Tài khoản: <strong class="text-dark">@Model.Email</strong></p>
        </div>

        <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 px-3 rounded-3 mb-3 border-0 shadow-sm" role="alert" style="background-color: #fef2f2; color: #b91c1c;"></div>

        <!-- Form Đặt lại mật khẩu -->
        <form asp-action="ResetPassword" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="Token" />

            <div class="mb-3 text-start">
                <label asp-for="MatKhauMoi" class="form-label-custom">
                    Mật khẩu mới <span class="text-danger">*</span>
                </label>
                <div class="custom-input-group">
                    <i class="bi bi-lock-fill input-icon-start"></i>
                    <input asp-for="MatKhauMoi" type="password" id="txtNewPass" class="form-control custom-input" placeholder="Tối thiểu 6 ký tự..." autofocus autocomplete="new-password" />
                    <button type="button" class="btn-toggle-eye" onclick="togglePasswordVisibility('txtNewPass', 'iconPass1')" title="Hiện / Ẩn mật khẩu" tabindex="-1">
                        <i class="bi bi-eye" id="iconPass1"></i>
                    </button>
                </div>
                <span asp-validation-for="MatKhauMoi" class="text-danger small mt-1 d-block fw-medium"></span>
            </div>

            <div class="mb-4 text-start">
                <label asp-for="XacNhanMatKhau" class="form-label-custom">
                    Xác nhận mật khẩu mới <span class="text-danger">*</span>
                </label>
                <div class="custom-input-group">
                    <i class="bi bi-shield-check input-icon-start"></i>
                    <input asp-for="XacNhanMatKhau" type="password" id="txtConfirmPass" class="form-control custom-input" placeholder="Nhập lại mật khẩu mới..." autocomplete="new-password" />
                    <button type="button" class="btn-toggle-eye" onclick="togglePasswordVisibility('txtConfirmPass', 'iconPass2')" title="Hiện / Ẩn mật khẩu" tabindex="-1">
                        <i class="bi bi-eye" id="iconPass2"></i>
                    </button>
                </div>
                <span asp-validation-for="XacNhanMatKhau" class="text-danger small mt-1 d-block fw-medium"></span>
            </div>

            <button type="submit" class="btn btn-submit-action mb-3">
                <i class="bi bi-check2-circle"></i>
                <span>Lưu mật khẩu mới</span>
            </button>

            <!-- Lối tắt quay lại -->
            <div class="text-center small text-muted">
                <a asp-action="Login" class="text-decoration-none fw-bold" style="color: #2563eb;">
                    <i class="bi bi-arrow-left me-1"></i>Quay lại Đăng nhập
                </a>
            </div>
        </form>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        function togglePasswordVisibility(inputId, iconId) {
            const pass = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (pass.type === 'password') {
                pass.type = 'text';
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
            } else {
                pass.type = 'password';
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            const form = document.querySelector('form');
            if (form) {
                form.addEventListener('submit', function (e) {
                    const pass = document.getElementById('txtNewPass');
                    const confirmPass = document.getElementById('txtConfirmPass');
                    let hasError = false;

                    if (pass && !pass.value) {
                        pass.classList.add('input-validation-error');
                        const err = form.querySelector('span[data-valmsg-for="MatKhauMoi"]');
                        if (err) {
                            err.textContent = 'Mật khẩu mới không được để trống';
                            err.style.display = 'block';
                            err.classList.remove('field-validation-valid');
                            err.classList.add('field-validation-error');
                        }
                        hasError = true;
                    } else if (pass && pass.value.length < 6) {
                        pass.classList.add('input-validation-error');
                        const err = form.querySelector('span[data-valmsg-for="MatKhauMoi"]');
                        if (err) {
                            err.textContent = 'Mật khẩu phải chứa ít nhất 6 ký tự';
                            err.style.display = 'block';
                            err.classList.remove('field-validation-valid');
                            err.classList.add('field-validation-error');
                        }
                        hasError = true;
                    }

                    if (confirmPass && !confirmPass.value) {
                        confirmPass.classList.add('input-validation-error');
                        const err = form.querySelector('span[data-valmsg-for="XacNhanMatKhau"]');
                        if (err) {
                            err.textContent = 'Vui lòng xác nhận mật khẩu mới';
                            err.style.display = 'block';
                            err.classList.remove('field-validation-valid');
                            err.classList.add('field-validation-error');
                        }
                        hasError = true;
                    } else if (pass && confirmPass && pass.value !== confirmPass.value) {
                        confirmPass.classList.add('input-validation-error');
                        const err = form.querySelector('span[data-valmsg-for="XacNhanMatKhau"]');
                        if (err) {
                            err.textContent = 'Mật khẩu xác nhận không trùng khớp';
                            err.style.display = 'block';
                            err.classList.remove('field-validation-valid');
                            err.classList.add('field-validation-error');
                        }
                        hasError = true;
                    }

                    if (hasError) {
                        e.preventDefault();
                        if (pass && (!pass.value || pass.value.length < 6)) {
                            pass.focus();
                        } else if (confirmPass) {
                            confirmPass.focus();
                        }
                    }
                });
            }
        });
    </script>
</body>
</html>
