@*
    Họ và tên: Trần Văn Thành
    Mã sinh viên: 23103100076
    Nội dung: Đặt lại mật khẩu
*@

@model HeThongQuanLyKhoaHocVaDangKy_3_UNETI3_TIN17A2HN.ViewModels.ResetPasswordViewModel
@{
    Layout = null;
    ViewData["Title"] = "Đặt lại mật khẩu mới";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <partial name="_Head" />
</head>
<body>
    <div class="reset-card">
        <!-- Logo & Header -->
        <div class="text-center mb-4">
            <div class="uneti-logo-badge">
                <i class="bi bi-shield-lock-fill"></i>
            </div>
            <h1 class="header-title">ĐẶT LẠI MẬT KHẨU</h1>
            <p class="header-subtitle mb-0">Tài khoản: <strong class="text-dark">@Model.Email</strong></p>
        </div>

        <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 px-3 rounded-3 mb-3 border-0 shadow-sm" role="alert" style="background-color: #fef2f2; color: #b91c1c;"></div>

        <!-- Form Đặt lại mật khẩu -->
        <form asp-action="ResetPassword" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="Token" />

            <div class="mb-3 text-start">
                <label asp-for="MatKhauMoi" class="form-label-custom">
                    Mật khẩu mới <span class="text-danger">*</span>
                </label>
                <div class="custom-input-group">
                    <i class="bi bi-lock-fill input-icon-start"></i>
                    <input asp-for="MatKhauMoi" type="password" id="txtNewPass" class="form-control custom-input" placeholder="Tối thiểu 6 ký tự..." autofocus autocomplete="new-password" oninput="checkPasswordStrength(this.value)" />
                    <button type="button" class="btn-toggle-eye" onclick="togglePasswordVisibility('txtNewPass', 'iconPass1', this)" title="Hiện / Ẩn mật khẩu" aria-label="Hiện / Ẩn mật khẩu" aria-pressed="false" tabindex="-1">
                        <i class="bi bi-eye" id="iconPass1"></i>
                    </button>
                </div>
                <!-- Thanh đo độ mạnh mật khẩu (Gợi ý UX) -->
                <div class="password-strength-bar mt-1.5">
                    <div id="pwdStrengthBar" class="password-strength-progress"></div>
                </div>
                <div class="d-flex justify-content-between align-items-center mt-1">
                    <small id="pwdStrengthText" class="text-muted uneti-fs-12">Độ mạnh: Chưa nhập</small>
                </div>
                <span asp-validation-for="MatKhauMoi" class="text-danger small mt-1 d-block fw-medium"></span>
            </div>

            <div class="mb-4 text-start">
                <label asp-for="XacNhanMatKhau" class="form-label-custom">
                    Xác nhận mật khẩu mới <span class="text-danger">*</span>
                </label>
                <div class="custom-input-group">
                    <i class="bi bi-shield-check input-icon-start"></i>
                    <input asp-for="XacNhanMatKhau" type="password" id="txtConfirmPass" class="form-control custom-input" placeholder="Nhập lại mật khẩu mới..." autocomplete="new-password" />
                    <button type="button" class="btn-toggle-eye" onclick="togglePasswordVisibility('txtConfirmPass', 'iconPass2', this)" title="Hiện / Ẩn mật khẩu" aria-label="Hiện / Ẩn mật khẩu" aria-pressed="false" tabindex="-1">
                        <i class="bi bi-eye" id="iconPass2"></i>
                    </button>
                </div>
                <span asp-validation-for="XacNhanMatKhau" class="text-danger small mt-1 d-block fw-medium"></span>
            </div>

            <button type="submit" class="btn btn-submit-action mb-3">
                <i class="bi bi-check2-circle"></i>
                <span>Lưu mật khẩu mới</span>
            </button>

            <!-- Lối tắt quay lại -->
            <div class="text-center small text-muted">
                <a asp-action="Login" class="text-decoration-none fw-bold" style="color: #2563eb;">
                    <i class="bi bi-arrow-left me-1"></i>Quay lại Đăng nhập
                </a>
            </div>
        </form>
    </div>

    <!-- Scripts -->
    <partial name="_Scripts" />
    <script>
        function checkPasswordStrength(val) {
            const bar = document.getElementById('pwdStrengthBar');
            const txt = document.getElementById('pwdStrengthText');
            if (!bar || !txt) return;

            if (!val || val.length === 0) {
                bar.style.width = '0%';
                bar.style.backgroundColor = '#e2e8f0';
                txt.textContent = 'Độ mạnh: Chưa nhập';
                txt.className = 'text-muted';
                return;
            }

            let score = 0;
            if (val.length >= 6) score++;
            if (val.length >= 8) score++;
            if (/[A-Z]/.test(val) && /[a-z]/.test(val)) score++;
            if (/[0-9]/.test(val)) score++;
            if (/[^A-Za-z0-9]/.test(val)) score++;

            if (score <= 1) {
                bar.style.width = '25%';
                bar.style.backgroundColor = '#ef4444';
                txt.textContent = 'Độ mạnh: Yếu';
                txt.className = 'text-danger fw-semibold';
            } else if (score === 2) {
                bar.style.width = '50%';
                bar.style.backgroundColor = '#f59e0b';
                txt.textContent = 'Độ mạnh: Trung bình';
                txt.className = 'text-warning fw-semibold';
            } else if (score === 3 || score === 4) {
                bar.style.width = '75%';
                bar.style.backgroundColor = '#3b82f6';
                txt.textContent = 'Độ mạnh: Khá an toàn';
                txt.className = 'text-primary fw-semibold';
            } else {
                bar.style.width = '100%';
                bar.style.backgroundColor = '#10b981';
                txt.textContent = 'Độ mạnh: Rất mạnh (Tối ưu)';
                txt.className = 'text-success fw-semibold';
            }
        }

        function togglePasswordVisibility(inputId, iconId, btn) {
            const pass = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (pass.type === 'password') {
                pass.type = 'text';
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
                if (btn) btn.setAttribute('aria-pressed', 'true');
            } else {
                pass.type = 'password';
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
                if (btn) btn.setAttribute('aria-pressed', 'false');
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            const form = document.querySelector('form');
            if (form) {
                form.addEventListener('submit', function (e) {
                    const pass = document.getElementById('txtNewPass');
                    const confirmPass = document.getElementById('txtConfirmPass');
                    let hasError = false;

                    if (pass && !pass.value) {
                        pass.classList.add('input-validation-error');
                        const err = form.querySelector('span[data-valmsg-for="MatKhauMoi"]');
                        if (err) {
                            err.textContent = 'Mật khẩu mới không được để trống';
                            err.style.display = 'block';
                            err.classList.remove('field-validation-valid');
                            err.classList.add('field-validation-error');
                        }
                        hasError = true;
                    } else if (pass && pass.value.length < 6) {
                        pass.classList.add('input-validation-error');
                        const err = form.querySelector('span[data-valmsg-for="MatKhauMoi"]');
                        if (err) {
                            err.textContent = 'Mật khẩu phải chứa ít nhất 6 ký tự';
                            err.style.display = 'block';
                            err.classList.remove('field-validation-valid');
                            err.classList.add('field-validation-error');
                        }
                        hasError = true;
                    }

                    if (confirmPass && !confirmPass.value) {
                        confirmPass.classList.add('input-validation-error');
                        const err = form.querySelector('span[data-valmsg-for="XacNhanMatKhau"]');
                        if (err) {
                            err.textContent = 'Vui lòng xác nhận mật khẩu mới';
                            err.style.display = 'block';
                            err.classList.remove('field-validation-valid');
                            err.classList.add('field-validation-error');
                        }
                        hasError = true;
                    } else if (pass && confirmPass && pass.value !== confirmPass.value) {
                        confirmPass.classList.add('input-validation-error');
                        const err = form.querySelector('span[data-valmsg-for="XacNhanMatKhau"]');
                        if (err) {
                            err.textContent = 'Mật khẩu xác nhận không trùng khớp';
                            err.style.display = 'block';
                            err.classList.remove('field-validation-valid');
                            err.classList.add('field-validation-error');
                        }
                        hasError = true;
                    }

                    if (hasError) {
                        e.preventDefault();
                        const card = document.querySelector('.reset-card');
                        if (card) {
                            card.classList.add('fx-shake');
                            setTimeout(() => card.classList.remove('fx-shake'), 450);
                        }
                        if (window.UnetiUI && typeof window.UnetiUI.toast === 'function') {
                            window.UnetiUI.toast({
                                type: 'danger',
                                title: 'Thông tin chưa hợp lệ',
                                message: 'Vui lòng kiểm tra lại mật khẩu mới và xác nhận mật khẩu.'
                            });
                        }
                        if (pass && (!pass.value || pass.value.length < 6)) {
                            pass.focus();
                        } else if (confirmPass) {
                            confirmPass.focus();
                        }
                    }
                });
            }
        });
    </script>
</body>
</html>
