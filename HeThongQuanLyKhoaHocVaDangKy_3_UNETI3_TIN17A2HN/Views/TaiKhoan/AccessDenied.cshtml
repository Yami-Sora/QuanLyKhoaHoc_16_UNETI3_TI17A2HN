@{
    ViewData["Title"] = "Từ chối truy cập";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-lg border-0 rounded-4 p-5">
                <div class="mb-4">
                    <span class="badge rounded-pill bg-danger-subtle text-danger p-3 mb-3">
                        <i class="bi bi-shield-lock-fill" style="font-size: 3.5rem;"></i>
                    </span>
                    <h2 class="fw-bold text-danger mt-2">403 - KHÔNG CÓ QUYỀN TRUY CẬP</h2>
                </div>

                <p class="text-muted fs-6 mb-4">
                    Rất tiếc! Tài khoản của bạn không được phân quyền để thực hiện hoặc xem chức năng này.
                    Vui lòng liên hệ Quản trị viên hệ thống nếu bạn nghĩ đây là một sự nhầm lẫn.
                </p>

                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary px-4 py-2">
                        <i class="bi bi-house-door-fill me-1"></i>Về trang chủ
                    </a>
                    <a asp-controller="TaiKhoan" asp-action="Logout" class="btn btn-danger px-4 py-2">
                        <i class="bi bi-box-arrow-right me-1"></i>Đổi tài khoản khác
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
