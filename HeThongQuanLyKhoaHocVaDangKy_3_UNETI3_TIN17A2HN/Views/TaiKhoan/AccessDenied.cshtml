@*
    Họ và tên: Trần Văn Thành
    Mã sinh viên: 23103100076
    Nội dung: Trang báo lỗi 403
*@

@{
    ViewData["Title"] = "Không có quyền truy cập (403)";
    var vaiTro = ViewBag.UserRole as string ?? Context.Session.GetString("VaiTro");
    
    // Điều hướng thông minh theo vai trò
    string homeUrl = Url.Action("Index", "Home") ?? "/";
    if (vaiTro == "Admin")
    {
        homeUrl = Url.Action("Index", "MonHoc") ?? "/MonHoc";
    }
    else if (vaiTro == "NhanVien")
    {
        homeUrl = Url.Action("Index", "MonHoc") ?? "/MonHoc";
    }
}

<style>
    .error-page-container {
        min-height: calc(100vh - 160px);
        background: radial-gradient(circle at 10% 20%, rgba(240, 247, 255, 0.85) 0%, rgba(255, 255, 255, 0.95) 90%),
                    url('/images/access-denied-bg.webp') no-repeat center center;
        background-size: cover;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 15px;
        position: relative;
        overflow: hidden;
    }

    .error-card-content {
        background: rgba(255, 255, 255, 0.92);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.8);
        border-radius: 32px;
        padding: 50px 40px;
        max-width: 600px;
        width: 100%;
        box-shadow: 0 25px 60px rgba(37, 99, 235, 0.12), 0 10px 25px rgba(0, 0, 0, 0.04);
        text-align: center;
        position: relative;
        z-index: 2;
        transition: transform 0.3s ease;
    }

    .error-card-content:hover {
        transform: translateY(-3px);
    }

    /* Khối đồ họa trọng tâm: Khóa + 403 */
    .hero-graphic-row {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 20px;
        margin-bottom: 22px;
    }

    .lock-illustration-wrapper {
        position: relative;
        width: 105px;
        height: 105px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .lock-svg {
        width: 100%;
        height: 100%;
        filter: drop-shadow(0 10px 20px rgba(37, 99, 235, 0.28));
        animation: subtleFloat 3.5s ease-in-out infinite;
    }

    @@keyframes subtleFloat {
        0%, 100% {
            transform: translateY(0px);
        }
        50% {
            transform: translateY(-6px);
        }
    }

    .error-code-label {
        font-size: 5.5rem;
        font-weight: 850;
        line-height: 1;
        color: #2563eb;
        letter-spacing: -3px;
        text-shadow: 0 4px 15px rgba(37, 99, 235, 0.18);
        user-select: none;
    }

    /* Tiêu đề & Nội dung mô tả */
    .error-main-heading {
        font-size: 1.85rem;
        font-weight: 750;
        color: #1e3a8a;
        margin-bottom: 14px;
        letter-spacing: -0.5px;
    }

    .error-sub-text {
        font-size: 1rem;
        color: #64748b;
        line-height: 1.65;
        margin-bottom: 32px;
        padding: 0 10px;
    }

    /* Nút bấm hành động (CTA) */
    .action-buttons-group {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 14px;
        flex-wrap: wrap;
    }

    .btn-action-primary {
        background-color: #2563eb;
        color: #ffffff !important;
        font-size: 1.05rem;
        font-weight: 600;
        padding: 13px 36px;
        border-radius: 50px;
        border: none;
        box-shadow: 0 6px 20px rgba(37, 99, 235, 0.38);
        transition: all 0.25s ease-in-out;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
    }

    .btn-action-primary:hover {
        background-color: #1d4ed8;
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(37, 99, 235, 0.48);
    }

    .btn-action-secondary {
        background-color: transparent;
        color: #475569 !important;
        font-size: 0.98rem;
        font-weight: 550;
        padding: 12px 28px;
        border-radius: 50px;
        border: 1.5px solid #cbd5e1;
        transition: all 0.25s ease-in-out;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
    }

    .btn-action-secondary:hover {
        background-color: #f1f5f9;
        border-color: #94a3b8;
        color: #1e293b !important;
        transform: translateY(-2px);
    }

    /* Họa tiết trang trí chấm bi Dot-Grid */
    .dot-pattern {
        position: absolute;
        width: 90px;
        height: 90px;
        background-image: radial-gradient(#93c5fd 2.2px, transparent 2.2px);
        background-size: 15px 15px;
        opacity: 0.65;
        pointer-events: none;
    }
    .dot-pattern-top-right { top: 30px; right: 30px; }
    .dot-pattern-bottom-right { bottom: 30px; right: 40px; }

    @@media (max-width: 576px) {
        .error-card-content {
            padding: 35px 20px;
            border-radius: 24px;
        }
        .error-code-label {
            font-size: 4rem;
        }
        .lock-illustration-wrapper {
            width: 80px;
            height: 80px;
        }
        .error-main-heading {
            font-size: 1.5rem;
        }
        .btn-action-primary, .btn-action-secondary {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<div class="error-page-container">
    <!-- Họa tiết ma trận chấm bi công nghệ góc phải -->
    <div class="dot-pattern dot-pattern-top-right d-none d-md-block"></div>
    <div class="dot-pattern dot-pattern-bottom-right d-none d-md-block"></div>

    <div class="error-card-content">
        <!-- Khối Đồ họa Ổ khóa 3D + Số 403 -->
        <div class="hero-graphic-row">
            <div class="lock-illustration-wrapper">
                <svg class="lock-svg" viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <!-- Hiệu ứng tia sáng / giọt nước xung quanh ổ khóa -->
                    <circle cx="20" cy="40" r="3.5" fill="#93C5FD" opacity="0.8" />
                    <circle cx="102" cy="35" r="4" fill="#93C5FD" opacity="0.8" />
                    <path d="M12 55C14 53 19 55 18 58C17 61 12 58 12 55Z" fill="#60A5FA" opacity="0.7"/>
                    <path d="M106 58C104 55 108 51 110 54C112 57 108 60 106 58Z" fill="#60A5FA" opacity="0.7"/>

                    <!-- Thân còng khóa (Shackle) -->
                    <path d="M40 50V35C40 23.9543 48.9543 15 60 15C71.0457 15 80 23.9543 80 35V50" stroke="#2563EB" stroke-width="12" stroke-linecap="round"/>
                    <path d="M40 50V35C40 23.9543 48.9543 15 60 15C71.0457 15 80 23.9543 80 35V50" stroke="#3B82F6" stroke-width="6" stroke-linecap="round" opacity="0.7"/>

                    <!-- Thân ổ khóa chính (Body) -->
                    <rect x="25" y="46" width="70" height="56" rx="18" fill="#3B82F6"/>
                    <rect x="29" y="50" width="62" height="48" rx="14" fill="#60A5FA"/>

                    <!-- Lỗ khóa trung tâm (Keyhole) -->
                    <circle cx="60" cy="69" r="6" fill="#1E3A8A"/>
                    <path d="M57 73L55 83H65L63 73H57Z" fill="#1E3A8A"/>

                    <!-- Biểu tượng cấm truy cập -->
                    <circle cx="86" cy="86" r="19" fill="#FB7185" stroke="#FFFFFF" stroke-width="5"/>
                    <rect x="74" y="83.5" width="24" height="5" rx="2.5" fill="#FFFFFF"/>
                </svg>
            </div>
            <div class="error-code-label">403</div>
        </div>

        <!-- Tiêu đề chính -->
        <h1 class="error-main-heading">Bạn không có quyền truy cập!</h1>

        <!-- Đoạn văn giải thích lịch sự & thân thiện -->
        <p class="error-sub-text">
            Rất tiếc, bạn không có quyền truy cập vào trang này.<br class="d-none d-sm-inline" />
            Vui lòng kiểm tra lại tài khoản hoặc liên hệ quản trị viên nếu cần.
        </p>

        <!-- Nhóm nút hành động (CTA) -->
        <div class="action-buttons-group">
            <a href="@homeUrl" class="btn-action-primary">
                <i class="bi bi-house-door-fill"></i>
                Quay về trang chủ
            </a>
            <form asp-controller="TaiKhoan" asp-action="Logout" method="post" class="d-inline m-0 p-0">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-action-secondary border-0">
                    <i class="bi bi-box-arrow-right"></i>
                    Đổi tài khoản khác
                </button>
            </form>
        </div>
    </div>
</div>
