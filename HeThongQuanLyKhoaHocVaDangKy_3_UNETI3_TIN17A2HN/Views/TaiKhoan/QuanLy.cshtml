@*
    Họ và tên: Trần Văn Thành
    Mã sinh viên: 23103100076
    Nội dung thực hiện: Module 1 - Giao diện Quản lý danh sách tài khoản, Phân quyền & Khóa/Mở khóa tài khoản (Admin)
*@

@model IEnumerable<HeThongQuanLyKhoaHocVaDangKy_3_UNETI3_TIN17A2HN.Models.TaiKhoan>
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Quản lý tài khoản người dùng";
    var currentUserId = Context.Session.GetInt32("MaTaiKhoan");
    var currentUserRole = Context.Session.GetString("VaiTro");
    var isCurrentUserAdmin = currentUserRole == "Admin";
    var totalAccounts = Model?.Count() ?? 0;
    var totalAdmins = Model?.Count(t => t.VaiTro == "Admin") ?? 0;
    var totalNhanViens = Model?.Count(t => t.VaiTro == "NhanVien") ?? 0;
    var totalHocViens = Model?.Count(t => t.VaiTro == "HocVien") ?? 0;
    var totalLocked = Model?.Count(t => !t.TrangThai) ?? 0;
}

<div class="container py-4">
    <!-- Header trang -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none" style="color: var(--uneti-primary);">Trang chủ</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Quản trị tài khoản</li>
                </ol>
            </nav>
            <h3 class="fw-bold mb-1 text-dark">
                <i class="bi bi-people-fill me-2" style="color: var(--uneti-primary);"></i>QUẢN LÝ TÀI KHOẢN & PHÂN QUYỀN
            </h3>
            <p class="text-muted mb-0 small">Kiểm soát danh sách người dùng, cấp phân quyền hệ thống và khóa/mở khóa tài khoản</p>
        </div>
        <div class="mt-2 mt-md-0 d-flex gap-2">
            @if (isCurrentUserAdmin)
            {
                <a asp-action="Register" class="btn uneti-btn-outline shadow-sm text-decoration-none">
                    <i class="bi bi-person-plus me-1"></i>Tạo tài khoản mới
                </a>
            }
            <a asp-controller="MonHoc" asp-action="QuanLy" class="btn uneti-btn-primary shadow-sm text-decoration-none">
                <i class="bi bi-book-half me-1"></i>Quản lý môn học
            </a>
        </div>
    </div>

    <!-- Thông báo TempData -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show uneti-card border-success-subtle mb-3 py-2 px-3" role="alert">
            <i class="bi bi-check-circle-fill text-success me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show uneti-card border-danger-subtle mb-3 py-2 px-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill text-danger me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- 4 Thẻ Thống Kê Hiện Đại & Trực Quan (Click để lọc nhanh) -->
    <div class="row g-3 mb-4">
        <!-- Thẻ 1: Tất cả tài khoản -->
        <div class="col-6 col-lg-3">
            <a asp-action="QuanLy" class="text-decoration-none">
                <div class="uneti-stat-card d-flex align-items-center gap-3 @(string.IsNullOrEmpty(ViewBag.CurrentRole) && ViewBag.CurrentTrangThai == null ? "active-filter border-primary bg-primary-subtle" : "")">
                    <span class="rounded-3 d-inline-flex justify-content-center align-items-center flex-shrink-0 bg-primary text-white shadow-sm" style="width: 48px; height: 48px;">
                        <i class="bi bi-people-fill fs-5"></i>
                    </span>
                    <div class="overflow-hidden">
                        <div class="fs-4 fw-bold text-dark lh-1 mb-1">@totalAccounts</div>
                        <div class="small text-muted fw-semibold text-truncate">Tất cả tài khoản</div>
                    </div>
                </div>
            </a>
        </div>

        <!-- Thẻ 2: Quản trị viên -->
        <div class="col-6 col-lg-3">
            <a asp-action="QuanLy" asp-route-role="Admin" class="text-decoration-none">
                <div class="uneti-stat-card d-flex align-items-center gap-3 @(ViewBag.CurrentRole == "Admin" ? "active-filter border-danger bg-danger-subtle" : "")">
                    <span class="rounded-3 d-inline-flex justify-content-center align-items-center flex-shrink-0 bg-danger text-white shadow-sm" style="width: 48px; height: 48px;">
                        <i class="bi bi-shield-lock-fill fs-5"></i>
                    </span>
                    <div class="overflow-hidden">
                        <div class="fs-4 fw-bold text-danger lh-1 mb-1">@totalAdmins</div>
                        <div class="small text-muted fw-semibold text-truncate">Quản trị viên (Admin)</div>
                    </div>
                </div>
            </a>
        </div>

        <!-- Thẻ 3: Nhân viên quản lý -->
        <div class="col-6 col-lg-3">
            <a asp-action="QuanLy" asp-route-role="NhanVien" class="text-decoration-none">
                <div class="uneti-stat-card d-flex align-items-center gap-3 @(ViewBag.CurrentRole == "NhanVien" ? "active-filter border-primary bg-primary-subtle" : "")">
                    <span class="rounded-3 d-inline-flex justify-content-center align-items-center flex-shrink-0 text-white shadow-sm" style="width: 48px; height: 48px; background-color: #4f46e5;">
                        <i class="bi bi-person-badge-fill fs-5"></i>
                    </span>
                    <div class="overflow-hidden">
                        <div class="fs-4 fw-bold lh-1 mb-1" style="color: #4f46e5;">@totalNhanViens</div>
                        <div class="small text-muted fw-semibold text-truncate">Nhân viên quản lý</div>
                    </div>
                </div>
            </a>
        </div>

        <!-- Thẻ 4: Học viên -->
        <div class="col-6 col-lg-3">
            <a asp-action="QuanLy" asp-route-role="HocVien" class="text-decoration-none">
                <div class="uneti-stat-card d-flex align-items-center gap-3 @(ViewBag.CurrentRole == "HocVien" ? "active-filter border-success bg-success-subtle" : "")">
                    <span class="rounded-3 d-inline-flex justify-content-center align-items-center flex-shrink-0 bg-success text-white shadow-sm" style="width: 48px; height: 48px;">
                        <i class="bi bi-mortarboard-fill fs-5"></i>
                    </span>
                    <div class="overflow-hidden">
                        <div class="fs-4 fw-bold text-success lh-1 mb-1">
                            @totalHocViens
                            @if (totalLocked > 0)
                            {
                                <span class="badge bg-danger text-white fw-normal ms-1" style="font-size: 11px;">@totalLocked khóa</span>
                            }
                        </div>
                        <div class="small text-muted fw-semibold text-truncate">Học viên đào tạo</div>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <!-- Thanh Tìm kiếm và Lọc -->
    <div class="uneti-card p-3 mb-4">
        <form method="get" asp-action="QuanLy" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchString" value="@ViewBag.CurrentSearch" 
                           class="form-control border-start-0 ps-1" 
                           placeholder="Tìm kiếm theo tên đăng nhập, họ tên, email..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="role" class="form-select">
                    <option value="">-- Tất cả vai trò --</option>
                    <!option value="Admin" @(ViewBag.CurrentRole == "Admin" ? "selected" : "")>Quản trị viên (Admin)</!option>
                    <!option value="NhanVien" @(ViewBag.CurrentRole == "NhanVien" ? "selected" : "")>Nhân viên quản lý</!option>
                    <!option value="HocVien" @(ViewBag.CurrentRole == "HocVien" ? "selected" : "")>Học viên</!option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="trangThai" class="form-select">
                    <option value="">-- Tất cả trạng thái --</option>
                    <!option value="true" @(ViewBag.CurrentTrangThai != null && (bool)ViewBag.CurrentTrangThai ? "selected" : "")>Đang hoạt động</!option>
                    <!option value="false" @(ViewBag.CurrentTrangThai != null && !(bool)ViewBag.CurrentTrangThai ? "selected" : "")>Đã bị khóa</!option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn uneti-btn-primary w-100 d-inline-flex align-items-center justify-content-center gap-1">
                    <i class="bi bi-funnel-fill"></i><span>Lọc</span>
                </button>
                <a asp-action="QuanLy" class="btn uneti-btn-outline" title="Đặt lại bộ lọc">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>

    <!-- Bảng danh sách tài khoản -->
    <div class="uneti-card overflow-hidden">
        <div class="table-responsive">
            <table class="table uneti-table align-middle mb-0" style="min-width: 1050px;">
                <thead>
                    <tr>
                        <th class="text-center" style="width: 50px;">STT</th>
                        <th style="width: 170px;">Tên đăng nhập</th>
                        <th style="width: 180px;">Họ và tên</th>
                        <th style="width: 220px;">Email liên hệ</th>
                        <th class="text-center" style="width: 140px;">Vai trò</th>
                        <th class="text-center" style="width: 130px;">Trạng thái</th>
                        <th class="text-center" style="width: 110px;">Ngày tạo</th>
                        <th class="text-center" style="width: 250px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model != null && Model.Any())
                {
                    int stt = 1;
                    foreach (var item in Model)
                    {
                        var isCurrentAdmin = currentUserId == item.MaTaiKhoan;
                        <tr>
                            <td class="text-center text-muted fw-bold">@stt</td>
                            <td>
                                <div class="fw-bold text-dark d-flex align-items-center gap-2">
                                    <span class="user-avatar text-white rounded-circle d-inline-flex justify-content-center align-items-center fw-bold shadow-sm" 
                                          style="width: 28px; height: 28px; font-size: 12px; background-color: var(--uneti-primary); flex-shrink: 0;">
                                        @(string.IsNullOrEmpty(item.HoTen) ? "U" : item.HoTen.Substring(0, 1).ToUpper())
                                    </span>
                                    <span class="text-nowrap">@item.TenDangNhap</span>
                                    @if (isCurrentAdmin)
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border py-0 px-1 text-nowrap" style="font-size: 10px;">Bạn</span>
                                    }
                                </div>
                            </td>
                            <td>
                                <span class="fw-semibold text-dark text-nowrap">@item.HoTen</span>
                            </td>
                            <td>
                                <a href="mailto:@item.Email" class="text-decoration-none text-muted small text-nowrap">
                                    <i class="bi bi-envelope me-1 text-primary"></i>@item.Email
                                </a>
                            </td>
                            <td class="text-center">
                                @switch (item.VaiTro)
                                {
                                    case "Admin":
                                        <span class="uneti-badge-danger"><i class="bi bi-shield-lock-fill me-1"></i>Admin</span>
                                        break;
                                    case "NhanVien":
                                        <span class="uneti-badge-primary"><i class="bi bi-person-badge me-1"></i>Nhân viên</span>
                                        break;
                                    case "HocVien":
                                        <span class="uneti-badge-success"><i class="bi bi-mortarboard me-1"></i>Học viên</span>
                                        break;
                                    default:
                                        <span class="uneti-badge-secondary">@item.VaiTro</span>
                                        break;
                                }
                            </td>
                            <td class="text-center">
                                @if (item.TrangThai)
                                {
                                    <span class="uneti-badge-success">
                                        <i class="bi bi-check-circle-fill me-1"></i>Hoạt động
                                    </span>
                                }
                                else
                                {
                                    <span class="uneti-badge-danger">
                                        <i class="bi bi-lock-fill me-1"></i>Đã khóa
                                    </span>
                                }
                            </td>
                            <td class="text-center text-muted small text-nowrap">
                                @item.NgayTao.ToString("dd/MM/yyyy")
                            </td>
                            <td class="text-center">
                                <div class="d-inline-flex align-items-center justify-content-center gap-1.5 flex-nowrap">
                                    @if (!isCurrentUserAdmin)
                                    {
                                        <span class="badge bg-light text-muted border py-1 px-2" style="font-size: 11px;">
                                            <i class="bi bi-eye me-1"></i>Chỉ xem
                                        </span>
                                    }
                                    else if (!isCurrentAdmin)
                                    {
                                        <!-- Nút Đổi vai trò / Phân quyền -->
                                        <button type="button" class="btn btn-sm btn-outline-primary uneti-action-btn" 
                                                data-bs-toggle="modal" data-bs-target="#editRoleModal_@item.MaTaiKhoan" 
                                                title="Chỉnh sửa vai trò / Phân quyền tài khoản">
                                            <i class="bi bi-person-gear"></i><span>Vai trò</span>
                                        </button>

                                        <!-- Nút Khóa / Mở khóa tài khoản -->
                                        <form method="post" asp-action="ToggleStatus" asp-route-id="@item.MaTaiKhoan" class="d-inline"
                                              onsubmit="return confirm('Bạn có chắc chắn muốn @(item.TrangThai ? "KHÓA" : "MỞ KHÓA") tài khoản @item.TenDangNhap?');">
                                            @Html.AntiForgeryToken()
                                            @if (item.TrangThai)
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-danger uneti-action-btn" title="Khóa tài khoản này">
                                                    <i class="bi bi-lock-fill"></i><span>Khóa</span>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-success uneti-action-btn" title="Mở khóa tài khoản này">
                                                    <i class="bi bi-unlock-fill"></i><span>Mở</span>
                                                </button>
                                            }
                                        </form>

                                        <!-- Nút Đặt lại mật khẩu về 123456 -->
                                        <form method="post" asp-action="ResetPasswordByAdmin" asp-route-id="@item.MaTaiKhoan" class="d-inline"
                                              onsubmit="return confirm('Đặt lại mật khẩu tài khoản @item.TenDangNhap về mặc định 123456?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-secondary uneti-action-btn" title="Đặt lại mật khẩu về 123456">
                                                <i class="bi bi-key-fill"></i><span>Reset</span>
                                            </button>
                                        </form>

                                        <!-- Modal Chỉnh sửa vai trò / Phân quyền -->
                                        <div class="modal fade" id="editRoleModal_@item.MaTaiKhoan" tabindex="-1" aria-labelledby="modalLabel_@item.MaTaiKhoan" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content uneti-card border-0 shadow">
                                                    <div class="modal-header bg-light border-bottom py-2.5 px-3">
                                                        <h5 class="modal-title fw-bold text-dark fs-6" id="modalLabel_@item.MaTaiKhoan">
                                                            <i class="bi bi-shield-lock-fill text-primary me-2"></i>Phân quyền tài khoản
                                                        </h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <form method="post" asp-action="UpdateRole" asp-route-id="@item.MaTaiKhoan">
                                                        @Html.AntiForgeryToken()
                                                        <div class="modal-body p-3.5 text-start">
                                                            <div class="mb-3 p-3 bg-light rounded-3 border">
                                                                <div class="d-flex align-items-center gap-2 mb-2">
                                                                    <span class="user-avatar text-white rounded-circle d-inline-flex justify-content-center align-items-center fw-bold" 
                                                                          style="width: 32px; height: 32px; font-size: 13px; background-color: var(--uneti-primary);">
                                                                        @(string.IsNullOrEmpty(item.HoTen) ? "U" : item.HoTen.Substring(0, 1).ToUpper())
                                                                    </span>
                                                                    <div>
                                                                        <div class="fw-bold text-dark">@item.HoTen</div>
                                                                        <div class="small text-muted">@@@item.TenDangNhap • @item.Email</div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <label class="form-label fw-bold small text-dark mb-2">Chọn vai trò mới cho tài khoản:</label>
                                                            <div class="d-flex flex-column gap-2">
                                                                <label class="p-2.5 border rounded-3 d-flex align-items-center gap-2.5 cursor-pointer">
                                                                    <input type="radio" name="vaiTro" value="Admin" @(item.VaiTro == "Admin" ? "checked" : "") class="form-check-input mt-0" />
                                                                    <div>
                                                                        <span class="uneti-badge-danger mb-1"><i class="bi bi-shield-lock-fill me-1"></i>Quản trị viên (Admin)</span>
                                                                        <div class="small text-muted" style="font-size: 11px;">Toàn quyền hệ thống, quản lý tài khoản & dữ liệu nền</div>
                                                                    </div>
                                                                </label>
                                                                <label class="p-2.5 border rounded-3 d-flex align-items-center gap-2.5 cursor-pointer">
                                                                    <input type="radio" name="vaiTro" value="NhanVien" @(item.VaiTro == "NhanVien" ? "checked" : "") class="form-check-input mt-0" />
                                                                    <div>
                                                                        <span class="uneti-badge-primary mb-1"><i class="bi bi-person-badge me-1"></i>Nhân viên quản lý</span>
                                                                        <div class="small text-muted" style="font-size: 11px;">Quản lý khóa học, duyệt đơn đăng ký & cập nhật kết quả</div>
                                                                    </div>
                                                                </label>
                                                                <label class="p-2.5 border rounded-3 d-flex align-items-center gap-2.5 cursor-pointer">
                                                                    <input type="radio" name="vaiTro" value="HocVien" @(item.VaiTro == "HocVien" ? "checked" : "") class="form-check-input mt-0" />
                                                                    <div>
                                                                        <span class="uneti-badge-success mb-1"><i class="bi bi-mortarboard me-1"></i>Học viên</span>
                                                                        <div class="small text-muted" style="font-size: 11px;">Xem thông tin khóa học, đăng ký & xem kết quả học tập</div>
                                                                    </div>
                                                                </label>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer bg-light border-top py-2 px-3">
                                                            <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Hủy</button>
                                                            <button type="submit" class="btn btn-sm uneti-btn-primary">
                                                                <i class="bi bi-check-lg me-1"></i>Lưu vai trò
                                                            </button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border px-3 py-1.5 text-nowrap">
                                            <i class="bi bi-person-check-fill me-1"></i>Đang đăng nhập
                                        </span>
                                    }
                                </div>
                            </td>
                        </tr>
                        stt++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary opacity-50"></i>
                            <div class="fw-semibold">Không tìm thấy tài khoản nào phù hợp</div>
                            <div class="small text-muted">Thử thay đổi từ khóa tìm kiếm hoặc đặt lại bộ lọc.</div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
