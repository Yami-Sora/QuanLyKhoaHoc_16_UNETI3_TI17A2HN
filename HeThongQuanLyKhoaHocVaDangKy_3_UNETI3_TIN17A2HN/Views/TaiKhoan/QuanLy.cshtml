@section Scripts {
    <script>
        (function () {
            // 1. Quản lý Modal phân quyền chung (Sử dụng Event Delegation để hoạt động trơn tru sau khi chuyển trang)
            const roleModalEl = document.getElementById('commonEditRoleModal');
            const roleModal = roleModalEl ? new bootstrap.Modal(roleModalEl) : null;
            const formRole = document.getElementById('formUpdateRole');
            const avatarEl = document.getElementById('roleModalAvatar');
            const fullNameEl = document.getElementById('roleModalFullName');
            const usernameEl = document.getElementById('roleModalUsername');
            const emailEl = document.getElementById('roleModalEmail');
            const currentRoleBadgeEl = document.getElementById('roleModalCurrentRole');

            function syncActiveRoleCard() {
                document.querySelectorAll('.role-option-card').forEach(function (card) {
                    const radio = card.querySelector('input[type="radio"]');
                    if (radio && radio.checked) {
                        card.classList.add('active');
                    } else {
                        card.classList.remove('active');
                    }
                });
            }

            // Lắng nghe thay đổi radio để cập nhật viền active mượt mà
            document.querySelectorAll('input[name="vaiTro"]').forEach(function (radio) {
                radio.addEventListener('change', syncActiveRoleCard);
            });

            // 1a. Quản lý Modal Thêm mới tài khoản người dùng (Popup ngay trong trang)
            const createModalEl = document.getElementById('commonCreateUserModal');
            const createModal = createModalEl ? new bootstrap.Modal(createModalEl) : null;
            const formCreate = document.getElementById('formCreateUser');
            const createAlert = document.getElementById('createModalAlert');
            const btnSubmitCreate = document.getElementById('btnSubmitCreateUser');
            const btnToggleCreatePassword = document.getElementById('btnToggleCreatePassword');

            const createTenDangNhap = document.getElementById('createModalTenDangNhap');
            const createMatKhau = document.getElementById('createModalMatKhau');
            const createHoTen = document.getElementById('createModalHoTen');
            const createEmail = document.getElementById('createModalEmail');
            const createPhone = document.getElementById('createModalSoDienThoai');
            const createVaiTro = document.getElementById('createModalVaiTro');
            const createTrangThai = document.getElementById('createModalTrangThai');

            if (createModalEl) {
                createModalEl.addEventListener('show.bs.modal', function () {
                    if (createAlert) {
                        createAlert.classList.add('d-none');
                        createAlert.textContent = '';
                    }
                    if (formCreate) {
                        formCreate.reset();
                        if (createMatKhau) {
                            createMatKhau.value = '123456';
                            createMatKhau.type = 'password';
                        }
                        if (btnToggleCreatePassword) {
                            const icon = btnToggleCreatePassword.querySelector('i');
                            if (icon) icon.className = 'bi bi-eye';
                        }
                        if (createVaiTro) createVaiTro.value = 'NhanVien';
                        if (createTrangThai) createTrangThai.checked = true;
                    }
                    setTimeout(function () {
                        if (createTenDangNhap) createTenDangNhap.focus();
                    }, 300);
                });
            }

            if (btnToggleCreatePassword && createMatKhau) {
                btnToggleCreatePassword.addEventListener('click', function () {
                    const isPassword = createMatKhau.type === 'password';
                    createMatKhau.type = isPassword ? 'text' : 'password';
                    const icon = btnToggleCreatePassword.querySelector('i');
                    if (icon) {
                        icon.className = isPassword ? 'bi bi-eye-slash' : 'bi bi-eye';
                    }
                });
            }

            function showCreateModalError(msg) {
                if (createAlert) {
                    createAlert.textContent = msg;
                    createAlert.classList.remove('d-none');
                } else {
                    alert(msg);
                }
            }

            formCreate?.addEventListener('submit', async function (e) {
                e.preventDefault();

                const usernameVal = createTenDangNhap ? createTenDangNhap.value.trim() : '';
                const passwordVal = createMatKhau ? createMatKhau.value : '';
                const hoTenVal = createHoTen ? createHoTen.value.trim() : '';
                const emailVal = createEmail ? createEmail.value.trim() : '';
                const phoneVal = createPhone ? createPhone.value.trim() : '';

                if (!usernameVal || usernameVal.length < 3 || usernameVal.length > 50) {
                    showCreateModalError('Tên đăng nhập phải từ 3 đến 50 ký tự.');
                    createTenDangNhap?.focus();
                    return;
                }

                if (!/^[a-zA-Z0-9_.]+$/.test(usernameVal)) {
                    showCreateModalError('Tên đăng nhập chỉ chứa chữ cái không dấu, số, dấu gạch dưới (_) và dấu chấm (.).');
                    createTenDangNhap?.focus();
                    return;
                }

                if (!passwordVal || passwordVal.length < 6) {
                    showCreateModalError('Mật khẩu khởi tạo tối thiểu 6 ký tự.');
                    createMatKhau?.focus();
                    return;
                }

                if (!hoTenVal || hoTenVal.length < 2) {
                    showCreateModalError('Họ và tên không được để trống và phải từ 2 ký tự trở lên.');
                    createHoTen?.focus();
                    return;
                }

                const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
                if (!emailVal || !emailRegex.test(emailVal)) {
                    showCreateModalError('Địa chỉ email không đúng định dạng.');
                    createEmail?.focus();
                    return;
                }

                if (phoneVal && !/^0[35789][0-9]{8}$/.test(phoneVal)) {
                    showCreateModalError('Số điện thoại phải là số di động Việt Nam hợp lệ (10 số, bắt đầu bằng 03, 05, 07, 08, 09).');
                    createPhone?.focus();
                    return;
                }

                if (createAlert) createAlert.classList.add('d-none');

                const originalBtnHtml = btnSubmitCreate ? btnSubmitCreate.innerHTML : '';
                if (btnSubmitCreate) {
                    btnSubmitCreate.disabled = true;
                    btnSubmitCreate.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span><span>Đang tạo...</span>';
                }

                try {
                    const formData = new FormData(formCreate);
                    const response = await fetch(formCreate.action, {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });

                    if (response.redirected) {
                        window.location.href = response.url;
                        return;
                    }

                    const result = await response.json();
                    if (result && result.success) {
                        if (createModal) createModal.hide();
                        if (window.UnetiUI && typeof window.UnetiUI.toast === 'function') {
                            window.UnetiUI.toast({
                                type: 'success',
                                title: 'Thành công',
                                message: result.message || 'Đã tạo mới tài khoản thành công!'
                            });
                        }
                        setTimeout(function () {
                            window.location.reload();
                        }, 400);
                    } else {
                        showCreateModalError(result.message || 'Không thể tạo tài khoản. Vui lòng kiểm tra lại.');
                    }
                } catch (err) {
                    formCreate.submit();
                } finally {
                    if (btnSubmitCreate) {
                        btnSubmitCreate.disabled = false;
                        btnSubmitCreate.innerHTML = originalBtnHtml;
                    }
                }
            });

            // 1b. Quản lý Modal Chỉnh sửa tài khoản người dùng (Popup ngay trong trang)
            const editModalEl = document.getElementById('commonEditUserModal');
            const editModal = editModalEl ? new bootstrap.Modal(editModalEl) : null;
            const formEdit = document.getElementById('formEditUser');
            const editAlert = document.getElementById('editModalAlert');
            const btnSubmitEdit = document.getElementById('btnSubmitEditUser');

            const editMaTaiKhoan = document.getElementById('editModalMaTaiKhoan');
            const editTenDangNhapHidden = document.getElementById('editModalTenDangNhapHidden');
            const editAvatar = document.getElementById('editModalAvatar');
            const editCardFullName = document.getElementById('editModalCardFullName');
            const editCardUsername = document.getElementById('editModalCardUsername');
            const editCardEmail = document.getElementById('editModalCardEmail');
            const editHoTen = document.getElementById('editModalHoTen');
            const editEmail = document.getElementById('editModalEmail');
            const editPhone = document.getElementById('editModalSoDienThoai');
            const editVaiTro = document.getElementById('editModalVaiTro');
            const editTrangThai = document.getElementById('editModalTrangThai');

            document.addEventListener('click', function (e) {
                const createBtn = e.target.closest('.js-open-create-modal');
                if (createBtn) {
                    if (createModal) createModal.show();
                    return;
                }

                const editBtn = e.target.closest('.js-open-edit-modal');
                if (editBtn) {
                    const id = editBtn.getAttribute('data-id');
                    const username = editBtn.getAttribute('data-username') || '';
                    const fullname = editBtn.getAttribute('data-fullname') || '';
                    const email = editBtn.getAttribute('data-email') || '';
                    const phone = editBtn.getAttribute('data-phone') || '';
                    const role = editBtn.getAttribute('data-role') || 'HocVien';
                    const status = editBtn.getAttribute('data-status') === 'true';

                    if (formEdit) formEdit.action = '/TaiKhoan/Edit/' + id;
                    if (editMaTaiKhoan) editMaTaiKhoan.value = id;
                    if (editTenDangNhapHidden) editTenDangNhapHidden.value = username;

                    if (editAvatar) editAvatar.textContent = (fullname && fullname.trim().length > 0) ? fullname.trim().charAt(0).toUpperCase() : 'U';
                    if (editCardFullName) editCardFullName.textContent = fullname || 'Chưa đặt họ tên';
                    if (editCardUsername) editCardUsername.textContent = '@@' + username;
                    if (editCardEmail) editCardEmail.textContent = email;

                    if (editHoTen) editHoTen.value = fullname;
                    if (editEmail) editEmail.value = email;
                    if (editPhone) editPhone.value = phone;
                    if (editVaiTro) editVaiTro.value = role;
                    if (editTrangThai) editTrangThai.checked = status;

                    if (editAlert) {
                        editAlert.classList.add('d-none');
                        editAlert.textContent = '';
                    }

                    // Tải dữ liệu bổ sung mới nhất nếu có
                    fetch('/TaiKhoan/Edit/' + id, {
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    })
                    .then(r => r.json())
                    .then(res => {
                        if (res && res.success && res.data) {
                            if (res.data.soDienThoai && editPhone) {
                                editPhone.value = res.data.soDienThoai;
                            }
                        }
                    })
                    .catch(() => {});

                    if (editModal) editModal.show();
                    return;
                }

                const roleBtn = e.target.closest('.js-open-role-modal');
                if (roleBtn) {
                    const id = roleBtn.getAttribute('data-id');
                    const username = roleBtn.getAttribute('data-username');
                    const fullname = roleBtn.getAttribute('data-fullname');
                    const email = roleBtn.getAttribute('data-email');
                    const role = roleBtn.getAttribute('data-role');

                    if (formRole) formRole.action = '/TaiKhoan/UpdateRole/' + id;
                    if (fullNameEl) fullNameEl.textContent = fullname || 'Chưa đặt họ tên';
                    if (usernameEl) usernameEl.textContent = '@@' + (username || '');
                    if (emailEl) emailEl.textContent = email || '';
                    if (avatarEl) avatarEl.textContent = (fullname && fullname.trim().length > 0) ? fullname.trim().charAt(0).toUpperCase() : 'U';

                    // Cập nhật huy hiệu vai trò hiện tại
                    if (currentRoleBadgeEl) {
                        if (role === 'Admin') {
                            currentRoleBadgeEl.className = 'role-current-tag uneti-badge-danger';
                            currentRoleBadgeEl.innerHTML = '<i class="bi bi-shield-lock-fill me-1"></i>Hiện tại: Admin';
                        } else if (role === 'NhanVien') {
                            currentRoleBadgeEl.className = 'role-current-tag uneti-badge-primary';
                            currentRoleBadgeEl.innerHTML = '<i class="bi bi-person-badge-fill me-1"></i>Hiện tại: Nhân viên';
                        } else {
                            currentRoleBadgeEl.className = 'role-current-tag uneti-badge-success';
                            currentRoleBadgeEl.innerHTML = '<i class="bi bi-mortarboard-fill me-1"></i>Hiện tại: Học viên';
                        }
                    }

                    const targetRadio = document.querySelector(`input[name="vaiTro"][value="${role}"]`);
                    if (targetRadio) {
                        targetRadio.checked = true;
                    }
                    syncActiveRoleCard();

                    if (roleModal) roleModal.show();
                    return;
                }
            });

            // Xử lý gửi Form Chỉnh sửa tài khoản
            formEdit?.addEventListener('submit', async function (e) {
                e.preventDefault();
                const hoTenVal = editHoTen ? editHoTen.value.trim() : '';
                const emailVal = editEmail ? editEmail.value.trim() : '';
                const phoneVal = editPhone ? editPhone.value.trim() : '';

                if (!hoTenVal || hoTenVal.length < 2) {
                    showEditModalError('Họ và tên không được để trống và phải từ 2 ký tự trở lên.');
                    editHoTen?.focus();
                    return;
                }

                const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
                if (!emailVal || !emailRegex.test(emailVal)) {
                    showEditModalError('Địa chỉ email không đúng định dạng.');
                    editEmail?.focus();
                    return;
                }

                if (phoneVal && !/^0[35789][0-9]{8}$/.test(phoneVal)) {
                    showEditModalError('Số điện thoại phải là số di động Việt Nam hợp lệ (10 số, bắt đầu bằng 03, 05, 07, 08, 09).');
                    editPhone?.focus();
                    return;
                }

                if (editAlert) editAlert.classList.add('d-none');

                const originalBtnHtml = btnSubmitEdit ? btnSubmitEdit.innerHTML : '';
                if (btnSubmitEdit) {
                    btnSubmitEdit.disabled = true;
                    btnSubmitEdit.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span><span>Đang lưu...</span>';
                }

                try {
                    const formData = new FormData(formEdit);
                    const response = await fetch(formEdit.action, {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });

                    if (response.redirected) {
                        window.location.href = response.url;
                        return;
                    }

                    const result = await response.json();
                    if (result && result.success) {
                        if (editModal) editModal.hide();
                        if (window.UnetiUI && typeof window.UnetiUI.toast === 'function') {
                            window.UnetiUI.toast({
                                type: 'success',
                                title: 'Thành công',
                                message: result.message || 'Đã lưu thay đổi thành công!'
                            });
                        }
                        setTimeout(function () {
                            window.location.reload();
                        }, 400);
                    } else {
                        showEditModalError(result.message || 'Không thể lưu thông tin. Vui lòng kiểm tra lại.');
                    }
                } catch (err) {
                    // Fallback gửi form mặc định
                    formEdit.submit();
                } finally {
                    if (btnSubmitEdit) {
                        btnSubmitEdit.disabled = false;
                        btnSubmitEdit.innerHTML = originalBtnHtml;
                    }
                }
            });

            function showEditModalError(msg) {
                if (editAlert) {
                    editAlert.textContent = msg;
                    editAlert.classList.remove('d-none');
                } else {
                    alert(msg);
                }
            }

            // 2. Phân trang AJAX giữ nguyên vị trí cuộn ("Đứng yên", không cuộn/giật lên đầu trang)
            const tableContainer = document.getElementById('taiKhoanTableContainer');
            if (tableContainer) {
                tableContainer.addEventListener('click', async function (e) {
                    const link = e.target.closest('.uneti-pagination a, .pagination a');
                    if (!link) return;

                    const item = link.closest('.page-item');
                    if (item && (item.classList.contains('disabled') || item.classList.contains('active'))) {
                        e.preventDefault();
                        return;
                    }

                    const href = link.getAttribute('href');
                    if (!href || href === '#' || href.startsWith('javascript:')) return;

                    e.preventDefault();

                    // Hiệu ứng mờ nhẹ trong lúc tải dữ liệu mới mà không thay đổi scroll màn hình
                    tableContainer.style.transition = 'opacity 0.15s ease';
                    tableContainer.style.opacity = '0.45';
                    tableContainer.style.pointerEvents = 'none';

                    try {
                        const response = await fetch(href, {
                            headers: { 'X-Requested-With': 'XMLHttpRequest' }
                        });
                        if (!response.ok) throw new Error('Network error ' + response.status);

                        const html = await response.text();
                        const parser = new DOMParser();
                        const doc = parser.parseFromString(html, 'text/html');
                        const newContainer = doc.getElementById('taiKhoanTableContainer');

                        if (newContainer) {
                            tableContainer.innerHTML = newContainer.innerHTML;
                            window.history.pushState({ path: href }, '', href);

                            // Khởi tạo tooltips
                            if (window.bootstrap && typeof window.bootstrap.Tooltip === 'function') {
                                tableContainer.querySelectorAll('[title]').forEach(function (el) {
                                    new bootstrap.Tooltip(el);
                                });
                            }
                        } else {
                            window.location.href = href;
                        }
                    } catch (err) {
                        console.error('AJAX pagination error:', err);
                        window.location.href = href;
                    } finally {
                        tableContainer.style.opacity = '1';
                        tableContainer.style.pointerEvents = '';
                    }
                });

                // Hỗ trợ nút Back / Forward trên trình duyệt
                window.addEventListener('popstate', async function () {
                    try {
                        tableContainer.style.opacity = '0.45';
                        const res = await fetch(window.location.href, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                        if (res.ok) {
                            const doc = new DOMParser().parseFromString(await res.text(), 'text/html');
                            const newContainer = doc.getElementById('taiKhoanTableContainer');
                            if (newContainer) {
                                tableContainer.innerHTML = newContainer.innerHTML;
                            }
                        }
                    } finally {
                        tableContainer.style.opacity = '1';
                    }
                });
            }
        })();
    </script>
}
