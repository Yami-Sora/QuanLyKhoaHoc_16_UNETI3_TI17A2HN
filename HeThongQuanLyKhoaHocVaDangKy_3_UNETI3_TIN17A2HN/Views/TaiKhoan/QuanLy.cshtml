@*
    Họ và tên: Trần Văn Thành
    Mã sinh viên: 23103100076
    Nội dung: Module 1 - Quản trị tài khoản (Admin) — dùng chung bộ CSS trang quản lý
             (dl-page-head / dl-stat-card / dl-filter-card / dl-table-card trong _admin.css) với Môn học và Giảng viên:
             thẻ thống kê bấm lọc theo vai trò, lọc nhanh trong đầu bảng, cột tài khoản gộp, phân trang ở chân bảng
*@

@model IEnumerable<HeThongQuanLyKhoaHocVaDangKy_3_UNETI3_TIN17A2HN.Models.TaiKhoan>
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Quản lý tài khoản người dùng";
    var currentUserId = Context.Session.GetInt32("MaTaiKhoan");
    var currentUserRole = Context.Session.GetString("VaiTro");
    var isCurrentUserAdmin = currentUserRole == "Admin";
    int totalCount = ViewBag.TotalCount ?? (Model?.Count() ?? 0);
    int totalFiltered = ViewBag.TotalFilteredItems ?? (Model?.Count() ?? 0);
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int pageSize = ViewBag.PageSize ?? 10;
    var currentSearch = ViewBag.CurrentSearch as string;
    var currentRole = ViewBag.CurrentRole as string;
    bool? currentTrangThai = ViewBag.CurrentTrangThai;

    var totalAccounts = totalCount;
    var totalAdmins = ViewBag.TotalAdmins ?? 0;
    var totalNhanViens = ViewBag.TotalNhanViens ?? 0;
    var totalHocViens = ViewBag.TotalHocViens ?? 0;
    var totalLocked = ViewBag.TotalLocked ?? 0;
}

<div class="container-fluid py-2">
    <!-- Header trang -->
    <div class="dl-page-head">
        <div class="dl-head-left">
            <span class="dl-head-icon">
                <i class="bi bi-people-fill"></i>
            </span>
            <div class="dl-head-text">
                <h4 class="dl-page-title">Quản lý tài khoản & phân quyền</h4>
                <p class="dl-page-sub">Kiểm soát người dùng, phân quyền và khóa/mở tài khoản</p>
            </div>
        </div>
        <div class="d-flex gap-2">
            @if (isCurrentUserAdmin)
            {
                <button type="button" class="btn uneti-btn-outline shadow-sm text-decoration-none js-open-create-modal" data-bs-toggle="modal" data-bs-target="#commonCreateUserModal">
                    <i class="bi bi-person-plus-fill me-1"></i>Thêm tài khoản mới
                </button>
            }
            <a asp-controller="MonHoc" asp-action="QuanLy" class="btn uneti-btn-primary shadow-sm text-decoration-none">
                <i class="bi bi-book-half me-1"></i>Quản lý môn học
            </a>
        </div>
    </div>

    <!-- Thông báo TempData -->
    <noscript>
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show uneti-card border-success-subtle mb-3 py-2 px-3" role="alert">
                <i class="bi bi-check-circle-fill text-success me-2"></i>@TempData["SuccessMessage"]
                <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show uneti-card border-danger-subtle mb-3 py-2 px-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill text-danger me-2"></i>@TempData["ErrorMessage"]
                <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </noscript>

    <!-- Thống kê: 4 thẻ dùng chung thiết kế với Môn học / Giảng viên (bấm vào thẻ = lọc theo vai trò) -->
    <div class="row g-3 mb-3">
        <div class="col-6 col-lg-3">
            <a asp-action="QuanLy" class="dl-stat-card dl-blue @(string.IsNullOrEmpty(ViewBag.CurrentRole) && ViewBag.CurrentTrangThai == null ? "dl-active" : "")" title="Xem tất cả tài khoản">
                <span class="dl-stat-icon"><i class="bi bi-people-fill"></i></span>
                <span>
                    <span class="dl-stat-label">Tất cả tài khoản</span>
                    <span class="dl-stat-num"><span data-count-to="@totalAccounts">@totalAccounts</span></span>
                    <span class="dl-stat-sub">Toàn bộ tài khoản hệ thống</span>
                </span>
            </a>
        </div>
        <div class="col-6 col-lg-3">
            <a asp-action="QuanLy" asp-route-role="Admin" class="dl-stat-card dl-red @(ViewBag.CurrentRole == "Admin" ? "dl-active" : "")" title="Lọc: quản trị viên (Admin)">
                <span class="dl-stat-icon"><i class="bi bi-shield-lock-fill"></i></span>
                <span>
                    <span class="dl-stat-label">Quản trị viên (Admin)</span>
                    <span class="dl-stat-num"><span data-count-to="@totalAdmins">@totalAdmins</span></span>
                    <span class="dl-stat-sub">Toàn quyền quản trị hệ thống</span>
                </span>
            </a>
        </div>
        <div class="col-6 col-lg-3">
            <a asp-action="QuanLy" asp-route-role="NhanVien" class="dl-stat-card dl-violet @(ViewBag.CurrentRole == "NhanVien" ? "dl-active" : "")" title="Lọc: nhân viên quản lý">
                <span class="dl-stat-icon"><i class="bi bi-person-badge-fill"></i></span>
                <span>
                    <span class="dl-stat-label">Nhân viên quản lý</span>
                    <span class="dl-stat-num"><span data-count-to="@totalNhanViens">@totalNhanViens</span></span>
                    <span class="dl-stat-sub">Quản lý đào tạo &amp; khóa học</span>
                </span>
            </a>
        </div>
        <div class="col-6 col-lg-3">
            <a asp-action="QuanLy" asp-route-role="HocVien" class="dl-stat-card dl-green @(ViewBag.CurrentRole == "HocVien" ? "dl-active" : "")" title="Lọc: học viên đào tạo">
                <span class="dl-stat-icon"><i class="bi bi-mortarboard-fill"></i></span>
                <span>
                    <span class="dl-stat-label">Học viên đào tạo</span>
                    <span class="dl-stat-num"><span data-count-to="@totalHocViens">@totalHocViens</span>@if (totalLocked > 0) { <span class="badge bg-danger text-white fw-normal ms-1 uneti-fs-xs">@totalLocked khóa</span> }</span>
                    <span class="dl-stat-sub">Tài khoản học viên của trung tâm</span>
                </span>
            </a>
        </div>
    </div>

    <!-- Thanh Tìm kiếm và Lọc (gọn 1 hàng) -->
    <div class="dl-filter-card">
        <form method="get" asp-action="QuanLy" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchString" value="@ViewBag.CurrentSearch"
                           class="form-control border-start-0 ps-1"
                           placeholder="Tìm kiếm theo tên đăng nhập, họ tên, email..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="role" class="form-select">
                    <option value="">-- Tất cả vai trò --</option>
                    @if (ViewBag.CurrentRole == "Admin") { <option value="Admin" selected>Quản trị viên (Admin)</option> } else { <option value="Admin">Quản trị viên (Admin)</option> }
                    @if (ViewBag.CurrentRole == "NhanVien") { <option value="NhanVien" selected>Nhân viên quản lý</option> } else { <option value="NhanVien">Nhân viên quản lý</option> }
                    @if (ViewBag.CurrentRole == "HocVien") { <option value="HocVien" selected>Học viên</option> } else { <option value="HocVien">Học viên</option> }
                </select>
            </div>
            <div class="col-md-2">
                <select name="trangThai" class="form-select">
                    <option value="">-- Tất cả trạng thái --</option>
                    @if (ViewBag.CurrentTrangThai != null && (bool)ViewBag.CurrentTrangThai) { <option value="true" selected>Đang hoạt động</option> } else { <option value="true">Đang hoạt động</option> }
                    @if (ViewBag.CurrentTrangThai != null && !(bool)ViewBag.CurrentTrangThai) { <option value="false" selected>Đã bị khóa</option> } else { <option value="false">Đã bị khóa</option> }
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn uneti-btn-primary flex-grow-1 d-inline-flex align-items-center justify-content-center gap-1">
                    <i class="bi bi-funnel-fill"></i><span>Lọc</span>
                </button>
                <a asp-action="QuanLy" class="btn uneti-btn-outline" title="Đặt lại bộ lọc">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>

    <!-- Bảng danh sách tài khoản: lọc nhanh nằm NGAY TRONG đầu bảng, phân trang nằm NGAY chân bảng -->
    <div id="taiKhoanTableContainer" class="position-relative">
        <div class="dl-table-card">
            <!-- Đầu bảng: tiêu đề + nút Xuất danh sách (chuẩn như Giảng viên) -->
            <div class="dl-table-head">
                <div class="d-flex align-items-center gap-2">
                    <span class="dl-head-ic"><i class="bi bi-people"></i></span>
                    <span class="fw-bold text-dark">Danh sách tài khoản</span>
                    <span class="dl-count-badge">@totalAccounts tài khoản</span>
                </div>
                <a asp-action="XuatDanhSach" asp-route-searchString="@currentSearch" asp-route-role="@currentRole" asp-route-trangThai="@currentTrangThai" class="btn btn-sm uneti-btn-outline" download data-no-transition title="Xuất danh sách tài khoản sang file Excel"><i class="bi bi-file-earmark-excel-fill text-success me-1"></i> Xuất Excel</a>
            </div>
            <div class="table-responsive">
                <table class="table uneti-table align-middle mb-0" style="min-width: 900px;" id="taiKhoanAdminTable">
                    <thead>
                        <tr>
                            <th class="text-center" style="width: 44px;">STT</th>
                            <th>Tài khoản</th>
                            <th>Email liên hệ</th>
                            <th class="text-center" style="width: 128px;">Vai trò</th>
                            <th class="text-center" style="width: 124px;">Trạng thái</th>
                            <th class="text-center" style="width: 102px;">Ngày tạo</th>
                            <th class="text-center" style="width: 168px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (Model != null && Model.Any())
                    {
                        int stt = (currentPage - 1) * pageSize + 1;
                        foreach (var item in Model)
                        {
                            var isSelf = currentUserId == item.MaTaiKhoan;
                            <tr>
                                <td class="text-center text-muted fw-bold">@stt</td>
                                <!-- GỘP 2 cột Tên đăng nhập + Họ và tên thành 1 cột Tài khoản -->
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="user-avatar text-white uneti-icon-box-32 bg-primary fw-bold shadow-sm flex-shrink-0">
                                            @(string.IsNullOrEmpty(item.HoTen) ? "U" : item.HoTen.Substring(0, 1).ToUpper())
                                        </span>
                                        <div class="overflow-hidden">
                                            <div class="fw-semibold text-dark text-nowrap">
                                                @item.HoTen
                                                @if (isSelf)
                                                {
                                                    <span class="badge bg-secondary-subtle text-secondary border py-0 px-1 uneti-fs-xs">Bạn</span>
                                                }
                                            </div>
                                            <div class="small text-muted text-nowrap">@@@item.TenDangNhap</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <a href="mailto:@item.Email" class="text-decoration-none text-muted small text-nowrap">
                                        <i class="bi bi-envelope me-1 text-primary"></i>@item.Email
                                    </a>
                                </td>
                                <td class="text-center">
                                    @switch (item.VaiTro)
                                    {
                                        case "Admin":
                                            <span class="uneti-badge-danger"><i class="bi bi-shield-lock-fill me-1"></i>Admin</span>
                                            break;
                                        case "NhanVien":
                                            <span class="uneti-badge-primary"><i class="bi bi-person-badge me-1"></i>Nhân viên</span>
                                            break;
                                        case "HocVien":
                                            <span class="uneti-badge-success"><i class="bi bi-mortarboard me-1"></i>Học viên</span>
                                            break;
                                        default:
                                            <span class="uneti-badge-secondary">@item.VaiTro</span>
                                            break;
                                    }
                                </td>
                                <td class="text-center">
                                    @if (item.TrangThai)
                                    {
                                        <span class="uneti-badge-success">
                                            <i class="bi bi-check-circle-fill me-1"></i>Hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="uneti-badge-danger">
                                            <i class="bi bi-lock-fill me-1"></i>Đã khóa
                                        </span>
                                    }
                                </td>
                                <td class="text-center text-muted small text-nowrap">
                                    @item.NgayTao.ToString("dd/MM/yyyy")
                                </td>
                                <td class="text-center">
                                    @if (!isCurrentUserAdmin)
                                    {
                                        <span class="badge bg-light text-muted border py-1 px-2 uneti-fs-xs">
                                            <i class="bi bi-eye me-1"></i>Chỉ xem
                                        </span>
                                    }
                                    else if (!isSelf)
                                    {
                                        <!-- Thao tác dạng ICON gọn (giống trang Môn học), có tooltip chú thích -->
                                        <div class="d-inline-flex align-items-center justify-content-center gap-1 flex-nowrap">
                                            <button type="button" class="btn-action-icon btn-action-edit js-open-edit-modal"
                                                    data-id="@item.MaTaiKhoan"
                                                    data-username="@item.TenDangNhap"
                                                    data-fullname="@item.HoTen"
                                                    data-email="@item.Email"
                                                    data-phone="@(item.HocVien?.SoDienThoai ?? "")"
                                                    data-role="@item.VaiTro"
                                                    data-status="@(item.TrangThai ? "true" : "false")"
                                                    title="Chỉnh sửa thông tin tài khoản">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                            <button type="button" class="btn-action-icon btn-action-toggle js-open-role-modal"
                                                    data-id="@item.MaTaiKhoan"
                                                    data-username="@item.TenDangNhap"
                                                    data-fullname="@item.HoTen"
                                                    data-email="@item.Email"
                                                    data-role="@item.VaiTro"
                                                    title="Đổi vai trò / Phân quyền tài khoản">
                                                <i class="bi bi-person-gear"></i>
                                            </button>
                                            <form method="post" asp-action="ToggleStatus" asp-route-id="@item.MaTaiKhoan" class="d-inline m-0 p-0"
                                                  data-uneti-confirm="Bạn có chắc chắn muốn @(item.TrangThai ? "KHÓA" : "MỞ KHÓA") tài khoản @item.TenDangNhap?"
                                                  data-uneti-title="@(item.TrangThai ? "Xác nhận khóa tài khoản" : "Xác nhận mở khóa tài khoản")"
                                                  data-uneti-type="@(item.TrangThai ? "danger" : "primary")"
                                                  data-uneti-ok="@(item.TrangThai ? "Khóa tài khoản" : "Mở khóa")">
                                                @Html.AntiForgeryToken()
                                                @if (item.TrangThai)
                                                {
                                                    <button type="submit" class="btn-action-icon btn-action-delete" title="Khóa tài khoản này">
                                                        <i class="bi bi-lock-fill"></i>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="submit" class="btn-action-icon btn-action-toggle" title="Mở khóa tài khoản này">
                                                        <i class="bi bi-unlock-fill"></i>
                                                    </button>
                                                }
                                            </form>
                                            <form method="post" asp-action="ResetPasswordByAdmin" asp-route-id="@item.MaTaiKhoan" class="d-inline m-0 p-0"
                                                  data-uneti-confirm="Đặt lại mật khẩu cho tài khoản @item.TenDangNhap về mặc định (123456)?"
                                                  data-uneti-title="Đặt lại mật khẩu"
                                                  data-uneti-type="warning"
                                                  data-uneti-ok="Đặt lại 123456">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn-action-icon btn-action-view" title="Đặt lại mật khẩu về mặc định (123456)">
                                                    <i class="bi bi-key-fill"></i>
                                                </button>
                                            </form>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border px-2 py-1 text-nowrap uneti-fs-xs">
                                            <i class="bi bi-person-check-fill me-1"></i>Đang đăng nhập
                                        </span>
                                    }
                                </td>
                            </tr>
                            stt++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary opacity-50"></i>
                                <div class="fw-semibold">Không tìm thấy tài khoản nào phù hợp</div>
                                <div class="small text-muted">Thử thay đổi từ khóa tìm kiếm hoặc đặt lại bộ lọc.</div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

        <!-- Chân bảng GỘP: tổng số hiển thị + phân trang cùng 1 hàng, nằm trong cùng thẻ bảng -->
        <div class="dl-table-foot">
            <span class="small text-muted">
                Hiển thị <strong><span id="summaryRowCount">@(Model?.Count() ?? 0)</span></strong> trên tổng số <strong>@totalAccounts</strong> tài khoản
                @if (totalPages > 1)
                {
                    <span>• Trang <strong>@currentPage</strong>/<strong>@totalPages</strong> (đã lọc: <strong>@totalFiltered</strong>)</span>
                }
            </span>
            @if (totalPages > 1)
            {
                <nav aria-label="Phân trang danh sách tài khoản">
                    <ul class="pagination uneti-pagination mb-0">
                        <li class="page-item @(currentPage <= 1 ? "disabled" : "")" title="Trang đầu">
                            <a class="page-link" asp-action="QuanLy" asp-route-page="1" asp-route-searchString="@currentSearch" asp-route-role="@currentRole" asp-route-trangThai="@currentTrangThai">
                                <i class="bi bi-chevron-double-left"></i>
                            </a>
                        </li>
                        <li class="page-item @(currentPage <= 1 ? "disabled" : "")" title="Trang trước">
                            <a class="page-link" asp-action="QuanLy" asp-route-page="@(currentPage - 1)" asp-route-searchString="@currentSearch" asp-route-role="@currentRole" asp-route-trangThai="@currentTrangThai">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>
                        @for (int p = 1; p <= totalPages; p++)
                        {
                            if (totalPages > 7 && Math.Abs(p - currentPage) > 2 && p != 1 && p != totalPages)
                            {
                                if (p == currentPage - 3 || p == currentPage + 3)
                                {
                                    <li class="page-item disabled"><span class="page-ellipsis">…</span></li>
                                }
                                continue;
                            }
                            <li class="page-item @(p == currentPage ? "active" : "")">
                                <a class="page-link" asp-action="QuanLy" asp-route-page="@p" asp-route-searchString="@currentSearch" asp-route-role="@currentRole" asp-route-trangThai="@currentTrangThai">@p</a>
                            </li>
                        }
                        <li class="page-item @(currentPage >= totalPages ? "disabled" : "")" title="Trang tiếp theo">
                            <a class="page-link" asp-action="QuanLy" asp-route-page="@(currentPage + 1)" asp-route-searchString="@currentSearch" asp-route-role="@currentRole" asp-route-trangThai="@currentTrangThai">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                        <li class="page-item @(currentPage >= totalPages ? "disabled" : "")" title="Trang cuối">
                            <a class="page-link" asp-action="QuanLy" asp-route-page="@totalPages" asp-route-searchString="@currentSearch" asp-route-role="@currentRole" asp-route-trangThai="@currentTrangThai">
                                <i class="bi bi-chevron-double-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
        </div>
    </div>
</div>

<!-- Modal phân quyền chung -->
<div class="modal fade" id="commonEditRoleModal" tabindex="-1" aria-labelledby="commonRoleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered role-modal-dialog">
        <div class="modal-content role-modal-content">
            <div class="role-modal-header">
                <div class="d-flex align-items-center gap-3">
                    <span class="role-modal-header-icon">
                        <i class="bi bi-shield-lock-fill"></i>
                    </span>
                    <div>
                        <h5 class="role-modal-title" id="commonRoleModalLabel">
                            Phân quyền tài khoản
                        </h5>
                        <div class="role-modal-sub">Điều chỉnh cấp bậc và phạm vi quyền hạn trên hệ thống</div>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <form method="post" id="formUpdateRole" asp-action="UpdateRole">
                @Html.AntiForgeryToken()
                <div class="role-modal-body text-start">
                    <!-- Khối thông tin tài khoản được chọn -->
                    <div class="role-user-card">
                        <div class="d-flex align-items-center gap-3 overflow-hidden">
                            <span class="role-user-avatar" id="roleModalAvatar">
                                U
                            </span>
                            <div class="role-user-info">
                                <div class="role-user-name text-truncate" id="roleModalFullName">...</div>
                                <div class="role-user-meta text-truncate">
                                    <span id="roleModalUsername">...</span>
                                    <span class="mx-1">•</span>
                                    <span id="roleModalEmail">...</span>
                                </div>
                            </div>
                        </div>
                        <div class="flex-shrink-0">
                            <span class="role-current-tag uneti-badge-primary" id="roleModalCurrentRole">
                                <i class="bi bi-person-badge-fill me-1"></i>Hiện tại: Nhân viên
                            </span>
                        </div>
                    </div>

