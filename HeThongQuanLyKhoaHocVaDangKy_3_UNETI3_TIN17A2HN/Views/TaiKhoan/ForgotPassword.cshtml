@*
    Họ và tên: Trần Văn Thành
    Mã sinh viên: 23103100076
    Nội dung thực hiện: Module 1 - Giao diện Quên mật khẩu chuẩn theo nhận diện UNETI (Đồng bộ với Login & Register)
*@

@model HeThongQuanLyKhoaHocVaDangKy_3_UNETI3_TIN17A2HN.ViewModels.ForgotPasswordViewModel
@{
    Layout = null;
    ViewData["Title"] = "Quên mật khẩu";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cổng Đào Tạo Trực Tuyến</title>
    
    <!-- Google Font: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap CSS & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: #f1f5f9;
            background-image: 
                linear-gradient(135deg, rgba(239, 246, 255, 0.45) 0%, rgba(219, 234, 254, 0.55) 100%),
                url('/images/auth-bg.jpg');
            background-repeat: no-repeat;
            background-position: center center;
            background-size: cover;
            background-attachment: fixed;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 2.5rem 1rem;
            margin: 0;
            position: relative;
        }

        /* Glassmorphism Card đồng bộ với Login & Register */
        .forgot-card {
            background: rgba(255, 255, 255, 0.94);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.85);
            border-radius: 24px;
            box-shadow: 
                0 20px 40px -15px rgba(15, 23, 42, 0.16),
                0 0 0 1px rgba(255, 255, 255, 0.8) inset;
            width: 100%;
            max-width: 440px;
            padding: 2.5rem 2.25rem;
            position: relative;
            z-index: 10;
            transition: transform 0.25s ease, box-shadow 0.25s ease;
        }

        /* Logo Badge với gradient mềm mại */
        .uneti-logo-badge {
            width: 58px;
            height: 58px;
            background: linear-gradient(135deg, #1d4ed8 0%, #3b82f6 100%);
            color: #ffffff;
            border-radius: 18px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            box-shadow: 0 10px 22px -6px rgba(29, 78, 216, 0.38);
            border: 3px solid #ffffff;
            margin: 0 auto;
        }

        .header-title {
            color: #0f172a;
            font-size: 1.45rem;
            font-weight: 800;
            letter-spacing: -0.02em;
            margin-top: 0.75rem;
            margin-bottom: 0.25rem;
        }

        .header-subtitle {
            color: #64748b;
            font-size: 13.5px;
            font-weight: 500;
            line-height: 1.45;
        }

        /* Label gọn gàng, tinh tế */
        .form-label-custom {
            color: #334155;
            font-size: 13.5px;
            font-weight: 600;
            display: block;
            margin-bottom: 0.45rem;
        }

        /* Custom Input Container */
        .custom-input-group {
            position: relative;
            display: flex;
            align-items: center;
            width: 100%;
        }

        .custom-input-group .input-icon-start {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 1.15rem;
            pointer-events: none;
            z-index: 5;
            transition: color 0.2s ease;
        }

        .custom-input-group:focus-within .input-icon-start {
            color: #2563eb;
        }

        .custom-input-group .form-control.custom-input {
            width: 100%;
            height: 48px;
            padding-left: 46px;
            padding-right: 16px;
            border-radius: 12px;
            border: 1.5px solid #e2e8f0;
            background-color: #f8fafc;
            font-size: 14.5px;
            font-family: inherit;
            color: #1e293b;
            transition: all 0.2s ease-in-out;
        }

        .custom-input-group .form-control.custom-input::placeholder {
            color: #94a3b8;
            font-size: 14px;
            font-weight: 400;
        }

        .custom-input-group .form-control.custom-input:focus {
            background-color: #ffffff;
            border-color: #3b82f6;
            box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.12);
            color: #0f172a;
            outline: none;
        }

        .custom-input-group .form-control.custom-input.input-validation-error {
            border-color: #ef4444;
            background-color: #fef2f2;
        }

        .btn-submit-action {
            background: linear-gradient(135deg, #1d4ed8 0%, #2563eb 100%);
            color: #ffffff;
            border: none;
            border-radius: 12px;
            height: 48px;
            font-size: 15px;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            box-shadow: 0 8px 18px -4px rgba(29, 78, 216, 0.35);
            transition: all 0.2s ease;
            width: 100%;
            cursor: pointer;
        }

        .btn-submit-action:hover {
            background: linear-gradient(135deg, #1e40af 0%, #1d4ed8 100%);
            box-shadow: 0 10px 22px -4px rgba(29, 78, 216, 0.45);
            transform: translateY(-1px);
            color: #ffffff;
        }
    </style>
</head>
<body>
    <div class="forgot-card">
        <!-- Logo & Header -->
        <div class="text-center mb-4">
            <div class="uneti-logo-badge">
                <i class="bi bi-key-fill"></i>
            </div>
            <h1 class="header-title">QUÊN MẬT KHẨU</h1>
            <p class="header-subtitle mb-0">Nhập email đã đăng ký để nhận liên kết khôi phục mật khẩu</p>
        </div>

        <!-- Thông báo thành công và liên kết test nhanh -->
        @if (ViewBag.SuccessMessage != null)
        {
            <div class="alert alert-success border-0 rounded-3 p-3 text-start mb-3 shadow-sm" style="background-color: #ecfdf5; color: #047857;">
                <div class="d-flex align-items-center gap-2 mb-1">
                    <i class="bi bi-check-circle-fill fs-5"></i>
                    <strong>Yêu cầu thành công!</strong>
                </div>
                <p class="mb-2 small">@ViewBag.SuccessMessage</p>
                <div class="bg-white p-2 rounded-2 border">
                    <small class="text-muted d-block mb-1" style="font-size: 11px;">🔗 Liên kết đặt lại mật khẩu (Hiệu lực 15 phút):</small>
                    <a href="@ViewBag.ResetLink" class="btn btn-sm text-white w-100 py-1 text-decoration-none fw-semibold" style="background-color: #1d4ed8;">
                        <i class="bi bi-shield-lock me-1"></i>Đặt lại mật khẩu ngay
                    </a>
                </div>
            </div>
        }

        <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 px-3 rounded-3 mb-3 border-0 shadow-sm" role="alert" style="background-color: #fef2f2; color: #b91c1c;"></div>

        <!-- Form nhập Email -->
        <form asp-action="ForgotPassword" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3 text-start">
                <label asp-for="Email" class="form-label-custom">
                    Địa chỉ Email đăng ký <span class="text-danger">*</span>
                </label>
                <div class="custom-input-group">
                    <i class="bi bi-envelope-fill input-icon-start"></i>
                    <input asp-for="Email" class="form-control custom-input" placeholder="Nhập địa chỉ email của bạn..." autofocus autocomplete="email" />
                </div>
                <span asp-validation-for="Email" class="text-danger small mt-1 d-block fw-medium"></span>
            </div>

            <button type="submit" class="btn btn-submit-action mb-3">
                <i class="bi bi-send-fill"></i>
                <span>Gửi liên kết khôi phục</span>
            </button>

            <!-- Lối tắt quay lại -->
            <div class="text-center small text-muted mb-2">
                Đã nhớ mật khẩu? 
                <a asp-action="Login" class="text-decoration-none fw-bold" style="color: #2563eb;">
                    Đăng nhập ngay
                </a>
            </div>
            <div class="text-center">
                <a asp-controller="Home" asp-action="Index" class="text-secondary text-decoration-none small d-inline-flex align-items-center gap-1 hover-underline">
                    <i class="bi bi-arrow-left"></i> Quay lại Trang chủ
                </a>
            </div>
        </form>

        <!-- Chú thích chân card -->
        <div class="mt-4 pt-3 border-top text-center text-muted" style="font-size: 11.5px;">
            <i class="bi bi-info-circle text-primary me-1"></i>
            Hệ thống sẽ gửi mã xác thực bảo mật có hiệu lực trong 15 phút.
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.querySelector('form');
            if (form) {
                form.addEventListener('submit', function (e) {
                    const email = form.querySelector('input[name="Email"]');
                    if (email && !email.value.trim()) {
                        e.preventDefault();
                        email.classList.add('input-validation-error');
                        const err = form.querySelector('span[data-valmsg-for="Email"]');
                        if (err) {
                            err.textContent = 'Vui lòng nhập địa chỉ email';
                            err.style.display = 'block';
                            err.classList.remove('field-validation-valid');
                            err.classList.add('field-validation-error');
                        }
                        email.focus();
                    }
                });
            }
        });
    </script>
</body>
</html>
