@*
    Họ và tên: Trần Văn Thành
    Mã sinh viên: 23103100076
    Nội dung thực hiện: Module 1 - Giao diện Quên mật khẩu chuẩn theo nhận diện UNETI (Đồng bộ với Login & Register)
*@

@model HeThongQuanLyKhoaHocVaDangKy_3_UNETI3_TIN17A2HN.ViewModels.ForgotPasswordViewModel
@{
    Layout = null;
    ViewData["Title"] = "Quên mật khẩu";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UNETI Đào Tạo</title>
    
    <!-- Google Font: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap CSS & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Site CSS (Unified Design System) -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        body {
            min-height: 100vh;
            background-color: #dbeafe;
            background-image: url('/images/auth-bg.jpg');
            background-repeat: no-repeat;
            background-position: center center;
            background-size: cover;
            background-attachment: fixed;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 2rem 1.5rem;
            margin: 0;
            position: relative;
        }

        .forgot-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.9);
            border-radius: 20px;
            box-shadow: 0 20px 40px -10px rgba(15, 23, 42, 0.18), 0 8px 16px -4px rgba(0, 0, 0, 0.06);
            width: 100%;
            max-width: 440px;
            position: relative;
            z-index: 10;
        }
        .uneti-logo-badge {
            width: 52px;
            height: 52px;
            background: var(--uneti-primary);
            color: #ffffff;
            border-radius: 14px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 26px;
            box-shadow: 0 4px 14px rgba(29, 78, 216, 0.3);
        }
    </style>
</head>
<body>
    <div class="forgot-card p-4 p-md-5">
        <!-- Logo & Header -->
        <div class="text-center mb-4">
            <div class="uneti-logo-badge mb-3">
                <i class="bi bi-key-fill"></i>
            </div>
            <h4 class="fw-bold text-dark mb-1">QUÊN MẬT KHẨU</h4>
            <p class="text-muted small mb-0">Nhập email đã đăng ký để nhận liên kết đặt lại mật khẩu</p>
        </div>

        <!-- Thông báo thành công và liên kết test nhanh -->
        @if (ViewBag.SuccessMessage != null)
        {
            <div class="alert alert-success border-success-subtle rounded-3 p-3 text-start mb-3 shadow-sm">
                <div class="d-flex align-items-center gap-2 mb-1">
                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                    <strong class="text-success small">Yêu cầu thành công!</strong>
                </div>
                <p class="mb-2 text-dark small">@ViewBag.SuccessMessage</p>
                <div class="bg-white p-2 rounded-2 border">
                    <small class="text-muted d-block mb-1" style="font-size: 11px;">🔗 Liên kết đặt lại mật khẩu (Hiệu lực 15 phút):</small>
                    <a href="@ViewBag.ResetLink" class="btn btn-sm uneti-btn-primary w-100 py-1 text-decoration-none">
                        <i class="bi bi-shield-lock me-1"></i>Đặt lại mật khẩu ngay
                    </a>
                </div>
            </div>
        }

        <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 px-3 rounded-3 mb-3" role="alert"></div>

        <!-- Form nhập Email -->
        <form asp-action="ForgotPassword" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3 text-start">
                <label asp-for="Email" class="form-label fw-semibold small text-secondary">
                    Địa chỉ Email đăng ký <span class="text-danger">*</span>
                </label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-envelope"></i></span>
                    <input asp-for="Email" class="form-control border-start-0 ps-0" placeholder="Nhập địa chỉ email của bạn..." autofocus autocomplete="email" />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn uneti-btn-primary w-100 py-2 fw-bold mb-3 shadow-sm">
                <i class="bi bi-send me-1"></i>Gửi liên kết đặt lại mật khẩu
            </button>

            <!-- Lối tắt quay lại -->
            <div class="text-center small text-muted">
                Đã nhớ mật khẩu? 
                <a asp-action="Login" class="text-decoration-none fw-bold" style="color: var(--uneti-primary);">
                    Đăng nhập ngay
                </a>
                <div class="mt-2">
                    <a asp-controller="Home" asp-action="Index" class="text-secondary text-decoration-none small">
                        <i class="bi bi-arrow-left me-1"></i>Quay lại Trang chủ
                    </a>
                </div>
            </div>
        </form>

        <!-- Chú thích chân card -->
        <div class="mt-4 pt-3 border-top text-center text-muted" style="font-size: 11px;">
            <i class="bi bi-info-circle text-primary me-1"></i>
            Hệ thống sẽ gửi mã xác thực bảo mật có hiệu lực trong 15 phút.
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
