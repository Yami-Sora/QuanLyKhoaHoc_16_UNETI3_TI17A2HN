@*
    Họ và tên: Trần Văn Thành
    Mã sinh viên: 23103100076
    Nội dung: Quên mật khẩu
*@

@model HeThongQuanLyKhoaHocVaDangKy_3_UNETI3_TIN17A2HN.ViewModels.ForgotPasswordViewModel
@{
    Layout = null;
    ViewData["Title"] = "Quên mật khẩu";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <partial name="_Head" />
</head>
<body>
    <div class="forgot-card">
        <!-- Logo & Header -->
        <div class="text-center mb-4">
            <div class="uneti-logo-badge">
                <i class="bi bi-key-fill"></i>
            </div>
            <h1 class="header-title">QUÊN MẬT KHẨU</h1>
            <p class="header-subtitle mb-0">Nhập email đã đăng ký để nhận liên kết khôi phục mật khẩu</p>
        </div>

        <!-- Thông báo thành công và liên kết test nhanh -->
        @if (ViewBag.SuccessMessage != null)
        {
            <div class="alert alert-success border-0 rounded-3 p-3 text-start mb-3 shadow-sm" style="background-color: #ecfdf5; color: #047857;">
                <div class="d-flex align-items-center gap-2 mb-1">
                    <i class="bi bi-check-circle-fill fs-5"></i>
                    <strong>Yêu cầu thành công!</strong>
                </div>
                <p class="mb-2 small">@ViewBag.SuccessMessage</p>
                @if (ViewBag.DevResetLink != null)
                {
                    <div class="bg-white p-2 rounded-2 border mt-2">
                        <small class="text-muted d-block mb-1 uneti-fs-12">🔧 Môi trường phát triển (Kiểm thử nhanh):</small>
                        <a href="@ViewBag.DevResetLink" class="btn btn-sm text-white w-100 py-1 text-decoration-none fw-semibold" style="background-color: #1d4ed8;">
                            <i class="bi bi-shield-lock me-1"></i>Đặt lại mật khẩu thử nghiệm
                        </a>
                    </div>
                }
            </div>
        }

        <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 px-3 rounded-3 mb-3 border-0 shadow-sm" role="alert" style="background-color: #fef2f2; color: #b91c1c;"></div>

        <!-- Form nhập Email -->
        <form asp-action="ForgotPassword" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3 text-start">
                <label asp-for="Email" class="form-label-custom">
                    Địa chỉ Email đăng ký <span class="text-danger">*</span>
                </label>
                <div class="custom-input-group">
                    <i class="bi bi-envelope-fill input-icon-start"></i>
                    <input asp-for="Email" class="form-control custom-input" placeholder="Nhập địa chỉ email của bạn..." autofocus autocomplete="email" />
                </div>
                <span asp-validation-for="Email" class="text-danger small mt-1 d-block fw-medium"></span>
            </div>

            <button type="submit" class="btn btn-submit-action mb-3">
                <i class="bi bi-send-fill"></i>
                <span>Gửi liên kết khôi phục</span>
            </button>

            <!-- Lối tắt quay lại -->
            <div class="text-center small text-muted mb-2">
                Đã nhớ mật khẩu? 
                <a asp-action="Login" class="text-decoration-none fw-bold" style="color: #2563eb;">
                    Đăng nhập ngay
                </a>
            </div>
            <div class="text-center">
                <a asp-controller="Home" asp-action="Index" class="text-secondary text-decoration-none small d-inline-flex align-items-center gap-1 hover-underline">
                    <i class="bi bi-arrow-left"></i> Quay lại Trang chủ
                </a>
            </div>
        </form>

        <!-- Chú thích chân card -->
        <div class="mt-4 pt-3 border-top text-center text-muted uneti-fs-12">
            <i class="bi bi-info-circle text-primary me-1"></i>
            Hệ thống sẽ gửi mã xác thực bảo mật có hiệu lực trong 15 phút.
        </div>
    </div>

    <!-- Scripts -->
    <partial name="_Scripts" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.querySelector('form');
            if (form) {
                form.addEventListener('submit', function (e) {
                    const email = form.querySelector('input[name="Email"]');
                    if (email && !email.value.trim()) {
                        e.preventDefault();
                        email.classList.add('input-validation-error');
                        const err = form.querySelector('span[data-valmsg-for="Email"]');
                        if (err) {
                            err.textContent = 'Vui lòng nhập địa chỉ email';
                            err.style.display = 'block';
                            err.classList.remove('field-validation-valid');
                            err.classList.add('field-validation-error');
                        }
                        email.focus();
                    }
                });
            }
        });
    </script>
</body>
</html>
