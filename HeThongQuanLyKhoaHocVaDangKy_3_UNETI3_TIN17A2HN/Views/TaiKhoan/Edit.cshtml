@*
    Họ và tên: Trần Văn Thành
    Mã sinh viên: 23103100076
    Nội dung: Sửa tài khoản (Admin)
*@

@model HeThongQuanLyKhoaHocVaDangKy_3_UNETI3_TIN17A2HN.ViewModels.EditUserViewModel
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Chỉnh sửa tài khoản";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-9 col-lg-8">
            <div class="uneti-card overflow-hidden">
                <div class="card-header py-3 px-4 text-white" style="background-color: var(--uneti-primary);">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-pencil-square me-2"></i>CHỈNH SỬA TÀI KHOẢN: @Model.TenDangNhap
                    </h5>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Edit" asp-route-id="@Model.MaTaiKhoan" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="MaTaiKhoan" />
                        <input type="hidden" asp-for="TenDangNhap" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                        <!-- PHẦN 1: THÔNG TIN TÀI KHOẢN -->
                        <div class="mb-4">
                            <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">
                                <i class="bi bi-person-badge text-primary me-2"></i>1. Định danh tài khoản
                            </h6>
                            <div class="mb-3">
                                <label class="form-label fw-semibold small text-secondary">Tên đăng nhập (Cố định)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted"><i class="bi bi-lock-fill"></i></span>
                                    <input type="text" class="form-control bg-light fw-bold text-dark" value="@Model.TenDangNhap" readonly disabled />
                                </div>
                                <small class="text-muted">Tên đăng nhập không thể thay đổi sau khi khởi tạo nhằm bảo đảm toàn vẹn lịch sử đào tạo.</small>
                            </div>
                        </div>

                        <!-- PHẦN 2: THÔNG TIN HỒ SƠ & LIÊN HỆ -->
                        <div class="mb-4">
                            <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">
                                <i class="bi bi-person-lines-fill text-primary me-2"></i>2. Thông tin cá nhân &amp; Liên hệ
                            </h6>
                            <div class="mb-3">
                                <label asp-for="HoTen" class="form-label fw-semibold small text-secondary">
                                    Họ và tên <span class="text-danger">*</span>
                                </label>
                                <input asp-for="HoTen" class="form-control" placeholder="Họ và tên người dùng..." autocomplete="name" />
                                <span asp-validation-for="HoTen" class="text-danger small"></span>
                            </div>

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="Email" class="form-label fw-semibold small text-secondary">
                                        Địa chỉ Email <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="Email" type="email" class="form-control" placeholder="example@email.com" autocomplete="email" />
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="SoDienThoai" class="form-label fw-semibold small text-secondary">
                                        Số điện thoại
                                    </label>
                                    <input asp-for="SoDienThoai" class="form-control" placeholder="0912 345 678" autocomplete="tel" />
                                    <span asp-validation-for="SoDienThoai" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <!-- PHẦN 3: PHÂN QUYỀN & TRẠNG THÁI -->
                        <div class="mb-4">
                            <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">
                                <i class="bi bi-person-gear text-primary me-2"></i>3. Vai trò &amp; Trạng thái hệ thống
                            </h6>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="VaiTro" class="form-label fw-semibold small text-secondary">
                                        Vai trò phân quyền <span class="text-danger">*</span>
                                    </label>
                                    <select asp-for="VaiTro" class="form-select">
                                        <option value="Admin">Quản trị viên (Admin)</option>
                                        <option value="NhanVien">Nhân viên đào tạo</option>
                                        <option value="HocVien">Học viên</option>
                                    </select>
                                    <span asp-validation-for="VaiTro" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6 d-flex align-items-end">
                                    <div class="form-check form-switch pb-2">
                                        <input class="form-check-input" type="checkbox" asp-for="TrangThai" id="chkEditTrangThai" style="cursor: pointer; width: 40px; height: 20px;">
                                        <label class="form-check-label ms-2 small fw-semibold text-dark user-select-none" for="chkEditTrangThai" style="cursor: pointer;">
                                            Tài khoản đang hoạt động
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- NÚT HÀNH ĐỘNG -->
                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <a asp-action="QuanLy" class="btn btn-outline-secondary px-3">
                                <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách
                            </a>
                            <button type="submit" class="btn uneti-btn-primary px-4 shadow-sm">
                                <i class="bi bi-check-circle-fill me-1"></i>Lưu thay đổi
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
