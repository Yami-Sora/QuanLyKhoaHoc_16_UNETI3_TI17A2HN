@*
    Họ và tên: Trần Văn Thành
    Mã sinh viên: 23103100076
    Nội dung thực hiện: Module 1 - Giao diện Đổi mật khẩu tài khoản đồng bộ chuẩn nhận diện UNETI với Đăng nhập & Quên mật khẩu
*@
@model HeThongQuanLyKhoaHocVaDangKy_3_UNETI3_TIN17A2HN.ViewModels.ChangePasswordViewModel
@{
    Layout = null;
    ViewData["Title"] = "Đổi mật khẩu";
    var vaiTro = Context.Session.GetString("VaiTro");
    string backUrl = Url.Action("Index", "Home") ?? "/";
    string backText = "Quay lại Trang chủ";
    if (vaiTro == "Admin" || vaiTro == "NhanVien")
    {
        backUrl = Url.Action("Dashboard", "QuanTri") ?? "/QuanTri/Dashboard";
        backText = "Quay lại Bảng điều khiển";
    }
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cổng Đào Tạo Trực Tuyến</title>
    
    <!-- Google Font: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap CSS & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: #f1f5f9;
            background-image: 
                linear-gradient(135deg, rgba(239, 246, 255, 0.45) 0%, rgba(219, 234, 254, 0.55) 100%),
                url('/images/auth-bg.jpg');
            background-repeat: no-repeat;
            background-position: center center;
            background-size: cover;
            background-attachment: fixed;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 2.5rem 1rem;
            margin: 0;
            position: relative;
        }

        /* Glassmorphism Card đồng bộ hoàn hảo với Login */
        .change-card {
            background: rgba(255, 255, 255, 0.94);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.85);
            border-radius: 24px;
            box-shadow: 
                0 20px 40px -15px rgba(15, 23, 42, 0.16),
                0 0 0 1px rgba(255, 255, 255, 0.8) inset;
            width: 100%;
            max-width: 440px;
            padding: 2.5rem 2.25rem;
            position: relative;
            z-index: 10;
            transition: transform 0.25s ease, box-shadow 0.25s ease;
        }

        /* Logo Badge với gradient mềm mại */
        .uneti-logo-badge {
            width: 58px;
            height: 58px;
            background: linear-gradient(135deg, #1d4ed8 0%, #3b82f6 100%);
            color: #ffffff;
            border-radius: 18px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            box-shadow: 0 10px 22px -6px rgba(29, 78, 216, 0.38);
            border: 3px solid #ffffff;
            margin: 0 auto;
        }

        .header-title {
            color: #0f172a;
            font-size: 1.45rem;
            font-weight: 800;
            letter-spacing: -0.02em;
            margin-top: 0.75rem;
            margin-bottom: 0.25rem;
        }

        .header-subtitle {
            color: #64748b;
            font-size: 13.5px;
            font-weight: 500;
            line-height: 1.45;
        }

        /* Label gọn gàng, tinh tế */
        .form-label-custom {
            color: #334155;
            font-size: 13.5px;
            font-weight: 600;
            display: block;
            margin-bottom: 0.45rem;
        }

        /* Custom Input Container liền mạch, không bị đứt đoạn viền */
        .custom-input-group {
            position: relative;
            display: flex;
            align-items: center;
            width: 100%;
        }

        .custom-input-group .input-icon-start {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 1.15rem;
            pointer-events: none;
            z-index: 5;
            transition: color 0.2s ease;
        }

        .custom-input-group:focus-within .input-icon-start {
            color: #2563eb;
        }

        /* Ô nhập liệu thanh thoát, bo góc và viền nguyên khối */
        .custom-input-group .form-control.custom-input {
            width: 100%;
            height: 48px;
            padding-left: 46px;
            padding-right: 46px;
            border-radius: 12px;
            border: 1.5px solid #e2e8f0;
            background-color: #f8fafc;
            font-size: 14.5px;
            font-family: inherit;
            color: #1e293b;
            transition: all 0.2s ease-in-out;
        }

        .custom-input-group .form-control.custom-input::placeholder {
            color: #94a3b8;
            font-size: 14px;
            font-weight: 400;
        }

        .custom-input-group .form-control.custom-input:focus {
            background-color: #ffffff;
            border-color: #3b82f6;
            box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.12);
            color: #0f172a;
            outline: none;
        }

        .custom-input-group .form-control.custom-input.input-validation-error,
        .form-control.input-validation-error {
            border-color: #ef4444 !important;
            background-color: #fef2f2 !important;
        }

        .custom-input-group .form-control.custom-input.input-validation-error:focus,
        .form-control.input-validation-error:focus {
            box-shadow: 0 0 0 4px rgba(239, 68, 68, 0.12) !important;
            border-color: #ef4444 !important;
        }

        .field-validation-error {
            color: #ef4444;
            font-size: 12.5px;
            font-weight: 500;
            margin-top: 4px;
            display: block;
            line-height: 1.3;
        }

        .field-validation-valid {
            display: none !important;
        }

        /* Nút ẩn/hiện mật khẩu tinh chỉnh */
        .btn-toggle-eye {
            position: absolute;
            right: 10px;
            top: 50%;
            transform: translateY(-50%);
            background: transparent;
            border: none;
            padding: 6px 8px;
            color: #94a3b8;
            font-size: 1.15rem;
            cursor: pointer;
            z-index: 6;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            transition: all 0.2s ease;
        }

        .btn-toggle-eye:hover {
            color: #334155;
            background-color: #e2e8f0;
        }

        /* Nút Lưu Mật Khẩu Gradient cao cấp */
        .btn-submit-change {
            background: linear-gradient(135deg, #1d4ed8 0%, #2563eb 100%);
            color: #ffffff;
            border: none;
            border-radius: 12px;
            height: 48px;
            font-size: 15.5px;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            box-shadow: 0 8px 18px -4px rgba(29, 78, 216, 0.35);
            transition: all 0.2s ease;
            width: 100%;
            cursor: pointer;
        }

        .btn-submit-change:hover {
            background: linear-gradient(135deg, #1e40af 0%, #1d4ed8 100%);
            box-shadow: 0 10px 22px -4px rgba(29, 78, 216, 0.45);
            transform: translateY(-1px);
            color: #ffffff;
        }

        .btn-submit-change:active {
            transform: translateY(0);
        }

        .hover-underline:hover {
            text-decoration: underline !important;
        }
    </style>
</head>
<body>
    <div class="change-card">
        <!-- Logo & Header -->
        <div class="text-center mb-4">
            <div class="uneti-logo-badge">
                <i class="bi bi-shield-lock-fill"></i>
            </div>
            <h1 class="header-title">ĐỔI MẬT KHẨU</h1>
            <p class="header-subtitle mb-0">Cập nhật mật khẩu mới để bảo vệ an toàn cho tài khoản</p>
        </div>

        <!-- Thông báo phản hồi -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show small py-2 px-3 rounded-3 mb-3 border-0 shadow-sm" role="alert" style="background-color: #ecfdf5; color: #047857;">
                <i class="bi bi-check-circle-fill me-1"></i>@TempData["SuccessMessage"]
                <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 px-3 rounded-3 mb-3 border-0 shadow-sm" role="alert" style="background-color: #fef2f2; color: #b91c1c;"></div>

        <!-- Form Đổi mật khẩu -->
        <form asp-action="ChangePassword" method="post" id="changePasswordForm">
            @Html.AntiForgeryToken()

            <!-- Mật khẩu hiện tại -->
            <div class="mb-3">
                <label asp-for="MatKhauHienTai" class="form-label-custom">
                    Mật khẩu hiện tại <span class="text-danger">*</span>
                </label>
                <div class="custom-input-group">
                    <i class="bi bi-lock-fill input-icon-start"></i>
                    <input asp-for="MatKhauHienTai" type="password" id="inputCurrentPwd" class="form-control custom-input" placeholder="Nhập mật khẩu hiện tại..." autofocus autocomplete="current-password" />
                    <button type="button" class="btn-toggle-eye" onclick="togglePasswordVisibility('inputCurrentPwd', 'iconEyeCurrent')" title="Hiện / Ẩn mật khẩu" aria-label="Hiện / Ẩn mật khẩu" tabindex="-1">
                        <i class="bi bi-eye" id="iconEyeCurrent"></i>
                    </button>
                </div>
                <span asp-validation-for="MatKhauHienTai" class="text-danger small mt-1 d-block fw-medium"></span>
            </div>

            <!-- Mật khẩu mới -->
            <div class="mb-3">
                <label asp-for="MatKhauMoi" class="form-label-custom">
                    Mật khẩu mới <span class="text-danger">*</span>
                </label>
                <div class="custom-input-group">
                    <i class="bi bi-shield-lock-fill input-icon-start"></i>
                    <input asp-for="MatKhauMoi" type="password" id="inputNewPwd" class="form-control custom-input" placeholder="Tối thiểu 6 ký tự..." autocomplete="new-password" />
                    <button type="button" class="btn-toggle-eye" onclick="togglePasswordVisibility('inputNewPwd', 'iconEyeNew')" title="Hiện / Ẩn mật khẩu" aria-label="Hiện / Ẩn mật khẩu" tabindex="-1">
                        <i class="bi bi-eye" id="iconEyeNew"></i>
                    </button>
                </div>
                <span asp-validation-for="MatKhauMoi" class="text-danger small mt-1 d-block fw-medium"></span>
            </div>

            <!-- Xác nhận mật khẩu mới -->
            <div class="mb-4">
                <label asp-for="XacNhanMatKhauMoi" class="form-label-custom">
                    Xác nhận mật khẩu mới <span class="text-danger">*</span>
                </label>
                <div class="custom-input-group">
                    <i class="bi bi-shield-check input-icon-start"></i>
                    <input asp-for="XacNhanMatKhauMoi" type="password" id="inputConfirmPwd" class="form-control custom-input" placeholder="Nhập lại mật khẩu mới..." autocomplete="new-password" />
                    <button type="button" class="btn-toggle-eye" onclick="togglePasswordVisibility('inputConfirmPwd', 'iconEyeConfirm')" title="Hiện / Ẩn mật khẩu" aria-label="Hiện / Ẩn mật khẩu" tabindex="-1">
                        <i class="bi bi-eye" id="iconEyeConfirm"></i>
                    </button>
                </div>
                <span asp-validation-for="XacNhanMatKhauMoi" class="text-danger small mt-1 d-block fw-medium"></span>
            </div>

            <!-- Nút Lưu Mật Khẩu Gradient -->
            <button type="submit" class="btn btn-submit-change mb-3">
                <i class="bi bi-check2-circle"></i>
                <span>Lưu mật khẩu mới</span>
            </button>

            <!-- Lối tắt quay lại -->
            <div class="text-center">
                <a href="@backUrl" class="text-secondary text-decoration-none small d-inline-flex align-items-center gap-1 hover-underline">
                    <i class="bi bi-arrow-left"></i> @backText
                </a>
            </div>
        </form>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        function togglePasswordVisibility(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (!input || !icon) return;

            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
            }
        }
    </script>
</body>
</html>
