@*
    Họ và tên: Trần Văn Thành
    Mã sinh viên: 23103100076
    Nội dung thực hiện: Module 1 - Giao diện Đổi mật khẩu cá nhân
*@

@model HeThongQuanLyKhoaHocVaDangKy_3_UNETI3_TIN17A2HN.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                <div class="card-header bg-warning text-dark text-center py-4">
                    <h4 class="fw-bold mb-1"><i class="bi bi-key-fill me-2"></i>ĐỔI MẬT KHẨU</h4>
                    <p class="small text-muted mb-0">Cập nhật mật khẩu mới để bảo vệ tài khoản của bạn</p>
                </div>

                <div class="card-body p-4 p-md-5">
                    <form asp-action="ChangePassword" method="post" novalidate>
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="MatKhauHienTai" class="form-label fw-semibold">Mật khẩu hiện tại <span class="text-danger">*</span></label>
                            <input asp-for="MatKhauHienTai" type="password" class="form-control" placeholder="Nhập mật khẩu đang dùng..." autofocus />
                            <span asp-validation-for="MatKhauHienTai" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MatKhauMoi" class="form-label fw-semibold">Mật khẩu mới <span class="text-danger">*</span></label>
                            <input asp-for="MatKhauMoi" type="password" class="form-control" placeholder="Tối thiểu 6 ký tự..." />
                            <span asp-validation-for="MatKhauMoi" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="XacNhanMatKhauMoi" class="form-label fw-semibold">Xác nhận mật khẩu mới <span class="text-danger">*</span></label>
                            <input asp-for="XacNhanMatKhauMoi" type="password" class="form-control" placeholder="Nhập lại mật khẩu mới..." />
                            <span asp-validation-for="XacNhanMatKhauMoi" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-warning text-dark btn-lg fw-bold shadow-sm">
                                <i class="bi bi-shield-check me-2"></i>Cập nhật mật khẩu
                            </button>
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                                Hủy bỏ
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
