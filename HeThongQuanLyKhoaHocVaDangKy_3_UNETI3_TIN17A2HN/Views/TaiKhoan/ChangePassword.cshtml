@*
    Họ và tên: Trần Văn Thành
    Mã sinh viên: 23103100076
    Nội dung thực hiện: Module 1 - Giao diện Đổi mật khẩu tài khoản (Đồng bộ nhận diện UNETI)
*@
@model HeThongQuanLyKhoaHocVaDangKy_3_UNETI3_TIN17A2HN.ViewModels.ChangePasswordViewModel
@{
    Layout = null;
    ViewData["Title"] = "Đổi mật khẩu";
    var vaiTro = Context.Session.GetString("VaiTro");
    string backUrl = Url.Action("Index", "Home") ?? "/";
    string backText = "Quay lại Trang chủ";
    if (vaiTro == "Admin" || vaiTro == "NhanVien")
    {
        backUrl = Url.Action("Index", "MonHoc") ?? "/MonHoc";
        backText = "Quay lại Quản lý môn học";
    }
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UNETI Đào Tạo</title>
    
    <!-- Google Font: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap CSS & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Site CSS (Unified Design System) -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        body {
            min-height: 100vh;
            background-color: #dbeafe;
            background-image: url('/images/auth-bg.jpg');
            background-repeat: no-repeat;
            background-position: center center;
            background-size: cover;
            background-attachment: fixed;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 2rem 1.5rem;
            margin: 0;
            position: relative;
        }

        .change-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.9);
            border-radius: 20px;
            box-shadow: 0 20px 40px -10px rgba(15, 23, 42, 0.18), 0 8px 16px -4px rgba(0, 0, 0, 0.06);
            width: 100%;
            max-width: 460px;
            position: relative;
            z-index: 10;
        }
        .uneti-logo-badge {
            width: 52px;
            height: 52px;
            background: var(--uneti-primary);
            color: #ffffff;
            border-radius: 14px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 26px;
            box-shadow: 0 4px 14px rgba(29, 78, 216, 0.3);
        }
    </style>
</head>
<body>
    <div class="change-card p-4 p-md-5">
        <!-- Logo & Header -->
        <div class="text-center mb-4">
            <div class="uneti-logo-badge mb-3">
                <i class="bi bi-shield-lock-fill"></i>
            </div>
            <h4 class="fw-bold text-dark mb-1">ĐỔI MẬT KHẨU</h4>
            <p class="text-muted small mb-0">Cập nhật mật khẩu mới để bảo vệ an toàn cho tài khoản</p>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show small py-2 px-3 rounded-3 mb-3" role="alert">
                <i class="bi bi-check-circle-fill me-1"></i>@TempData["SuccessMessage"]
                <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 px-3 rounded-3 mb-3" role="alert"></div>

        <!-- Form Đổi mật khẩu -->
        <form asp-action="ChangePassword" method="post">
            @Html.AntiForgeryToken()

            <!-- Mật khẩu hiện tại -->
            <div class="mb-3 text-start">
                <label asp-for="MatKhauHienTai" class="form-label fw-semibold small text-secondary">
                    Mật khẩu hiện tại <span class="text-danger">*</span>
                </label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-lock"></i></span>
                    <input asp-for="MatKhauHienTai" type="password" id="inputCurrentPwd" class="form-control border-start-0 border-end-0 ps-0" placeholder="Nhập mật khẩu hiện tại..." autofocus />
                    <button class="btn btn-outline-secondary border-start-0 bg-light" type="button" onclick="togglePasswordVisibility('inputCurrentPwd', 'iconEyeCurrent')">
                        <i class="bi bi-eye" id="iconEyeCurrent"></i>
                    </button>
                </div>
                <span asp-validation-for="MatKhauHienTai" class="text-danger small"></span>
            </div>

            <!-- Mật khẩu mới -->
            <div class="mb-3 text-start">
                <label asp-for="MatKhauMoi" class="form-label fw-semibold small text-secondary">
                    Mật khẩu mới <span class="text-danger">*</span>
                </label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-shield-lock"></i></span>
                    <input asp-for="MatKhauMoi" type="password" id="inputNewPwd" class="form-control border-start-0 border-end-0 ps-0" placeholder="Tối thiểu 6 ký tự..." />
                    <button class="btn btn-outline-secondary border-start-0 bg-light" type="button" onclick="togglePasswordVisibility('inputNewPwd', 'iconEyeNew')">
                        <i class="bi bi-eye" id="iconEyeNew"></i>
                    </button>
                </div>
                <span asp-validation-for="MatKhauMoi" class="text-danger small"></span>
            </div>

            <!-- Xác nhận mật khẩu mới -->
            <div class="mb-3 text-start">
                <label asp-for="XacNhanMatKhauMoi" class="form-label fw-semibold small text-secondary">
                    Xác nhận mật khẩu mới <span class="text-danger">*</span>
                </label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-shield-check"></i></span>
                    <input asp-for="XacNhanMatKhauMoi" type="password" id="inputConfirmPwd" class="form-control border-start-0 border-end-0 ps-0" placeholder="Nhập lại mật khẩu mới..." />
                    <button class="btn btn-outline-secondary border-start-0 bg-light" type="button" onclick="togglePasswordVisibility('inputConfirmPwd', 'iconEyeConfirm')">
                        <i class="bi bi-eye" id="iconEyeConfirm"></i>
                    </button>
                </div>
                <span asp-validation-for="XacNhanMatKhauMoi" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn uneti-btn-primary w-100 py-2 fw-bold mb-3 shadow-sm">
                <i class="bi bi-check2-circle me-1"></i>Lưu mật khẩu mới
            </button>

            <!-- Lối tắt quay lại -->
            <div class="text-center small text-muted">
                <a href="@backUrl" class="text-secondary text-decoration-none small">
                    <i class="bi bi-arrow-left me-1"></i>@backText
                </a>
            </div>
        </form>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function togglePasswordVisibility(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (!input || !icon) return;

            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
            }
        }
    </script>
</body>
</html>
