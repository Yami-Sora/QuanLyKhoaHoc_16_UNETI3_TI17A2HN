@*
    Họ và tên: Trần Văn Thành
    Mã sinh viên: 23103100076
    Nội dung: Đổi mật khẩu
*@
@model HeThongQuanLyKhoaHocVaDangKy_3_UNETI3_TIN17A2HN.ViewModels.ChangePasswordViewModel
@{
    Layout = null;
    ViewData["Title"] = "Đổi mật khẩu";
    var vaiTro = Context.Session.GetString("VaiTro");
    string backUrl = Url.Action("Index", "Home") ?? "/";
    string backText = "Quay lại Trang chủ";
    if (vaiTro == "Admin" || vaiTro == "NhanVien")
    {
        backUrl = Url.Action("Dashboard", "QuanTri") ?? "/QuanTri/Dashboard";
        backText = "Quay lại Bảng điều khiển";
    }
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <partial name="_Head" />
</head>
<body>
    <div class="change-card">
        <!-- Logo & Header -->
        <div class="text-center mb-4">
            <div class="uneti-logo-badge">
                <i class="bi bi-shield-lock-fill"></i>
            </div>
            <h1 class="header-title">ĐỔI MẬT KHẨU</h1>
            <p class="header-subtitle mb-0">Cập nhật mật khẩu mới để bảo vệ an toàn cho tài khoản</p>
        </div>

        <!-- Thông báo phản hồi -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show small py-2 px-3 rounded-3 mb-3 border-0 shadow-sm" role="alert" style="background-color: #ecfdf5; color: #047857;">
                <i class="bi bi-check-circle-fill me-1"></i>@TempData["SuccessMessage"]
                <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 px-3 rounded-3 mb-3 border-0 shadow-sm" role="alert" style="background-color: #fef2f2; color: #b91c1c;"></div>

        <!-- Form Đổi mật khẩu -->
        <form asp-action="ChangePassword" method="post" id="changePasswordForm">
            @Html.AntiForgeryToken()

            <!-- Mật khẩu hiện tại -->
            <div class="mb-3">
                <label asp-for="MatKhauHienTai" class="form-label-custom">
                    Mật khẩu hiện tại <span class="text-danger">*</span>
                </label>
                <div class="custom-input-group">
                    <i class="bi bi-lock-fill input-icon-start"></i>
                    <input asp-for="MatKhauHienTai" type="password" id="inputCurrentPwd" class="form-control custom-input" placeholder="Nhập mật khẩu hiện tại..." autofocus autocomplete="current-password" />
                    <button type="button" class="btn-toggle-eye" onclick="togglePasswordVisibility('inputCurrentPwd', 'iconEyeCurrent')" title="Hiện / Ẩn mật khẩu" aria-label="Hiện / Ẩn mật khẩu" tabindex="-1">
                        <i class="bi bi-eye" id="iconEyeCurrent"></i>
                    </button>
                </div>
                <span asp-validation-for="MatKhauHienTai" class="text-danger small mt-1 d-block fw-medium"></span>
            </div>

            <!-- Mật khẩu mới -->
            <div class="mb-3">
                <label asp-for="MatKhauMoi" class="form-label-custom">
                    Mật khẩu mới <span class="text-danger">*</span>
                </label>
                <div class="custom-input-group">
                    <i class="bi bi-shield-lock-fill input-icon-start"></i>
                    <input asp-for="MatKhauMoi" type="password" id="inputNewPwd" class="form-control custom-input" placeholder="Tối thiểu 6 ký tự..." autocomplete="new-password" oninput="checkPasswordStrength(this.value)" />
                    <button type="button" class="btn-toggle-eye" onclick="togglePasswordVisibility('inputNewPwd', 'iconEyeNew', this)" title="Hiện / Ẩn mật khẩu" aria-label="Hiện / Ẩn mật khẩu" aria-pressed="false" tabindex="-1">
                        <i class="bi bi-eye" id="iconEyeNew"></i>
                    </button>
                </div>
                <!-- Thanh đo độ mạnh mật khẩu (Gợi ý UX) -->
                <div class="password-strength-bar mt-1.5">
                    <div id="pwdStrengthBar" class="password-strength-progress"></div>
                </div>
                <div class="d-flex justify-content-between align-items-center mt-1">
                    <small id="pwdStrengthText" class="text-muted uneti-fs-12">Độ mạnh: Chưa nhập</small>
                </div>
                <span asp-validation-for="MatKhauMoi" class="text-danger small mt-1 d-block fw-medium"></span>
            </div>

            <!-- Xác nhận mật khẩu mới -->
            <div class="mb-4">
                <label asp-for="XacNhanMatKhauMoi" class="form-label-custom">
                    Xác nhận mật khẩu mới <span class="text-danger">*</span>
                </label>
                <div class="custom-input-group">
                    <i class="bi bi-shield-check input-icon-start"></i>
                    <input asp-for="XacNhanMatKhauMoi" type="password" id="inputConfirmPwd" class="form-control custom-input" placeholder="Nhập lại mật khẩu mới..." autocomplete="new-password" />
                    <button type="button" class="btn-toggle-eye" onclick="togglePasswordVisibility('inputConfirmPwd', 'iconEyeConfirm', this)" title="Hiện / Ẩn mật khẩu" aria-label="Hiện / Ẩn mật khẩu" aria-pressed="false" tabindex="-1">
                        <i class="bi bi-eye" id="iconEyeConfirm"></i>
                    </button>
                </div>
                <span asp-validation-for="XacNhanMatKhauMoi" class="text-danger small mt-1 d-block fw-medium"></span>
            </div>

            <!-- Nút Lưu Mật Khẩu Gradient -->
            <button type="submit" class="btn btn-submit-change mb-3">
                <i class="bi bi-check2-circle"></i>
                <span>Lưu mật khẩu mới</span>
            </button>

            <!-- Lối tắt quay lại -->
            <div class="text-center">
                <a href="@backUrl" class="text-secondary text-decoration-none small d-inline-flex align-items-center gap-1 hover-underline">
                    <i class="bi bi-arrow-left"></i> @backText
                </a>
            </div>
        </form>
    </div>

    <!-- Scripts -->
    <partial name="_Scripts" />
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script>
        function checkPasswordStrength(val) {
            const bar = document.getElementById('pwdStrengthBar');
            const txt = document.getElementById('pwdStrengthText');
            if (!bar || !txt) return;

            if (!val || val.length === 0) {
                bar.style.width = '0%';
                bar.style.backgroundColor = '#e2e8f0';
                txt.textContent = 'Độ mạnh: Chưa nhập';
                txt.className = 'text-muted';
                return;
            }

            let score = 0;
            if (val.length >= 6) score++;
            if (val.length >= 8) score++;
            if (/[A-Z]/.test(val) && /[a-z]/.test(val)) score++;
            if (/[0-9]/.test(val)) score++;
            if (/[^A-Za-z0-9]/.test(val)) score++;

            if (score <= 1) {
                bar.style.width = '25%';
                bar.style.backgroundColor = '#ef4444';
                txt.textContent = 'Độ mạnh: Yếu';
                txt.className = 'text-danger fw-semibold';
            } else if (score === 2) {
                bar.style.width = '50%';
                bar.style.backgroundColor = '#f59e0b';
                txt.textContent = 'Độ mạnh: Trung bình';
                txt.className = 'text-warning fw-semibold';
            } else if (score === 3 || score === 4) {
                bar.style.width = '75%';
                bar.style.backgroundColor = '#3b82f6';
                txt.textContent = 'Độ mạnh: Khá an toàn';
                txt.className = 'text-primary fw-semibold';
            } else {
                bar.style.width = '100%';
                bar.style.backgroundColor = '#10b981';
                txt.textContent = 'Độ mạnh: Rất mạnh (Tối ưu)';
                txt.className = 'text-success fw-semibold';
            }
        }

        function togglePasswordVisibility(inputId, iconId, btn) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (!input || !icon) return;

            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
                if (btn) btn.setAttribute('aria-pressed', 'true');
            } else {
                input.type = 'password';
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
                if (btn) btn.setAttribute('aria-pressed', 'false');
            }
        }

        $(function () {
            @if (!ViewData.ModelState.IsValid)
            {
                <text>
                const card = document.querySelector('.change-card');
                if (card) {
                    card.classList.add('fx-shake');
                    setTimeout(() => card.classList.remove('fx-shake'), 450);
                }
                if (window.UnetiUI && typeof window.UnetiUI.toast === 'function') {
                    window.UnetiUI.toast({
                        type: 'danger',
                        title: 'Đổi mật khẩu thất bại',
                        message: 'Vui lòng kiểm tra lại mật khẩu hiện tại và các trường mật khẩu mới.'
                    });
                }
                </text>
            }
        });
    </script>
</body>
</html>
