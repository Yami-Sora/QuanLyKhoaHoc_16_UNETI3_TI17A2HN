@*
    Họ và tên: Trần Văn Thành
    Mã sinh viên: 23103100076
    Nội dung: Module 1 - Chỉnh sửa thông tin giảng viên
*@

@model HeThongQuanLyKhoaHocVaDangKy_3_UNETI3_TIN17A2HN.Models.GiangVien
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Chỉnh sửa giảng viên";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-9 col-lg-8">
            <div class="uneti-card overflow-hidden">
                <div class="card-header py-3 px-4 text-white" style="background-color: var(--uneti-primary);">
                    <h5 class="fw-bold mb-0"><i class="bi bi-pencil-square me-2"></i>CHỈNH SỬA GIẢNG VIÊN <span class="badge bg-white text-primary ms-2">@($"#GV{Model.MaGiangVien:D3}")</span></h5>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="MaGiangVien" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                        <!-- PHẦN 1: THÔNG TIN CÁ NHÂN -->
                        <div class="mb-4">
                            <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">
                                <i class="bi bi-person-fill text-primary me-2"></i>1. Thông tin cá nhân
                            </h6>
                            <div class="mb-3">
                                <label asp-for="HoTen" class="form-label fw-semibold small text-secondary">Họ và tên <span class="text-danger">*</span></label>
                                <input asp-for="HoTen" class="form-control" />
                                <span asp-validation-for="HoTen" class="text-danger small"></span>
                            </div>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="Email" class="form-label fw-semibold small text-secondary">Email <span class="text-danger">*</span></label>
                                    <input asp-for="Email" type="email" class="form-control" />
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="SoDienThoai" class="form-label fw-semibold small text-secondary">Số điện thoại <span class="text-danger">*</span></label>
                                    <input asp-for="SoDienThoai" class="form-control" />
                                    <span asp-validation-for="SoDienThoai" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="mt-3">
                                <label class="form-label fw-semibold small text-secondary">Giới tính</label>
                                <div class="d-flex gap-4">
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" asp-for="GioiTinh" value="Nam" id="gioiTinhNam" />
                                        <label class="form-check-label" for="gioiTinhNam"><i class="bi bi-gender-male me-1 text-primary"></i>Nam</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" asp-for="GioiTinh" value="Nữ" id="gioiTinhNu" />
                                        <label class="form-check-label" for="gioiTinhNu"><i class="bi bi-gender-female me-1 text-danger"></i>Nữ</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- PHẦN 2: CHUYÊN MÔN & CÔNG TÁC -->
                        <div class="mb-4">
                            <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">
                                <i class="bi bi-mortarboard-fill text-primary me-2"></i>2. Chuyên môn &amp; Trạng thái công tác
                            </h6>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="HocVi" class="form-label fw-semibold small text-secondary">Học vị</label>
                                    <select asp-for="HocVi" class="form-select">
                                        <option value="">-- Chọn học vị --</option>
                                        <option>Cử nhân</option>
                                        <option>Thạc sĩ</option>
                                        <option>Tiến sĩ</option>
                                        <option>Phó giáo sư</option>
                                        <option>Giáo sư</option>
                                    </select>
                                    <span asp-validation-for="HocVi" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="TrangThai" class="form-label fw-semibold small text-secondary">Trạng thái công tác</label>
                                    <select asp-for="TrangThai" class="form-select">
                                        <option value="true">Đang giảng dạy</option>
                                        <option value="false">Tạm nghỉ</option>
                                    </select>
                                </div>
                            </div>
                            <div class="mt-3">
                                <label asp-for="ChuyenMon" class="form-label fw-semibold small text-secondary">Chuyên môn</label>
                                <input asp-for="ChuyenMon" class="form-control" />
                                <span asp-validation-for="ChuyenMon" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between pt-3 border-top">
                            <a asp-action="Index" class="btn uneti-btn-outline text-decoration-none">
                                <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách
                            </a>
                            <button type="submit" class="btn uneti-btn-primary fw-bold px-4 shadow-sm" data-loading-text="Đang cập nhật...">
                                <i class="bi bi-save me-1"></i>Lưu thay đổi
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
