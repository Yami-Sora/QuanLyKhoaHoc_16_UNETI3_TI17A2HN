@section Scripts {
    <script>
        (function () {
            // 0. Quản lý Modal Xóa giảng viên (Popup trực tiếp)
            const deleteGvModalEl = document.getElementById('modalDeleteGiangVien');
            const deleteGvModal = deleteGvModalEl ? new bootstrap.Modal(deleteGvModalEl) : null;
            const formDeleteGv = document.getElementById('formDeleteGiangVien');
            const deleteGvId = document.getElementById('deleteGvId');
            const deleteGvCardCode = document.getElementById('deleteGvCardCode');
            const deleteGvCardFullName = document.getElementById('deleteGvCardFullName');
            const deleteGvCardHocVi = document.getElementById('deleteGvCardHocVi');
            const deleteGvCardEmail = document.getElementById('deleteGvCardEmail');
            const deleteGvCardPhone = document.getElementById('deleteGvCardPhone');
            const deleteGvCardStatus = document.getElementById('deleteGvCardStatus');
            const deleteGvBlockWarning = document.getElementById('deleteGvBlockWarning');
            const deleteGvConfirmAlert = document.getElementById('deleteGvConfirmAlert');
            const deleteGvSoKhoaHoc = document.getElementById('deleteGvSoKhoaHoc');
            const btnSubmitDeleteGv = document.getElementById('btnSubmitDeleteGv');
            const btnBlockDeleteGv = document.getElementById('btnBlockDeleteGv');
            const deleteGvAlertError = document.getElementById('deleteGvAlertError');

            document.addEventListener('click', function (e) {
                const btnDelete = e.target.closest('.js-open-delete-gv-modal');
                if (!btnDelete) return;
                e.preventDefault();

                const id = btnDelete.getAttribute('data-id');
                const code = btnDelete.getAttribute('data-code') || ('#GV' + id);
                const hoten = btnDelete.getAttribute('data-hoten') || '';
                const email = btnDelete.getAttribute('data-email') || '';
                const sdt = btnDelete.getAttribute('data-sdt') || '';
                const hocvi = btnDelete.getAttribute('data-hocvi') || '—';
                const status = btnDelete.getAttribute('data-status') || '';
                const hasKhoaHoc = btnDelete.getAttribute('data-has-khoahoc') === 'true';
                const countKhoaHoc = parseInt(btnDelete.getAttribute('data-khoahoc-count')) || 0;

                if (formDeleteGv) formDeleteGv.action = '/GiangVien/Delete/' + id;
                if (deleteGvId) deleteGvId.value = id;
                if (deleteGvCardCode) deleteGvCardCode.textContent = code;
                if (deleteGvCardFullName) deleteGvCardFullName.textContent = hoten;
                if (deleteGvCardHocVi) deleteGvCardHocVi.textContent = hocvi;
                if (deleteGvCardEmail) deleteGvCardEmail.textContent = email;
                if (deleteGvCardPhone) deleteGvCardPhone.textContent = sdt;
                if (deleteGvCardStatus) deleteGvCardStatus.textContent = status;
                if (deleteGvAlertError) deleteGvAlertError.classList.add('d-none');

                if (hasKhoaHoc || countKhoaHoc > 0) {
                    if (deleteGvBlockWarning) deleteGvBlockWarning.classList.remove('d-none');
                    if (deleteGvConfirmAlert) deleteGvConfirmAlert.classList.add('d-none');
                    if (deleteGvSoKhoaHoc) deleteGvSoKhoaHoc.textContent = countKhoaHoc;
                    if (btnSubmitDeleteGv) btnSubmitDeleteGv.classList.add('d-none');
                    if (btnBlockDeleteGv) btnBlockDeleteGv.classList.remove('d-none');
                } else {
                    if (deleteGvBlockWarning) deleteGvBlockWarning.classList.add('d-none');
                    if (deleteGvConfirmAlert) deleteGvConfirmAlert.classList.remove('d-none');
                    if (btnSubmitDeleteGv) btnSubmitDeleteGv.classList.remove('d-none');
                    if (btnBlockDeleteGv) btnBlockDeleteGv.classList.add('d-none');
                }

                if (deleteGvModal) deleteGvModal.show();
            });

            if (formDeleteGv) {
                formDeleteGv.addEventListener('submit', async function (e) {
                    e.preventDefault();

                    const origBtnHtml = btnSubmitDeleteGv ? btnSubmitDeleteGv.innerHTML : '';
                    if (btnSubmitDeleteGv) {
                        btnSubmitDeleteGv.disabled = true;
                        btnSubmitDeleteGv.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span><span>Đang xóa...</span>';
                    }

                    try {
                        const formData = new FormData(formDeleteGv);
                        const response = await fetch(formDeleteGv.action, {
                            method: 'POST',
                            body: formData,
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest'
                            }
                        });

                        if (response.redirected) {
                            window.location.href = response.url;
                            return;
                        }

                        const result = await response.json();
                        if (result && result.success) {
                            if (deleteGvModal) deleteGvModal.hide();
                            if (window.UnetiUI && typeof window.UnetiUI.toast === 'function') {
                                window.UnetiUI.toast({
                                    type: 'success',
                                    title: 'Đã xóa giảng viên',
                                    message: result.message || 'Xóa giảng viên thành công!'
                                });
                            }
                            setTimeout(function () {
                                window.location.reload();
                            }, 400);
                        } else {
                            if (deleteGvAlertError) {
                                document.getElementById('deleteGvAlertErrorText').textContent = result.message || 'Không thể xóa giảng viên này.';
                                deleteGvAlertError.classList.remove('d-none');
                            }
                        }
                    } catch (err) {
                        formDeleteGv.submit();
                    } finally {
                        if (btnSubmitDeleteGv) {
                            btnSubmitDeleteGv.disabled = false;
                            btnSubmitDeleteGv.innerHTML = origBtnHtml;
                        }
                    }
                });
            }

            // 1. Quản lý Modal Thêm mới giảng viên (Popup trực tiếp)
            const createGvModalEl = document.getElementById('modalCreateGiangVien');
            const createGvModal = createGvModalEl ? new bootstrap.Modal(createGvModalEl) : null;
            const formCreateGv = document.getElementById('formCreateGiangVien');

            const btnOpenCreate = document.getElementById('btnOpenCreateGvModal');
            const btnSubmitCreate = document.getElementById('btnSubmitCreateGv');
            const createHoTenInput = document.getElementById('createGvHoTen');
            const createEmailInput = document.getElementById('createGvEmail');
            const createSdtInput = document.getElementById('createGvSoDienThoai');
            const createHocViSelect = document.getElementById('createGvHocVi');
            const createTrangThaiSelect = document.getElementById('createGvTrangThai');
            const createChuyenMonInput = document.getElementById('createGvChuyenMon');
            const createRadioNam = document.getElementById('createGvGioiTinhNam');

            function showCreateGvError(msg) {
                const alertBox = document.getElementById('createGvAlertError');
                const alertText = document.getElementById('createGvAlertErrorText');
                if (alertBox && alertText) {
                    alertText.textContent = msg;
                    alertBox.classList.remove('d-none');
                } else {
                    alert(msg);
                }
            }

            btnOpenCreate?.addEventListener('click', function (e) {
                e.preventDefault();
                if (formCreateGv) formCreateGv.reset();
                if (createRadioNam) createRadioNam.checked = true;
                if (createTrangThaiSelect) createTrangThaiSelect.value = 'true';
                document.getElementById('createGvAlertError')?.classList.add('d-none');
                ['valCreateErrorHoTen', 'valCreateErrorEmail', 'valCreateErrorSoDienThoai'].forEach(function(eid) {
                    const el = document.getElementById(eid);
                    if (el) el.textContent = '';
                });
                if (createGvModal) createGvModal.show();
            });

            if (formCreateGv) {
                formCreateGv.addEventListener('submit', async function (e) {
                    e.preventDefault();

                    const hoTenVal = createHoTenInput ? createHoTenInput.value.trim() : '';
                    const emailVal = createEmailInput ? createEmailInput.value.trim() : '';
                    const sdtVal = createSdtInput ? createSdtInput.value.trim() : '';

                    const errHoTen = document.getElementById('valCreateErrorHoTen');
                    const errEmail = document.getElementById('valCreateErrorEmail');
                    const errSdt = document.getElementById('valCreateErrorSoDienThoai');

                    if (errHoTen) errHoTen.textContent = '';
                    if (errEmail) errEmail.textContent = '';
                    if (errSdt) errSdt.textContent = '';
                    document.getElementById('createGvAlertError')?.classList.add('d-none');

                    if (!hoTenVal || hoTenVal.length < 2) {
                        showCreateGvError('Họ và tên giảng viên không được để trống và phải từ 2 ký tự trở lên.');
                        createHoTenInput?.focus();
                        return;
                    }

                    const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
                    if (!emailVal || !emailRegex.test(emailVal)) {
                        showCreateGvError('Địa chỉ email không đúng định dạng.');
                        createEmailInput?.focus();
                        return;
                    }

                    if (!sdtVal) {
                        showCreateGvError('Số điện thoại giảng viên không được để trống.');
                        createSdtInput?.focus();
                        return;
                    }

                    const origHtml = btnSubmitCreate ? btnSubmitCreate.innerHTML : '';
                    if (btnSubmitCreate) {
                        btnSubmitCreate.disabled = true;
                        btnSubmitCreate.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span><span>Đang lưu...</span>';
                    }

                    try {
                        const formData = new FormData(formCreateGv);
                        const response = await fetch(formCreateGv.action, {
                            method: 'POST',
                            body: formData,
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest'
                            }
                        });

                        if (response.redirected) {
                            window.location.href = response.url;
                            return;
                        }

                        const result = await response.json();
                        if (result && result.success) {
                            if (createGvModal) createGvModal.hide();
                            if (window.UnetiUI && typeof window.UnetiUI.toast === 'function') {
                                window.UnetiUI.toast({
                                    type: 'success',
                                    title: 'Thành công',
                                    message: result.message || 'Thêm mới giảng viên thành công!'
                                });
                            }
                            setTimeout(function () {
                                window.location.reload();
                            }, 400);
                        } else {
                            showCreateGvError(result.message || 'Không thể thêm giảng viên. Vui lòng thử lại.');
                        }
                    } catch (err) {
                        console.error('Lỗi khi gửi form thêm mới:', err);
                        formCreateGv.submit();
                    } finally {
                        if (btnSubmitCreate) {
                            btnSubmitCreate.disabled = false;
                            btnSubmitCreate.innerHTML = origHtml;
                        }
                    }
                });
            }

            // 2. Quản lý Modal Chỉnh sửa giảng viên (Popup trực tiếp)
            const editGvModalEl = document.getElementById('modalEditGiangVien');
            const editGvModal = editGvModalEl ? new bootstrap.Modal(editGvModalEl) : null;
            const formEditGv = document.getElementById('formEditGiangVien');

            const idInput = document.getElementById('editGvId');
            const badgeCode = document.getElementById('editGvBadgeCode');
            const avatarEl = document.getElementById('editGvAvatar');
            const cardFullName = document.getElementById('editGvCardFullName');
            const cardCode = document.getElementById('editGvCardCode');
            const cardEmail = document.getElementById('editGvCardEmail');

            const hoTenInput = document.getElementById('editGvHoTen');
            const emailInput = document.getElementById('editGvEmail');
            const sdtInput = document.getElementById('editGvSoDienThoai');
            const hocViSelect = document.getElementById('editGvHocVi');
            const trangThaiSelect = document.getElementById('editGvTrangThai');
            const chuyenMonInput = document.getElementById('editGvChuyenMon');
            const radioNam = document.getElementById('editGvGioiTinhNam');
            const radioNu = document.getElementById('editGvGioiTinhNu');
            const btnSubmit = document.getElementById('btnSubmitEditGv');

            let currentTeacherHasActive = false;
            let currentTeacherActiveCount = 0;

            function showEditGvError(msg) {
                const alertBox = document.getElementById('editGvAlertError');
                const alertText = document.getElementById('editGvAlertErrorText');
                if (alertBox && alertText) {
                    alertText.textContent = msg;
                    alertBox.classList.remove('d-none');
                } else {
                    alert(msg);
                }
            }

            // Event delegation cho nút mở popup (hoạt động trơn tru cả khi lọc & phân trang)
            document.addEventListener('click', function (e) {
                const btn = e.target.closest('.js-open-edit-gv-modal');
                if (!btn) return;
                e.preventDefault();

                const id = btn.getAttribute('data-id');
                const code = btn.getAttribute('data-code') || ('#GV' + id);
                const hoten = btn.getAttribute('data-hoten') || '';
                const email = btn.getAttribute('data-email') || '';
                const sdt = btn.getAttribute('data-sodienthoai') || '';
                const gioitinh = btn.getAttribute('data-gioitinh') || 'Nam';
                const hocvi = btn.getAttribute('data-hocvi') || '';
                const trangthai = btn.getAttribute('data-trangthai') || 'true';
                const chuyenmon = btn.getAttribute('data-chuyenmon') || '';
                const hasActive = btn.getAttribute('data-has-active') === 'true';
                const activeCount = parseInt(btn.getAttribute('data-active-count') || '0', 10);

                currentTeacherHasActive = hasActive;
                currentTeacherActiveCount = activeCount;

                if (formEditGv) formEditGv.action = '/GiangVien/Edit/' + id;
                if (idInput) idInput.value = id;
                if (badgeCode) badgeCode.textContent = code;

                // Cập nhật card định danh trên đầu modal
                const initialChar = (hoten && hoten.trim().length > 0) ? hoten.trim().charAt(0).toUpperCase() : 'G';
                if (avatarEl) avatarEl.textContent = initialChar;
                if (cardFullName) cardFullName.textContent = hoten || 'Chưa đặt họ tên';
                if (cardCode) cardCode.textContent = code;
                if (cardEmail) cardEmail.textContent = email;

                if (hoTenInput) hoTenInput.value = hoten;
                if (emailInput) emailInput.value = email;
                if (sdtInput) sdtInput.value = sdt;
                if (chuyenMonInput) chuyenMonInput.value = chuyenmon;

                if (hocViSelect) hocViSelect.value = hocvi;
                if (trangThaiSelect) trangThaiSelect.value = trangthai;

                if (gioitinh === 'Nữ') {
                    if (radioNu) radioNu.checked = true;
                } else {
                    if (radioNam) radioNam.checked = true;
                }

                // Cập nhật cảnh báo và trạng thái disable của option "Tạm nghỉ"
                const warningEl = document.getElementById('editGvActiveCourseWarning');
                const countTextEl = document.getElementById('editGvActiveCountText');
                const optTamNghi = trangThaiSelect ? trangThaiSelect.querySelector('option[value="false"]') : null;

                if (hasActive) {
                    if (warningEl) warningEl.classList.remove('d-none');
                    if (countTextEl) countTextEl.textContent = activeCount;
                    if (optTamNghi) {
                        optTamNghi.disabled = true;
                        optTamNghi.textContent = 'Tạm nghỉ (Đang phụ trách ' + activeCount + ' lớp có lịch dạy)';
                    }
                } else {
                    if (warningEl) warningEl.classList.add('d-none');
                    if (optTamNghi) {
                        optTamNghi.disabled = false;
                        optTamNghi.textContent = 'Tạm nghỉ';
                    }
                }

                // Xóa thông báo lỗi cũ nếu có
                document.getElementById('editGvAlertError')?.classList.add('d-none');
                ['valErrorHoTen', 'valErrorEmail', 'valErrorSoDienThoai'].forEach(function(eid) {
                    const el = document.getElementById(eid);
                    if (el) el.textContent = '';
                });

                // Tải dữ liệu mới nhất từ server qua AJAX
                fetch('/GiangVien/Edit/' + id, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                })
                .then(r => r.json())
                .then(res => {
                    if (res && res.success && res.data) {
                        const d = res.data;
                        if (d.hoTen && hoTenInput) hoTenInput.value = d.hoTen;
                        if (d.email && emailInput) emailInput.value = d.email;
                        if (d.soDienThoai && sdtInput) sdtInput.value = d.soDienThoai;
                        if (d.chuyenMon !== undefined && chuyenMonInput) chuyenMonInput.value = d.chuyenMon || '';
                        if (d.hocVi !== undefined && hocViSelect) hocViSelect.value = d.hocVi || '';
                        if (d.trangThai !== undefined && trangThaiSelect) trangThaiSelect.value = d.trangThai ? 'true' : 'false';
                        if (d.gioiTinh === 'Nữ' && radioNu) radioNu.checked = true;
                        else if (radioNam) radioNam.checked = true;

                        if (res.hasActiveCourses) {
                            currentTeacherHasActive = true;
                            currentTeacherActiveCount = res.activeCourseCount || activeCount;
                            if (warningEl) warningEl.classList.remove('d-none');
                            if (countTextEl) countTextEl.textContent = currentTeacherActiveCount;
                            if (optTamNghi) {
                                optTamNghi.disabled = true;
                                optTamNghi.textContent = 'Tạm nghỉ (Đang phụ trách ' + currentTeacherActiveCount + ' lớp có lịch dạy)';
                            }
                        } else {
                            currentTeacherHasActive = false;
                            currentTeacherActiveCount = 0;
                            if (warningEl) warningEl.classList.add('d-none');
                            if (optTamNghi) {
                                optTamNghi.disabled = false;
                                optTamNghi.textContent = 'Tạm nghỉ';
                            }
                        }
                    }
                })
                .catch(() => {});

                if (editGvModal) editGvModal.show();
            });

            // 3. Xử lý khi bấm nút Đổi trạng thái của giảng viên ĐANG CÓ LỚP DẠY (Chặn đổi sang Tạm nghỉ)
            document.addEventListener('click', function (e) {
                const btn = e.target.closest('.js-btn-gv-active-warning');
                if (!btn) return;
                e.preventDefault();

                const hoTen = btn.getAttribute('data-hoten') || 'Giảng viên';
                const count = btn.getAttribute('data-count') || '1';
                const rawCourses = btn.getAttribute('data-courses') || '';
                const courses = rawCourses.split(' | ').filter(Boolean);

                let coursesListHtml = courses.map(c => `<li class="py-1"><i class="bi bi-mortarboard-fill text-primary me-2"></i><strong>${c}</strong></li>`).join('');

                const contentHtml = `
                    <div class="text-start">
                        <p class="mb-2">Giảng viên <strong>${hoTen}</strong> đang được phân công phụ trách <strong>${count} khóa học</strong> đang mở hoặc có lịch giảng dạy:</p>
                        <ul class="list-unstyled bg-light rounded-3 p-3 border mb-3 small" style="max-height: 150px; overflow-y: auto;">
                            ${coursesListHtml}
                        </ul>
                        <div class="alert alert-danger py-2 px-3 small mb-0 d-flex align-items-center gap-2">
                            <i class="bi bi-shield-lock-fill fs-5 flex-shrink-0 text-danger"></i>
                            <div>
                                <strong>Không thể chuyển sang trạng thái "Tạm nghỉ":</strong><br>
                                Giảng viên đang có khóa học với lịch giảng dạy thực tế. Vui lòng vào <em>Quản lý khóa học</em> để bàn giao hoặc phân công giảng viên khác thay thế trước khi cho tạm nghỉ!
                            </div>
                        </div>
                    </div>
                `;

                if (window.UnetiUI && typeof window.UnetiUI.confirm === 'function') {
                    window.UnetiUI.confirm({
                        title: 'Chặn đổi trạng thái công tác',
                        message: contentHtml,
                        type: 'warning',
                        confirmText: 'Đã hiểu',
                        cancelText: 'Đóng',
                        onConfirm: function () {}
                    });
                } else {
                    alert(`Giảng viên ${hoTen} đang phụ trách ${count} khóa học có lịch dạy. Không thể chuyển sang Tạm nghỉ!`);
                }
            });

            // Gửi form với AJAX + Toast thông báo thành công chuẩn mực
            if (formEditGv) {
                formEditGv.addEventListener('submit', async function (e) {
                    e.preventDefault();

                    const hoTenVal = hoTenInput ? hoTenInput.value.trim() : '';
                    const emailVal = emailInput ? emailInput.value.trim() : '';
                    const sdtVal = sdtInput ? sdtInput.value.trim() : '';

                    const errHoTen = document.getElementById('valErrorHoTen');
                    const errEmail = document.getElementById('valErrorEmail');
                    const errSdt = document.getElementById('valErrorSoDienThoai');

                    if (errHoTen) errHoTen.textContent = '';
                    if (errEmail) errEmail.textContent = '';
                    if (errSdt) errSdt.textContent = '';
                    document.getElementById('editGvAlertError')?.classList.add('d-none');

                    if (!hoTenVal || hoTenVal.length < 2) {
                        showEditGvError('Họ và tên giảng viên không được để trống và phải từ 2 ký tự trở lên.');
                        hoTenInput?.focus();
                        return;
                    }

                    const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
                    if (!emailVal || !emailRegex.test(emailVal)) {
                        showEditGvError('Địa chỉ email không đúng định dạng.');
                        emailInput?.focus();
                        return;
                    }

                    if (!sdtVal) {
                        showEditGvError('Số điện thoại giảng viên không được để trống.');
                        sdtInput?.focus();
                        return;
                    }

                    // Ràng buộc nghiệp vụ: Không cho phép chọn Tạm nghỉ khi giảng viên đang có lớp dạy
                    if (trangThaiSelect && trangThaiSelect.value === 'false' && currentTeacherHasActive) {
                        showEditGvError(`Giảng viên đang phụ trách ${currentTeacherActiveCount} khóa học có lịch giảng dạy. Không thể chuyển sang trạng thái "Tạm nghỉ"! Vui lòng chuyển giao các khóa học này trước.`);
                        trangThaiSelect.focus();
                        return;
                    }

                    // Hiển thị trạng thái đang xử lý
                    const origHtml = btnSubmit ? btnSubmit.innerHTML : '';
                    if (btnSubmit) {
                        btnSubmit.disabled = true;
                        btnSubmit.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span><span>Đang lưu...</span>';
                    }

                    try {
                        const formData = new FormData(formEditGv);
                        const response = await fetch(formEditGv.action, {
                            method: 'POST',
                            body: formData,
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest'
                            }
                        });

                        if (response.redirected) {
                            window.location.href = response.url;
                            return;
                        }

                        const result = await response.json();
                        if (result && result.success) {
                            if (editGvModal) editGvModal.hide();
                            if (window.UnetiUI && typeof window.UnetiUI.toast === 'function') {
                                window.UnetiUI.toast({
                                    type: 'success',
                                    title: 'Thành công',
                                    message: result.message || 'Cập nhật giảng viên thành công!'
                                });
                            }
                            setTimeout(function () {
                                window.location.reload();
                            }, 400);
                        } else {
                            showEditGvError(result.message || 'Không thể lưu thông tin giảng viên. Vui lòng thử lại.');
                        }
                    } catch (err) {
                        console.error('Lỗi khi gửi form chỉnh sửa:', err);
                        // Fallback submit form thông thường
                        formEditGv.submit();
                    } finally {
                        if (btnSubmit) {
                            btnSubmit.disabled = false;
                            btnSubmit.innerHTML = origHtml;
                        }
                    }
                });
            }
        })();
    </script>
}
