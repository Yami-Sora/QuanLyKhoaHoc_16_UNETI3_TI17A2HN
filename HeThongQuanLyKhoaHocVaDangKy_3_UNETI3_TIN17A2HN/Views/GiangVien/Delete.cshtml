@*
    Họ và tên: Trần Văn Thành
    Mã sinh viên: 23103100076
    Nội dung: Module 1 - Xác nhận xóa giảng viên
*@

@model HeThongQuanLyKhoaHocVaDangKy_3_UNETI3_TIN17A2HN.Models.GiangVien
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Xác nhận xóa giảng viên";
    bool hasKhoaHoc = ViewBag.HasKhoaHoc ?? false;
    int soKhoaHoc = ViewBag.SoKhoaHoc ?? 0;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="uneti-card overflow-hidden">
                <div class="card-header bg-danger text-white py-3 px-4">
                    <h5 class="fw-bold mb-0"><i class="bi bi-exclamation-triangle-fill me-2"></i>XÁC NHẬN XÓA GIẢNG VIÊN</h5>
                </div>

                <div class="card-body p-4">
                    @if (hasKhoaHoc)
                    {
                        <!-- CẢNH BÁO CHẶN XÓA GIẢNG VIÊN ĐANG PHỤ TRÁCH KHÓA HỌC -->
                        <div class="alert alert-warning border-warning d-flex align-items-start p-3 mb-4 rounded-3" role="alert">
                            <i class="bi bi-shield-exclamation text-warning fs-3 me-3 mt-1"></i>
                            <div>
                                <h6 class="fw-bold text-dark mb-1">KHÔNG THỂ XÓA GIẢNG VIÊN NÀY!</h6>
                                <p class="small text-muted mb-2">
                                    Giảng viên này hiện đang phụ trách <strong>@soKhoaHoc khóa học</strong> trong hệ thống.
                                    Theo quy tắc bảo toàn toàn vẹn dữ liệu, không được phép xóa giảng viên còn đang phụ trách khóa học.
                                </p>
                                <span class="badge bg-danger">Giải pháp:</span>
                                <span class="small text-dark fw-semibold ms-1">Chuyển các khóa học sang giảng viên khác hoặc chuyển giảng viên sang trạng thái "Tạm nghỉ" thay vì xóa!</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-danger p-3 mb-4 text-center rounded-3">
                            <i class="bi bi-trash-fill fs-2 d-block mb-1"></i>
                            <h6 class="fw-bold mb-0">Bạn có chắc chắn muốn xóa vĩnh viễn giảng viên này khỏi hệ thống?</h6>
                            <small class="text-muted">Giảng viên này chưa phụ trách khóa học nào, thao tác xóa có thể thực hiện an toàn.</small>
                        </div>
                    }

                    <div class="bg-light p-3 rounded-3 mb-4 border">
                        <dl class="row mb-0">
                            <dt class="col-sm-4 text-muted">Mã giảng viên:</dt>
                            <dd class="col-sm-8 fw-bold">@($"#GV{Model.MaGiangVien:D3}")</dd>

                            <dt class="col-sm-4 text-muted">Họ và tên:</dt>
                            <dd class="col-sm-8 fw-bold" style="color: var(--uneti-primary);">@Model.HoTen</dd>

                            <dt class="col-sm-4 text-muted">Email:</dt>
                            <dd class="col-sm-8">@Model.Email</dd>

                            <dt class="col-sm-4 text-muted">Số điện thoại:</dt>
                            <dd class="col-sm-8">@Model.SoDienThoai</dd>

                            <dt class="col-sm-4 text-muted">Học vị:</dt>
                            <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.HocVi) ? "—" : Model.HocVi)</dd>

                            <dt class="col-sm-4 text-muted">Chuyên môn:</dt>
                            <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.ChuyenMon) ? "—" : Model.ChuyenMon)</dd>

                            <dt class="col-sm-4 text-muted">Trạng thái:</dt>
                            <dd class="col-sm-8">
                                @if (Model.TrangThai)
                                {
                                    <span class="uneti-badge-success">Đang giảng dạy</span>
                                }
                                else
                                {
                                    <span class="uneti-badge-danger">Tạm nghỉ</span>
                                }
                            </dd>
                        </dl>
                    </div>

                    <form asp-action="Delete" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="MaGiangVien" />

                        <div class="d-flex justify-content-between pt-3 border-top">
                            <a asp-action="Index" class="btn uneti-btn-outline text-decoration-none">
                                <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách
                            </a>

                            @if (!hasKhoaHoc)
                            {
                                <button type="submit" class="btn btn-danger fw-bold px-4 rounded-3 shadow-sm" data-loading-text="Đang xóa giảng viên...">
                                    <i class="bi bi-trash me-1"></i>Xác nhận Xóa
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-secondary px-4 rounded-3" disabled title="Bị khóa do đang phụ trách khóa học">
                                    <i class="bi bi-slash-circle me-1"></i>Không thể xóa
                                </button>
                            }
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
