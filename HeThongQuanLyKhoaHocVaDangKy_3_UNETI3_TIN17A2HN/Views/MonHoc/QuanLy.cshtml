@section Scripts {
    <script>
        (function () {
            // 0. Modal Thêm mới môn học
            const createModalEl = document.getElementById('commonCreateMonHocModal');
            const createModal = createModalEl ? bootstrap.Modal.getOrCreateInstance(createModalEl) : null;
            const formCreate = document.getElementById('formCreateMonHoc');
            const createAlert = document.getElementById('createMonHocAlert');
            const btnSubmitCreate = document.getElementById('btnSubmitCreateMonHoc');

            const createTen = document.getElementById('createMonHocTen');
            const createSoTC = document.getElementById('createMonHocSoTinChi');
            const createDonGia = document.getElementById('createMonHocDonGia');
            const createHocPhi = document.getElementById('createMonHocHocPhi');
            const createTrangThai = document.getElementById('createMonHocTrangThai');
            const createMoTa = document.getElementById('createMonHocMoTa');
            const createFormulaBadge = document.getElementById('createMonHocFormulaBadge');

            function updateCreateFormulaBadge(tc, dg, total) {
                if (createFormulaBadge) {
                    createFormulaBadge.innerHTML = `${tc} TC × ${dg.toLocaleString('vi-VN')} đ = <strong>${total.toLocaleString('vi-VN')} đ</strong>`;
                }
            }

            function calcCreateHocPhi() {
                const tc = parseInt(createSoTC ? createSoTC.value : 0) || 0;
                const dg = parseInt(createDonGia ? createDonGia.value : 0) || 0;
                const total = tc * dg;
                if (createHocPhi) createHocPhi.value = total;
                updateCreateFormulaBadge(tc, dg, total);
            }

            if (createSoTC) createSoTC.addEventListener('input', calcCreateHocPhi);
            if (createDonGia) createDonGia.addEventListener('input', calcCreateHocPhi);

            if (createHocPhi) {
                createHocPhi.addEventListener('input', function () {
                    const tc = parseInt(createSoTC ? createSoTC.value : 0) || 0;
                    const total = parseInt(this.value) || 0;
                    if (tc > 0 && total > 0) {
                        const dg = Math.round(total / tc / 1000) * 1000;
                        if (createDonGia) createDonGia.value = dg;
                        updateCreateFormulaBadge(tc, dg, total);
                    }
                });
            }

            function showCreateError(msg) {
                if (createAlert) {
                    createAlert.textContent = msg;
                    createAlert.classList.remove('d-none');
                } else {
                    alert(msg);
                }
            }

            if (formCreate) {
                formCreate.addEventListener('submit', async function (e) {
                    e.preventDefault();

                    const tenVal = createTen ? createTen.value.trim() : '';
                    const tcVal = parseInt(createSoTC ? createSoTC.value : 0) || 0;
                    const hpVal = parseInt(createHocPhi ? createHocPhi.value : 0) || 0;

                    if (!tenVal || tenVal.length < 2) {
                        showCreateError('Tên môn học không được để trống và phải từ 2 ký tự trở lên.');
                        createTen?.focus();
                        return;
                    }

                    if (tcVal < 1 || tcVal > 10) {
                        showCreateError('Số tín chỉ phải từ 1 đến 10.');
                        createSoTC?.focus();
                        return;
                    }

                    if (hpVal < 0) {
                        showCreateError('Học phí không thể là số âm.');
                        createHocPhi?.focus();
                        return;
                    }

                    if (createAlert) createAlert.classList.add('d-none');

                    const originalBtnHtml = btnSubmitCreate ? btnSubmitCreate.innerHTML : '';
                    if (btnSubmitCreate) {
                        btnSubmitCreate.disabled = true;
                        btnSubmitCreate.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span><span>Đang thêm...</span>';
                    }

                    try {
                        const formData = new FormData(formCreate);
                        const response = await fetch(formCreate.action, {
                            method: 'POST',
                            body: formData,
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest'
                            }
                        });

                        if (response.redirected) {
                            window.location.href = response.url;
                            return;
                        }

                        const result = await response.json();
                        if (result && result.success) {
                            if (createModal) createModal.hide();

                            if (window.UnetiUI && typeof window.UnetiUI.toast === 'function') {
                                window.UnetiUI.toast({
                                    type: 'success',
                                    title: 'Thành công',
                                    message: result.message || 'Thêm mới môn học thành công!'
                                });
                            }
                            setTimeout(function () {
                                window.location.reload();
                            }, 400);
                        } else {
                            showCreateError(result.message || 'Không thể tạo môn học. Vui lòng kiểm tra lại.');
                        }
                    } catch (err) {
                        formCreate.submit();
                    } finally {
                        if (btnSubmitCreate) {
                            btnSubmitCreate.disabled = false;
                            btnSubmitCreate.innerHTML = originalBtnHtml;
                        }
                    }
                });
            }

            // 1. Modal Chỉnh sửa môn học
            const editModalEl = document.getElementById('commonEditMonHocModal');
            const editModal = editModalEl ? bootstrap.Modal.getOrCreateInstance(editModalEl) : null;
            const formEdit = document.getElementById('formEditMonHoc');
            const editAlert = document.getElementById('editMonHocAlert');
            const btnSubmitEdit = document.getElementById('btnSubmitEditMonHoc');

            const editMa = document.getElementById('editMonHocMaMonHoc');
            const editCardName = document.getElementById('editMonHocCardName');
            const editCardCode = document.getElementById('editMonHocCardCode');
            const editCardTinChi = document.getElementById('editMonHocCardTinChi');
            const editTen = document.getElementById('editMonHocTen');
            const editSoTC = document.getElementById('editMonHocSoTinChi');
            const editDonGia = document.getElementById('editMonHocDonGia');
            const editHocPhi = document.getElementById('editMonHocHocPhi');
            const editTrangThai = document.getElementById('editMonHocTrangThai');
            const editMoTa = document.getElementById('editMonHocMoTa');
            const formulaBadge = document.getElementById('editMonHocFormulaBadge');

            function updateFormulaBadge(tc, dg, total) {
                if (formulaBadge) {
                    formulaBadge.innerHTML = `${tc} TC × ${dg.toLocaleString('vi-VN')} đ = <strong>${total.toLocaleString('vi-VN')} đ</strong>`;
                }
            }

            function calcHocPhiFromDonGia() {
                const tc = parseInt(editSoTC ? editSoTC.value : 0) || 0;
                const dg = parseInt(editDonGia ? editDonGia.value : 0) || 0;
                const total = tc * dg;
                if (editHocPhi) editHocPhi.value = total;
                updateFormulaBadge(tc, dg, total);
                if (editCardTinChi) editCardTinChi.textContent = tc + ' tín chỉ';
            }

            if (editSoTC) editSoTC.addEventListener('input', calcHocPhiFromDonGia);
            if (editDonGia) editDonGia.addEventListener('input', calcHocPhiFromDonGia);

            if (editHocPhi) {
                editHocPhi.addEventListener('input', function () {
                    const tc = parseInt(editSoTC ? editSoTC.value : 0) || 0;
                    const total = parseInt(this.value) || 0;
                    if (tc > 0 && total > 0) {
                        const dg = Math.round(total / tc / 1000) * 1000;
                        if (editDonGia) editDonGia.value = dg;
                        updateFormulaBadge(tc, dg, total);
                    }
                });
            }

            function showEditError(msg) {
                if (editAlert) {
                    editAlert.textContent = msg;
                    editAlert.classList.remove('d-none');
                } else {
                    alert(msg);
                }
            }

            if (formEdit) {
                formEdit.addEventListener('submit', async function (e) {
                    e.preventDefault();

                    const tenVal = editTen ? editTen.value.trim() : '';
                    const tcVal = parseInt(editSoTC ? editSoTC.value : 0) || 0;
                    const hpVal = parseInt(editHocPhi ? editHocPhi.value : 0) || 0;

                    if (!tenVal || tenVal.length < 2) {
                        showEditError('Tên môn học không được để trống và phải từ 2 ký tự trở lên.');
                        editTen?.focus();
                        return;
                    }

                    if (tcVal < 1 || tcVal > 10) {
                        showEditError('Số tín chỉ phải từ 1 đến 10.');
                        editSoTC?.focus();
                        return;
                    }

                    if (hpVal < 0) {
                        showEditError('Học phí không thể là số âm.');
                        editHocPhi?.focus();
                        return;
                    }

                    if (editAlert) editAlert.classList.add('d-none');

                    const originalBtnHtml = btnSubmitEdit ? btnSubmitEdit.innerHTML : '';
                    if (btnSubmitEdit) {
                        btnSubmitEdit.disabled = true;
                        btnSubmitEdit.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span><span>Đang lưu...</span>';
                    }

                    try {
                        const formData = new FormData(formEdit);
                        const response = await fetch(formEdit.action, {
                            method: 'POST',
                            body: formData,
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest'
                            }
                        });

                        if (response.redirected) {
                            window.location.href = response.url;
                            return;
                        }

                        const result = await response.json();
                        if (result && result.success) {
                            if (editModal) editModal.hide();

                            if (window.UnetiUI && typeof window.UnetiUI.toast === 'function') {
                                window.UnetiUI.toast({
                                    type: 'success',
                                    title: 'Thành công',
                                    message: result.message || 'Cập nhật môn học thành công!'
                                });
                            }
                            setTimeout(function () {
                                window.location.reload();
                            }, 400);
                        } else {
                            showEditError(result.message || 'Không thể lưu thông tin. Vui lòng kiểm tra lại.');
                        }
                    } catch (err) {
                        formEdit.submit();
                    } finally {
                        if (btnSubmitEdit) {
                            btnSubmitEdit.disabled = false;
                            btnSubmitEdit.innerHTML = originalBtnHtml;
                        }
                    }
                });
            }

            // 2. Modal Xóa môn học
            const deleteMhModalEl = document.getElementById('commonDeleteMonHocModal');
            const deleteMhModal = deleteMhModalEl ? bootstrap.Modal.getOrCreateInstance(deleteMhModalEl) : null;
            const formDeleteMh = document.getElementById('formDeleteMonHoc');
            const deleteMhId = document.getElementById('deleteMhId');
            const deleteMhCardCode = document.getElementById('deleteMhCardCode');
            const deleteMhCardName = document.getElementById('deleteMhCardName');
            const deleteMhCardTinChi = document.getElementById('deleteMhCardTinChi');
            const deleteMhCardHocPhi = document.getElementById('deleteMhCardHocPhi');
            const deleteMhCardStatus = document.getElementById('deleteMhCardStatus');
            const deleteMhBlockWarning = document.getElementById('deleteMhBlockWarning');
            const deleteMhConfirmAlert = document.getElementById('deleteMhConfirmAlert');
            const deleteMhSoKhoaHoc = document.getElementById('deleteMhSoKhoaHoc');
            const btnSubmitDeleteMh = document.getElementById('btnSubmitDeleteMonHoc');
            const btnBlockDeleteMh = document.getElementById('btnBlockDeleteMonHoc');
            const deleteMhAlertError = document.getElementById('deleteMhAlertError');

            if (formDeleteMh) {
                formDeleteMh.addEventListener('submit', async function (e) {
                    e.preventDefault();

                    const origBtnHtml = btnSubmitDeleteMh ? btnSubmitDeleteMh.innerHTML : '';
                    if (btnSubmitDeleteMh) {
                        btnSubmitDeleteMh.disabled = true;
                        btnSubmitDeleteMh.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span><span>Đang xóa...</span>';
                    }

                    try {
                        const formData = new FormData(formDeleteMh);
                        const response = await fetch(formDeleteMh.action, {
                            method: 'POST',
                            body: formData,
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest'
                            }
                        });

                        if (response.redirected) {
                            window.location.href = response.url;
                            return;
                        }

                        const result = await response.json();
                        if (result && result.success) {
                            if (deleteMhModal) deleteMhModal.hide();
                            if (window.UnetiUI && typeof window.UnetiUI.toast === 'function') {
                                window.UnetiUI.toast({
                                    type: 'success',
                                    title: 'Đã xóa môn học',
                                    message: result.message || 'Xóa môn học thành công!'
                                });
                            }
                            setTimeout(function () {
                                window.location.reload();
                            }, 400);
                        } else {
                            if (deleteMhAlertError) {
                                document.getElementById('deleteMhAlertErrorText').textContent = result.message || 'Không thể xóa môn học này.';
                                deleteMhAlertError.classList.remove('d-none');
                            } else {
                                alert(result.message || 'Không thể xóa môn học này.');
                            }
                        }
                    } catch (err) {
                        formDeleteMh.submit();
                    } finally {
                        if (btnSubmitDeleteMh) {
                            btnSubmitDeleteMh.disabled = false;
                            btnSubmitDeleteMh.innerHTML = origBtnHtml;
                        }
                    }
                });
            }

            // 3. Sự kiện Click chung (Event Delegation)
            document.addEventListener('click', function (e) {
                // A. Mở modal Thêm mới môn học
                const btnOpenCreate = e.target.closest('.js-open-create-monhoc-modal');
                if (btnOpenCreate) {
                    e.preventDefault();
                    if (formCreate) formCreate.reset();
                    if (createSoTC) createSoTC.value = 3;
                    if (createDonGia) createDonGia.value = 1000000;
                    if (createHocPhi) createHocPhi.value = 3000000;
                    if (createTrangThai) createTrangThai.value = 'true';
                    updateCreateFormulaBadge(3, 1000000, 3000000);
                    if (createAlert) {
                        createAlert.classList.add('d-none');
                        createAlert.textContent = '';
                    }
                    if (createModal) createModal.show();
                    setTimeout(() => createTen?.focus(), 300);
                    return;
                }

                // B. Chọn nhanh đơn giá ở form Thêm mới: 800k, 1.0tr, 1.2tr
                const btnCreatePrice = e.target.closest('.js-create-dongia');
                if (btnCreatePrice) {
                    const price = parseInt(btnCreatePrice.getAttribute('data-price')) || 1000000;
                    if (createDonGia) {
                        createDonGia.value = price;
                        calcCreateHocPhi();
                    }
                    return;
                }

                // C. Chọn nhanh đơn giá ở form Chỉnh sửa: 800k, 1.0tr, 1.2tr
                const btnPrice = e.target.closest('.js-monhoc-dongia');
                if (btnPrice) {
                    const price = parseInt(btnPrice.getAttribute('data-price')) || 1000000;
                    if (editDonGia) {
                        editDonGia.value = price;
                        calcHocPhiFromDonGia();
                    }
                    return;
                }

                // D. Mở modal Chỉnh sửa môn học
                const btnEdit = e.target.closest('.js-open-edit-monhoc-modal');
                if (btnEdit) {
                    e.preventDefault();

                    const id = btnEdit.getAttribute('data-id');
                    const code = btnEdit.getAttribute('data-code');
                    const name = btnEdit.getAttribute('data-name');
                    const tinchi = parseInt(btnEdit.getAttribute('data-tinchi')) || 3;
                    const hocphi = parseInt(btnEdit.getAttribute('data-hocphi')) || 0;
                    const status = btnEdit.getAttribute('data-status');
                    const desc = btnEdit.getAttribute('data-desc');

                    if (formEdit) formEdit.action = '/MonHoc/Edit/' + id;
                    if (editMa) editMa.value = id;
                    if (editCardName) editCardName.textContent = name || 'Môn học #' + id;
                    if (editCardCode) editCardCode.textContent = code || ('#MH' + id);
                    if (editCardTinChi) editCardTinChi.textContent = tinchi + ' tín chỉ';

                    if (editTen) editTen.value = name || '';
                    if (editSoTC) editSoTC.value = tinchi;
                    if (editHocPhi) editHocPhi.value = hocphi;

                    const donGia = tinchi > 0 ? (Math.round((hocphi / tinchi) / 1000) * 1000) : 1000000;
                    if (editDonGia) editDonGia.value = donGia;
                    updateFormulaBadge(tinchi, donGia, hocphi);

                    if (editTrangThai) editTrangThai.value = (status === 'true' || status === 'True') ? 'true' : 'false';
                    if (editMoTa) editMoTa.value = desc || '';

                    if (editAlert) {
                        editAlert.classList.add('d-none');
                        editAlert.textContent = '';
                    }

                    if (editModal) editModal.show();
                    return;
                }

                // E. Mở modal Xóa môn học
                const btnDelete = e.target.closest('.js-open-delete-monhoc-modal');
                if (btnDelete) {
                    e.preventDefault();

                    const id = btnDelete.getAttribute('data-id');
                    const code = btnDelete.getAttribute('data-code') || ('#MH' + id);
                    const name = btnDelete.getAttribute('data-name') || '';
                    const tinchi = btnDelete.getAttribute('data-tinchi') || '0';
                    const hocphi = btnDelete.getAttribute('data-hocphi') || '0';
                    const statusIsOpen = btnDelete.getAttribute('data-status-is-open') === 'true';
                    const hasKhoaHoc = btnDelete.getAttribute('data-has-khoahoc') === 'true';
                    const countKhoaHoc = parseInt(btnDelete.getAttribute('data-khoahoc-count')) || 0;

                    if (formDeleteMh) formDeleteMh.action = '/MonHoc/Delete/' + id;
                    if (deleteMhId) deleteMhId.value = id;
                    if (deleteMhCardCode) deleteMhCardCode.textContent = code;
                    if (deleteMhCardName) deleteMhCardName.textContent = name;
                    if (deleteMhCardTinChi) deleteMhCardTinChi.textContent = tinchi + ' tín chỉ';
                    if (deleteMhCardHocPhi) deleteMhCardHocPhi.textContent = hocphi + ' đ';

                    if (deleteMhCardStatus) {
                        if (statusIsOpen) {
                            deleteMhCardStatus.className = 'uneti-badge-success';
                            deleteMhCardStatus.innerHTML = '<i class="bi bi-check-circle me-1"></i>Đang mở';
                        } else {
                            deleteMhCardStatus.className = 'uneti-badge-danger';
                            deleteMhCardStatus.innerHTML = '<i class="bi bi-pause-circle me-1"></i>Tạm dừng';
                        }
                    }

                    if (deleteMhAlertError) deleteMhAlertError.classList.add('d-none');

                    if (hasKhoaHoc || countKhoaHoc > 0) {
                        if (deleteMhBlockWarning) deleteMhBlockWarning.classList.remove('d-none');
                        if (deleteMhConfirmAlert) deleteMhConfirmAlert.classList.add('d-none');
                        if (deleteMhSoKhoaHoc) deleteMhSoKhoaHoc.textContent = countKhoaHoc + ' khóa học';
                        if (btnSubmitDeleteMh) btnSubmitDeleteMh.classList.add('d-none');
                        if (btnBlockDeleteMh) btnBlockDeleteMh.classList.remove('d-none');
                    } else {
                        if (deleteMhBlockWarning) deleteMhBlockWarning.classList.add('d-none');
                        if (deleteMhConfirmAlert) deleteMhConfirmAlert.classList.remove('d-none');
                        if (btnSubmitDeleteMh) btnSubmitDeleteMh.classList.remove('d-none');
                        if (btnBlockDeleteMh) btnBlockDeleteMh.classList.add('d-none');
                    }

                    if (deleteMhModal) deleteMhModal.show();
                    return;
                }
            });

            // 4. Lọc nhanh trong bảng môn học
            function initQuickSearch() {
                const searchInput = document.getElementById('adminTableQuickSearch');
                const clearBtn = document.getElementById('btnClearQuickSearch');
                const resetBtn = document.getElementById('btnResetQuickFilter');
                const emptyRow = document.getElementById('quickSearchEmptyRow');
                const visibleCountEl = document.getElementById('visibleRowCount');
                const summaryCountEl = document.getElementById('summaryRowCount');
                const table = document.getElementById('monHocAdminTable');
                if (!searchInput || !table) return;

                const rows = table.querySelectorAll('tbody tr:not(#quickSearchEmptyRow)');

                function doFilter() {
                    const term = searchInput.value.trim().toLowerCase();
                    if (clearBtn) clearBtn.style.display = term ? 'inline-block' : 'none';
                    let visibleCount = 0;

                    rows.forEach(function (row) {
                        const text = row.textContent.toLowerCase();
                        if (!term || text.indexOf(term) !== -1) {
                            row.style.display = '';
                            visibleCount++;
                        } else {
                            row.style.display = 'none';
                        }
                    });

                    if (visibleCountEl) visibleCountEl.textContent = visibleCount;
                    if (summaryCountEl) summaryCountEl.textContent = visibleCount;
                    if (emptyRow) {
                        emptyRow.style.display = (visibleCount === 0 && rows.length > 0) ? '' : 'none';
                        const termSpan = document.getElementById('quickSearchTerm');
                        if (termSpan) termSpan.textContent = searchInput.value;
                    }
                }

                searchInput.oninput = doFilter;

                function resetSearch() {
                    searchInput.value = '';
                    doFilter();
                    searchInput.focus();
                }

                if (clearBtn) clearBtn.onclick = resetSearch;
                if (resetBtn) resetBtn.onclick = resetSearch;

                if (searchInput.value.trim()) {
                    doFilter();
                }
            }

            initQuickSearch();

            // 5. Phân trang AJAX giữ nguyên vị trí cuộn ("Đứng yên", không nhảy lên đầu)
            const tableContainer = document.getElementById('monHocTableContainer');
            if (tableContainer) {
                tableContainer.addEventListener('click', async function (e) {
                    const link = e.target.closest('.uneti-pagination a, .pagination a');
                    if (!link) return;

                    const item = link.closest('.page-item');
                    if (item && (item.classList.contains('disabled') || item.classList.contains('active'))) {
                        e.preventDefault();
                        return;
                    }

                    const href = link.getAttribute('href');
                    if (!href || href === '#' || href.startsWith('javascript:')) return;

                    e.preventDefault();

                    tableContainer.style.transition = 'opacity 0.15s ease';
                    tableContainer.style.opacity = '0.45';
                    tableContainer.style.pointerEvents = 'none';

                    try {
                        const response = await fetch(href, {
                            headers: { 'X-Requested-With': 'XMLHttpRequest' }
                        });
                        if (!response.ok) throw new Error('Network error ' + response.status);

                        const html = await response.text();
                        const parser = new DOMParser();
                        const doc = parser.parseFromString(html, 'text/html');
                        const newContainer = doc.getElementById('monHocTableContainer');

                        if (newContainer) {
                            tableContainer.innerHTML = newContainer.innerHTML;
                            window.history.pushState({ path: href }, '', href);
                            initQuickSearch();

                            if (window.bootstrap && typeof window.bootstrap.Tooltip === 'function') {
                                tableContainer.querySelectorAll('[title]').forEach(function (el) {
                                    new bootstrap.Tooltip(el);
                                });
                            }
                        } else {
                            window.location.href = href;
                        }
                    } catch (err) {
                        console.error('AJAX pagination error:', err);
                        window.location.href = href;
                    } finally {
                        tableContainer.style.opacity = '1';
                        tableContainer.style.pointerEvents = '';
                    }
                });

                window.addEventListener('popstate', async function () {
                    try {
                        tableContainer.style.opacity = '0.45';
                        const res = await fetch(window.location.href, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                        if (res.ok) {
                            const doc = new DOMParser().parseFromString(await res.text(), 'text/html');
                            const newContainer = doc.getElementById('monHocTableContainer');
                            if (newContainer) {
                                tableContainer.innerHTML = newContainer.innerHTML;
                                initQuickSearch();
                            }
                        }
                    } finally {
                        tableContainer.style.opacity = '1';
                    }
                });
            }
        })();
    </script>
}
