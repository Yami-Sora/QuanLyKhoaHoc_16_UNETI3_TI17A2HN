@*
    Họ và tên: Trần Văn Thành
    Mã sinh viên: 23103100076
    Nội dung: Quản trị môn học
*@

@model IEnumerable<HeThongQuanLyKhoaHocVaDangKy_3_UNETI3_TIN17A2HN.Models.MonHoc>
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var userRole = Context.Session.GetString("VaiTro");
    var isAdmin = userRole == "Admin";
    var isManager = userRole == "Admin" || userRole == "NhanVien";

    ViewData["Title"] = "Quản lý môn học";
    int totalCount = ViewBag.TotalCount ?? (Model?.Count() ?? 0);
    int activeCount = ViewBag.ActiveCount ?? (Model?.Count(m => m.TrangThai) ?? 0);
    int inactiveCount = ViewBag.InactiveCount ?? (Model?.Count(m => !m.TrangThai) ?? 0);
    int totalTinChi = ViewBag.TotalTinChi ?? (Model?.Sum(m => m.SoTinChi) ?? 0);
    int avgHocPhi = ViewBag.AvgHocPhi ?? (Model?.Any() == true ? (int)(Math.Floor(Model.Average(m => m.HocPhi) / 1000m) * 1000m) : 0);
    bool? currentTrangThai = ViewBag.CurrentTrangThai;
    var currentSearch = ViewBag.CurrentSearch as string;

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int pageSize = ViewBag.PageSize ?? 10;
}

<div class="container-fluid py-2">
    <!-- Header trang Quản lý cho Admin & Nhân viên -->
    <div class="dl-page-head">
        <div class="dl-head-left">
            <span class="dl-head-icon">
                <i class="bi bi-book-half"></i>
            </span>
            <div class="dl-head-text">
                <h4 class="dl-page-title">Quản lý môn học</h4>
                <p class="dl-page-sub">Quản lý danh sách môn học trong hệ thống đào tạo</p>
            </div>
        </div>
        <div class="mt-2 mt-md-0 d-flex gap-2">
            <a asp-controller="GiangVien" asp-action="Index" class="btn uneti-btn-outline shadow-sm text-decoration-none">
                <i class="bi bi-person-badge me-1"></i>Quản lý giảng viên
            </a>
            @if (isManager)
            {
                <button type="button" class="btn uneti-btn-primary shadow-sm js-open-create-monhoc-modal" id="btnOpenCreateMonHoc">
                    <i class="bi bi-plus-circle me-1"></i>Thêm môn học mới
                </button>
            }
        </div>
    </div>

    <!-- 4 thẻ thống kê (dùng chung thiết kế với Giảng viên / Tài khoản) -->
    <div class="row g-3 mb-3">
        <!-- 1. Tổng số môn học -->
        <div class="col-sm-6 col-xl-3">
            <a asp-action="QuanLy" class="dl-stat-card dl-blue @(currentTrangThai == null ? "dl-active" : "")" title="Xem tất cả môn học">
                <span class="dl-stat-icon"><i class="bi bi-journal-bookmark"></i></span>
                <span>
                    <span class="dl-stat-label">Tổng số môn học</span>
                    <span class="dl-stat-num"><span data-count-to="@totalCount">@totalCount</span></span>
                    <span class="dl-stat-sub">Môn trong khung đào tạo</span>
                </span>
            </a>
        </div>

        <!-- 2. Đang mở giảng dạy -->
        <div class="col-sm-6 col-xl-3">
            <a asp-action="QuanLy" asp-route-trangThai="true" class="dl-stat-card dl-green @(currentTrangThai == true ? "dl-active" : "")" title="Lọc các môn đang mở">
                <span class="dl-stat-icon"><i class="bi bi-check2-circle"></i></span>
                <span>
                    <span class="dl-stat-label">Đang giảng dạy</span>
                    <span class="dl-stat-num"><span data-count-to="@activeCount">@activeCount</span></span>
                    <span class="dl-stat-sub">Sẵn sàng mở khóa học</span>
                </span>
            </a>
        </div>

        <!-- 3. Tạm dừng mở lớp -->
        <div class="col-sm-6 col-xl-3">
            <a asp-action="QuanLy" asp-route-trangThai="false" class="dl-stat-card dl-red @(currentTrangThai == false ? "dl-active" : "")" title="Lọc các môn tạm dừng">
                <span class="dl-stat-icon"><i class="bi bi-pause-circle"></i></span>
                <span>
                    <span class="dl-stat-label">Tạm dừng mở lớp</span>
                    <span class="dl-stat-num"><span data-count-to="@inactiveCount">@inactiveCount</span></span>
                    <span class="dl-stat-sub">Đang bảo trì / ngưng tuyển</span>
                </span>
            </a>
        </div>

        <!-- 4. Học phí trung bình -->
        <div class="col-sm-6 col-xl-3">
            <div class="dl-stat-card dl-amber">
                <span class="dl-stat-icon"><i class="bi bi-cash-stack"></i></span>
                <span>
                    <span class="dl-stat-label">Học phí trung bình</span>
                    <span class="dl-stat-num"><span data-count-to="@avgHocPhi" data-format="number">@avgHocPhi.ToString("N0")</span> <small class="fs-6 fw-normal">đ</small></span>
                    <span class="dl-stat-sub">Tổng tích lũy: <strong>@totalTinChi</strong> tín chỉ</span>
                </span>
            </div>
        </div>
    </div>

    <!-- Thông báo TempData -->
    <noscript>
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show uneti-card border-success-subtle mb-4 py-3" role="alert">
                <i class="bi bi-check-circle-fill text-success me-2 fs-5 align-middle"></i>
                <span class="align-middle fw-semibold text-dark">@TempData["SuccessMessage"]</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show uneti-card border-danger-subtle mb-4 py-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill text-danger me-2 fs-5 align-middle"></i>
                <span class="align-middle fw-semibold text-dark">@TempData["ErrorMessage"]</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </noscript>

    <!-- THANH TÌM KIẾM & BỘ LỌC -->
    <div class="dl-filter-card">
        <form method="get" asp-action="QuanLy" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" name="searchString" value="@ViewBag.CurrentSearch" class="form-control border-start-0 ps-0" placeholder="Nhập tên môn học cần tìm..." />
                </div>
            </div>
            <div class="col-md-4">
                <select name="trangThai" class="form-select">
                    <option value="">-- Tất cả trạng thái --</option>
                    <option value="true" selected="@(currentTrangThai == true)">Đang mở giảng dạy</option>
                    <option value="false" selected="@(currentTrangThai == false)">Tạm dừng giảng dạy</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn uneti-btn-primary flex-grow-1">
                    <i class="bi bi-funnel me-1"></i>Lọc môn
                </button>
                <a asp-action="QuanLy" class="btn uneti-btn-outline" title="Xóa bộ lọc">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>

    <!-- BẢNG DANH MỤC MÔN HỌC QUẢN TRỊ -->
    <div id="monHocTableContainer" class="position-relative">
        <div class="dl-table-card">
        <!-- Đầu bảng: tiêu đề + nút Xuất danh sách (chuẩn như Giảng viên) -->
        <div class="dl-table-head">
            <div class="d-flex align-items-center gap-2">
                <span class="dl-head-ic"><i class="bi bi-list-check"></i></span>
                <span class="fw-bold text-dark">Danh sách môn học</span>
                <span class="dl-count-badge">@totalCount môn học</span>
            </div>
            <a asp-action="XuatDanhSach" asp-route-searchString="@currentSearch" asp-route-trangThai="@currentTrangThai" class="btn btn-sm uneti-btn-outline" download data-no-transition title="Xuất danh sách môn học sang file Excel"><i class="bi bi-file-earmark-excel-fill text-success me-1"></i> Xuất Excel</a>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 uneti-table" id="monHocAdminTable">
                <thead>
                    <tr>
                        <th class="ps-3" style="width: 100px;">Mã môn</th>
                        <th>Tên môn học</th>
                        <th class="text-center" style="width: 110px;">Số tín chỉ</th>
                        <th class="text-end" style="width: 160px;">Định mức học phí</th>
                        <th class="text-center" style="width: 120px;">Khóa mở</th>
                        <th class="text-center" style="width: 140px;">Trạng thái</th>
                        <th class="text-center" style="width: 180px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>Không tìm thấy môn học nào phù hợp.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-bold text-muted">@($"#MH{item.MaMonHoc:D3}")</td>
                                <td>
                                    <div class="fw-bold text-dark">@item.TenMonHoc</div>
                                    @if (!string.IsNullOrEmpty(item.MoTa))
                                    {
                                        <small class="text-muted text-truncate d-block uneti-max-w-340">@item.MoTa</small>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="uneti-badge-primary">
                                        @item.SoTinChi TC
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="fw-bold text-primary">
                                        @item.HocPhi.ToString("N0") đ
                                    </div>
                                    <div class="text-muted small uneti-fs-xs">
                                        ~@((item.SoTinChi > 0 ? Math.Round((item.HocPhi / item.SoTinChi) / 1000m, MidpointRounding.AwayFromZero) * 1000m : 0m).ToString("N0")) đ/tín
                                    </div>
                                </td>
                                <td class="text-center">
                                    @if (item.KhoaHocs != null && item.KhoaHocs.Any())
                                    {
                                        <span class="badge bg-light text-dark border">
                                            <i class="bi bi-mortarboard me-1 text-primary"></i>@item.KhoaHocs.Count lớp
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Chưa mở</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (item.TrangThai)
                                    {
                                        <span class="uneti-badge-success">
                                            <i class="bi bi-check-circle me-1"></i>Đang mở
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="uneti-badge-danger">
                                            <i class="bi bi-pause-circle me-1"></i>Tạm dừng
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="d-inline-flex align-items-center justify-content-center gap-1">
                                        <a asp-action="Details" asp-route-id="@item.MaMonHoc" class="btn-action-icon btn-action-view" title="Xem chi tiết môn học">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        @if (isManager)
                                        {
                                            <button type="button" class="btn-action-icon btn-action-edit js-open-edit-monhoc-modal"
                                                    data-id="@item.MaMonHoc"
                                                    data-code="@($"#MH{item.MaMonHoc:D3}")"
                                                    data-name="@item.TenMonHoc"
                                                    data-tinchi="@item.SoTinChi"
                                                    data-hocphi="@((long)item.HocPhi)"
                                                    data-status="@(item.TrangThai ? "true" : "false")"
                                                    data-desc="@(item.MoTa ?? "")"
                                                    title="Chỉnh sửa môn học">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                            <form asp-action="ToggleStatus" asp-route-id="@item.MaMonHoc" method="post" class="d-inline m-0 p-0"
                                                  data-uneti-confirm="Bạn có chắc chắn muốn thay đổi trạng thái môn '@item.TenMonHoc' sang @(item.TrangThai ? "Tạm dừng" : "Đang mở")?"
                                                  data-uneti-title="Đổi trạng thái môn học"
                                                  data-uneti-type="warning"
                                                  data-uneti-ok="Đổi trạng thái">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn-action-icon btn-action-toggle" data-no-loading title="Đổi trạng thái Đang mở / Tạm dừng">
                                                    <i class="bi bi-arrow-repeat"></i>
                                                </button>
                                            </form>
                                        }
                                        @if (isAdmin)
                                        {
                                            var hasKhoaHoc = item.KhoaHocs != null && item.KhoaHocs.Any();
                                            var countKhoaHoc = item.KhoaHocs?.Count ?? 0;
                                            <button type="button" class="btn-action-icon btn-action-delete js-open-delete-monhoc-modal"
                                                    data-id="@item.MaMonHoc"
                                                    data-code="@($"#MH{item.MaMonHoc:D3}")"
                                                    data-name="@item.TenMonHoc"
                                                    data-tinchi="@item.SoTinChi"
                                                    data-hocphi="@item.HocPhi.ToString("N0")"
                                                    data-status="@(item.TrangThai ? "Đang mở giảng dạy" : "Tạm dừng")"
                                                    data-status-is-open="@(item.TrangThai ? "true" : "false")"
                                                    data-has-khoahoc="@(hasKhoaHoc ? "true" : "false")"
                                                    data-khoahoc-count="@countKhoaHoc"
                                                    title="Xóa môn học">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <!-- Chân bảng gộp: tổng số + phân trang cùng 1 hàng, nằm trong cùng thẻ bảng -->
        <div class="dl-table-foot">
            <span class="small text-muted">Hiển thị <strong><span id="summaryRowCount">@(Model?.Count() ?? 0)</span></strong> trên tổng số <strong>@totalCount</strong> môn học @if (totalPages > 1) { <text>• Trang <strong>@currentPage</strong>/<strong>@totalPages</strong></text> }</span>
            @if (totalPages > 1)
            {
            <nav aria-label="Phân trang danh mục môn học">
                <ul class="pagination uneti-pagination mb-0">
                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")" title="Trang đầu">
                        <a class="page-link" asp-action="QuanLy" asp-route-page="1" asp-route-searchString="@currentSearch" asp-route-trangThai="@currentTrangThai">
                            <i class="bi bi-chevron-double-left"></i>
                        </a>
                    </li>
                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")" title="Trang trước">
                        <a class="page-link" asp-action="QuanLy" asp-route-page="@(currentPage - 1)" asp-route-searchString="@currentSearch" asp-route-trangThai="@currentTrangThai">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>
                    @for (int p = 1; p <= totalPages; p++)
                    {
                        if (totalPages > 7 && Math.Abs(p - currentPage) > 2 && p != 1 && p != totalPages)
                        {
                            if (p == currentPage - 3 || p == currentPage + 3)
                            {
                                <li class="page-item disabled"><span class="page-ellipsis">…</span></li>
                            }
                            continue;
                        }
                        <li class="page-item @(p == currentPage ? "active" : "")">
                            <a class="page-link" asp-action="QuanLy" asp-route-page="@p" asp-route-searchString="@currentSearch" asp-route-trangThai="@currentTrangThai">@p</a>
                        </li>
                    }
                    <li class="page-item @(currentPage >= totalPages ? "disabled" : "")" title="Trang tiếp theo">
                        <a class="page-link" asp-action="QuanLy" asp-route-page="@(currentPage + 1)" asp-route-searchString="@currentSearch" asp-route-trangThai="@currentTrangThai">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                    <li class="page-item @(currentPage >= totalPages ? "disabled" : "")" title="Trang cuối">
                        <a class="page-link" asp-action="QuanLy" asp-route-page="@totalPages" asp-route-searchString="@currentSearch" asp-route-trangThai="@currentTrangThai">
                            <i class="bi bi-chevron-double-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
            }
        </div>
    </div>
    </div>
</div>

<!-- MODAL THÊM MỚI MÔN HỌC (POPUP TRỰC TIẾP TRONG TRANG - CHUẨN GIAO DIỆN TÀI KHOẢN) -->
<div class="modal fade" id="commonCreateMonHocModal" tabindex="-1" aria-labelledby="commonCreateMonHocModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered role-modal-dialog" style="max-width: 600px;">
        <div class="modal-content role-modal-content">
            <div class="role-modal-header">
                <div class="d-flex align-items-center gap-3">
                    <span class="role-modal-header-icon" style="background: #eff6ff; color: #0066ff; border-color: #dbeafe;">
                        <i class="bi bi-plus-circle-fill"></i>
                    </span>
                    <div>
                        <h5 class="role-modal-title" id="commonCreateMonHocModalLabel">
                            Thêm môn học mới
                        </h5>
                        <div class="role-modal-sub">Khởi tạo học phần mới vào khung chương trình đào tạo tín chỉ</div>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>

            <form method="post" id="formCreateMonHoc" asp-action="Create">
                @Html.AntiForgeryToken()

                <div class="role-modal-body text-start">
                    <!-- Thông báo lỗi khi submit (nếu có) -->
                    <div id="createMonHocAlert" class="alert alert-danger py-2 small d-none mb-3" role="alert"></div>

                    <!-- Banner nhận diện tạo mới -->
                    <div class="role-user-card mb-3" style="background: #f0fdf4; border-color: #bbf7d0;">
                        <div class="d-flex align-items-center gap-3 overflow-hidden">
                            <span class="role-user-avatar" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%);">
                                <i class="bi bi-journal-plus fs-5 text-white"></i>
                            </span>
                            <div class="role-user-info overflow-hidden">
                                <div class="role-user-name text-truncate text-dark fw-bold">Môn học đào tạo mới</div>
                                <div class="role-user-meta text-truncate text-muted">
                                    Mã môn sẽ được hệ thống sinh tự động (#MH...)
                                </div>
                            </div>
                        </div>
                        <div class="flex-shrink-0">
                            <span class="badge bg-success-subtle text-success border border-success-subtle py-1 px-2 uneti-fs-xs fw-semibold">
                                <i class="bi bi-stars me-1"></i>Tạo mới
                            </span>
                        </div>
                    </div>

                    <!-- PHẦN 1: TÊN MÔN HỌC -->
                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark small mb-1">
                            Tên môn học <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="bi bi-book"></i></span>
                            <input type="text" name="TenMonHoc" id="createMonHocTen" class="form-control" placeholder="Ví dụ: Lập trình Cloud với AWS..." required />
                        </div>
                    </div>

                    <!-- PHẦN 2: ĐỊNH MỨC TÍN CHỈ & HỌC PHÍ -->
                    <div class="card bg-light border-0 rounded-3 p-3 mb-3">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="fw-semibold small text-dark">
                                <i class="bi bi-cash-stack text-success me-1"></i>Công cụ tính học phí tức thì
                            </span>
                            <span class="badge bg-white text-primary border small" id="createMonHocFormulaBadge">
                                3 TC × 1.000.000 đ = 3.000.000 đ
                            </span>
                        </div>

                        <div class="row g-2">
                            <div class="col-sm-4">
                                <label class="form-label fw-bold text-dark small mb-1">
                                    Số tín chỉ <span class="text-danger">*</span>
                                </label>
                                <input type="number" name="SoTinChi" id="createMonHocSoTinChi" min="1" max="10" value="3" class="form-control bg-white" required />
                            </div>

                            <div class="col-sm-4">
                                <label class="form-label fw-bold text-dark small mb-1">
                                    Đơn giá 1 tín chỉ
                                </label>
                                <div class="input-group">
                                    <input type="number" id="createMonHocDonGia" class="form-control bg-white" value="1000000" min="100000" step="50000" />
                                    <span class="input-group-text bg-white text-muted small">đ</span>
                                </div>
                                <div class="d-flex gap-1 mt-1">
                                    <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1 rounded-pill js-create-dongia" style="font-size: 11px;" data-price="800000">800k</button>
                                    <button type="button" class="btn btn-sm btn-outline-primary py-0 px-1 rounded-pill js-create-dongia" style="font-size: 11px;" data-price="1000000">1.0tr</button>
                                    <button type="button" class="btn btn-sm btn-outline-primary py-0 px-1 rounded-pill js-create-dongia" style="font-size: 11px;" data-price="1200000">1.2tr</button>
                                </div>
                            </div>

                            <div class="col-sm-4">
                                <label class="form-label fw-bold text-dark small mb-1">
                                    Học phí định mức <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <input type="number" name="HocPhi" id="createMonHocHocPhi" value="3000000" min="0" step="1000" class="form-control fw-bold bg-white" style="color: var(--uneti-primary);" required />
                                    <span class="input-group-text bg-white text-muted small">đ</span>
                                </div>
