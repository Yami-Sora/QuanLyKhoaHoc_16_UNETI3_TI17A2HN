@*
    Họ và tên: Trần Văn Thành
    Mã sinh viên: 23103100076
    Nội dung: Quản trị môn học
*@

@model IEnumerable<HeThongQuanLyKhoaHocVaDangKy_3_UNETI3_TIN17A2HN.Models.MonHoc>
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var userRole = Context.Session.GetString("VaiTro");
    var isAdmin = userRole == "Admin";
    var isManager = userRole == "Admin" || userRole == "NhanVien";

    ViewData["Title"] = "Quản lý môn học";
    int totalCount = ViewBag.TotalCount ?? (Model?.Count() ?? 0);
    int activeCount = ViewBag.ActiveCount ?? (Model?.Count(m => m.TrangThai) ?? 0);
    int inactiveCount = ViewBag.InactiveCount ?? (Model?.Count(m => !m.TrangThai) ?? 0);
    int totalTinChi = ViewBag.TotalTinChi ?? (Model?.Sum(m => m.SoTinChi) ?? 0);
    int avgHocPhi = ViewBag.AvgHocPhi ?? (Model?.Any() == true ? (int)(Math.Floor(Model.Average(m => m.HocPhi) / 1000m) * 1000m) : 0);
    bool? currentTrangThai = ViewBag.CurrentTrangThai;
    var currentSearch = ViewBag.CurrentSearch as string;

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int pageSize = ViewBag.PageSize ?? 10;
}

<div class="container-fluid py-2">
    <!-- Header trang Quản lý cho Admin & Nhân viên -->
    <div class="dl-page-head">
        <div>
            <h4 class="dl-page-title">
                <i class="bi bi-book-half me-2 text-primary"></i>DANH MỤC MÔN HỌC
            </h4>
            <p class="dl-page-sub">Hệ thống quản lý dữ liệu môn học, định mức học phí và trạng thái mở lớp đào tạo theo học chế tín chỉ</p>
        </div>
        <div class="mt-2 mt-md-0 d-flex gap-2">
            @if (isManager)
            {
                <a asp-action="Create" class="btn uneti-btn-primary shadow-sm text-decoration-none">
                    <i class="bi bi-plus-circle me-1"></i>Thêm môn học mới
                </a>
            }
        </div>
    </div>

    <!-- 4 thẻ thống kê (dùng chung thiết kế với Giảng viên / Tài khoản) -->
    <div class="row g-3 mb-3">
        <!-- 1. Tổng số môn học -->
        <div class="col-sm-6 col-xl-3">
            <a asp-action="QuanLy" class="dl-stat-card dl-blue @(currentTrangThai == null ? "dl-active" : "")" title="Xem tất cả môn học">
                <span class="dl-stat-icon"><i class="bi bi-journal-bookmark"></i></span>
                <span>
                    <span class="dl-stat-label">Tổng số môn học</span>
                    <span class="dl-stat-num"><span data-count-to="@totalCount">@totalCount</span></span>
                    <span class="dl-stat-sub">Môn trong khung đào tạo</span>
                </span>
            </a>
        </div>

        <!-- 2. Đang mở giảng dạy -->
        <div class="col-sm-6 col-xl-3">
            <a asp-action="QuanLy" asp-route-trangThai="true" class="dl-stat-card dl-green @(currentTrangThai == true ? "dl-active" : "")" title="Lọc các môn đang mở">
                <span class="dl-stat-icon"><i class="bi bi-check2-circle"></i></span>
                <span>
                    <span class="dl-stat-label">Đang giảng dạy</span>
                    <span class="dl-stat-num"><span data-count-to="@activeCount">@activeCount</span></span>
                    <span class="dl-stat-sub">Sẵn sàng mở khóa học</span>
                </span>
            </a>
        </div>

        <!-- 3. Tạm dừng mở lớp -->
        <div class="col-sm-6 col-xl-3">
            <a asp-action="QuanLy" asp-route-trangThai="false" class="dl-stat-card dl-red @(currentTrangThai == false ? "dl-active" : "")" title="Lọc các môn tạm dừng">
                <span class="dl-stat-icon"><i class="bi bi-pause-circle"></i></span>
                <span>
                    <span class="dl-stat-label">Tạm dừng mở lớp</span>
                    <span class="dl-stat-num"><span data-count-to="@inactiveCount">@inactiveCount</span></span>
                    <span class="dl-stat-sub">Đang bảo trì / ngưng tuyển</span>
                </span>
            </a>
        </div>

        <!-- 4. Học phí trung bình -->
        <div class="col-sm-6 col-xl-3">
            <div class="dl-stat-card dl-amber">
                <span class="dl-stat-icon"><i class="bi bi-cash-stack"></i></span>
                <span>
                    <span class="dl-stat-label">Học phí trung bình</span>
                    <span class="dl-stat-num"><span data-count-to="@avgHocPhi" data-format="number">@avgHocPhi.ToString("N0")</span> <small class="fs-6 fw-normal">đ</small></span>
                    <span class="dl-stat-sub">Tổng tích lũy: <strong>@totalTinChi</strong> tín chỉ</span>
                </span>
            </div>
        </div>
    </div>

    <!-- Thông báo TempData -->
    <noscript>
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show uneti-card border-success-subtle mb-4 py-3" role="alert">
                <i class="bi bi-check-circle-fill text-success me-2 fs-5 align-middle"></i>
                <span class="align-middle fw-semibold text-dark">@TempData["SuccessMessage"]</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show uneti-card border-danger-subtle mb-4 py-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill text-danger me-2 fs-5 align-middle"></i>
                <span class="align-middle fw-semibold text-dark">@TempData["ErrorMessage"]</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </noscript>

    <!-- THANH TÌM KIẾM & BỘ LỌC -->
    <div class="dl-filter-card">
        <form method="get" asp-action="QuanLy" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" name="searchString" value="@ViewBag.CurrentSearch" class="form-control border-start-0 ps-0" placeholder="Nhập tên môn học cần tìm..." />
                </div>
            </div>
            <div class="col-md-4">
                <select name="trangThai" class="form-select">
                    <option value="">-- Tất cả trạng thái --</option>
                    <option value="true" selected="@(currentTrangThai == true)">Đang mở giảng dạy</option>
                    <option value="false" selected="@(currentTrangThai == false)">Tạm dừng giảng dạy</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn uneti-btn-primary flex-grow-1">
                    <i class="bi bi-funnel me-1"></i>Lọc môn
                </button>
                <a asp-action="QuanLy" class="btn uneti-btn-outline" title="Xóa bộ lọc">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>

    <!-- BẢNG DANH MỤC MÔN HỌC QUẢN TRỊ -->
    <div id="monHocTableContainer" class="position-relative">
        <div class="dl-table-card">
        <!-- Đầu bảng: tiêu đề + thanh lọc nhanh trên bảng hiện tại -->
        <div class="dl-table-head">
            <div class="d-flex align-items-center gap-2">
                <span class="dl-head-ic"><i class="bi bi-list-check"></i></span>
                <span class="fw-bold text-dark">Danh sách môn học</span>
                <span class="dl-count-badge"><span id="visibleRowCount">@(Model?.Count() ?? 0)</span> môn học</span>
            </div>
            <div style="min-width: 280px;">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-filter"></i></span>
                    <input type="text" id="adminTableQuickSearch" class="form-control border-start-0" placeholder="Lọc nhanh trên bảng (tên, mã, TC)..." aria-label="Lọc nhanh trên bảng" />
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="btnClearQuickSearch" style="display:none;" title="Xóa lọc nhanh">
                        <i class="bi bi-x"></i>
                    </button>
                </div>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 uneti-table" id="monHocAdminTable">
                <thead>
                    <tr>
                        <th class="ps-3" style="width: 100px;">Mã môn</th>
                        <th>Tên môn học</th>
                        <th class="text-center" style="width: 110px;">Số tín chỉ</th>
                        <th class="text-end" style="width: 160px;">Định mức học phí</th>
                        <th class="text-center" style="width: 120px;">Khóa mở</th>
                        <th class="text-center" style="width: 140px;">Trạng thái</th>
                        <th class="text-center" style="width: 180px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    <tr id="quickSearchEmptyRow" style="display: none;">
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-search fs-2 d-block mb-2 text-secondary"></i>
                            <div>Không tìm thấy môn học nào khớp với từ khóa "<strong><span id="quickSearchTerm"></span></strong>".</div>
                            <button type="button" class="btn btn-sm uneti-btn-outline mt-3 rounded-pill" id="btnResetQuickFilter">
                                <i class="bi bi-arrow-counterclockwise me-1"></i>Xóa lọc nhanh
                            </button>
                        </td>
                    </tr>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>Không tìm thấy môn học nào phù hợp.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-bold text-muted">@($"#MH{item.MaMonHoc:D3}")</td>
                                <td>
                                    <div class="fw-bold text-dark">@item.TenMonHoc</div>
                                    @if (!string.IsNullOrEmpty(item.MoTa))
                                    {
                                        <small class="text-muted text-truncate d-block uneti-max-w-340">@item.MoTa</small>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="uneti-badge-primary">
                                        @item.SoTinChi TC
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="fw-bold text-primary">
                                        @item.HocPhi.ToString("N0") đ
                                    </div>
                                    <div class="text-muted small uneti-fs-xs">
                                        ~@((item.SoTinChi > 0 ? Math.Round((item.HocPhi / item.SoTinChi) / 1000m, MidpointRounding.AwayFromZero) * 1000m : 0m).ToString("N0")) đ/tín
                                    </div>
                                </td>
                                <td class="text-center">
                                    @if (item.KhoaHocs != null && item.KhoaHocs.Any())
                                    {
                                        <span class="badge bg-light text-dark border">
                                            <i class="bi bi-mortarboard me-1 text-primary"></i>@item.KhoaHocs.Count lớp
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Chưa mở</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (item.TrangThai)
                                    {
                                        <span class="uneti-badge-success">
                                            <i class="bi bi-check-circle me-1"></i>Đang mở
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="uneti-badge-danger">
                                            <i class="bi bi-pause-circle me-1"></i>Tạm dừng
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="d-inline-flex align-items-center justify-content-center gap-1">
                                        <a asp-action="Details" asp-route-id="@item.MaMonHoc" class="btn-action-icon btn-action-view" title="Xem chi tiết môn học">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        @if (isManager)
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.MaMonHoc" class="btn-action-icon btn-action-edit" title="Chỉnh sửa môn học">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <form asp-action="ToggleStatus" asp-route-id="@item.MaMonHoc" method="post" class="d-inline m-0 p-0"
                                                  data-uneti-confirm="Bạn có chắc chắn muốn thay đổi trạng thái môn '@item.TenMonHoc' sang @(item.TrangThai ? "Tạm dừng" : "Đang mở")?"
                                                  data-uneti-title="Đổi trạng thái môn học"
                                                  data-uneti-type="warning"
                                                  data-uneti-ok="Đổi trạng thái">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn-action-icon btn-action-toggle" title="Đổi trạng thái Đang mở / Tạm dừng">
                                                    <i class="bi bi-arrow-repeat"></i>
                                                </button>
                                            </form>
                                        }
                                        @if (isAdmin)
                                        {
                                            <a asp-action="Delete" asp-route-id="@item.MaMonHoc" class="btn-action-icon btn-action-delete" title="Xóa môn học">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <!-- Chân bảng gộp: tổng số + phân trang cùng 1 hàng, nằm trong cùng thẻ bảng -->
        <div class="dl-table-foot">
            <span class="small text-muted">Hiển thị <strong><span id="summaryRowCount">@(Model?.Count() ?? 0)</span></strong> trên tổng số <strong>@totalCount</strong> môn học @if (totalPages > 1) { <text>• Trang <strong>@currentPage</strong>/<strong>@totalPages</strong></text> }</span>
            @if (totalPages > 1)
            {
            <nav aria-label="Phân trang danh mục môn học">
                <ul class="pagination uneti-pagination mb-0">
                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")" title="Trang đầu">
                        <a class="page-link" asp-action="QuanLy" asp-route-page="1" asp-route-searchString="@currentSearch" asp-route-trangThai="@currentTrangThai">
                            <i class="bi bi-chevron-double-left"></i>
                        </a>
                    </li>
                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")" title="Trang trước">
                        <a class="page-link" asp-action="QuanLy" asp-route-page="@(currentPage - 1)" asp-route-searchString="@currentSearch" asp-route-trangThai="@currentTrangThai">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>
                    @for (int p = 1; p <= totalPages; p++)
                    {
                        if (totalPages > 7 && Math.Abs(p - currentPage) > 2 && p != 1 && p != totalPages)
                        {
                            if (p == currentPage - 3 || p == currentPage + 3)
                            {
                                <li class="page-item disabled"><span class="page-ellipsis">…</span></li>
                            }
                            continue;
                        }
                        <li class="page-item @(p == currentPage ? "active" : "")">
                            <a class="page-link" asp-action="QuanLy" asp-route-page="@p" asp-route-searchString="@currentSearch" asp-route-trangThai="@currentTrangThai">@p</a>
                        </li>
                    }
                    <li class="page-item @(currentPage >= totalPages ? "disabled" : "")" title="Trang tiếp theo">
                        <a class="page-link" asp-action="QuanLy" asp-route-page="@(currentPage + 1)" asp-route-searchString="@currentSearch" asp-route-trangThai="@currentTrangThai">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                    <li class="page-item @(currentPage >= totalPages ? "disabled" : "")" title="Trang cuối">
                        <a class="page-link" asp-action="QuanLy" asp-route-page="@totalPages" asp-route-searchString="@currentSearch" asp-route-trangThai="@currentTrangThai">
                            <i class="bi bi-chevron-double-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
            }
        </div>
    </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            // 1. Lọc nhanh trong bảng môn học
            function initQuickSearch() {
                const searchInput = document.getElementById('adminTableQuickSearch');
                const clearBtn = document.getElementById('btnClearQuickSearch');
                const resetBtn = document.getElementById('btnResetQuickFilter');
                const emptyRow = document.getElementById('quickSearchEmptyRow');
                const visibleCountEl = document.getElementById('visibleRowCount');
                const summaryCountEl = document.getElementById('summaryRowCount');
                const table = document.getElementById('monHocAdminTable');
                if (!searchInput || !table) return;

                const rows = table.querySelectorAll('tbody tr:not(#quickSearchEmptyRow)');

                function doFilter() {
                    const term = searchInput.value.trim().toLowerCase();
                    if (clearBtn) clearBtn.style.display = term ? 'inline-block' : 'none';
                    let visibleCount = 0;

                    rows.forEach(function (row) {
                        const text = row.textContent.toLowerCase();
                        if (!term || text.indexOf(term) !== -1) {
                            row.style.display = '';
                            visibleCount++;
                        } else {
                            row.style.display = 'none';
                        }
                    });

                    if (visibleCountEl) visibleCountEl.textContent = visibleCount;
                    if (summaryCountEl) summaryCountEl.textContent = visibleCount;
                    if (emptyRow) {
                        emptyRow.style.display = (visibleCount === 0 && rows.length > 0) ? '' : 'none';
                        const termSpan = document.getElementById('quickSearchTerm');
                        if (termSpan) termSpan.textContent = searchInput.value;
                    }
                }

                searchInput.oninput = doFilter;

                function resetSearch() {
                    searchInput.value = '';
                    doFilter();
                    searchInput.focus();
                }

                if (clearBtn) clearBtn.onclick = resetSearch;
                if (resetBtn) resetBtn.onclick = resetSearch;

                if (searchInput.value.trim()) {
                    doFilter();
                }
            }

            initQuickSearch();

            // 2. Phân trang AJAX giữ nguyên vị trí cuộn ("Đứng yên", không nhảy lên đầu)
            const tableContainer = document.getElementById('monHocTableContainer');
            if (tableContainer) {
                tableContainer.addEventListener('click', async function (e) {
                    const link = e.target.closest('.uneti-pagination a, .pagination a');
                    if (!link) return;

                    const item = link.closest('.page-item');
                    if (item && (item.classList.contains('disabled') || item.classList.contains('active'))) {
                        e.preventDefault();
                        return;
                    }

                    const href = link.getAttribute('href');
                    if (!href || href === '#' || href.startsWith('javascript:')) return;

                    e.preventDefault();

                    tableContainer.style.transition = 'opacity 0.15s ease';
                    tableContainer.style.opacity = '0.45';
                    tableContainer.style.pointerEvents = 'none';

                    try {
                        const response = await fetch(href, {
                            headers: { 'X-Requested-With': 'XMLHttpRequest' }
                        });
                        if (!response.ok) throw new Error('Network error ' + response.status);

                        const html = await response.text();
                        const parser = new DOMParser();
                        const doc = parser.parseFromString(html, 'text/html');
                        const newContainer = doc.getElementById('monHocTableContainer');

                        if (newContainer) {
                            tableContainer.innerHTML = newContainer.innerHTML;
                            window.history.pushState({ path: href }, '', href);
                            initQuickSearch();

                            if (window.bootstrap && typeof window.bootstrap.Tooltip === 'function') {
                                tableContainer.querySelectorAll('[title]').forEach(function (el) {
                                    new bootstrap.Tooltip(el);
                                });
                            }
                        } else {
                            window.location.href = href;
                        }
                    } catch (err) {
                        console.error('AJAX pagination error:', err);
                        window.location.href = href;
                    } finally {
                        tableContainer.style.opacity = '1';
                        tableContainer.style.pointerEvents = '';
                    }
                });

                window.addEventListener('popstate', async function () {
                    try {
                        tableContainer.style.opacity = '0.45';
                        const res = await fetch(window.location.href, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                        if (res.ok) {
                            const doc = new DOMParser().parseFromString(await res.text(), 'text/html');
                            const newContainer = doc.getElementById('monHocTableContainer');
                            if (newContainer) {
                                tableContainer.innerHTML = newContainer.innerHTML;
                                initQuickSearch();
                            }
                        }
                    } finally {
                        tableContainer.style.opacity = '1';
                    }
                });
            }
        })();
    </script>
}
