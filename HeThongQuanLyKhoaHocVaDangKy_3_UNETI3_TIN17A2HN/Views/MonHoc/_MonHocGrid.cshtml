@*
    Họ và tên: Trần Văn Thành
    Mã sinh viên: 23103100076
    Nội dung: Lưới môn học & phân trang AJAX
*@

@model IEnumerable<HeThongQuanLyKhoaHocVaDangKy_3_UNETI3_TIN17A2HN.Models.MonHoc>
@using HeThongQuanLyKhoaHocVaDangKy_3_UNETI3_TIN17A2HN.Helpers
@{
    int totalCount = ViewBag.TotalCount ?? 0;
    int totalFiltered = ViewBag.TotalFilteredItems ?? (Model?.Count() ?? 0);
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int? currentTinChi = ViewBag.CurrentTinChi;
    bool? currentTrangThai = ViewBag.CurrentTrangThai;
    var currentSearch = ViewBag.CurrentSearch as string;
    var sortBy = ViewBag.SortBy as string;
    bool hasActiveFilter = !string.IsNullOrWhiteSpace(currentSearch) || currentTinChi.HasValue || currentTrangThai.HasValue;
}

@functions {
    public static Microsoft.AspNetCore.Html.IHtmlContent HighlightText(string? text, string? query)
    {
        if (string.IsNullOrEmpty(text)) return Microsoft.AspNetCore.Html.HtmlString.Empty;
        if (string.IsNullOrWhiteSpace(query)) return new Microsoft.AspNetCore.Html.HtmlString(System.Net.WebUtility.HtmlEncode(text));

        var escapedText = System.Net.WebUtility.HtmlEncode(text);
        var escapedQuery = System.Net.WebUtility.HtmlEncode(query.Trim());

        var index = escapedText.IndexOf(escapedQuery, System.StringComparison.OrdinalIgnoreCase);
        if (index < 0) return new Microsoft.AspNetCore.Html.HtmlString(escapedText);

        var sb = new System.Text.StringBuilder();
        int lastPos = 0;
        while (index >= 0)
        {
            sb.Append(escapedText.Substring(lastPos, index - lastPos));
            sb.Append("<mark class=\"bg-warning-subtle text-dark px-1 rounded-1 fw-bold\">");
            sb.Append(escapedText.Substring(index, escapedQuery.Length));
            sb.Append("</mark>");
            lastPos = index + escapedQuery.Length;
            index = escapedText.IndexOf(escapedQuery, lastPos, System.StringComparison.OrdinalIgnoreCase);
        }
        sb.Append(escapedText.Substring(lastPos));
        return new Microsoft.AspNetCore.Html.HtmlString(sb.ToString());
    }
}

<!-- Thanh trạng thái kết quả -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 px-1 gap-2">
    <div class="d-flex align-items-center flex-wrap gap-2 small">
        <span class="mh2-result-count">
            Hiển thị <strong>@(Model?.Count() ?? 0)</strong> / <strong>@totalFiltered</strong> môn học phù hợp (Tổng <strong>@totalCount</strong> môn)
        </span>

        @if (!string.IsNullOrWhiteSpace(currentSearch))
        {
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 rounded-pill">
                <i class="bi bi-search me-1"></i>Từ khóa: "@currentSearch"
            </span>
        }
        @if (currentTinChi.HasValue)
        {
            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1 rounded-pill">
                <i class="bi bi-journal-text me-1"></i>@currentTinChi Tín chỉ
            </span>
        }
        @if (currentTrangThai.HasValue)
        {
            <span class="badge @(currentTrangThai == true ? "bg-success-subtle text-success border-success-subtle" : "bg-danger-subtle text-danger border-danger-subtle") border px-2 py-1 rounded-pill">
                <i class="bi bi-circle-fill me-1" style="font-size: 7px;"></i>@(currentTrangThai == true ? "Đang mở" : "Tạm dừng")
            </span>
        }
        @if (hasActiveFilter)
        {
            <button type="button" class="btn btn-link text-danger text-decoration-none p-0 ms-1 fw-semibold small js-clear-filters">
                <i class="bi bi-x-circle me-1"></i>Bỏ lọc
            </button>
        }
    </div>

    <!-- Nút chuyển Lưới / Danh sách -->
    <div class="d-flex align-items-center gap-2">
        <div class="btn-group btn-group-sm" role="group" aria-label="Chế độ hiển thị">
            <button type="button" class="btn btn-outline-secondary js-view-mode active" data-view="grid" title="Chế độ xem dạng lưới (Grid)">
                <i class="bi bi-grid-fill"></i>
            </button>
            <button type="button" class="btn btn-outline-secondary js-view-mode" data-view="list" title="Chế độ xem danh sách (List)">
                <i class="bi bi-list-ul"></i>
            </button>
        </div>
    </div>
</div>

<!-- LƯỚI / DANH SÁCH MÔN HỌC -->
<div id="monHocCardList" class="row g-4 view-grid stagger-group">
    @if (Model == null || !Model.Any())
    {
        <div class="col-12 text-center py-5">
            <div class="uneti-card p-5 mx-auto" style="max-width: 540px;">
                <svg width="84" height="84" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mx-auto mb-3">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    <line x1="8" y1="11" x2="14" y2="11"></line>
                </svg>
                <h5 class="fw-bold text-dark mb-2">Không tìm thấy môn học phù hợp</h5>
                <p class="text-muted small mb-4">
                    Không có kết quả nào khớp với điều kiện tìm kiếm hoặc bộ lọc hiện tại. Hãy thử từ khóa khác hoặc xóa bộ lọc để xem toàn bộ danh mục.
                </p>
                <button type="button" class="btn uneti-btn-primary btn-sm px-4 py-2 rounded-3 js-clear-filters">
                    <i class="bi bi-arrow-counterclockwise me-1"></i>Xóa bộ lọc & Xem tất cả
                </button>
            </div>
        </div>
    }
    else
    {
        var itemIdx = 0;
        @foreach (var item in Model)
        {
                                    <div class="col-12 col-md-6 col-lg-4 mon-hoc-col reveal" style="--i: @(itemIdx % 6);">
                @{
                    // Lấy hồ sơ nhận diện thông minh của môn học (màu sắc, logo theo đúng chuyên ngành)
                    var profile = MonHocProfileHelper.GetProfile(item);
                    var hocPhiMoiTin = item.SoTinChi > 0
                        ? Math.Round((item.HocPhi / item.SoTinChi) / 1000m, MidpointRounding.AwayFromZero) * 1000m
                        : 0m;
                }
                <article class="card mh-card @(!item.TrangThai ? "paused" : "")" style="--c1:@profile.ColorC1; --c2:@profile.ColorC2; --accent:@profile.ColorAccent;">
                    <div class="banner">
                        <div class="icon">
                            @Html.Raw(profile.IconWhiteSvg)
                        </div>
                        <span class="id">#MH@(item.MaMonHoc.ToString("D3"))</span>
                        @if (item.TrangThai)
                        {
                            <span class="status open"><i class="bi bi-circle-fill me-1" style="font-size: 6px;"></i>Đang mở</span>
                        }
                        else
                        {
                            <span class="status paused"><i class="bi bi-circle-fill me-1" style="font-size: 6px;"></i>Tạm dừng</span>
                        }
                    </div>
                    <div class="body">
                        <h3>@HighlightText(item.TenMonHoc, currentSearch)</h3>
                        <p class="desc">@(string.IsNullOrEmpty(item.MoTa) ? "Học phần đào tạo theo hệ thống tín chỉ của nhà trường." : item.MoTa)</p>
                        <div class="meta">
                            <span class="credit">
                                <i class="bi bi-mortarboard-fill"></i>
                                <span data-count-to="@item.SoTinChi" data-format="number">@item.SoTinChi</span> Tín chỉ
                            </span>
                            <span class="chip">
                                <i class="bi bi-cash-stack"></i>
                                @hocPhiMoiTin.ToString("N0") đ/tín
                            </span>
                            <strong class="price" data-count-to="@item.HocPhi" data-format="currency">
                                @item.HocPhi.ToString("N0") đ
                            </strong>
                        </div>
                        <a asp-action="Details" asp-route-id="@item.MaMonHoc" class="btn">
                            <span>Xem chi tiết môn học</span> <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </article>
            </div>
itemIdx++;
        }
    }
</div>

<!-- PHÂN TRANG (PAGINATION) -->
@if (totalPages > 1)
{
    <div class="mt-4 pt-2 d-flex justify-content-center align-items-center">
        <nav aria-label="Phân trang môn học">
            <ul class="pagination uneti-pagination-new mb-0">
                <li class="page-item @(currentPage <= 1 ? "disabled" : "")" title="Trang trước">
                    <a class="page-link js-page-link" 
                       href="?searchString=@currentSearch&soTinChi=@currentTinChi&trangThai=@currentTrangThai&sortBy=@sortBy&page=@(currentPage - 1)" 
                       data-page="@(currentPage - 1)">
                        <i class="bi bi-chevron-left small"></i>
                    </a>
                </li>

                @for (int p = 1; p <= totalPages; p++)
                {
                    if (totalPages > 7 && Math.Abs(p - currentPage) > 2 && p != 1 && p != totalPages)
                    {
                        if (p == currentPage - 3 || p == currentPage + 3)
                        {
                            <li class="page-item disabled"><span class="page-link">…</span></li>
                        }
                        continue;
                    }
                    <li class="page-item @(p == currentPage ? "active" : "")">
                        <a class="page-link js-page-link" 
                           href="?searchString=@currentSearch&soTinChi=@currentTinChi&trangThai=@currentTrangThai&sortBy=@sortBy&page=@p" 
                           data-page="@p">
                            @p
                        </a>
                    </li>
                }

                <li class="page-item @(currentPage >= totalPages ? "disabled" : "")" title="Trang tiếp">
                    <a class="page-link js-page-link" 
                       href="?searchString=@currentSearch&soTinChi=@currentTinChi&trangThai=@currentTrangThai&sortBy=@sortBy&page=@(currentPage + 1)" 
                       data-page="@(currentPage + 1)">
                        <i class="bi bi-chevron-right small"></i>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
}

