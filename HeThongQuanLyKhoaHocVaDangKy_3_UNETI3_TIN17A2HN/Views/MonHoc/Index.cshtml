@*
    Họ và tên: Trần Văn Thành
    Mã sinh viên: 23103100076
    Nội dung thực hiện: Module 1 - Cổng Danh mục Môn học (Dành cho Sinh viên & Khách tra cứu theo Lưới Thẻ Card Grid)
*@

@model IEnumerable<HeThongQuanLyKhoaHocVaDangKy_3_UNETI3_TIN17A2HN.Models.MonHoc>
@{
    var userRole = Context.Session.GetString("VaiTro");
    var hoTen = Context.Session.GetString("HoTen");
    var tenDangNhap = Context.Session.GetString("TenDangNhap");
    var isLoggedIn = Context.Session.GetInt32("MaTaiKhoan") != null;
    var isStaffOrAdmin = userRole == "Admin" || userRole == "NhanVien";

    ViewData["Title"] = "Danh mục Môn học Đào tạo - UNETI";
    int totalCount = ViewBag.TotalCount ?? Model.Count();
    int? currentTinChi = ViewBag.CurrentTinChi;
    bool? currentTrangThai = ViewBag.CurrentTrangThai;
    var currentSearch = ViewBag.CurrentSearch as string;
    bool hasActiveFilter = !string.IsNullOrWhiteSpace(currentSearch) || currentTinChi.HasValue || currentTrangThai.HasValue;
}

<div class="container py-4">
    <!-- 1. BREADCRUMB & TIÊU ĐỀ TRANG GỌN GÀNG, TINH TẾ -->
    <div class="mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2 small">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none" style="color: var(--uneti-primary);">Trang chủ</a></li>
                <li class="breadcrumb-item active text-muted" aria-current="page">Danh mục môn học</li>
            </ol>
        </nav>
        
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h3 class="fw-bold mb-1 text-dark" style="letter-spacing: -0.02em;">
                    <i class="bi bi-journal-bookmark-fill me-2" style="color: var(--uneti-primary);"></i>DANH MỤC MÔN HỌC ĐÀO TẠO
                </h3>
                <p class="text-muted mb-0 small">
                    Hệ thống học phần đào tạo theo học chế tín chỉ &bull; Trường Đại học Kinh tế - Kỹ thuật Công nghiệp (UNETI)
                </p>
            </div>

            <!-- Cụm thông tin & hành động góc phải -->
            <div class="d-flex align-items-center gap-2">
                @if (isStaffOrAdmin)
                {
                    <a asp-action="QuanLy" class="btn btn-warning text-dark fw-bold shadow-sm text-decoration-none rounded-3 btn-sm py-2 px-3">
                        <i class="bi bi-gear-fill me-1"></i>Vào Console Quản trị (Admin)
                    </a>
                }
                else if (!isLoggedIn)
                {
                    <a asp-controller="TaiKhoan" asp-action="Login" class="btn uneti-btn-primary btn-sm py-2 px-3 rounded-3 shadow-sm text-decoration-none">
                        <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập học viên
                    </a>
                }
                <span class="badge bg-white text-dark border px-3 py-2 rounded-pill fw-semibold shadow-sm small">
                    <i class="bi bi-collection text-primary me-1"></i><strong>@totalCount</strong> môn học
                </span>
            </div>
        </div>
    </div>

    @if (isStaffOrAdmin)
    {
        <div class="alert alert-info border-0 shadow-sm py-2 px-3 rounded-3 small d-flex align-items-center justify-content-between mb-4" style="background-color: #eff6ff; color: #1e40af; border: 1px solid #bfdbfe !important;">
            <div>
                <i class="bi bi-info-circle-fill me-2 fs-6 align-middle"></i>
                <span class="align-middle">Bạn đang xem chế độ <strong>Giao diện Học viên & Khách tra cứu (Card Grid)</strong>. Để thêm, sửa hoặc xóa môn học, vui lòng vào trang Quản trị.</span>
            </div>
            <a asp-action="QuanLy" class="btn btn-sm btn-primary fw-semibold ms-3 text-nowrap rounded-2 py-1 px-3" style="font-size: 12px;">
                Quản trị môn học <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
    }

    <!-- 2. THANH CÔNG CỤ TÌM KIẾM & BỘ LỌC LIỀN KHỐI (INTEGRATED TOOLBAR) -->
    <div class="uneti-card p-3 mb-3 shadow-sm" style="border-radius: 14px; border: 1px solid #e2e8f0; background: #ffffff;">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <!-- Ô tìm kiếm -->
            <div class="col-lg-5 col-md-12">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted ps-3">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" name="searchString" value="@ViewBag.CurrentSearch" 
                           class="form-control border-start-0 ps-2" 
                           placeholder="Tìm kiếm môn học theo tên môn hoặc mã môn..." 
                           style="border-color: #cbd5e1; font-size: 14px;" />
                </div>
            </div>

            <!-- Lọc số tín chỉ -->
            <div class="col-lg-3 col-sm-6">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted">
                        <i class="bi bi-journal-text"></i>
                    </span>
                    <select name="soTinChi" class="form-select border-start-0 ps-2" style="border-color: #cbd5e1; font-size: 13.5px;">
                        <option value="">-- Tất cả số tín chỉ --</option>
                        <option value="2" selected="@(currentTinChi == 2)">2 Tín chỉ</option>
                        <option value="3" selected="@(currentTinChi == 3)">3 Tín chỉ</option>
                        <option value="4" selected="@(currentTinChi == 4)">4 Tín chỉ</option>
                        <option value="5" selected="@(currentTinChi == 5)">5 Tín chỉ</option>
                    </select>
                </div>
            </div>

            <!-- Lọc trạng thái -->
            <div class="col-lg-2 col-sm-6">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted">
                        <i class="bi bi-activity"></i>
                    </span>
                    <select name="trangThai" class="form-select border-start-0 ps-2" style="border-color: #cbd5e1; font-size: 13.5px;">
                        <option value="">-- Trạng thái --</option>
                        <option value="true" selected="@(currentTrangThai == true)">Đang mở</option>
                        <option value="false" selected="@(currentTrangThai == false)">Tạm dừng</option>
                    </select>
                </div>
            </div>

            <!-- Cụm nút hành động -->
            <div class="col-lg-2 col-md-12 d-flex gap-2">
                <button type="submit" class="btn uneti-btn-primary flex-grow-1 d-flex align-items-center justify-content-center gap-1 shadow-sm" style="font-size: 13.5px;">
                    <i class="bi bi-funnel-fill"></i>
                    <span>Lọc môn</span>
                </button>
                @if (hasActiveFilter)
                {
                    <a asp-action="Index" class="btn btn-outline-danger px-3 d-flex align-items-center justify-content-center" title="Xóa bộ lọc" style="border-radius: 8px;">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
                else
                {
                    <a asp-action="Index" class="btn uneti-btn-outline px-3 d-flex align-items-center justify-content-center" title="Làm mới" style="border-radius: 8px;">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                }
            </div>
        </form>
    </div>

    <!-- 3. THANH THÔNG TIN TRẠNG THÁI KẾT QUẢ & BỘ LỌC ĐANG ÁP DỤNG -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 px-1 gap-2">
        <div class="d-flex align-items-center flex-wrap gap-2 small">
            <span class="text-muted">
                Tìm thấy <strong class="text-dark">@Model.Count()</strong> môn học
            </span>

            @if (!string.IsNullOrWhiteSpace(currentSearch))
            {
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 rounded-pill">
                    <i class="bi bi-search me-1"></i>Từ khóa: "@currentSearch"
                </span>
            }
            @if (currentTinChi.HasValue)
            {
                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1 rounded-pill">
                    <i class="bi bi-journal-text me-1"></i>@currentTinChi Tín chỉ
                </span>
            }
            @if (currentTrangThai.HasValue)
            {
                <span class="badge @(currentTrangThai == true ? "bg-success-subtle text-success border-success-subtle" : "bg-danger-subtle text-danger border-danger-subtle") border px-2 py-1 rounded-pill">
                    <i class="bi bi-circle-fill me-1" style="font-size: 7px;"></i>@(currentTrangThai == true ? "Đang mở" : "Tạm dừng")
                </span>
            }
            @if (hasActiveFilter)
            {
                <a asp-action="Index" class="text-danger text-decoration-none ms-1 fw-semibold small">
                    <i class="bi bi-x-circle me-1"></i>Bỏ lọc
                </a>
            }
        </div>

        <div class="small text-muted d-none d-sm-block">
            <i class="bi bi-info-circle me-1 text-primary"></i>Học phí được tính định mức theo số tín chỉ
        </div>
    </div>

    <!-- 4. LƯỚI DANH MỤC THẺ CARD (GIỮ NGUYÊN HOÀN TOÀN CẤU TRÚC ĐẸP) -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5">
                <div class="uneti-card p-5">
                    <i class="bi bi-search fs-1 text-muted d-block mb-3"></i>
                    <h5 class="fw-bold text-dark">Không tìm thấy môn học nào</h5>
                    <p class="text-muted small">Hãy thử tìm kiếm với từ khóa khác hoặc làm mới bộ lọc tín chỉ.</p>
                    <a asp-action="Index" class="btn uneti-btn-outline btn-sm">
                        <i class="bi bi-arrow-clockwise me-1"></i>Xem tất cả môn học
                    </a>
                </div>
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="uneti-card uneti-card-hover h-100 p-4 d-flex flex-column" style="border-radius: 16px; border: 1px solid #e2e8f0; background: #ffffff;">
                        <!-- Hàng trên: Mã môn & Trạng thái -->
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-light text-secondary border px-2 py-1 fw-semibold" style="font-size: 12px;">#MH0@(item.MaMonHoc)</span>
                            @if (item.TrangThai)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 fw-semibold d-inline-flex align-items-center" style="font-size: 12px;">
                                    <i class="bi bi-check-circle me-1"></i>Đang mở
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 fw-semibold d-inline-flex align-items-center" style="font-size: 12px;">
                                    <i class="bi bi-pause-circle me-1"></i>Tạm dừng
                                </span>
                            }
                        </div>

                        <!-- Tên môn học -->
                        <h5 class="fw-bold text-dark mb-2" style="font-size: 1.08rem; line-height: 1.4;">
                            @item.TenMonHoc
                        </h5>

                        <!-- Mô tả tóm tắt -->
                        <p class="text-muted small flex-grow-1 mb-3" style="line-height: 1.5; min-height: 44px;">
                            @(string.IsNullOrEmpty(item.MoTa) ? "Học phần đào tạo theo hệ thống tín chỉ chuẩn UNETI." : item.MoTa)
                        </p>

                        <!-- Số tín chỉ & Định mức học phí -->
                        <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 rounded-pill fw-bold" style="font-size: 13px;">
                                @item.SoTinChi Tín chỉ
                            </span>
                            <div class="text-end">
                                <span class="fw-bold fs-5" style="color: var(--uneti-primary);">
                                    @item.HocPhi.ToString("N0") đ
                                </span>
                                <div class="text-muted small" style="font-size: 11px;">
                                    ~@((item.SoTinChi > 0 ? item.HocPhi / item.SoTinChi : 0).ToString("N0")) đ/tín
                                </div>
                            </div>
                        </div>

                        <!-- Nút xem chi tiết -->
                        <a asp-action="Details" asp-route-id="@item.MaMonHoc" class="btn btn-outline-secondary w-100 rounded-3 mt-3 fw-semibold text-dark text-decoration-none py-2 d-flex align-items-center justify-content-center" style="border-color: #e2e8f0; background-color: #fafbfc; font-size: 13.5px; transition: all 0.2s;">
                            <span>Xem chi tiết môn học</span>
                            <i class="bi bi-chevron-right ms-1 small"></i>
                        </a>
                    </div>
                </div>
            }
        }
    </div>
</div>
