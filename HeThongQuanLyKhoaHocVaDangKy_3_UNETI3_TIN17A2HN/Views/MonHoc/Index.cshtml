@*
    Họ và tên: Trần Văn Thành
    Mã sinh viên: 23103100076
    Nội dung: Danh mục môn học công khai
*@

@model IEnumerable<HeThongQuanLyKhoaHocVaDangKy_3_UNETI3_TIN17A2HN.Models.MonHoc>
@{
    var userRole = Context.Session.GetString("VaiTro");
    var hoTen = Context.Session.GetString("HoTen");
    var tenDangNhap = Context.Session.GetString("TenDangNhap");
    var isLoggedIn = Context.Session.GetInt32("MaTaiKhoan") != null;
    var isStaffOrAdmin = userRole == "Admin" || userRole == "NhanVien";

    ViewData["Title"] = "Danh mục Môn học Đào tạo";
    int totalCount = ViewBag.TotalCount ?? (Model?.Count() ?? 0);
    int? currentTinChi = ViewBag.CurrentTinChi;
    bool? currentTrangThai = ViewBag.CurrentTrangThai;
    var currentSearch = ViewBag.CurrentSearch as string;
    var sortBy = ViewBag.SortBy as string;
    bool hasActiveFilter = !string.IsNullOrWhiteSpace(currentSearch) || currentTinChi.HasValue || currentTrangThai.HasValue;
}

<div class="container py-4">
    <!-- 1. TIÊU ĐỀ TRANG GỌN GÀNG, TINH TẾ -->
    <div class="mb-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h3 class="fw-bold mb-1 text-dark" style="letter-spacing: -0.02em;">
                    <i class="bi bi-journal-bookmark-fill me-2 text-primary"></i>DANH MỤC MÔN HỌC ĐÀO TẠO
                </h3>
                <p class="text-muted mb-0 small">
                    Hệ thống học phần đào tạo theo học chế tín chỉ &bull; Trường Đại học Kinh tế - Kỹ thuật Công nghiệp
                </p>
            </div>

            <!-- Cụm thông tin & hành động góc phải -->
            <div class="d-flex align-items-center gap-2">
                @if (isStaffOrAdmin)
                {
                    <a asp-action="QuanLy" class="btn btn-warning text-dark fw-bold shadow-sm text-decoration-none rounded-3 btn-sm py-2 px-3">
                        <i class="bi bi-gear-fill me-1"></i>Vào Console Quản trị (Admin)
                    </a>
                }
                else if (!isLoggedIn)
                {
                    <a asp-controller="TaiKhoan" asp-action="Login" class="btn uneti-btn-primary btn-sm py-2 px-3 rounded-3 shadow-sm text-decoration-none">
                        <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập học viên
                    </a>
                }
                <span class="badge bg-white text-dark border px-3 py-2 rounded-pill fw-semibold shadow-sm small">
                    <i class="bi bi-collection text-primary me-1"></i><strong>@totalCount</strong> môn học
                </span>
            </div>
        </div>
    </div>

    @if (isStaffOrAdmin)
    {
        <div class="alert alert-info border-0 shadow-sm py-2 px-3 rounded-3 small d-flex align-items-center justify-content-between mb-4 bg-primary-subtle text-primary border border-primary-subtle">
            <div>
                <i class="bi bi-info-circle-fill me-2 fs-6 align-middle"></i>
                <span class="align-middle">Bạn đang xem chế độ <strong>Giao diện Học viên & Khách tra cứu (Card Grid)</strong>. Để thêm, sửa hoặc xóa môn học, vui lòng vào trang Quản trị.</span>
            </div>
            <a asp-action="QuanLy" class="btn btn-sm btn-primary fw-semibold ms-3 text-nowrap rounded-2 py-1 px-3" style="font-size: 12px;">
                Quản trị môn học <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
    }

    <!-- Thanh tìm kiếm & bộ lọc -->
    <div class="uneti-card p-3 mb-3 shadow-sm rounded-4">
        <style>
            /* Triệt tiêu hoàn toàn vệt kẻ xanh, outline, viền và shadow bên trong các input-group của bộ lọc */
            #filterForm .input-group {
                transition: border-color 0.2s ease, box-shadow 0.2s ease;
            }
            #filterForm .input-group:focus-within {
                border-color: #3b82f6 !important;
                box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12) !important;
            }
            #filterForm .input-group .form-select,
            #filterForm .input-group .form-select:focus,
            #filterForm .input-group .form-select:focus-visible,
            #filterForm .input-group .form-select:active,
            #filterForm .input-group .form-control,
            #filterForm .input-group .form-control:focus,
            #filterForm .input-group .form-control:focus-visible,
            #filterForm .input-group .form-control:active {
                border: none !important;
                border-left: none !important;
                border-right: none !important;
                outline: none !important;
                box-shadow: none !important;
                -webkit-box-shadow: none !important;
                background-color: transparent !important;
            }
            #filterForm .input-group-text {
                border: none !important;
                border-right: none !important;
                outline: none !important;
                box-shadow: none !important;
            }
        </style>
        <form id="filterForm" method="get" asp-action="Index" class="row g-2 align-items-center">
            <!-- Ô tìm kiếm tức thì (Debounced) -->
            <div class="col-lg-3 col-md-12">
                <div class="input-group rounded-pill border bg-white shadow-sm overflow-hidden" style="height: 42px;">
                    <span class="input-group-text bg-transparent border-0 text-primary ps-3 pe-2">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" id="searchString" name="searchString" value="@ViewBag.CurrentSearch" 
                           class="form-control border-0 bg-transparent shadow-none px-1" 
                           placeholder="Tìm kiếm theo tên môn học, mã môn..." 
                           autocomplete="off" style="font-size: 0.85rem; outline: none; box-shadow: none;" />
                </div>
            </div>

            <!-- Lọc số tín chỉ -->
            <div class="col-lg-2 col-sm-6">
                <div class="input-group rounded-pill border bg-white shadow-sm overflow-hidden" style="height: 42px;">
                    <span class="input-group-text bg-transparent border-0 text-primary ps-3 pe-2">
                        <i class="bi bi-circle-square"></i> <!-- Hoặc icon phù hợp -->
                    </span>
                    <select id="soTinChi" name="soTinChi" class="form-select border-0 bg-transparent shadow-none px-1 text-muted" style="font-size: 0.85rem; outline: none; border: none; box-shadow: none;">
                        <option value="">Tất cả tín chỉ</option>
                        <option value="2" selected="@(currentTinChi == 2)">2 Tín chỉ</option>
                        <option value="3" selected="@(currentTinChi == 3)">3 Tín chỉ</option>
                        <option value="4" selected="@(currentTinChi == 4)">4 Tín chỉ</option>
                        <option value="5" selected="@(currentTinChi == 5)">5 Tín chỉ</option>
                    </select>
                </div>
            </div>

            <!-- Lọc trạng thái -->
            <div class="col-lg-2 col-sm-6">
                <div class="input-group rounded-pill border bg-white shadow-sm overflow-hidden" style="height: 42px;">
                    <span class="input-group-text bg-transparent border-0 text-primary ps-3 pe-2">
                        <i class="bi bi-activity"></i>
                    </span>
                    <select id="trangThai" name="trangThai" class="form-select border-0 bg-transparent shadow-none px-1 text-muted" style="font-size: 0.85rem; outline: none; border: none; box-shadow: none;">
                        <option value="">Trạng thái</option>
                        <option value="true" selected="@(currentTrangThai == true)">Đang mở</option>
                        <option value="false" selected="@(currentTrangThai == false)">Tạm dừng</option>
                    </select>
                </div>
            </div>

            <!-- Sắp xếp danh mục -->
            <div class="col-lg-2 col-sm-6">
                <div class="input-group rounded-pill border bg-white shadow-sm overflow-hidden" style="height: 42px;">
                    <span class="input-group-text bg-transparent border-0 text-primary ps-3 pe-2">
                        <i class="bi bi-sort-down"></i>
                    </span>
                    <select id="sortBy" name="sortBy" class="form-select border-0 bg-transparent shadow-none px-1 text-muted" style="font-size: 0.85rem; outline: none; border: none; box-shadow: none;">
                        <option value="" selected="@(string.IsNullOrEmpty(sortBy))">Mã môn (Mặc định)</option>
                        <option value="ten_asc" selected="@(sortBy == "ten_asc")">Tên môn: A &rarr; Z</option>
                        <option value="ten_desc" selected="@(sortBy == "ten_desc")">Tên môn: Z &rarr; A</option>
                        <option value="tinchi_asc" selected="@(sortBy == "tinchi_asc")">Tín chỉ: Tăng dần</option>
                        <option value="tinchi_desc" selected="@(sortBy == "tinchi_desc")">Tín chỉ: Giảm dần</option>
                        <option value="hocphi_asc" selected="@(sortBy == "hocphi_asc")">Học phí: Thấp &rarr; Cao</option>
                        <option value="hocphi_desc" selected="@(sortBy == "hocphi_desc")">Học phí: Cao &rarr; Thấp</option>
                    </select>
                </div>
            </div>

            <!-- Nút hành động Lọc môn -->
            <div class="col-lg-3 col-md-12">
                <button type="submit" class="btn btn-primary w-100 d-flex align-items-center justify-content-center gap-2 shadow-sm rounded-pill fw-semibold" style="height: 42px; font-size: 0.9rem;">
                    <i class="bi bi-funnel-fill"></i>
                    Lọc môn
                </button>
            </div>
        </form>

        <!-- 3. CHIP LỌC NHANH (QUICK FILTER CHIPS) -->
        <div class="d-flex flex-wrap align-items-center gap-2 pt-3 mt-3 border-top border-light">
            <span class="small text-primary fw-semibold me-2 d-flex align-items-center gap-1">
                <i class="bi bi-tags"></i> Lọc nhanh:
            </span>
            <button type="button" class="btn btn-sm rounded-pill px-3 py-1 fw-semibold js-filter-chip-new @(!hasActiveFilter ? "btn-primary" : "bg-primary-subtle text-primary border-0")" data-type="all">
                <i class="bi bi-grid-fill me-1 small"></i> Tất cả
            </button>
            <button type="button" class="btn btn-sm rounded-pill px-3 py-1 fw-semibold js-filter-chip-new @(currentTinChi == 2 ? "btn-primary" : "bg-primary-subtle text-primary border-0")" data-type="tinchi" data-value="2">
                2 Tín chỉ
            </button>
            <button type="button" class="btn btn-sm rounded-pill px-3 py-1 fw-semibold js-filter-chip-new @(currentTinChi == 3 ? "btn-primary" : "bg-primary-subtle text-primary border-0")" data-type="tinchi" data-value="3">
                3 Tín chỉ
            </button>
            <button type="button" class="btn btn-sm rounded-pill px-3 py-1 fw-semibold js-filter-chip-new @(currentTinChi == 4 ? "btn-primary" : "bg-primary-subtle text-primary border-0")" data-type="tinchi" data-value="4">
                4 Tín chỉ
            </button>
            <button type="button" class="btn btn-sm rounded-pill px-3 py-1 fw-semibold js-filter-chip-new @(currentTinChi == 5 ? "btn-primary" : "bg-primary-subtle text-primary border-0")" data-type="tinchi" data-value="5">
                5 Tín chỉ
            </button>
            <button type="button" class="btn btn-sm rounded-pill px-3 py-1 fw-semibold js-filter-chip-new @(currentTrangThai == true ? "btn-success" : "bg-success-subtle text-success border-0")" data-type="trangthai" data-value="true">
                <i class="bi bi-check-circle-fill me-1"></i> Đang mở
            </button>
            <button type="button" class="btn btn-sm rounded-pill px-3 py-1 fw-semibold js-filter-chip-new @(currentTrangThai == false ? "btn-danger" : "bg-danger-subtle text-danger border-0")" data-type="trangthai" data-value="false">
                <i class="bi bi-pause-circle-fill me-1"></i> Tạm dừng
            </button>
        </div>
    </div>

    <!-- Danh sách môn học (AJAX) -->
    <div id="monHocGridContainer" class="position-relative min-vh-25">
        <partial name="_MonHocGrid" model="Model" />
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('filterForm');
            const searchInput = document.getElementById('searchString');
            const selectTinChi = document.getElementById('soTinChi');
            const selectTrangThai = document.getElementById('trangThai');
            const selectSortBy = document.getElementById('sortBy');
            const gridContainer = document.getElementById('monHocGridContainer');
            let debounceTimer = null;
            let currentViewMode = localStorage.getItem('uneti_monhoc_view') || 'grid';

            // Áp dụng view mode đã lưu
            function applyViewMode() {
                const cardList = document.getElementById('monHocCardList');
                if (cardList) {
                    if (currentViewMode === 'list') {
                        cardList.classList.remove('view-grid');
                        cardList.classList.add('view-list');
                    } else {
                        cardList.classList.remove('view-list');
                        cardList.classList.add('view-grid');
                    }
                }
                document.querySelectorAll('.js-view-mode').forEach(btn => {
                    btn.classList.toggle('active', btn.getAttribute('data-view') === currentViewMode);
                });
            }

            // Hiển thị khung Skeleton loading khi đang fetch
            function showSkeleton() {
                gridContainer.innerHTML = `
                    <div class="row g-4">
                        ${Array(6).fill(0).map(() => `
                            <div class="col-12 col-md-6 col-lg-4">
                                <div class="uneti-card p-4 h-100">
                                    <div class="d-flex justify-content-between mb-3">
                                        <div class="skeleton skeleton-badge"></div>
                                        <div class="skeleton skeleton-badge"></div>
                                    </div>
                                    <div class="skeleton skeleton-title"></div>
                                    <div class="skeleton skeleton-text"></div>
                                    <div class="skeleton skeleton-text" style="width: 85%;"></div>
                                    <div class="d-flex justify-content-between align-items-center pt-3 border-top mt-auto">
                                        <div class="skeleton skeleton-badge"></div>
                                        <div class="skeleton skeleton-title" style="width: 35%;"></div>
                                    </div>
                                    <div class="skeleton" style="height: 38px; border-radius: 8px; margin-top: 14px;"></div>
                                </div>
                            </div>
                        `).join('')}
                    </div>
                `;
            }

            // Gọi API nạp dữ liệu tức thì qua AJAX
            function fetchResults(isPageChange = false, page = 1) {
                const params = new URLSearchParams();
                const q = searchInput.value.trim();
                const tc = selectTinChi.value;
                const tt = selectTrangThai.value;
                const sb = selectSortBy.value;

                if (q) params.set('searchString', q);
                if (tc) params.set('soTinChi', tc);
                if (tt !== '') params.set('trangThai', tt);
                if (sb) params.set('sortBy', sb);
                if (page > 1) params.set('page', page);

                // Cập nhật URL trình duyệt
                const newUrl = window.location.pathname + (params.toString() ? '?' + params.toString() : '');
                window.history.replaceState({ path: newUrl }, '', newUrl);

                showSkeleton();

                fetch(newUrl, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                })
                .then(response => {
                    if (!response.ok) throw new Error('Network error');
                    return response.text();
                })
                .then(html => {
                    gridContainer.innerHTML = html;
                    applyViewMode();

                    // Kích hoạt lại hiệu ứng UI
                    if (window.UnetiEffects && typeof window.UnetiEffects.refresh === 'function') {
                        window.UnetiEffects.refresh();
                    }

                    // Nếu chuyển trang thì cuộn mượt nhẹ lên đầu danh sách môn học
                    if (isPageChange) {
                        const targetY = gridContainer.getBoundingClientRect().top + window.pageYOffset - 90;
                        window.scrollTo({ top: targetY, behavior: 'smooth' });
                    }
                })
                .catch(err => {
                    console.error('Fetch error:', err);
                    if (window.UnetiUI && typeof window.UnetiUI.toast === 'function') {
                        window.UnetiUI.toast({
                            type: 'danger',
                            title: 'Lỗi tải dữ liệu',
                            message: 'Không thể tải danh sách môn học. Vui lòng thử lại!'
                        });
                    }
                });
            }

            // 1. Debounce tìm kiếm tức thì 300ms
            searchInput.addEventListener('input', function () {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(() => {
                    fetchResults(false, 1);
                }, 300);
            });

            // 2. Thay đổi dropdown Lọc / Sắp xếp
            selectTinChi.addEventListener('change', () => fetchResults(false, 1));
            selectTrangThai.addEventListener('change', () => fetchResults(false, 1));
            selectSortBy.addEventListener('change', () => fetchResults(false, 1));

            // Ngăn form submit reload trang
            form.addEventListener('submit', function (e) {
                e.preventDefault();
                fetchResults(false, 1);
            });

            // 3. Xử lý Chip lọc nhanh
            document.querySelectorAll('.js-filter-chip-new').forEach(chip => {
                chip.addEventListener('click', function () {
                    const type = this.getAttribute('data-type');
                    const val = this.getAttribute('data-value');

                    if (type === 'all') {
                        selectTinChi.value = '';
                        selectTrangThai.value = '';
                    } else if (type === 'tinchi') {
                        selectTinChi.value = selectTinChi.value === val ? '' : val;
                    } else if (type === 'trangthai') {
                        selectTrangThai.value = selectTrangThai.value === val ? '' : val;
                    }

                    // Đồng bộ class trên các chips
                    document.querySelectorAll('.js-filter-chip-new').forEach(c => {
                        const cType = c.getAttribute('data-type');
                        const cVal = c.getAttribute('data-value');
                        let isActive = false;
                        if (cType === 'all') {
                            isActive = !selectTinChi.value && selectTrangThai.value === '';
                        } else if (cType === 'tinchi') {
                            isActive = selectTinChi.value === cVal;
                        } else if (cType === 'trangthai') {
                            isActive = selectTrangThai.value === cVal;
                        }

                        // Reset class
                        if (isActive) {
                            if (cType === 'trangthai' && cVal === 'true') {
                                c.className = 'btn btn-sm rounded-pill px-3 py-1 fw-semibold js-filter-chip-new btn-success';
                            } else if (cType === 'trangthai' && cVal === 'false') {
                                c.className = 'btn btn-sm rounded-pill px-3 py-1 fw-semibold js-filter-chip-new btn-danger';
                            } else {
                                c.className = 'btn btn-sm rounded-pill px-3 py-1 fw-semibold js-filter-chip-new btn-primary';
                            }
                        } else {
                            if (cType === 'trangthai' && cVal === 'true') {
                                c.className = 'btn btn-sm rounded-pill px-3 py-1 fw-semibold js-filter-chip-new bg-success-subtle text-success border-0';
                            } else if (cType === 'trangthai' && cVal === 'false') {
                                c.className = 'btn btn-sm rounded-pill px-3 py-1 fw-semibold js-filter-chip-new bg-danger-subtle text-danger border-0';
                            } else {
                                c.className = 'btn btn-sm rounded-pill px-3 py-1 fw-semibold js-filter-chip-new bg-primary-subtle text-primary border-0';
                            }
                        }
                    });

                    fetchResults(false, 1);
                });
            });

            // Xử lý sự kiện phân trang AJAX
            gridContainer.addEventListener('click', function (e) {
                // Chuyển trang AJAX
                const pageLink = e.target.closest('.js-page-link');
                if (pageLink && !pageLink.parentElement.classList.contains('disabled') && !pageLink.parentElement.classList.contains('active')) {
                    e.preventDefault();
                    const page = parseInt(pageLink.getAttribute('data-page'), 10) || 1;
                    fetchResults(true, page);
                    return;
                }

                // Xóa bộ lọc
                const clearBtn = e.target.closest('.js-clear-filters');
                if (clearBtn) {
                    e.preventDefault();
                    searchInput.value = '';
                    selectTinChi.value = '';
                    selectTrangThai.value = '';
                    selectSortBy.value = '';
                    document.querySelectorAll('.js-filter-chip-new').forEach(c => {
                        const cType = c.getAttribute('data-type');
                        const cVal = c.getAttribute('data-value');
                        if (cType === 'all') {
                            c.className = 'btn btn-sm rounded-pill px-3 py-1 fw-semibold js-filter-chip-new btn-primary';
                        } else {
                            if (cType === 'trangthai' && cVal === 'true') {
                                c.className = 'btn btn-sm rounded-pill px-3 py-1 fw-semibold js-filter-chip-new bg-success-subtle text-success border-0';
                            } else if (cType === 'trangthai' && cVal === 'false') {
                                c.className = 'btn btn-sm rounded-pill px-3 py-1 fw-semibold js-filter-chip-new bg-danger-subtle text-danger border-0';
                            } else {
                                c.className = 'btn btn-sm rounded-pill px-3 py-1 fw-semibold js-filter-chip-new bg-primary-subtle text-primary border-0';
                            }
                        }
                    });
                    fetchResults(false, 1);
                    return;
                }

                // Nút chuyển chế độ xem (Lưới / Danh sách)
                const viewBtn = e.target.closest('.js-view-mode');
                if (viewBtn) {
                    currentViewMode = viewBtn.getAttribute('data-view') || 'grid';
                    localStorage.setItem('uneti_monhoc_view', currentViewMode);
                    applyViewMode();
                }
            });

            // Khởi tạo chế độ xem ban đầu
            applyViewMode();
        });
    </script>
}

