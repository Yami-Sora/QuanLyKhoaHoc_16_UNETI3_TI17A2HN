@*
    Họ và tên: Trần Văn Thành
    Mã sinh viên: 23103100076
    Nội dung: Danh mục môn học công khai
*@

@model IEnumerable<HeThongQuanLyKhoaHocVaDangKy_3_UNETI3_TIN17A2HN.Models.MonHoc>
@{
    var userRole = Context.Session.GetString("VaiTro");
    var hoTen = Context.Session.GetString("HoTen");
    var tenDangNhap = Context.Session.GetString("TenDangNhap");
    var isLoggedIn = Context.Session.GetInt32("MaTaiKhoan") != null;
    var isStaffOrAdmin = userRole == "Admin" || userRole == "NhanVien";

    ViewData["Title"] = "Danh mục Môn học Đào tạo";
    int totalCount = ViewBag.TotalCount ?? (Model?.Count() ?? 0);
    int? currentTinChi = ViewBag.CurrentTinChi;
    bool? currentTrangThai = ViewBag.CurrentTrangThai;
    var currentSearch = ViewBag.CurrentSearch as string;
    var sortBy = ViewBag.SortBy as string;
    bool hasActiveFilter = !string.IsNullOrWhiteSpace(currentSearch) || currentTinChi.HasValue || currentTrangThai.HasValue;
}

<link rel="stylesheet" href="~/css/monhoc-v2.css" asp-append-version="true" />

<div class="container py-4">
    <!-- 1. BANNER TIÊU ĐỀ -->
    <div class="mh2-page-banner mb-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 position-relative" style="z-index: 2;">
            <div class="d-flex align-items-center gap-3">
                <div class="mh2-banner-icon">
                    <i class="bi bi-mortarboard-fill"></i>
                </div>
                <div>
                    <h1 class="mh2-banner-title">DANH MỤC MÔN HỌC ĐÀO TẠO</h1>
                    <p class="mh2-banner-sub">
                        Hệ thống học phần đào tạo theo học chế tín chỉ &bull; Trường Đại học Kinh tế - Kỹ thuật Công nghiệp (UNETI)
                    </p>
                </div>
            </div>

            <!-- Cụm thông tin & hành động góc phải -->
            <div class="d-flex align-items-center gap-2">
                @if (userRole == "Admin")
                {
                    <a asp-action="QuanLy" class="btn btn-sm py-2 px-3 rounded-pill fw-semibold shadow-sm mh2-admin-btn text-decoration-none">
                        <i class="bi bi-shield-lock-fill me-1"></i>Quản trị môn học
                    </a>
                }
                else if (!isLoggedIn)
                {
                    <a asp-controller="TaiKhoan" asp-action="Login" class="btn btn-light btn-sm py-2 px-3 rounded-pill shadow-sm text-decoration-none fw-bold text-primary">
                        <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập học viên
                    </a>
                }
                <span class="mh2-badge-count">
                    <i class="bi bi-journal-check text-primary"></i><strong>@totalCount</strong> môn học
                </span>
            </div>
        </div>
    </div>

    <!-- 2. HỘP CÔNG CỤ TÌM KIẾM & BỘ LỌC HIỆN ĐẠI (2 TẦNG MẠCH LẠC) -->
    <div class="mh2-filter-card">
        <form id="filterForm" method="get" asp-action="Index">
            <!-- Hidden inputs điều khiển bởi chip lọc -->
            <input type="hidden" id="soTinChi" name="soTinChi" value="@(currentTinChi?.ToString() ?? "")" />
            <input type="hidden" id="trangThai" name="trangThai" value="@(currentTrangThai.HasValue ? currentTrangThai.Value.ToString().ToLower() : "")" />

            <!-- Tầng 1: Ô tìm kiếm rộng rãi & Dropdown sắp xếp & Nút đặt lại -->
            <div class="mh2-search-row">
                <!-- Ô tìm kiếm tức thì -->
                <div class="mh2-search-input-wrap">
                    <i class="bi bi-search mh2-search-icon"></i>
                    <input type="text" id="searchString" name="searchString" value="@ViewBag.CurrentSearch"
                           class="form-control" placeholder="Tìm kiếm theo tên môn học, mã môn (MH001, C#, SQL...)"
                           autocomplete="off" />
                    <button type="button" class="mh2-search-clear-btn @(string.IsNullOrWhiteSpace(currentSearch) ? "d-none" : "")" id="btnSearchClear" title="Xóa tìm kiếm">
                        <i class="bi bi-x-circle-fill"></i>
                    </button>
                </div>

                <!-- Dropdown Sắp xếp danh mục -->
                <div class="mh2-sort-control">
                    <i class="bi bi-arrow-down-up mh2-sort-icon"></i>
                    <select id="sortBy" name="sortBy" class="form-select mh2-sort-select">
                        <option value="" selected="@(string.IsNullOrEmpty(sortBy))">Mã môn (Mặc định)</option>
                        <option value="ten_asc" selected="@(sortBy == "ten_asc")">Tên môn: A &rarr; Z</option>
                        <option value="ten_desc" selected="@(sortBy == "ten_desc")">Tên môn: Z &rarr; A</option>
                        <option value="tinchi_asc" selected="@(sortBy == "tinchi_asc")">Tín chỉ: Tăng dần</option>
                        <option value="tinchi_desc" selected="@(sortBy == "tinchi_desc")">Tín chỉ: Giảm dần</option>
                        <option value="hocphi_asc" selected="@(sortBy == "hocphi_asc")">Học phí: Thấp &rarr; Cao</option>
                        <option value="hocphi_desc" selected="@(sortBy == "hocphi_desc")">Học phí: Cao &rarr; Thấp</option>
                    </select>
                </div>

                <!-- Nút đặt lại toàn bộ bộ lọc -->
                <button type="button" class="mh2-reset-btn js-clear-filters @(!hasActiveFilter ? "d-none" : "")" id="btnResetFilters" title="Đặt lại bộ lọc">
                    <i class="bi bi-arrow-counterclockwise"></i>
                    <span>Đặt lại</span>
                </button>
            </div>

            <!-- Tầng 2: Hệ thống Chip lọc 1 chạm (Segmented Filter Chips) -->
            <div class="mh2-chips-container">
                <!-- Nhóm Tín chỉ -->
                <div class="mh2-chip-cluster">
                    <span class="mh2-chip-label">
                        <i class="bi bi-mortarboard"></i> Tín chỉ:
                    </span>
                    <button type="button" class="mh2-chip js-filter-chip-new @(!currentTinChi.HasValue ? "active" : "")" data-type="tinchi" data-value="">
                        Tất cả
                    </button>
                    <button type="button" class="mh2-chip js-filter-chip-new @(currentTinChi == 2 ? "active" : "")" data-type="tinchi" data-value="2">
                        2 Tín chỉ
                    </button>
                    <button type="button" class="mh2-chip js-filter-chip-new @(currentTinChi == 3 ? "active" : "")" data-type="tinchi" data-value="3">
                        3 Tín chỉ
                    </button>
                    <button type="button" class="mh2-chip js-filter-chip-new @(currentTinChi == 4 ? "active" : "")" data-type="tinchi" data-value="4">
                        4 Tín chỉ
                    </button>
                    <button type="button" class="mh2-chip js-filter-chip-new @(currentTinChi == 5 ? "active" : "")" data-type="tinchi" data-value="5">
                        5 Tín chỉ
                    </button>
                </div>

                <div class="mh2-chip-separator d-none d-md-block" aria-hidden="true"></div>

                <!-- Nhóm Trạng thái -->
                <div class="mh2-chip-cluster">
                    <span class="mh2-chip-label">
                        <i class="bi bi-activity"></i> Trạng thái:
                    </span>
                    <button type="button" class="mh2-chip js-filter-chip-new @(!currentTrangThai.HasValue ? "active" : "")" data-type="trangthai" data-value="">
                        Tất cả
                    </button>
                    <button type="button" class="mh2-chip mh2-chip-status-open js-filter-chip-new @(currentTrangThai == true ? "active" : "")" data-type="trangthai" data-value="true">
                        <span class="mh2-dot mh2-dot-open"></span> Đang mở
                    </button>
                    <button type="button" class="mh2-chip mh2-chip-status-paused js-filter-chip-new @(currentTrangThai == false ? "active" : "")" data-type="trangthai" data-value="false">
                        <span class="mh2-dot mh2-dot-paused"></span> Tạm dừng
                    </button>
                </div>
            </div>
        </form>
    </div>

    <!-- Danh sách môn học (AJAX) -->
    <div id="monHocGridContainer" class="position-relative min-vh-25">
        <partial name="_MonHocGrid" model="Model" />
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('filterForm');
            const searchInput = document.getElementById('searchString');
            const selectTinChi = document.getElementById('soTinChi');
            const selectTrangThai = document.getElementById('trangThai');
            const selectSortBy = document.getElementById('sortBy');
            const gridContainer = document.getElementById('monHocGridContainer');
            let debounceTimer = null;
            let currentViewMode = localStorage.getItem('uneti_monhoc_view') || 'grid';

            // Áp dụng view mode đã lưu
            function applyViewMode() {
                const cardList = document.getElementById('monHocCardList');
                if (cardList) {
                    if (currentViewMode === 'list') {
                        cardList.classList.remove('view-grid');
                        cardList.classList.add('view-list');
                    } else {
                        cardList.classList.remove('view-list');
                        cardList.classList.add('view-grid');
                    }
                }
                document.querySelectorAll('.js-view-mode').forEach(btn => {
                    btn.classList.toggle('active', btn.getAttribute('data-view') === currentViewMode);
                });
            }

            // Hiển thị khung Skeleton loading khi đang fetch
            function showSkeleton() {
                gridContainer.innerHTML = `
                    <div class="row g-4">
                        ${Array(6).fill(0).map(() => `
                            <div class="col-12 col-md-6 col-lg-4">
                                <div class="uneti-card p-4 h-100">
                                    <div class="d-flex justify-content-between mb-3">
                                        <div class="skeleton skeleton-badge"></div>
                                        <div class="skeleton skeleton-badge"></div>
                                    </div>
                                    <div class="skeleton skeleton-title"></div>
                                    <div class="skeleton skeleton-text"></div>
                                    <div class="skeleton skeleton-text" style="width: 85%;"></div>
                                    <div class="d-flex justify-content-between align-items-center pt-3 border-top mt-auto">
                                        <div class="skeleton skeleton-badge"></div>
                                        <div class="skeleton skeleton-title" style="width: 35%;"></div>
                                    </div>
                                    <div class="skeleton" style="height: 38px; border-radius: 8px; margin-top: 14px;"></div>
                                </div>
                            </div>
                        `).join('')}
                    </div>
                `;
            }

            // Gọi API nạp dữ liệu tức thì qua AJAX
            function fetchResults(isPageChange = false, page = 1) {
                const params = new URLSearchParams();
                const q = searchInput.value.trim();
                const tc = selectTinChi.value;
                const tt = selectTrangThai.value;
                const sb = selectSortBy.value;

                if (q) params.set('searchString', q);
                if (tc) params.set('soTinChi', tc);
                if (tt !== '') params.set('trangThai', tt);
                if (sb) params.set('sortBy', sb);
                if (page > 1) params.set('page', page);

                // Cập nhật URL trình duyệt
                const newUrl = window.location.pathname + (params.toString() ? '?' + params.toString() : '');
                window.history.replaceState({ path: newUrl }, '', newUrl);

                showSkeleton();

                fetch(newUrl, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                })
                .then(response => {
                    if (!response.ok) throw new Error('Network error');
                    return response.text();
                })
                .then(html => {
                    gridContainer.innerHTML = html;
                    applyViewMode();

                    // Kích hoạt lại hiệu ứng UI
                    if (window.UnetiEffects && typeof window.UnetiEffects.refresh === 'function') {
                        window.UnetiEffects.refresh();
                    }

                    // Nếu chuyển trang thì cuộn mượt nhẹ lên đầu danh sách môn học
                    if (isPageChange) {
                        const targetY = gridContainer.getBoundingClientRect().top + window.pageYOffset - 90;
                        window.scrollTo({ top: targetY, behavior: 'smooth' });
                    }
                })
                .catch(err => {
                    console.error('Fetch error:', err);
                    if (window.UnetiUI && typeof window.UnetiUI.toast === 'function') {
                        window.UnetiUI.toast({
                            type: 'danger',
                            title: 'Lỗi tải dữ liệu',
                            message: 'Không thể tải danh sách môn học. Vui lòng thử lại!'
                        });
                    }
                });
            }

            // Cập nhật trạng thái hiển thị của nút Xóa tìm kiếm và nút Đặt lại bộ lọc
            function updateFilterUI() {
                const hasSearch = searchInput && searchInput.value.trim().length > 0;
                const hasTinChi = selectTinChi && selectTinChi.value !== '';
                const hasTrangThai = selectTrangThai && selectTrangThai.value !== '';
                const hasSort = selectSortBy && selectSortBy.value !== '';

                if (btnSearchClear) {
                    btnSearchClear.classList.toggle('d-none', !hasSearch);
                }
                if (btnResetFilters) {
                    btnResetFilters.classList.toggle('d-none', !(hasSearch || hasTinChi || hasTrangThai || hasSort));
                }
            }

            // Hàm xóa toàn bộ bộ lọc
            function resetAllFilters() {
                if (searchInput) searchInput.value = '';
                if (selectTinChi) selectTinChi.value = '';
                if (selectTrangThai) selectTrangThai.value = '';
                if (selectSortBy) selectSortBy.value = '';

                // Đồng bộ lại các chip về "Tất cả"
                document.querySelectorAll('.js-filter-chip-new').forEach(c => {
                    const cVal = c.getAttribute('data-value');
                    c.classList.toggle('active', cVal === '');
                });

                updateFilterUI();
                fetchResults(false, 1);
            }

            // 1. Debounce tìm kiếm tức thì 300ms
            if (searchInput) {
                searchInput.addEventListener('input', function () {
                    updateFilterUI();
                    clearTimeout(debounceTimer);
                    debounceTimer = setTimeout(() => {
                        fetchResults(false, 1);
                    }, 300);
                });
            }

            // Nút xóa nhanh ô tìm kiếm
            if (btnSearchClear) {
                btnSearchClear.addEventListener('click', function () {
                    searchInput.value = '';
                    searchInput.focus();
                    updateFilterUI();
                    fetchResults(false, 1);
                });
            }

            // 2. Thay đổi dropdown Sắp xếp
            if (selectSortBy) {
                selectSortBy.addEventListener('change', () => {
                    updateFilterUI();
                    fetchResults(false, 1);
                });
            }

            // Ngăn form submit reload trang
            if (form) {
                form.addEventListener('submit', function (e) {
                    e.preventDefault();
                    fetchResults(false, 1);
                });
            }

            // 3. Xử lý Chip lọc nhanh (Tín chỉ & Trạng thái 1 chạm)
            document.querySelectorAll('.js-filter-chip-new').forEach(chip => {
                chip.addEventListener('click', function () {
                    const type = this.getAttribute('data-type');
                    const val = this.getAttribute('data-value');

                    if (type === 'tinchi') {
                        // Nếu bấm lại chính chip đang chọn (và val != '') -> bỏ chọn về ''
                        if (selectTinChi.value === val && val !== '') {
                            selectTinChi.value = '';
                        } else {
                            selectTinChi.value = val;
                        }
                    } else if (type === 'trangthai') {
                        if (selectTrangThai.value === val && val !== '') {
                            selectTrangThai.value = '';
                        } else {
                            selectTrangThai.value = val;
                        }
                    }

                    // Đồng bộ class .active trên các chip cùng nhóm
                    document.querySelectorAll('.js-filter-chip-new').forEach(c => {
                        const cType = c.getAttribute('data-type');
                        const cVal = c.getAttribute('data-value');
                        if (cType === 'tinchi') {
                            const isMatch = selectTinChi.value === cVal || (!selectTinChi.value && cVal === '');
                            c.classList.toggle('active', isMatch);
                        } else if (cType === 'trangthai') {
                            const isMatch = selectTrangThai.value === cVal || (!selectTrangThai.value && cVal === '');
                            c.classList.toggle('active', isMatch);
                        }
                    });

                    updateFilterUI();
                    fetchResults(false, 1);
                });
            });

            // Nút Đặt lại bộ lọc tại thanh công cụ
            if (btnResetFilters) {
                btnResetFilters.addEventListener('click', resetAllFilters);
            }

            // Xử lý sự kiện phân trang và các nút khác trong container AJAX
            gridContainer.addEventListener('click', function (e) {
                // Chuyển trang AJAX
                const pageLink = e.target.closest('.js-page-link');
                if (pageLink && !pageLink.parentElement.classList.contains('disabled') && !pageLink.parentElement.classList.contains('active')) {
                    e.preventDefault();
                    const page = parseInt(pageLink.getAttribute('data-page'), 10) || 1;
                    fetchResults(true, page);
                    return;
                }

                // Xóa bộ lọc từ grid container
                const clearBtn = e.target.closest('.js-clear-filters');
                if (clearBtn) {
                    e.preventDefault();
                    resetAllFilters();
                    return;
                }

                // Nút chuyển chế độ xem (Lưới / Danh sách)
                const viewBtn = e.target.closest('.js-view-mode');
                if (viewBtn) {
                    currentViewMode = viewBtn.getAttribute('data-view') || 'grid';
                    localStorage.setItem('uneti_monhoc_view', currentViewMode);
                    applyViewMode();
                }
            });

            // Khởi tạo trạng thái ban đầu
            updateFilterUI();
            applyViewMode();
        });
    </script>
}

