@*
    Họ và tên: Trần Văn Thành
    Mã sinh viên: 23103100076
    Nội dung thực hiện: Module 1 - Giao diện Chỉnh sửa môn học (Dữ liệu nền) - Đồng bộ UNETI kèm tự động tính học phí theo tín chỉ
*@

@model HeThongQuanLyKhoaHocVaDangKy_3_UNETI3_TIN17A2HN.Models.MonHoc
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Chỉnh sửa môn học";
    int defaultDonGia = Model.SoTinChi > 0 ? (int)Math.Round((double)Model.HocPhi / Model.SoTinChi) : 1000000;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-9 col-lg-8">
            <div class="uneti-card overflow-hidden">
                <div class="card-header py-3 px-4 text-white" style="background-color: var(--uneti-primary);">
                    <h5 class="fw-bold mb-0"><i class="bi bi-pencil-square me-2"></i>CHỈNH SỬA MÔN HỌC #MH0@(Model.MaMonHoc)</h5>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="MaMonHoc" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="TenMonHoc" class="form-label fw-semibold small text-secondary">Tên môn học <span class="text-danger">*</span></label>
                            <input asp-for="TenMonHoc" class="form-control" autofocus />
                            <span asp-validation-for="TenMonHoc" class="text-danger small"></span>
                        </div>

                        <!-- Khối tính toán học phí theo tín chỉ thông minh -->
                        <div class="card bg-light border-0 rounded-3 p-3 mb-3">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="fw-semibold small text-dark">
                                    <i class="bi bi-calculator text-primary me-1"></i>Định mức học phí theo tín chỉ
                                </span>
                                <span class="badge bg-white text-primary border small" id="formulaBadge">
                                    Công thức: Số tín chỉ × Đơn giá tín
                                </span>
                            </div>

                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label asp-for="SoTinChi" class="form-label fw-semibold small text-secondary">
                                        Số tín chỉ <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="SoTinChi" id="inputSoTinChi" type="number" min="1" max="10" class="form-control bg-white" />
                                    <span asp-validation-for="SoTinChi" class="text-danger small"></span>
                                </div>

                                <div class="col-md-4">
                                    <label class="form-label fw-semibold small text-secondary">
                                        Đơn giá 1 tín chỉ (VNĐ)
                                    </label>
                                    <div class="input-group">
                                        <input type="number" id="inputDonGia" class="form-control bg-white" value="@defaultDonGia" min="100000" step="50000" />
                                        <span class="input-group-text bg-white text-muted small">đ</span>
                                    </div>
                                    <div class="d-flex gap-1 mt-1">
                                        <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 rounded-pill" style="font-size: 11px;" onclick="setDonGia(800000)">800k</button>
                                        <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2 rounded-pill" style="font-size: 11px;" onclick="setDonGia(1000000)">1.0tr</button>
                                        <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2 rounded-pill" style="font-size: 11px;" onclick="setDonGia(1200000)">1.2tr</button>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <label asp-for="HocPhi" class="form-label fw-semibold small text-secondary">
                                        Học phí định mức (VNĐ) <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-group">
                                        <input asp-for="HocPhi" id="inputHocPhi" type="number" value="@Model.HocPhi" min="0" step="1000" class="form-control fw-bold bg-white" style="color: var(--uneti-primary);" />
                                        <span class="input-group-text bg-white text-muted small">đ</span>
                                    </div>
                                    <span asp-validation-for="HocPhi" class="text-danger small"></span>
                                    <small class="text-muted d-block mt-1" style="font-size: 11px;">(Tự động tính hoặc tùy chỉnh)</small>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="TrangThai" class="form-label fw-semibold small text-secondary">Trạng thái giảng dạy</label>
                            <select asp-for="TrangThai" class="form-select">
                                <option value="true">Đang mở giảng dạy</option>
                                <option value="false">Tạm dừng giảng dạy</option>
                            </select>
                        </div>

                        <div class="mb-4">
                            <label asp-for="MoTa" class="form-label fw-semibold small text-secondary">Mô tả tóm tắt môn học</label>
                            <textarea asp-for="MoTa" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="MoTa" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between pt-3 border-top">
                            <a asp-action="QuanLy" class="btn uneti-btn-outline text-decoration-none">
                                <i class="bi bi-arrow-left me-1"></i>Hủy bỏ & Quay lại
                            </a>
                            <button type="submit" class="btn uneti-btn-primary fw-bold px-4 shadow-sm">
                                <i class="bi bi-check2-circle me-1"></i>Cập nhật thay đổi
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function calculateHocPhi() {
            const soTinChi = parseInt(document.getElementById('inputSoTinChi').value) || 0;
            const donGia = parseInt(document.getElementById('inputDonGia').value) || 0;
            const total = soTinChi * donGia;
            document.getElementById('inputHocPhi').value = total;
            updateBadge(soTinChi, donGia, total);
        }

        function updateBadge(soTinChi, donGia, total) {
            document.getElementById('formulaBadge').innerHTML = 
                `${soTinChi} TC × ${donGia.toLocaleString('vi-VN')} đ = <strong>${total.toLocaleString('vi-VN')} đ</strong>`;
        }

        function setDonGia(price) {
            document.getElementById('inputDonGia').value = price;
            calculateHocPhi();
        }

        document.getElementById('inputSoTinChi').addEventListener('input', calculateHocPhi);
        document.getElementById('inputDonGia').addEventListener('input', calculateHocPhi);

        // Khởi tạo hiển thị công thức ban đầu
        window.addEventListener('DOMContentLoaded', function() {
            const soTinChi = parseInt(document.getElementById('inputSoTinChi').value) || 0;
            const donGia = parseInt(document.getElementById('inputDonGia').value) || 0;
            const total = parseInt(document.getElementById('inputHocPhi').value) || (soTinChi * donGia);
            updateBadge(soTinChi, donGia, total);
        });
    </script>
}
