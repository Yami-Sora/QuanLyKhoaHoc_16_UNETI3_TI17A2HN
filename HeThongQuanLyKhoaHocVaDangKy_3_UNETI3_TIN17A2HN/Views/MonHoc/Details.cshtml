@*
    Họ và tên: Trần Văn Thành
    Mã sinh viên: 23103100076
    Nội dung: Chi tiết môn học
*@

@model HeThongQuanLyKhoaHocVaDangKy_3_UNETI3_TIN17A2HN.Models.MonHoc
@{
    var userRole = Context.Session.GetString("VaiTro");
    var isStaffOrAdmin = userRole == "Admin" || userRole == "NhanVien";
    var isAdmin = userRole == "Admin";
    var hoTen = Context.Session.GetString("HoTen");
    var isLoggedIn = Context.Session.GetInt32("MaTaiKhoan") != null;
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Chi tiết môn học: " + Model.TenMonHoc;

    decimal hocPhiMoiTin = Model.SoTinChi > 0 ? Math.Round((Model.HocPhi / Model.SoTinChi) / 1000m, MidpointRounding.AwayFromZero) * 1000m : 0m;
    int tietLyThuyet = Model.SoTinChi * 10;
    int tietThucHanh = Model.SoTinChi * 5;
    int tongTietLenLop = tietLyThuyet + tietThucHanh; // Ví dụ 3 TC = 45 tiết chuẩn
    int gioTuHoc = Model.SoTinChi * 30; // 3 TC = 90 giờ tự học độc lập
    double pctLT = tongTietLenLop > 0 ? Math.Round(tietLyThuyet * 100.0 / tongTietLenLop) : 67;
    double pctTH = tongTietLenLop > 0 ? (100 - pctLT) : 33;
}

<div class="container py-4">
    <!-- BREADCRUMB ĐIỀU HƯỚNG -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-primary">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-action="@(isStaffOrAdmin ? "QuanLy" : "Index")" class="text-decoration-none text-primary">@(isStaffOrAdmin ? "Quản lý môn học" : "Danh mục môn học")</a></li>
            <li class="breadcrumb-item active text-muted" aria-current="page">@Model.TenMonHoc</li>
        </ol>
    </nav>

    <!-- HERO HEADER CARD CỦA MÔN HỌC -->
    <div class="uneti-card uneti-hero-detail p-4 p-md-5 mb-4 shadow-sm border-0 position-relative overflow-hidden reveal">
        <div class="row align-items-center g-3">
            <div class="col-lg-8">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 uneti-badge-tag">
                        <i class="bi bi-mortarboard-fill me-1"></i>TRƯỜNG ĐH KINH TẾ - KỸ THUẬT CÔNG NGHIỆP
                    </span>
                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3 py-1 uneti-badge-tag">
                        MÃ HỌC PHẦN: @($"#MH{Model.MaMonHoc:D3}")
                    </span>
                    @if (Model.TrangThai)
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 uneti-badge-tag">
                            <i class="bi bi-check-circle-fill me-1"></i>Đang mở giảng dạy
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-1 uneti-badge-tag">
                            <i class="bi bi-pause-circle-fill me-1"></i>Tạm dừng tuyển sinh
                        </span>
                    }
                </div>

                <h1 class="fw-bold text-dark mb-2 uneti-detail-title">
                    @Model.TenMonHoc
                </h1>
                <p class="text-muted mb-0 lead fs-6">
                    Học phần đào tạo theo hệ thống tín chỉ chuẩn kiểm định chất lượng giáo dục đại học.
                </p>
            </div>

            <div class="col-lg-4 text-lg-end">
                <div class="d-flex flex-wrap justify-content-lg-end gap-2">
                    <a asp-action="@(isStaffOrAdmin ? "QuanLy" : "Index")" class="btn btn-outline-secondary rounded-3 px-3 py-2 d-inline-flex align-items-center gap-2 shadow-sm text-decoration-none">
                        <i class="bi bi-arrow-left"></i>
                        <span>@(isStaffOrAdmin ? "Về Quản trị" : "Tất cả môn học")</span>
                    </a>
                    @if (isStaffOrAdmin)
                    {
                        <a asp-action="Edit" asp-route-id="@Model.MaMonHoc" class="btn btn-warning text-dark fw-bold rounded-3 px-3 py-2 d-inline-flex align-items-center gap-2 shadow-sm text-decoration-none">
                            <i class="bi bi-pencil-square"></i>
                            <span>Chỉnh sửa môn học</span>
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- 4 THẺ THÔNG SỐ NHANH (QUICK METRIC TILES) -->
    <div class="row g-3 mb-4">
        <!-- 1. Số tín chỉ -->
        <div class="col-6 col-md-3 reveal" style="--i: 0;">
            <div class="uneti-card p-3 h-100 shadow-sm d-flex align-items-center gap-3" data-tilt>
                <div class="uneti-icon-box-48 bg-primary-subtle text-primary">
                    <i class="bi bi-journal-bookmark-fill fs-4"></i>
                </div>
                <div>
                    <span class="text-muted small d-block fw-semibold text-uppercase uneti-fs-xs">Số tín chỉ</span>
                    <span class="fs-4 fw-bold text-dark lh-1">
                        <span data-count-to="@Model.SoTinChi" data-format="number">@Model.SoTinChi</span> TC
                    </span>
                </div>
            </div>
        </div>

        <!-- 2. Học phí định mức -->
        <div class="col-6 col-md-3 reveal" style="--i: 1;">
            <div class="uneti-card p-3 h-100 shadow-sm d-flex align-items-center gap-3" data-tilt>
                <div class="uneti-icon-box-48 bg-success-subtle text-success">
                    <i class="bi bi-cash-coin fs-4"></i>
                </div>
                <div>
                    <span class="text-muted small d-block fw-semibold text-uppercase uneti-fs-xs">Học phí định mức</span>
                    <span class="fs-5 fw-bold text-success lh-1" data-count-to="@Model.HocPhi" data-format="currency">
                        @Model.HocPhi.ToString("N0") đ
                    </span>
                </div>
            </div>
        </div>

        <!-- 3. Khóa học liên kết -->
        <div class="col-6 col-md-3 reveal" style="--i: 2;">
            <div class="uneti-card p-3 h-100 shadow-sm d-flex align-items-center gap-3" data-tilt>
                <div class="uneti-icon-box-48 bg-info-subtle text-info">
                    <i class="bi bi-mortarboard-fill fs-4"></i>
                </div>
                <div>
                    <span class="text-muted small d-block fw-semibold text-uppercase uneti-fs-xs">Lớp học phần mở</span>
                    @if ((Model.KhoaHocs?.Count ?? 0) > 0)
                    {
                        <span class="fs-4 fw-bold text-dark lh-1">
                            <span data-count-to="@(Model.KhoaHocs?.Count ?? 0)" data-format="number">@(Model.KhoaHocs?.Count ?? 0)</span> lớp
                        </span>
                    }
                    else
                    {
                        <div class="d-flex align-items-center gap-1.5 mt-1">
                            <span class="fs-5 fw-bold text-secondary lh-1">0</span>
                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-1.5 py-0.5 uneti-fs-xs">Chờ mở lớp</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- 4. Đơn giá mỗi tín chỉ -->
        <div class="col-6 col-md-3 reveal" style="--i: 3;">
            <div class="uneti-card p-3 h-100 shadow-sm d-flex align-items-center gap-3" data-tilt>
                <div class="uneti-icon-box-48 bg-warning-subtle text-warning">
                    <i class="bi bi-tag-fill fs-4"></i>
                </div>
                <div>
                    <span class="text-muted small d-block fw-semibold text-uppercase uneti-fs-xs">Đơn giá tín chỉ</span>
                    <span class="fs-5 fw-bold text-dark lh-1" data-count-to="@hocPhiMoiTin" data-format="currency">
                        ~@hocPhiMoiTin.ToString("N0") đ
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- KHU VỰC NỘI DUNG CHÍNH (2 CỘT CÂN ĐỐI) -->
    <div class="row g-4 align-items-start">
        <!-- Cột trái: Đề cương & chuẩn đầu ra -->
        <div class="col-lg-7 col-xl-8">
            <!-- Đề cương & chuẩn đầu ra -->
            <div class="reveal">
                <partial name="_MonHocOutcomes" model="Model" />
            </div>

            <!-- 2. DANH SÁCH LỚP HỌC PHẦN ĐÃ MỞ (KẾT NỐI MODULE 2) -->
            <div class="uneti-card p-4 shadow-sm uneti-card-surface reveal">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3 pb-2 border-bottom">
                    <div class="d-flex align-items-center gap-2">
                        <span class="uneti-icon-box-36 text-primary bg-primary-subtle">
                            <i class="bi bi-mortarboard-fill fs-5"></i>
                        </span>
                        <div>
                            <h5 class="fw-bold text-dark mb-0 fs-6">Danh sách Khóa học đã mở</h5>
                            <small class="text-muted uneti-fs-sm">Các lớp học phần mở tuyển sinh trực thuộc môn này</small>
                        </div>
                    </div>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 rounded-pill">
                        @(Model.KhoaHocs?.Count ?? 0) lớp khả dụng
                    </span>
                </div>

                @if (Model.KhoaHocs != null && Model.KhoaHocs.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 uneti-fs-13-5">
                            <thead class="table-light">
                                <tr>
                                    <th class="py-2">Mã lớp</th>
                                    <th class="py-2">Tên khóa học</th>
                                    <th class="py-2">Ngày khai giảng</th>
                                    <th class="py-2">Sĩ số</th>
                                    <th class="py-2">Hình thức</th>
                                    <th class="py-2 text-center" style="width: 170px;">Đăng ký</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var kh in Model.KhoaHocs)
                                {
                                    <tr>
                                        <td><code>#@kh.MaKhoaHoc</code></td>
                                        <td class="fw-semibold text-dark">@kh.TenKhoaHoc</td>
                                        <td>@kh.NgayBatDau.ToString("dd/MM/yyyy")</td>
                                        <td><span class="badge bg-light text-dark border">@kh.SoLuongToiDa học viên</span></td>
                                        <td><span class="badge bg-primary-subtle text-primary border border-primary-subtle">@kh.HinhThuc</span></td>
                                        <td class="text-center">
                                            @if (!isLoggedIn)
                                            {
                                                <a asp-controller="TaiKhoan" asp-action="Login" asp-route-returnUrl="@Context.Request.Path" class="btn btn-sm btn-outline-warning text-dark fw-bold px-2 py-1 shadow-sm text-nowrap uneti-fs-sm">
                                                    <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập
                                                </a>
                                            }
                                            else if (userRole == "HocVien")
                                            {
                                                <button type="button" class="btn btn-sm uneti-btn-primary px-3 py-1 shadow-sm fw-semibold text-nowrap uneti-fs-sm" onclick="UnetiUI.toast({ type: 'info', title: 'Tiếp nhận yêu cầu', message: 'Đã tiếp nhận yêu cầu đăng ký lớp [#@kh.MaKhoaHoc - @kh.TenKhoaHoc] cho học viên @hoTen! Chức năng này kết nối trực tiếp với Module 3 &amp; 4 của nhóm.' })">
                                                    <i class="bi bi-pencil-square me-1"></i>Đăng ký học
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-muted border py-1 px-2 uneti-fs-xs">
                                                    <i class="bi bi-shield-lock me-1"></i>Cán bộ
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-4 px-3 rounded-3 bg-light border border-dashed">
                        <div class="d-inline-flex justify-content-center align-items-center rounded-circle bg-white text-muted mb-2 shadow-sm" style="width: 50px; height: 50px; border: 1px solid #e2e8f0;">
                            <i class="bi bi-calendar-x fs-4 text-secondary"></i>
                        </div>
                        <h6 class="fw-bold text-dark mb-1">Hiện chưa có lớp học phần nào mở cho môn học này</h6>
                        <p class="text-muted small mb-3" style="max-width: 480px; margin: 0 auto; line-height: 1.5;">
                            Phòng Đào tạo và Khoa CNTT sẽ cập nhật lịch mở lớp vào đợt tuyển sinh tín chỉ tiếp theo. Học viên có thể tra cứu các môn học khác hoặc theo dõi thông báo.
                        </p>
                        <a asp-action="@(isStaffOrAdmin ? "QuanLy" : "Index")" class="btn btn-sm uneti-btn-outline rounded-3 px-3 py-1.5">
                            <i class="bi bi-arrow-left me-1"></i>Xem các môn học khác
                        </a>
                    </div>
                }
            </div>
        </div>

        <!-- Cột phải: Thông tin môn học -->
        <div class="col-lg-5 col-xl-4 sticky-top" style="top: 85px; z-index: 10;">
            <div class="d-flex flex-column gap-4">
                <!-- 1. THẺ THÔNG SỐ MÔN HỌC & ĐỊNH MỨC HỌC PHÍ -->
                <div class="uneti-card p-4 shadow-sm uneti-card-surface reveal">
                    <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                        <div class="d-flex align-items-center gap-2">
                            <span class="uneti-icon-box-36 bg-primary-subtle text-primary">
                                <i class="bi bi-info-circle-fill fs-5"></i>
                            </span>
                            <h5 class="fw-bold text-dark mb-0 fs-6">Thông số môn học</h5>
                        </div>
                        <span class="badge bg-light text-muted border px-2 py-1 uneti-fs-xs">Cổng đào tạo</span>
                    </div>

                    <!-- Khối Học phí nổi bật -->
                    <div class="p-3 rounded-3 text-center mb-3 position-relative overflow-hidden" 
                         style="background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%); border: 1.5px solid #bfdbfe;">
                        <span class="badge bg-white text-primary border border-primary-subtle px-2 py-1 rounded-pill fw-semibold text-uppercase uneti-fs-xs">
                            Mức học phí định mức
                        </span>
                        <div class="fs-2 fw-bold text-primary my-1" style="letter-spacing: -0.02em;">
                            <span data-count-to="@Model.HocPhi" data-format="currency">@Model.HocPhi.ToString("N0")</span> <span class="fs-6 fw-normal">đ</span>
                        </div>
                        <small class="text-secondary d-block uneti-fs-sm">
                            Đơn giá: <strong>~@hocPhiMoiTin.ToString("N0") đ</strong> / 1 tín chỉ
                        </small>
                    </div>

                    <!-- Bảng thông số chi tiết -->
                    <div class="d-flex flex-column gap-2 uneti-fs-13-5">
                        <div class="d-flex justify-content-between align-items-center py-2 px-3 rounded-2 bg-light border">
                            <span class="text-muted d-flex align-items-center gap-2">
                                <i class="bi bi-tag text-primary"></i>Mã học phần:
                            </span>
                            <code class="fw-bold fs-6">@($"#MH{Model.MaMonHoc:D3}")</code>
                        </div>

                        <div class="d-flex justify-content-between align-items-center py-2 px-3 rounded-2 bg-light border">
                            <span class="text-muted d-flex align-items-center gap-2">
                                <i class="bi bi-journal-bookmark text-primary"></i>Số tín chỉ:
                            </span>
                            <span class="fw-bold text-dark">
                                <span data-count-to="@Model.SoTinChi" data-format="number">@Model.SoTinChi</span> Tín chỉ
                            </span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center py-2 px-3 rounded-2 bg-light border">
                            <span class="text-muted d-flex align-items-center gap-2">
                                <i class="bi bi-clock-history text-primary"></i>Thời lượng lên lớp:
                            </span>
                            <span class="fw-bold text-dark">
                                <span data-count-to="@tongTietLenLop" data-format="number">@tongTietLenLop</span> tiết chuẩn
                            </span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center py-2 px-3 rounded-2 bg-light border">
                            <span class="text-muted d-flex align-items-center gap-2">
                                <i class="bi bi-check2-circle text-primary"></i>Hình thức thi:
                            </span>
                            <span class="fw-bold text-dark">Vấn đáp / Thực hành</span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center py-2 px-3 rounded-2 bg-light border">
                            <span class="text-muted d-flex align-items-center gap-2">
                                <i class="bi bi-diagram-3 text-primary"></i>Tỷ lệ đánh giá:
                            </span>
                            <span class="badge bg-white text-dark border fw-semibold" title="Chuyên cần 10% - Quá trình 30% - Cuối kỳ 60%">
                                CC 10% • GK 30% • CK 60%
                            </span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center py-2 px-3 rounded-2 bg-light border">
                            <span class="text-muted d-flex align-items-center gap-2">
                                <i class="bi bi-building text-primary"></i>Đơn vị quản lý:
                            </span>
                            <span class="fw-bold text-dark">Nhà trường</span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center py-2 px-3 rounded-2 bg-light border">
                            <span class="text-muted d-flex align-items-center gap-2">
                                <i class="bi bi-toggle2-on text-primary"></i>Trạng thái mở:
                            </span>
                            @if (Model.TrangThai)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle fw-semibold">
                                    <i class="bi bi-check-circle me-1"></i>Đang mở
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle fw-semibold">
                                    <i class="bi bi-pause-circle me-1"></i>Tạm dừng
                                </span>
                            }
                        </div>
                    </div>
                </div>

                <!-- Cơ cấu thời lượng & đánh giá -->
                <div class="uneti-card p-4 shadow-sm uneti-card-surface reveal">
                    <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                        <div class="d-flex align-items-center gap-2">
                            <span class="uneti-icon-box-36 bg-info-subtle text-info">
                                <i class="bi bi-pie-chart-fill fs-5"></i>
                            </span>
                            <h6 class="fw-bold text-dark mb-0">Cơ cấu thời lượng & Đánh giá</h6>
                        </div>
                        <span class="badge bg-light text-muted border px-2 py-0.5 uneti-fs-xs">Quy chế tín chỉ</span>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1.5">
                            <span class="fw-semibold text-dark small uneti-fs-13">Thời lượng giảng đường:</span>
                            <span class="badge bg-primary text-white uneti-fs-xs">
                                <span data-count-to="@tongTietLenLop" data-format="number">@tongTietLenLop</span> tiết chuẩn
                            </span>
                        </div>
                        
                        <div class="row g-2 text-center mb-2">
                            <div class="col-6">
                                <div class="p-2 rounded-2 bg-light border">
                                    <span class="d-block text-muted uneti-fs-xs fw-medium">LÝ THUYẾT</span>
                                    <span class="fs-5 fw-bold text-primary lh-1 d-block my-1" data-count-to="@tietLyThuyet" data-format="number">@tietLyThuyet</span>
                                    <small class="text-secondary d-block uneti-fs-xs">tiết (@pctLT%)</small>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-2 rounded-2 bg-light border">
                                    <span class="d-block text-muted uneti-fs-xs fw-medium">THỰC HÀNH</span>
                                    <span class="fs-5 fw-bold text-info lh-1 d-block my-1" data-count-to="@tietThucHanh" data-format="number">@tietThucHanh</span>
                                    <small class="text-secondary d-block uneti-fs-xs">tiết (@pctTH%)</small>
                                </div>
                            </div>
                        </div>

                        <!-- Thanh tiến độ -->
                        <div class="progress rounded-pill bg-light overflow-hidden" style="height: 8px;">
                            <div class="progress-bar bg-primary fx-progress-bar" role="progressbar" style="--w: @pctLT%; width: @pctLT%;" title="Lý thuyết: @tietLyThuyet tiết (@pctLT%)"></div>
                            <div class="progress-bar bg-info fx-progress-bar" role="progressbar" style="--w: @pctTH%; width: @pctTH%;" title="Thực hành: @tietThucHanh tiết (@pctTH%)"></div>
                        </div>
                        <div class="d-flex justify-content-between text-muted mt-1 uneti-fs-xs">
                            <span><i class="bi bi-circle-fill text-primary me-1" style="font-size: 7px;"></i>Lý thuyết (@pctLT%)</span>
                            <span><i class="bi bi-circle-fill text-info me-1" style="font-size: 7px;"></i>Thực hành (@pctTH%)</span>
                        </div>

                        <!-- Khối tự học -->
                        <div class="mt-2.5 p-2 rounded-2 border d-flex align-items-center gap-2 uneti-callout-info">
                            <i class="bi bi-lightbulb-fill text-primary fs-5"></i>
                            <div class="uneti-fs-sm lh-sm">
                                <strong class="text-dark">Tự học & Nghiên cứu: <span data-count-to="@gioTuHoc" data-format="number">@gioTuHoc</span> giờ</strong>
                                <span class="text-secondary d-block uneti-fs-xs">(30 giờ tự học/tín chỉ theo quy chế học chế tín chỉ)</span>
                            </div>
                        </div>
                    </div>

                    <!-- Chi tiết tỷ lệ đánh giá -->
                    <div class="pt-3 border-top">
                        <span class="text-dark fw-bold small d-flex align-items-center gap-1.5 mb-2 uneti-fs-13">
                            <i class="bi bi-clipboard2-check text-success"></i>Cơ cấu điểm học phần (Chuẩn học chế tín chỉ):
                        </span>
                        <div class="d-flex flex-column gap-1.5 uneti-fs-12">
                            <div class="d-flex align-items-center justify-content-between p-2 rounded-2 bg-light border">
                                <span><i class="bi bi-check2-circle text-primary me-1"></i><strong>Chuyên cần (10%):</strong> Điểm danh & thái độ</span>
                                <span class="badge bg-primary-subtle text-primary border fw-semibold">10%</span>
                            </div>
                            <div class="d-flex align-items-center justify-content-between p-2 rounded-2 bg-light border">
                                <span><i class="bi bi-journal-code text-info me-1"></i><strong>Giữa kỳ / BTL (30%):</strong> Đánh giá quá trình</span>
                                <span class="badge bg-info-subtle text-info border fw-semibold">30%</span>
                            </div>
                            <div class="d-flex align-items-center justify-content-between p-2 rounded-2 bg-light border">
                                <span><i class="bi bi-award text-success me-1"></i><strong>Thi kết thúc môn (60%):</strong> Đánh giá cuối kỳ</span>
                                <span class="badge bg-success-subtle text-success border fw-semibold">60%</span>
                            </div>
                        </div>
                        <small class="text-muted d-block mt-2 uneti-fs-xs lh-sm">
                            * Điều kiện dự thi: Không vắng quá 20% số tiết và điểm quá trình đạt từ 4.0 trở lên.
                        </small>
                    </div>
                </div>

                <!-- Thẻ hỗ trợ học tập -->
                <div class="uneti-card p-4 shadow-sm uneti-card-surface reveal">
                    <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
                        <span class="uneti-icon-box-36 bg-info-subtle text-info">
                            <i class="bi bi-headset fs-5"></i>
                        </span>
                        <div>
                            <h6 class="fw-bold text-dark mb-0">Tư vấn & Hỗ trợ học vụ</h6>
                            <small class="text-muted uneti-fs-xs">Phòng Đào tạo</small>
                        </div>
                    </div>
                    <div class="small text-muted lh-base">
                        <div class="mb-2">
                            <span class="text-dark fw-semibold d-block">Bộ phận Cố vấn học tập</span>
                            Giải đáp thắc mắc về kế hoạch đào tạo, điều kiện môn học và hướng dẫn đăng ký học phần.
                        </div>
                        <div class="p-2.5 rounded-3 bg-light border mb-2 d-flex flex-column gap-1 uneti-fs-13">
                            <div>
                                <i class="bi bi-telephone-fill text-primary me-2"></i>Hotline: <strong class="text-dark">1900 xxxx</strong>
                            </div>
                            <div>
                                <i class="bi bi-envelope-fill text-primary me-2"></i>Email: <strong class="text-dark">hotro@uneti.edu.vn</strong>
                            </div>
                            <div>
                                <i class="bi bi-geo-alt-fill text-primary me-2"></i>Địa điểm: <span class="text-secondary">Cơ sở Lĩnh Nam / Minh Khai</span>
                            </div>
                        </div>
                        <button type="button" class="btn btn-outline-primary btn-sm w-100 rounded-3 mt-1" onclick="UnetiUI.toast({ type: 'info', title: 'Tư vấn học phần', message: 'Đã tiếp nhận yêu cầu tư vấn học phần! Cố vấn học tập sẽ liên hệ phản hồi qua email học viên.' })">
                            <i class="bi bi-chat-dots me-1"></i>Gửi câu hỏi tư vấn học phần
                        </button>
                    </div>
                </div>

                @if (isAdmin)
                {
                    <!-- 4. VÙNG TÁC VỤ QUẢN TRỊ VIÊN (DANGER ZONE) -->
                    <div class="uneti-card p-3 shadow-sm rounded-3 border border-danger-subtle bg-danger-subtle reveal">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="text-danger fw-bold small d-flex align-items-center gap-1.5">
                                <i class="bi bi-shield-exclamation fs-5"></i>Vùng thao tác Quản trị
                            </span>
                            <span class="badge bg-danger text-white uneti-fs-xs">Chỉ Admin</span>
                        </div>
                        <p class="text-muted mb-2 uneti-fs-sm lh-sm">
                            Thao tác nhạy cảm với cơ sở dữ liệu. Cần xác nhận kỹ lưỡng trước khi thực hiện.
                        </p>
                        <button type="button" class="btn btn-outline-danger btn-sm w-100 rounded-3 fw-semibold py-1.5 uneti-fs-13" data-bs-toggle="modal" data-bs-target="#confirmDeleteModal">
                            <i class="bi bi-trash3-fill me-1"></i>Xóa môn học này
                        </button>
                    </div>

                    <!-- Modal xác nhận xóa môn học -->
                    <div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-labelledby="confirmDeleteModalLabel" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content rounded-4 border-0 shadow">
                                <div class="modal-header border-bottom-0 pb-0">
                                    <div class="d-flex align-items-center gap-2 text-danger">
                                        <i class="bi bi-exclamation-triangle-fill fs-4"></i>
                                        <h5 class="modal-title fw-bold" id="confirmDeleteModalLabel">Xác nhận xóa môn học</h5>
                                    </div>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body py-3">
                                    <p class="mb-2 text-dark">
                                        Bạn có chắc chắn muốn xóa môn học <strong>@Model.TenMonHoc</strong> (Mã học phần: <code>@($"#MH{Model.MaMonHoc:D3}")</code>) khỏi hệ thống?
                                    </p>
                                    <div class="alert alert-warning border-0 small py-2 px-3 mb-0 bg-warning-subtle text-warning-emphasis">
                                        <i class="bi bi-info-circle me-1"></i>Nếu môn học đã có khóa học/lớp học phần đang hoạt động, hệ thống sẽ bảo vệ toàn vẹn dữ liệu và từ chối xóa.
                                    </div>
                                </div>
                                <div class="modal-footer border-top-0 pt-0">
                                    <button type="button" class="btn btn-light rounded-3 px-3 py-1.5" data-bs-dismiss="modal">Hủy bỏ</button>
                                    <a asp-action="Delete" asp-route-id="@Model.MaMonHoc" class="btn btn-danger rounded-3 px-3 py-1.5 fw-semibold">
                                        <i class="bi bi-trash3-fill me-1"></i>Xác nhận chuyển sang trang Xóa
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
