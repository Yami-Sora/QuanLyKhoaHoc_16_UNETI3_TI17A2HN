@*
// Họ và tên: Bạch Đức Sự
// Mã sinh viên: 23103100063
// Nội dung thực hiện: Module 4 - Tiếp nhận đăng ký, Xác nhận/Hủy đăng ký và Quản lý trạng thái.
*@

@model HeThongQuanLyKhoaHocVaDangKy_3_UNETI3_TIN17A2HN.ViewModels.TiepNhanFilterViewModel
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Tiếp nhận & Quản lý Đăng ký Khóa học";
}

<div class="container-fluid py-3 px-4">
    <!-- Breadcrumb & Tiêu đề trang -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h3 class="fw-bold mb-1 text-dark">
                <i class="bi bi-card-checklist me-2" style="color: var(--uneti-primary);"></i>TIẾP NHẬN & QUẢN LÝ ĐĂNG KÝ KHÓA HỌC
            </h3>
            <p class="text-muted mb-0 small">Kiểm soát hồ sơ đăng ký, thẩm định điều kiện sĩ số, xét duyệt luồng trạng thái và quản lý công nợ học phí</p>
        </div>
        <div class="mt-2 mt-md-0 d-flex gap-2">
            <a asp-action="Create" class="btn uneti-btn-primary shadow-sm text-decoration-none d-flex align-items-center gap-1">
                <i class="bi bi-plus-circle-fill"></i>
                <span>Ghi danh tại quầy</span>
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary shadow-sm text-decoration-none d-flex align-items-center gap-1">
                <i class="bi bi-arrow-clockwise"></i>
                <span>Tải lại</span>
            </a>
        </div>
    </div>

    <!-- Thông báo TempData phản hồi -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show uneti-card border-success-subtle mb-4 py-3" role="alert">
            <i class="bi bi-check-circle-fill text-success me-2 fs-5 align-middle"></i>
            <span class="align-middle fw-semibold text-dark">@TempData["SuccessMessage"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show uneti-card border-danger-subtle mb-4 py-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill text-danger me-2 fs-5 align-middle"></i>
            <span class="align-middle fw-semibold text-dark">@TempData["ErrorMessage"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- 5 THẺ THỐNG KÊ (STAT CARDS) ĐỒNG BỘ DESIGN SYSTEM -->
    <div class="row g-3 mb-4">
        <!-- 1. Tổng số đơn -->
        <div class="col-6 col-md-4 col-xl">
            <div class="uneti-card p-3 h-100 shadow-sm border-start border-4 border-primary">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <span class="text-muted small fw-semibold text-uppercase" style="font-size: 11px;">Tổng hồ sơ</span>
                    <span class="badge bg-primary-subtle text-primary rounded-circle p-2"><i class="bi bi-files fs-6"></i></span>
                </div>
                <h3 class="fw-bold text-dark mb-0">@Model.TongSoDon</h3>
                <small class="text-secondary" style="font-size: 11px;">Tổng lượt ghi danh</small>
            </div>
        </div>

        <!-- 2. Chờ xử lý -->
        <div class="col-6 col-md-4 col-xl">
            <div class="uneti-card p-3 h-100 shadow-sm border-start border-4 border-warning">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <span class="text-muted small fw-semibold text-uppercase" style="font-size: 11px;">Chờ xử lý</span>
                    <span class="badge bg-warning-subtle text-warning-emphasis rounded-circle p-2"><i class="bi bi-hourglass-split fs-6"></i></span>
                </div>
                <h3 class="fw-bold text-warning-emphasis mb-0">@Model.SoDonChoXuLy</h3>
                <small class="text-muted" style="font-size: 11px;">Cần tiếp nhận sơ bộ</small>
            </div>
        </div>

        <!-- 3. Đang xử lý -->
        <div class="col-6 col-md-4 col-xl">
            <div class="uneti-card p-3 h-100 shadow-sm border-start border-4 border-info">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <span class="text-muted small fw-semibold text-uppercase" style="font-size: 11px;">Đang xử lý</span>
                    <span class="badge bg-info-subtle text-info-emphasis rounded-circle p-2"><i class="bi bi-gear-wide-connected fs-6"></i></span>
                </div>
                <h3 class="fw-bold text-primary mb-0">@Model.SoDonDangXuLy</h3>
                <small class="text-muted" style="font-size: 11px;">Đang thẩm định & đối soát</small>
            </div>
        </div>

        <!-- 4. Hoàn thành -->
        <div class="col-6 col-md-6 col-xl">
            <div class="uneti-card p-3 h-100 shadow-sm border-start border-4 border-success">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <span class="text-muted small fw-semibold text-uppercase" style="font-size: 11px;">Hoàn thành</span>
                    <span class="badge bg-success-subtle text-success rounded-circle p-2"><i class="bi bi-check-circle-fill fs-6"></i></span>
                </div>
                <h3 class="fw-bold text-success mb-0">@Model.SoDonHoanThanh</h3>
                <small class="text-success" style="font-size: 11px;">Đã nhập học chính thức</small>
            </div>
        </div>

        <!-- 5. Đã hủy -->
        <div class="col-12 col-md-6 col-xl">
            <div class="uneti-card p-3 h-100 shadow-sm border-start border-4 border-danger">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <span class="text-muted small fw-semibold text-uppercase" style="font-size: 11px;">Đã hủy / Từ chối</span>
                    <span class="badge bg-danger-subtle text-danger rounded-circle p-2"><i class="bi bi-x-circle-fill fs-6"></i></span>
                </div>
                <h3 class="fw-bold text-danger mb-0">@Model.SoDonBiHuy</h3>
                <small class="text-danger" style="font-size: 11px;">Không đủ điều kiện / Hủy</small>
            </div>
        </div>
    </div>

    <!-- KHỐI TÀI CHÍNH TÓM TẮT -->
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="p-3 rounded-3 bg-white border d-flex align-items-center justify-content-between shadow-sm">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-2 bg-success-subtle text-success rounded-3"><i class="bi bi-cash-stack fs-4"></i></div>
                    <div>
                        <div class="text-muted small fw-semibold">TỔNG HỌC PHÍ ĐÃ THU</div>
                        <div class="fs-5 fw-bold text-success">@Model.TongDoanhThuDaThu.ToString("N0") <small class="text-muted fs-6">VNĐ</small></div>
                    </div>
                </div>
                <span class="badge bg-success-subtle text-success border border-success-subtle">Thực thu</span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="p-3 rounded-3 bg-white border d-flex align-items-center justify-content-between shadow-sm">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-2 @(Model.TongCongNoConLai > 0 ? "bg-warning-subtle text-warning-emphasis" : "bg-success-subtle text-success") rounded-3">
                        <i class="bi @(Model.TongCongNoConLai > 0 ? "bi-receipt-cutoff" : "bi-check-circle") fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-semibold">TỔNG CÔNG NỢ HỌC PHÍ CÒN LẠI</div>
                        <div class="fs-5 fw-bold @(Model.TongCongNoConLai > 0 ? "text-warning-emphasis" : "text-success")">
                            @Model.TongCongNoConLai.ToString("N0") <small class="text-muted fs-6">VNĐ</small>
                        </div>
                    </div>
                </div>
                @if (Model.TongCongNoConLai > 0)
                {
                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">Cần thu tiếp</span>
                }
                else
                {
                    <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-check-circle me-1"></i>Đã thu đủ</span>
                }
            </div>
        </div>
    </div>

    <!-- FORM TÌM KIẾM, LỌC ĐA TIÊU CHÍ VÀ SẮP XẾP -->
    <div class="uneti-card p-3 mb-4 shadow-sm">
        <form method="get" asp-action="Index" id="filterForm">
            <div class="row g-2 align-items-end">
                <!-- Tìm kiếm từ khóa chung -->
                <div class="col-12 col-md-3">
                    <label class="form-label small fw-semibold text-secondary mb-1">
                        <i class="bi bi-search me-1"></i>Từ khóa chung
                    </label>
                    <input type="text" name="searchString" value="@Model.SearchString" class="form-control form-control-sm" placeholder="Mã đơn, tên, SĐT, Email..." />
                </div>

                <!-- Lọc trạng thái -->
                <div class="col-6 col-md-2">
                    <label class="form-label small fw-semibold text-secondary mb-1">
                        <i class="bi bi-funnel me-1"></i>Trạng thái
                    </label>
                    <select name="trangThai" class="form-select form-select-sm">
                        <option value="TatCa" selected="@(string.IsNullOrEmpty(Model.TrangThai) || Model.TrangThai == "TatCa")">-- Tất cả trạng thái --</option>
                        <option value="ChoXuLy" selected="@(Model.TrangThai == "ChoXuLy")">Chờ xử lý</option>
                        <option value="DangXuLy" selected="@(Model.TrangThai == "DangXuLy")">Đang xử lý</option>
                        <option value="HoanThanh" selected="@(Model.TrangThai == "HoanThanh")">Hoàn thành</option>
                        <option value="BiHuy" selected="@(Model.TrangThai == "BiHuy")">Đã hủy / Từ chối</option>
                    </select>
                </div>

                <!-- Lọc từ ngày -->
                <div class="col-6 col-md-2">
                    <label class="form-label small fw-semibold text-secondary mb-1">
                        <i class="bi bi-calendar-event me-1"></i>Từ ngày
                    </label>
                    <input type="date" name="tuNgay" value="@(Model.TuNgay?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
                </div>

                <!-- Lọc đến ngày -->
                <div class="col-6 col-md-2">
                    <label class="form-label small fw-semibold text-secondary mb-1">
                        <i class="bi bi-calendar-check me-1"></i>Đến ngày
                    </label>
                    <input type="date" name="denNgay" value="@(Model.DenNgay?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
                </div>

                <!-- Sắp xếp -->
                <div class="col-6 col-md-2">
                    <label class="form-label small fw-semibold text-secondary mb-1">
                        <i class="bi bi-sort-down me-1"></i>Sắp xếp
                    </label>
                    <select name="sortBy" class="form-select form-select-sm">
                        <option value="ngay_desc" selected="@(Model.SortBy == "ngay_desc")">Ngày đk: Mới nhất</option>
                        <option value="ngay_asc" selected="@(Model.SortBy == "ngay_asc")">Ngày đk: Cũ nhất</option>
                        <option value="ten_asc" selected="@(Model.SortBy == "ten_asc")">Tên học viên: A - Z</option>
                        <option value="ten_desc" selected="@(Model.SortBy == "ten_desc")">Tên học viên: Z - A</option>
                        <option value="khoahoc_asc" selected="@(Model.SortBy == "khoahoc_asc")">Khóa học: A - Z</option>
                        <option value="tiendadong_desc" selected="@(Model.SortBy == "tiendadong_desc")">Đã nộp: Cao &rarr; Thấp</option>
                        <option value="tienconlai_desc" selected="@(Model.SortBy == "tienconlai_desc")">Công nợ: Cao &rarr; Thấp</option>
                    </select>
                </div>

                <!-- Nút thao tác lọc -->
                <div class="col-12 col-md-1 d-flex gap-1">
                    <button type="submit" class="btn btn-sm uneti-btn-primary w-100" title="Tìm kiếm">
                        <i class="bi bi-filter"></i>
                    </button>
                    <a asp-action="Index" class="btn btn-sm btn-light border" title="Xóa bộ lọc">
                        <i class="bi bi-x-lg"></i>
                    </a>
                </div>
            </div>
        </form>
    </div>

    <!-- BẢNG DỮ LIỆU DANH SÁCH TIẾP NHẬN ĐĂNG KÝ -->
    <div class="uneti-card shadow-sm overflow-hidden mb-4">
        <div class="p-3 bg-white border-bottom d-flex justify-content-between align-items-center">
            <span class="fw-bold text-dark small text-uppercase">
                <i class="bi bi-table me-1 text-primary"></i>Danh sách hồ sơ đăng ký (@Model.TotalItems kết quả)
            </span>
            <div class="small text-muted">
                Trang <strong>@Model.PageIndex</strong> / <strong>@(Model.TotalPages == 0 ? 1 : Model.TotalPages)</strong>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 13.5px;">
                <thead class="table-light text-secondary border-bottom">
                    <tr>
                        <th class="text-center" style="width: 70px;">Mã đơn</th>
                        <th>Học viên</th>
                        <th>Khóa học / Môn học</th>
                        <th class="text-center">Ngày đăng ký</th>
                        <th class="text-end">Học phí / Đã nộp</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-center" style="width: 170px;">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.DanhSachDangKy != null && Model.DanhSachDangKy.Any())
                    {
                        foreach (var item in Model.DanhSachDangKy)
                        {
                            var hocPhi = item.KhoaHoc?.HocPhi ?? 0;
                            var daDong = item.SoTienDaDong;
                            var conLai = item.SoTienConLai;
                            var isPaidFull = daDong >= hocPhi && hocPhi > 0;

                            <tr>
                                <!-- Mã đơn -->
                                <td class="text-center fw-bold text-secondary">
                                    #@item.MaDangKy
                                </td>

                                <!-- Thông tin Học viên -->
                                <td>
                                    @if (item.HocVien != null)
                                    {
                                        <div class="fw-bold text-dark">
                                            <a asp-action="Details" asp-route-id="@item.MaDangKy" class="text-decoration-none text-dark hover-primary">
                                                @item.HocVien.HoTen
                                            </a>
                                        </div>
                                        <div class="small text-muted d-flex align-items-center gap-2 mt-0.5">
                                            <span><i class="bi bi-telephone text-primary me-1"></i>@item.HocVien.SoDienThoai</span>
                                            <span>•</span>
                                            <span class="text-truncate" style="max-width: 170px;" title="@item.HocVien.Email">@item.HocVien.Email</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic">Học viên ID: @item.MaHocVien</span>
                                    }
                                </td>

                                <!-- Khóa học & Môn học -->
                                <td>
                                    @if (item.KhoaHoc != null)
                                    {
                                        <div class="fw-semibold text-primary">
                                            @item.KhoaHoc.TenKhoaHoc
                                        </div>
                                        <div class="small text-muted">
                                            <i class="bi bi-book me-1"></i>@(item.KhoaHoc.MonHoc?.TenMonHoc ?? "Chưa phân môn")
                                            <span class="badge bg-light text-secondary border ms-1" style="font-size: 10px;">@item.KhoaHoc.TrangThai</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic">Khóa học ID: @item.MaKhoaHoc</span>
                                    }
                                </td>

                                <!-- Ngày đăng ký & Ngày duyệt -->
                                <td class="text-center">
                                    <div class="fw-medium text-dark">@item.NgayDangKy.ToString("dd/MM/yyyy")</div>
                                    <small class="text-muted" style="font-size: 11px;">@item.NgayDangKy.ToString("HH:mm")</small>
                                    @if (item.NgayXacNhan.HasValue)
                                    {
                                        <div class="text-success small mt-1" style="font-size: 10.5px;" title="Ngày duyệt">
                                            <i class="bi bi-check2"></i> Duyệt: @item.NgayXacNhan.Value.ToString("dd/MM/yyyy")
                                        </div>
                                    }
                                </td>

                                <!-- Tài chính: Học phí & Đã nộp -->
                                <td class="text-end">
                                    <div class="fw-bold text-dark">@daDong.ToString("N0") <small class="text-muted">đ</small></div>
                                    <div class="small">
                                        @if (isPaidFull)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-1.5 py-0.5" style="font-size: 10.5px;">Đã nộp đủ</span>
                                        }
                                        else if (conLai > 0)
                                        {
                                            <span class="text-danger fw-semibold" style="font-size: 11px;">Còn nợ: @conLai.ToString("N0") đ</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted" style="font-size: 11px;">Tổng: @hocPhi.ToString("N0") đ</span>
                                        }
                                    </div>
                                </td>

                                <!-- Trạng thái đơn -->
                                <td class="text-center">
                                    @switch (item.TrangThai)
                                    {
                                        case "ChoXuLy":
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2.5 py-1 rounded-pill fw-semibold">
                                                <i class="bi bi-clock me-1"></i>Chờ xử lý
                                            </span>
                                            break;
                                        case "DangXuLy":
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2.5 py-1 rounded-pill fw-semibold">
                                                <i class="bi bi-gear me-1"></i>Đang xử lý
                                            </span>
                                            break;
                                        case "HoanThanh":
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1 rounded-pill fw-semibold">
                                                <i class="bi bi-check-circle-fill me-1"></i>Hoàn thành
                                            </span>
                                            break;
                                        case "BiHuy":
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2.5 py-1 rounded-pill fw-semibold">
                                                <i class="bi bi-x-circle-fill me-1"></i>Đã hủy
                                            </span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary-subtle text-secondary px-2.5 py-1 rounded-pill">
                                                @item.TrangThai
                                            </span>
                                            break;
                                    }
                                </td>

                                <!-- Cột Hành động -->
                                <td class="text-center">
                                    <div class="d-flex justify-content-center align-items-center gap-1">
                                        <!-- Xem chi tiết -->
                                        <a asp-action="Details" asp-route-id="@item.MaDangKy" class="btn btn-sm btn-light border px-2 py-1" title="Xem chi tiết đơn">
                                            <i class="bi bi-eye text-primary"></i>
                                        </a>

                                        <!-- Đổi trạng thái Form chuẩn -->
                                        <a asp-action="CapNhatTrangThai" asp-route-id="@item.MaDangKy" class="btn btn-sm btn-light border px-2 py-1" title="Cập nhật trạng thái / Tài chính">
                                            <i class="bi bi-sliders text-dark"></i>
                                        </a>

                                        <!-- Thao tác nhanh tùy theo trạng thái -->
                                        @if (item.TrangThai == "ChoXuLy")
                                        {
                                            <!-- Tiếp nhận nhanh -> DangXuLy -->
                                            <form asp-action="TiepNhanNhanh" asp-route-id="@item.MaDangKy" method="post" class="d-inline" onsubmit="return confirm('Xác nhận tiếp nhận đơn này sang trạng thái ĐANG XỬ LÝ?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-primary px-2 py-1" title="Tiếp nhận đơn (Chuyển sang Đang xử lý)">
                                                    <i class="bi bi-arrow-right-circle"></i>
                                                </button>
                                            </form>

                                            <!-- Hủy đơn -->
                                            <button type="button" class="btn btn-sm btn-outline-danger px-2 py-1" title="Từ chối / Hủy đơn"
                                                    onclick="openHuyModal(@item.MaDangKy, '@item.HocVien?.HoTen', '@item.KhoaHoc?.TenKhoaHoc')">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        }
                                        else if (item.TrangThai == "DangXuLy")
                                        {
                                            <!-- Xác nhận hoàn thành -> HoanThanh -->
                                            <form asp-action="XacNhanHoanThanh" asp-route-id="@item.MaDangKy" method="post" class="d-inline" onsubmit="return confirm('Xác nhận duyệt hồ sơ này HOÀN THÀNH (Đủ điều kiện nhập học)?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-success px-2 py-1" title="Duyệt hoàn thành">
                                                    <i class="bi bi-check-lg"></i>
                                                </button>
                                            </form>

                                            <!-- Hủy đơn -->
                                            <button type="button" class="btn btn-sm btn-outline-danger px-2 py-1" title="Hủy đơn"
                                                    onclick="openHuyModal(@item.MaDangKy, '@item.HocVien?.HoTen', '@item.KhoaHoc?.TenKhoaHoc')">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        }
                                        else if (item.TrangThai == "HoanThanh")
                                        {
                                            <!-- In phiếu xác nhận -->
                                            <a asp-action="InPhieuDangKy" asp-route-id="@item.MaDangKy" target="_blank" class="btn btn-sm btn-outline-success px-2 py-1" title="In phiếu xác nhận đăng ký / Biên lai">
                                                <i class="bi bi-printer"></i>
                                            </a>
                                        }
                                        else if (item.TrangThai == "BiHuy")
                                        {
                                            <!-- Khôi phục lại trạng thái Chờ xử lý -->
                                            <a asp-action="CapNhatTrangThai" asp-route-id="@item.MaDangKy" class="btn btn-sm btn-outline-secondary px-2 py-1" title="Xem xét khôi phục">
                                                <i class="bi bi-arrow-counterclockwise"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <div class="mb-2"><i class="bi bi-inbox fs-1 text-secondary opacity-50"></i></div>
                                <div class="fw-semibold">Không tìm thấy bản ghi đăng ký nào phù hợp</div>
                                <small class="text-muted">Vui lòng thử điều chỉnh lại từ khóa tìm kiếm hoặc bộ lọc ngày, trạng thái.</small>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- PHÂN TRANG CHUẨN LINQ (PRESERVE QUERY PARAMS) -->
        @if (Model.TotalPages > 1)
        {
            <div class="p-3 bg-light border-top d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div class="small text-muted">
                    Hiển thị từ <strong>@((Model.PageIndex - 1) * Model.PageSize + 1)</strong> đến <strong>@(Math.Min(Model.PageIndex * Model.PageSize, Model.TotalItems))</strong> trong tổng số <strong>@Model.TotalItems</strong> đơn
                </div>
                <nav aria-label="Page navigation">
                    <ul class="pagination pagination-sm mb-0">
                        <!-- Nút Trước -->
                        <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@(Model.PageIndex - 1)"
                               asp-route-pageSize="@Model.PageSize"
                               asp-route-searchString="@Model.SearchString"
                               asp-route-searchHocVien="@Model.SearchHocVien"
                               asp-route-searchKhoaHoc="@Model.SearchKhoaHoc"
                               asp-route-trangThai="@Model.TrangThai"
                               asp-route-tuNgay="@(Model.TuNgay?.ToString("yyyy-MM-dd"))"
                               asp-route-denNgay="@(Model.DenNgay?.ToString("yyyy-MM-dd"))"
                               asp-route-sortBy="@Model.SortBy">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>

                        <!-- Các trang số -->
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            if (i == 1 || i == Model.TotalPages || (i >= Model.PageIndex - 2 && i <= Model.PageIndex + 2))
                            {
                                <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-page="@i"
                                       asp-route-pageSize="@Model.PageSize"
                                       asp-route-searchString="@Model.SearchString"
                                       asp-route-searchHocVien="@Model.SearchHocVien"
                                       asp-route-searchKhoaHoc="@Model.SearchKhoaHoc"
                                       asp-route-trangThai="@Model.TrangThai"
                                       asp-route-tuNgay="@(Model.TuNgay?.ToString("yyyy-MM-dd"))"
                                       asp-route-denNgay="@(Model.DenNgay?.ToString("yyyy-MM-dd"))"
                                       asp-route-sortBy="@Model.SortBy">
                                        @i
                                    </a>
                                </li>
                            }
                            else if (i == Model.PageIndex - 3 || i == Model.PageIndex + 3)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                        }

                        <!-- Nút Sau -->
                        <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@(Model.PageIndex + 1)"
                               asp-route-pageSize="@Model.PageSize"
                               asp-route-searchString="@Model.SearchString"
                               asp-route-searchHocVien="@Model.SearchHocVien"
                               asp-route-searchKhoaHoc="@Model.SearchKhoaHoc"
                               asp-route-trangThai="@Model.TrangThai"
                               asp-route-tuNgay="@(Model.TuNgay?.ToString("yyyy-MM-dd"))"
                               asp-route-denNgay="@(Model.DenNgay?.ToString("yyyy-MM-dd"))"
                               asp-route-sortBy="@Model.SortBy">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

<!-- MODAL XÁC NHẬN HỦY / TỪ CHỐI ĐĂNG KÝ -->
<div class="modal fade" id="modalHuyDangKy" tabindex="-1" aria-labelledby="modalHuyLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <form asp-action="HuyDangKy" method="post" id="formHuyDangKy">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="modalMaDangKy" />
                <div class="modal-header border-bottom">
                    <div class="d-flex align-items-center gap-2">
                        <div class="p-2 bg-danger-subtle text-danger rounded-3">
                            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                        </div>
                        <h5 class="modal-title fw-bold text-dark fs-6" id="modalHuyLabel">Xác nhận Hủy / Từ chối đơn đăng ký</h5>
                    </div>
                    <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body py-3">
                    <div class="p-2.5 bg-light rounded-3 border mb-3 small">
                        <div><strong>Học viên:</strong> <span id="modalTenHocVien" class="text-primary fw-semibold"></span></div>
                        <div class="mt-1"><strong>Khóa học:</strong> <span id="modalTenKhoaHoc" class="text-dark"></span></div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-danger">Lý do hủy / từ chối (* Bắt buộc):</label>
                        <textarea name="lyDoHuy" class="form-control form-control-sm" rows="3" required placeholder="Nhập lý do học viên xin rút, không đủ điều kiện tài chính hoặc hết chỗ..."></textarea>
                    </div>
                    <div class="alert alert-warning py-2 px-3 small mb-0 border-0 rounded-3">
                        <i class="bi bi-info-circle me-1"></i>Đơn sau khi hủy sẽ giải phóng một vị trí sĩ số cho khóa học này.
                    </div>
                </div>
                <div class="modal-footer border-top pt-2">
                    <button type="button" class="btn btn-sm btn-light border px-3" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-sm btn-danger px-3 fw-semibold">
                        <i class="bi bi-trash3 me-1"></i>Xác nhận hủy đơn
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Mở Modal Hủy đơn đăng ký
        function openHuyModal(maDangKy, tenHocVien, tenKhoaHoc) {
            document.getElementById('modalMaDangKy').value = maDangKy;
            document.getElementById('modalTenHocVien').innerText = tenHocVien;
            document.getElementById('modalTenKhoaHoc').innerText = tenKhoaHoc;
            var modal = new bootstrap.Modal(document.getElementById('modalHuyDangKy'));
            modal.show();
        }
    </script>
}

