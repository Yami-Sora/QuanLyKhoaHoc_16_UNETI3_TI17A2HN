@*
    Họ và tên: Ngọc Tùng Lâm
    Mã sinh viên: 23103100098
    Nội dung thực hiện: Module 3 - Giao diện Theo dõi Đăng ký & Khóa học của tôi
*@

@model HeThongQuanLyKhoaHocVaDangKy_3_UNETI3_TIN17A2HN.ViewModels.TheoDoiDangKyFilterViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Khóa học của tôi & Theo dõi đăng ký";
}

<div class="container py-4">
    <!-- Breadcrumb & Tiêu đề -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h3 class="fw-bold mb-1 text-dark">
                <i class="bi bi-journal-check me-2" style="color: var(--uneti-primary);"></i>KHÓA HỌC CỦA TÔI & THEO DÕI ĐĂNG KÝ
            </h3>
            <p class="text-muted mb-0 small">Danh sách giao dịch đã tạo, trạng thái xử lý, công nợ học phí và kết quả học tập cá nhân</p>
        </div>
        <div class="mt-2 mt-md-0 d-flex gap-2">
            <a asp-controller="KhoaHoc" asp-action="Index" class="btn uneti-btn-primary shadow-sm text-decoration-none d-flex align-items-center gap-1">
                <i class="bi bi-plus-circle"></i>
                <span>Đăng ký khóa mới</span>
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary shadow-sm text-decoration-none d-flex align-items-center gap-1">
                <i class="bi bi-arrow-clockwise"></i>
                <span>Tải lại</span>
            </a>
        </div>
    </div>

    <!-- Thông báo TempData phản hồi -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show uneti-card border-success-subtle mb-4 py-3" role="alert">
            <i class="bi bi-check-circle-fill text-success me-2 fs-5 align-middle"></i>
            <span class="align-middle fw-semibold text-dark">@TempData["SuccessMessage"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show uneti-card border-danger-subtle mb-4 py-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill text-danger me-2 fs-5 align-middle"></i>
            <span class="align-middle fw-semibold text-dark">@TempData["ErrorMessage"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- 5 THẺ THỐNG KÊ TIẾN ĐỘ ĐĂNG KÝ CỦA HỌC VIÊN -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="uneti-card p-3 shadow-sm h-100 border-start border-4 border-primary">
                <span class="text-muted small fw-medium text-uppercase d-block">Tổng số đơn đã tạo</span>
                <h3 class="fw-bold text-dark mt-1 mb-0">@Model.TongSoDon</h3>
                <small class="text-primary uneti-fs-xs"><i class="bi bi-file-earmark-text me-1"></i>Tất cả giao dịch</small>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="uneti-card p-3 shadow-sm h-100 border-start border-4 border-warning">
                <span class="text-muted small fw-medium text-uppercase d-block">Đang chờ xử lý</span>
                <h3 class="fw-bold text-warning-emphasis mt-1 mb-0">@Model.SoDonChoXuLy</h3>
                <small class="text-muted uneti-fs-xs">Chờ nhân viên duyệt</small>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="uneti-card p-3 shadow-sm h-100 border-start border-4 border-info">
                <span class="text-muted small fw-medium text-uppercase d-block">Đang xử lý</span>
                <h3 class="fw-bold text-info mt-1 mb-0">@Model.SoDonDangXuLy</h3>
                <small class="text-muted uneti-fs-xs">Đang kiểm tra hồ sơ</small>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="uneti-card p-3 shadow-sm h-100 border-start border-4 border-success">
                <span class="text-muted small fw-medium text-uppercase d-block">Hoàn thành ghi danh</span>
                <h3 class="fw-bold text-success mt-1 mb-0">@Model.SoDonHoanThanh</h3>
                <small class="text-muted uneti-fs-xs">Đã ghi danh lớp học</small>
            </div>
        </div>
    </div>

    <!-- KHỐI TÌM KIẾM & BỘ LỌC TRẠNG THÁI -->
    <div class="uneti-card p-3 shadow-sm mb-4">
        <form method="get" asp-action="Index" class="row g-3 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" asp-for="SearchKhoaHoc" class="form-control border-start-0" placeholder="Tìm kiếm theo tên khóa học, môn học..." />
                </div>
            </div>

            <div class="col-md-3 col-sm-6">
                <select asp-for="TrangThai" class="form-select">
                    <option value="TatCa">Tất cả trạng thái</option>
                    <option value="ChoXuLy">Chờ xử lý</option>
                    <option value="DangXuLy">Đang xử lý</option>
                    <option value="HoanThanh">Hoàn thành</option>
                    <option value="BiHuy">Đã hủy</option>
                </select>
            </div>

            <div class="col-md-2 col-sm-6">
                <select asp-for="SortBy" class="form-select">
                    <option value="ngay_desc">Mới nhất trước</option>
                    <option value="ngay_asc">Cũ nhất trước</option>
                    <option value="hocphi_desc">Học phí: Cao &rarr; Thấp</option>
                    <option value="hocphi_asc">Học phí: Thấp &rarr; Cao</option>
                </select>
            </div>

            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn uneti-btn-primary w-100 fw-semibold">
                    <i class="bi bi-filter me-1"></i>Lọc
                </button>
                <a asp-action="Index" class="btn btn-light border" title="Xóa lọc">
                    <i class="bi bi-x-circle"></i>
                </a>
            </div>
        </form>
    </div>

    <!-- BẢNG DANH SÁCH KHÓA HỌC ĐÃ ĐĂNG KÝ -->
    <div class="uneti-card shadow-sm overflow-hidden mb-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light border-bottom">
                    <tr class="small text-secondary text-uppercase fw-semibold" style="letter-spacing: 0.03em;">
                        <th class="ps-4" style="width: 80px;">Mã ĐK</th>
                        <th>Khóa học / Môn học</th>
                        <th>Thời gian học</th>
                        <th>Ngày đăng ký</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-end">Học phí</th>
                        <th class="text-center">Kết quả</th>
                        <th class="text-end pe-4" style="width: 140px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.DanhSachDangKy.Any())
                    {
                        foreach (var item in Model.DanhSachDangKy)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-muted small">
                                    #@item.MaDangKy
                                </td>
                                <td>
                                    <a asp-action="ChiTiet" asp-route-id="@item.MaDangKy" class="fw-bold text-dark text-decoration-none d-block">
                                        @item.TenKhoaHoc
                                    </a>
                                    <small class="text-muted uneti-fs-xs">
                                        <i class="bi bi-journal-text me-1"></i>@item.TenMonHoc (@item.SoTinChi TC)
                                        @if (!string.IsNullOrEmpty(item.TenGiangVien))
                                        {
                                            <span> &bull; GV: @item.TenGiangVien</span>
                                        }
                                    </small>
                                </td>
                                <td class="small text-dark">
                                    <i class="bi bi-calendar-event me-1 text-primary"></i>
                                    @item.NgayBatDau.ToString("dd/MM/yyyy") &rarr; @item.NgayKetThuc.ToString("dd/MM/yyyy")
                                    <div class="text-muted uneti-fs-xs">Hình thức: @item.HinhThuc</div>
                                </td>
                                <td class="small text-secondary">
                                    @item.NgayDangKy.ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td class="text-center">
                                    @switch (item.TrangThai)
                                    {
                                        case "ChoXuLy":
                                            <span class="uneti-badge-warning px-2.5 py-1">
                                                <i class="bi bi-hourglass-split me-1"></i>Chờ xử lý
                                            </span>
                                            break;
                                        case "DangXuLy":
                                            <span class="uneti-badge-primary px-2.5 py-1">
                                                <i class="bi bi-arrow-repeat me-1"></i>Đang xử lý
                                            </span>
                                            break;
                                        case "HoanThanh":
                                            <span class="uneti-badge-success px-2.5 py-1">
                                                <i class="bi bi-check-circle me-1"></i>Hoàn thành
                                            </span>
                                            break;
                                        case "BiHuy":
                                            <span class="uneti-badge-danger px-2.5 py-1">
                                                <i class="bi bi-x-circle me-1"></i>Đã hủy
                                            </span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary">@item.TrangThai</span>
                                            break;
                                    }
                                </td>
                                <td class="text-end small">
                                    <strong class="text-dark d-block">@item.HocPhi.ToString("N0") đ</strong>
                                    <small class="@(item.SoTienConLai > 0 ? "text-danger" : "text-success") uneti-fs-xs">
                                        Đã đóng: @item.SoTienDaDong.ToString("N0") đ
                                    </small>
                                </td>
                                <td class="text-center small">
                                    @if (item.DiemTongKet.HasValue)
                                    {
                                        <span class="badge @(item.DiemTongKet >= 5.0m ? "bg-success" : "bg-danger") px-2 py-1">
                                            @item.DiemTongKet.Value.ToString("0.0") đ - @item.XepLoai
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted uneti-fs-xs">Chưa có kết quả</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-flex justify-content-end gap-1">
                                        <a asp-action="ChiTiet" asp-route-id="@item.MaDangKy" class="btn btn-sm uneti-btn-outline" title="Xem chi tiết đơn">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="InPhieu" asp-route-id="@item.MaDangKy" class="btn btn-sm btn-light border text-secondary" title="In phiếu xác nhận">
                                            <i class="bi bi-printer"></i>
                                        </a>
                                        @if (item.DuocPhepTuhuy)
                                        {
                                            <!-- Nút mở modal hủy đăng ký (Mục 7.4) -->
                                            <button type="button" class="btn btn-sm btn-outline-danger" 
                                                    data-bs-toggle="modal" data-bs-target="#modalHuy_@item.MaDangKy" 
                                                    title="Hủy đơn đăng ký này">
                                                <i class="bi bi-x-lg"></i>
                                            </button>

                                            <!-- Modal Xác nhận Hủy Đơn -->
                                            <div class="modal fade text-start" id="modalHuy_@item.MaDangKy" tabindex="-1" aria-hidden="true">
                                                <div class="modal-dialog">
                                                    <div class="modal-content">
                                                        <form asp-action="HuyDangKy" asp-route-id="@item.MaDangKy" method="post">
                                                            @Html.AntiForgeryToken()
                                                            <div class="modal-header border-bottom">
                                                                <h6 class="modal-title fw-bold text-danger">
                                                                    <i class="bi bi-exclamation-triangle-fill me-1"></i>Xác nhận hủy đơn đăng ký #@item.MaDangKy
                                                                </h6>
                                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                            </div>
                                                            <div class="modal-body small">
                                                                <p class="mb-2 text-dark">
                                                                    Bạn có chắc chắn muốn hủy đăng ký khóa học <strong>"@item.TenKhoaHoc"</strong> không?
                                                                </p>
                                                                <div class="alert alert-warning py-2 small mb-3">
                                                                    Lưu ý: Chỉ được hủy đơn khi đang ở trạng thái <em>Chờ xử lý</em>. Sau khi hủy, chỗ của bạn trên lớp sẽ được nhường lại cho học viên khác.
                                                                </div>
                                                                <div class="mb-3">
                                                                    <label class="form-label fw-semibold text-secondary">Lý do hủy đơn (tùy chọn):</label>
                                                                    <textarea name="lyDoHuy" class="form-control" rows="2" placeholder="Ví dụ: Trùng lịch học, đổi nguyện vọng..."></textarea>
                                                                </div>
                                                            </div>
                                                            <div class="modal-footer border-top">
                                                                <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Đóng</button>
                                                                <button type="submit" class="btn btn-danger fw-semibold">Xác nhận hủy đơn</button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <div class="py-3">
                                    <i class="bi bi-journal-x fs-1 text-muted d-block mb-2"></i>
                                    <p class="mb-1 fw-semibold text-secondary">Bạn chưa có đơn đăng ký khóa học nào phù hợp với bộ lọc.</p>
                                    <a asp-controller="KhoaHoc" asp-action="Index" class="btn uneti-btn-primary btn-sm mt-2">
                                        <i class="bi bi-search me-1"></i>Khám phá danh sách khóa học đang mở
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- PHÂN TRANG LINQ -->
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-white border-top py-3 px-4 d-flex flex-wrap align-items-center justify-content-between gap-2">
                <div class="small text-muted">
                    Trang <strong>@Model.PageIndex</strong> / <strong>@Model.TotalPages</strong> (Tổng số <strong>@Model.TotalItems</strong> đơn)
                </div>
                <nav aria-label="Page navigation">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Index"
                               asp-route-pageIndex="@(Model.PageIndex - 1)"
                               asp-route-pageSize="@Model.PageSize"
                               asp-route-searchKhoaHoc="@Model.SearchKhoaHoc"
                               asp-route-trangThai="@Model.TrangThai"
                               asp-route-sortBy="@Model.SortBy">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>

                        @for (int p = 1; p <= Model.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.PageIndex ? "active" : "")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-pageIndex="@p"
                                   asp-route-pageSize="@Model.PageSize"
                                   asp-route-searchKhoaHoc="@Model.SearchKhoaHoc"
                                   asp-route-trangThai="@Model.TrangThai"
                                   asp-route-sortBy="@Model.SortBy">@p</a>
                            </li>
                        }

                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Index"
                               asp-route-pageIndex="@(Model.PageIndex + 1)"
                               asp-route-pageSize="@Model.PageSize"
                               asp-route-searchKhoaHoc="@Model.SearchKhoaHoc"
                               asp-route-trangThai="@Model.TrangThai"
                               asp-route-sortBy="@Model.SortBy">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

