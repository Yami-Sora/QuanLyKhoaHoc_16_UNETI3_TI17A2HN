@*
    Trang in bảng điểm cá nhân (standalone, Layout = null)
    Tương tự cách làm của InPhieu.cshtml — trang riêng, không dùng layout
*@

@model HeThongQuanLyKhoaHocVaDangKy_3_UNETI3_TIN17A2HN.ViewModels.KetQuaCuaToiViewModel
@{
    Layout = null;
}
@functions {
    public static string TranslateXepLoai(string? xl)
    {
        return xl switch
        {
            "XuatSac" => "Xuất sắc",
            "Gioi" => "Giỏi",
            "Kha" => "Khá",
            "TrungBinh" => "Trung bình",
            "Yeu" => "Yếu",
            _ => xl ?? "Chưa xếp loại"
        };
    }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Bảng điểm cá nhân - @Model.HoTenHocVien</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #f1f5f9;
            color: #0f172a;
            padding: 24px;
            font-size: 13px;
        }
        .print-container {
            max-width: 860px;
            margin: 0 auto;
            background: #ffffff;
            padding: 40px 48px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.06);
        }
        .uneti-title {
            color: #1d4ed8;
            font-weight: 800;
            letter-spacing: -0.01em;
        }
        .table-report {
            width: 100%;
            border-collapse: collapse;
            font-size: 12.5px;
        }
        .table-report th, .table-report td {
            padding: 7px 10px;
            border: 1px solid #e2e8f0;
        }
        .table-report th {
            background-color: #f8fafc;
            font-weight: 600;
            color: #475569;
            text-align: center;
        }
        .table-info th, .table-info td {
            padding: 8px 12px;
            border: 1px solid #e2e8f0;
        }
        .table-info th {
            background-color: #f8fafc;
            font-weight: 600;
            color: #475569;
            width: 25%;
        }
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 12px;
            margin-bottom: 20px;
        }
        .kpi-box {
            padding: 12px 14px;
            border-radius: 8px;
            border: 1px solid #e2e8f0;
            background: #f8fafc;
            text-align: center;
        }
        .kpi-box .kpi-label {
            font-size: 10.5px;
            color: #64748b;
            font-weight: 600;
            text-transform: uppercase;
            margin-bottom: 4px;
        }
        .kpi-box .kpi-value {
            font-size: 20px;
            font-weight: 800;
        }
        .kpi-box .kpi-sub {
            font-size: 10.5px;
            color: #94a3b8;
        }
        .text-success { color: #16a34a !important; }
        .text-danger { color: #dc2626 !important; }
        .text-primary { color: #1d4ed8 !important; }
        .text-muted { color: #64748b !important; }
        .fw-bold { font-weight: 700 !important; }
        .text-center { text-align: center !important; }
        .text-end { text-align: right !important; }
        .small { font-size: 11.5px !important; }
        .section-title {
            color: #1d4ed8;
            font-weight: 800;
            font-size: 14px;
            text-transform: uppercase;
            border-bottom: 2px solid #1d4ed8;
            padding-bottom: 6px;
            margin-bottom: 12px;
            margin-top: 24px;
        }

        @@media print {
            body {
                background: #ffffff;
                padding: 0;
                margin: 0;
            }
            .print-container {
                box-shadow: none;
                padding: 20px;
                max-width: 100%;
                border-radius: 0;
            }
            .no-print {
                display: none !important;
            }
            @@page {
                size: A4 portrait;
                margin: 10mm 12mm;
            }
        }
    </style>
</head>
<body>
    <div class="print-container">
        <!-- Nút in (ẩn khi in) -->
        <div class="d-flex justify-content-end mb-4 pb-3 border-bottom no-print">
            <button onclick="window.print()" class="btn btn-primary btn-sm fw-semibold px-3">
                <i class="bi bi-printer-fill me-1"></i>In bảng điểm
            </button>
        </div>

        <!-- TIÊU ĐỀ ĐƠN VỊ ĐÀO TẠO -->
        <div class="row align-items-center mb-4 pb-3 border-bottom">
            <div class="col-7">
                <div style="font-size: 13px; font-weight: 700; line-height: 1.3; text-transform: uppercase;">
                    TRƯỜNG ĐẠI HỌC KINH TẾ - KỸ THUẬT CÔNG NGHIỆP<br />
                    <span class="text-primary" style="font-weight: 700;">KHOA CÔNG NGHỆ THÔNG TIN</span><br />
                    <small class="text-muted" style="text-transform: capitalize; font-weight: 400;">Trung tâm Đào tạo &amp; Khảo thí Phần mềm</small>
                </div>
            </div>
            <div class="col-5 text-end" style="font-size: 12.5px;">
                <strong>CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM</strong><br />
                <em>Độc lập - Tự do - Hạnh phúc</em><br />
                <span class="text-muted">---o0o---</span>
            </div>
        </div>

        <!-- TÊN PHIẾU -->
        <div class="text-center my-4">
            <h3 class="uneti-title mb-1">BẢNG ĐIỂM KẾT QUẢ HỌC TẬP CÁ NHÂN</h3>
            <p class="text-muted small mb-0">
                Mã học viên: <strong>#HV@(Model.MaHocVien)</strong> | Ngày xuất: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
            </p>
        </div>

        <!-- THÔNG TIN HỌC VIÊN -->
        <div class="section-title">I. Thông tin học viên</div>
        <table class="table-info" style="width: 100%; border-collapse: collapse; margin-bottom: 16px;">
            <tr>
                <th>Họ và tên:</th>
                <td class="fw-bold" style="width: 25%;">@Model.HoTenHocVien</td>
                <th style="width: 25%;">Mã học viên:</th>
                <td style="width: 25%;">#HV@(Model.MaHocVien)</td>
            </tr>
            <tr>
                <th>Email:</th>
                <td colspan="3">@(Model.EmailHocVien ?? "Chưa cập nhật")</td>
            </tr>
        </table>

        <!-- THẺ THỐNG KÊ KẾT QUẢ -->
        <div class="section-title">II. Tổng quan kết quả học tập</div>
        <div class="kpi-grid">
            <div class="kpi-box" style="border-left: 3px solid #1d4ed8;">
                <div class="kpi-label">Điểm TB tích lũy</div>
                <div class="kpi-value @(Model.DiemTBToanBo.HasValue && Model.DiemTBToanBo.Value >= 8.0m ? "text-success" : (Model.DiemTBToanBo.HasValue && Model.DiemTBToanBo.Value >= 5.0m ? "text-primary" : "text-danger"))">
                    @(Model.DiemTBToanBo.HasValue ? Model.DiemTBToanBo.Value.ToString("0.00") : "--")
                </div>
                <div class="kpi-sub">Thang điểm 10</div>
            </div>
            <div class="kpi-box" style="border-left: 3px solid #16a34a;">
                <div class="kpi-label">Tín chỉ tích lũy</div>
                <div class="kpi-value text-success">@Model.TinChiDat <span style="font-size: 12px; color: #94a3b8;">/ @Model.TongTinChi</span></div>
                <div class="kpi-sub">Đã hoàn thành</div>
            </div>
            <div class="kpi-box" style="border-left: 3px solid #0ea5e9;">
                <div class="kpi-label">Khóa học Đạt</div>
                <div class="kpi-value text-primary">@Model.SoKhoaDat <span style="font-size: 12px; color: #94a3b8;">/ @Model.TongSoKhoaDaHoc</span></div>
                <div class="kpi-sub">@(Model.SoKhoaKhongDat > 0 ? $"{Model.SoKhoaKhongDat} khóa chưa đạt" : "Tất cả đều đạt")</div>
            </div>
            <div class="kpi-box" style="border-left: 3px solid #f59e0b;">
                <div class="kpi-label">Tỷ lệ đạt chuẩn</div>
                <div class="kpi-value" style="color: #b45309;">@Model.TyLeDat%</div>
                <div class="kpi-sub">
                    @if (Model.SoKhoaChuaCoKetQua > 0)
                    {
                        <span>Có @Model.SoKhoaChuaCoKetQua khóa đang chấm</span>
                    }
                    else
                    {
                        <span>Đã đánh giá đầy đủ</span>
                    }
                </div>
            </div>
        </div>

        <!-- BẢNG CHI TIẾT ĐIỂM -->
        <div class="section-title">III. Chi tiết điểm số từng khóa học (@Model.DanhSachKetQua.Count khóa đào tạo)</div>
        <table class="table-report">
            <thead>
                <tr>
                    <th style="width: 40px;">STT</th>
                    <th>Khóa học & Môn học</th>
                    <th style="width: 50px;">TC</th>
                    <th style="width: 70px;">Chuyên cần<br /><small style="font-weight: 400; color: #94a3b8;">(10%)</small></th>
                    <th style="width: 70px;">Giữa kỳ<br /><small style="font-weight: 400; color: #94a3b8;">(40%)</small></th>
                    <th style="width: 70px;">Cuối kỳ<br /><small style="font-weight: 400; color: #94a3b8;">(50%)</small></th>
                    <th style="width: 75px;">Tổng kết</th>
                    <th style="width: 80px;">Xếp loại</th>
                    <th style="width: 90px;">Kết quả</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.DanhSachKetQua != null && Model.DanhSachKetQua.Any())
                {
                    int stt = 1;
                    foreach (var item in Model.DanhSachKetQua)
                    {
                        var isDat = item.KetQua == "Dat";
                        <tr>
                            <td class="text-center text-muted">@stt</td>
                            <td>
                                <span class="fw-bold">@item.TenKhoaHoc</span><br />
                                <span class="small text-muted">@(item.TenMonHoc ?? "Chưa phân môn") • GV: @(item.TenGiangVien ?? "N/A") • @item.HinhThucHoc</span>
                            </td>
                            <td class="text-center">@item.SoTinChi</td>

                            @if (item.DaCoKetQua)
                            {
                                <td class="text-center">@item.DiemChuyenCan.ToString("0.0")</td>
                                <td class="text-center">@item.DiemGiuaKy.ToString("0.0")</td>
                                <td class="text-center">@item.DiemCuoiKy.ToString("0.0")</td>
                                <td class="text-center fw-bold @(item.DiemTongKet >= 8.0m ? "text-success" : (item.DiemTongKet >= 5.0m ? "text-primary" : "text-danger"))" style="font-size: 14px;">
                                    @item.DiemTongKet.ToString("0.00")
                                </td>
                                <td class="text-center">@TranslateXepLoai(item.XepLoai)</td>
                                <td class="text-center fw-bold @(isDat ? "text-success" : "text-danger")">
                                    @(isDat ? "ĐẠT" : "KHÔNG ĐẠT")
                                    @if (item.NgayCapNhat.HasValue)
                                    {
                                        <br /><span class="small text-muted" style="font-weight: 400;">@item.NgayCapNhat.Value.ToString("dd/MM/yyyy")</span>
                                    }
                                </td>
                            }
                            else
                            {
                                <td colspan="5" class="text-center text-muted" style="font-style: italic;">
                                    Đang học — Chờ giảng viên nhập điểm
                                </td>
                                <td class="text-center text-muted">Chưa có</td>
                            }
                        </tr>
                        stt++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center text-muted" style="padding: 24px;">
                            Chưa hoàn thành khóa học nào trong hệ thống.
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div style="margin-top: 12px; font-size: 11.5px; color: #64748b; border-top: 1px solid #e2e8f0; padding-top: 8px;">
            <strong>Quy tắc xét đạt:</strong> Điểm tổng kết ≥ 5.0 và tích lũy đủ số tín chỉ quy định của môn học.
        </div>

        <!-- CHỮ KÝ XÁC NHẬN -->
        <div class="row text-center mt-5 pt-3" style="font-size: 12px;">
            <div class="col-4">
                <strong>HỌC VIÊN</strong><br />
                <em class="text-muted">(Ký và ghi rõ họ tên)</em>
                <div style="height: 70px;"></div>
                <strong>@Model.HoTenHocVien</strong>
            </div>
            <div class="col-4">
                <strong>PHÒNG ĐÀO TẠO</strong><br />
                <em class="text-muted">(Ký và ghi rõ họ tên)</em>
                <div style="height: 70px;"></div>
            </div>
            <div class="col-4">
                <em class="text-muted" style="font-size: 10px;">
                    Hà Nội, ngày @DateTime.Now.Day tháng @DateTime.Now.Month năm @DateTime.Now.Year
                </em><br />
                <strong>BAN GIÁM HIỆU</strong><br />
                <em class="text-muted">(Ký, đóng dấu xác nhận)</em>
                <div style="height: 70px;"></div>
            </div>
        </div>
    </div>
</body>
</html>
