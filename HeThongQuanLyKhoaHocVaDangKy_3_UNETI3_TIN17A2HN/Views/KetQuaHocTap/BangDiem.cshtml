@*
    Họ và tên: Nguyễn Công Thành
    Mã sinh viên: 23103100102
    Nội dung thực hiện: Module 5 - Giao diện Bảng điểm khóa học & Nhập điểm hàng loạt
*@

@model HeThongQuanLyKhoaHocVaDangKy_3_UNETI3_TIN17A2HN.ViewModels.BangDiemKhoaHocViewModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Bảng điểm & Nhập điểm - " + Model.TenKhoaHoc;
}

<link rel="stylesheet" href="~/css/module5-v2.css" asp-append-version="true" />

<div class="container-fluid px-0">
    <!-- 1. HERO BANNER CHUẨN DASHBOARD / MODULE 5 -->
    <div class="m5-hero-banner">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 position-relative" style="z-index: 2;">
            <div class="d-flex align-items-center gap-3">
                <div class="m5-banner-icon">
                    <i class="bi bi-journal-check"></i>
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="badge bg-white text-primary fw-bold px-2.5 py-0.5 rounded-pill shadow-sm" style="font-size: 11px;">
                            #KH@(Model.MaKhoaHoc.ToString("D2"))
                        </span>
                        <span class="text-white-50 small">• @Model.TenMonHoc (@Model.SoTinChi tín chỉ)</span>
                    </div>
                    <h1 class="m5-banner-title">BẢNG ĐIỂM: @Model.TenKhoaHoc</h1>
                    <p class="m5-banner-sub">
                        Giảng viên phụ trách: <strong>@(Model.TenGiangVien ?? "Chưa phân công")</strong> • Hệ thống tự động tính điểm tổng kết &amp; xếp loại tức thì
                    </p>
                </div>
            </div>

            <!-- Cụm nút tác vụ phía trên -->
            <div class="d-flex align-items-center gap-2">
                <a asp-action="Index" class="m5-banner-btn-white">
                    <i class="bi bi-arrow-left"></i>
                    <span>Danh sách khóa học</span>
                </a>
                <button type="submit" form="formBangDiem" class="m5-banner-btn border-0">
                    <i class="bi bi-floppy2-fill"></i>
                    <span>Lưu toàn bộ bảng điểm</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Thông báo TempData phản hồi -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-success-subtle mb-4 py-3 shadow-sm rounded-3" role="alert">
            <i class="bi bi-check-circle-fill text-success me-2 fs-5 align-middle"></i>
            <span class="align-middle fw-semibold text-dark">@TempData["SuccessMessage"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-danger-subtle mb-4 py-3 shadow-sm rounded-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill text-danger me-2 fs-5 align-middle"></i>
            <span class="align-middle fw-semibold text-dark">@TempData["ErrorMessage"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- THẺ TỔNG HỢP THỐNG KÊ LỚP HỌC ĐỒNG BỘ DASHBOARD -->
    <div class="row g-3 mb-4">
        <!-- Sĩ số học viên -->
        <div class="col-6 col-md-3">
            <div class="m5-stat-card theme-blue">
                <div class="d-flex align-items-center justify-content-between">
                    <span class="text-muted small fw-bold text-uppercase" style="font-size: 11px; letter-spacing: 0.5px;">Sĩ số hoàn tất</span>
                    <span class="m5-stat-icon"><i class="bi bi-people-fill"></i></span>
                </div>
                <div>
                    <div class="m5-stat-val" id="statTongHV">@Model.TongSoDangKyHoanThanh</div>
                    <div class="m5-stat-sub"><i class="bi bi-dot text-primary fs-5 align-middle"></i>Đã hoàn tất thủ tục</div>
                </div>
            </div>
        </div>

        <!-- Đã có điểm -->
        <div class="col-6 col-md-3">
            <div class="m5-stat-card theme-sky">
                <div class="d-flex align-items-center justify-content-between">
                    <span class="text-muted small fw-bold text-uppercase" style="font-size: 11px; letter-spacing: 0.5px;">Đã chấm điểm</span>
                    <span class="m5-stat-icon"><i class="bi bi-check2-circle"></i></span>
                </div>
                <div>
                    <div class="m5-stat-val" id="statDaCham">@Model.SoDaCoKetQua</div>
                    <div class="m5-stat-sub"><i class="bi bi-dot text-info fs-5 align-middle"></i>Còn lại: <span id="statChuaCham">@Model.SoChuaCoKetQua</span> HV</div>
                </div>
            </div>
        </div>

        <!-- Điểm trung bình lớp -->
        <div class="col-6 col-md-3">
            <div class="m5-stat-card theme-amber">
                <div class="d-flex align-items-center justify-content-between">
                    <span class="text-muted small fw-bold text-uppercase" style="font-size: 11px; letter-spacing: 0.5px;">Điểm TB cả lớp</span>
                    <span class="m5-stat-icon"><i class="bi bi-bar-chart-fill"></i></span>
                </div>
                <div>
                    <div class="m5-stat-val" id="statDiemTB">
                        @(Model.DiemTBLop.HasValue ? Model.DiemTBLop.Value.ToString("0.00") : "--")
                    </div>
                    <div class="m5-stat-sub"><i class="bi bi-dot text-warning fs-5 align-middle"></i>Thang điểm 10</div>
                </div>
            </div>
        </div>

        <!-- Tỷ lệ Đạt -->
        <div class="col-6 col-md-3">
            <div class="m5-stat-card theme-emerald">
                <div class="d-flex align-items-center justify-content-between">
                    <span class="text-muted small fw-bold text-uppercase" style="font-size: 11px; letter-spacing: 0.5px;">Tỷ lệ Đạt yêu cầu</span>
                    <span class="m5-stat-icon"><i class="bi bi-award-fill"></i></span>
                </div>
                <div>
                    <div class="m5-stat-val"><span id="statTyLeDat">@Model.TyLeDat</span>%</div>
                    <div class="m5-stat-sub"><i class="bi bi-dot text-success fs-5 align-middle"></i><span id="statSoDat">@Model.SoDat</span> Đạt / <span id="statSoKhongDat">@Model.SoKhongDat</span> Không đạt</div>
                </div>
            </div>
        </div>
    </div>

    <!-- HƯỚNG DẪN CÔNG THỨC TÍNH ĐIỂM -->
    <div class="m5-card p-3 mb-4" style="border-radius: 14px;">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 small">
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-primary-subtle text-primary p-2 rounded-3">
                    <i class="bi bi-calculator-fill fs-6"></i>
                </span>
                <div>
                    <span class="fw-bold text-dark">Quy chế tính điểm:</span>
                    <span class="text-secondary ms-1">Điểm tổng kết = <code>Chuyên cần (10%)</code> + <code>Giữa kỳ (40%)</code> + <code>Cuối kỳ (50%)</code>.</span>
                    <span class="badge bg-success-subtle text-success border border-success-subtle ms-2 fw-semibold">Điểm &ge; 5.0: ĐẠT</span>
                </div>
            </div>
            <div class="d-flex flex-wrap align-items-center gap-1">
                <span class="badge bg-success-subtle text-success border border-success-subtle">&ge; 9.0: Xuất sắc</span>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">&ge; 8.0: Giỏi</span>
                <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">&ge; 6.5: Khá</span>
                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">&ge; 5.0: Trung bình</span>
                <span class="badge bg-danger-subtle text-danger border border-danger-subtle">&lt; 5.0: Yếu</span>
            </div>
        </div>
    </div>

    <!-- BẢNG NHẬP ĐIỂM HÀNG LOẠT -->
    <div class="m5-card p-0 overflow-hidden mb-4">
        <div class="m5-card-header px-4 pt-3 pb-3 mb-0">
            <h2 class="m5-card-title">
                <span class="m5-header-icon bg-primary-subtle text-primary">
                    <i class="bi bi-pencil-square"></i>
                </span>
                <span>Danh sách học viên &amp; Bảng điểm</span>
                <span class="badge bg-light text-secondary border px-2 py-1 ms-1" style="font-size: 11px;">
                    @Model.DanhSachDiem.Count học viên
                </span>
            </h2>
            <div class="small text-muted d-none d-md-flex align-items-center gap-1">
                <i class="bi bi-lightning-charge-fill text-warning"></i>
                <span>Tự động tính điểm &amp; xếp loại realtime</span>
            </div>
        </div>

        <form asp-action="LuuDiem" method="post" id="formBangDiem">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="MaKhoaHoc" />
            <input type="hidden" asp-for="TenKhoaHoc" />
            <input type="hidden" asp-for="TenMonHoc" />
            <input type="hidden" asp-for="SoTinChi" />
            <input type="hidden" asp-for="TenGiangVien" />

            <div class="table-responsive">
                <table class="table m5-table-clean table-zebra-m5 align-middle mb-0" id="tableDiem" style="font-size: 13.5px;">
                    <thead>
                        <tr>
                            <th class="text-center" style="width: 50px;">STT</th>
                            <th style="min-width: 180px;">Họ và tên học viên</th>
                            <th style="width: 120px;" class="text-center">Chuyên cần<br /><small class="fw-normal text-muted">(10%)</small></th>
                            <th style="width: 120px;" class="text-center">Giữa kỳ<br /><small class="fw-normal text-muted">(40%)</small></th>
                            <th style="width: 120px;" class="text-center">Cuối kỳ<br /><small class="fw-normal text-muted">(50%)</small></th>
                            <th style="width: 120px;" class="text-center">Tổng kết</th>
                            <th style="width: 120px;" class="text-center">Xếp loại</th>
                            <th style="width: 110px;" class="text-center">Kết quả</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.DanhSachDiem != null && Model.DanhSachDiem.Any())
                        {
                            for (int i = 0; i < Model.DanhSachDiem.Count; i++)
                            {
                                var item = Model.DanhSachDiem[i];
                                var isDat = item.KetQua == "Dat";

                                <tr class="diem-row" data-index="@i">
                                    <!-- STT -->
                                    <td class="text-center text-muted fw-semibold">
                                        @(i + 1)
                                        <input type="hidden" name="DanhSachDiem[@i].MaDangKy" value="@item.MaDangKy" />
                                        <input type="hidden" name="DanhSachDiem[@i].MaHocVien" value="@item.MaHocVien" />
                                        <input type="hidden" name="DanhSachDiem[@i].HoTenHocVien" value="@item.HoTenHocVien" />
                                        <input type="hidden" name="DanhSachDiem[@i].EmailHocVien" value="@item.EmailHocVien" />
                                        <input type="hidden" name="DanhSachDiem[@i].MaKetQua" value="@item.MaKetQua" />
                                    </td>

                                    <!-- Học viên -->
                                    <td>
                                        <div class="fw-bold text-dark">@item.HoTenHocVien</div>
                                        <div class="text-muted uneti-fs-xs">
                                            <span>#ĐK: @item.MaDangKy</span>
                                            @if (!string.IsNullOrEmpty(item.EmailHocVien))
                                            {
                                                <span> • @item.EmailHocVien</span>
                                            }
                                        </div>
                                    </td>

                                    <!-- Điểm chuyên cần (10%) -->
                                    <td class="text-center">
                                        <input type="number" 
                                               step="0.1" 
                                               min="0" 
                                               max="10" 
                                               name="DanhSachDiem[@i].DiemChuyenCan" 
                                               value="@item.DiemChuyenCan.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)" 
                                               class="form-control form-control-sm text-center fw-semibold diem-input input-cc" 
                                               data-index="@i" 
                                               placeholder="0.0" />
                                    </td>

                                    <!-- Điểm giữa kỳ (40%) -->
                                    <td class="text-center">
                                        <input type="number" 
                                               step="0.1" 
                                               min="0" 
                                               max="10" 
                                               name="DanhSachDiem[@i].DiemGiuaKy" 
                                               value="@item.DiemGiuaKy.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)" 
                                               class="form-control form-control-sm text-center fw-semibold diem-input input-gk" 
                                               data-index="@i" 
                                               placeholder="0.0" />
                                    </td>

                                    <!-- Điểm cuối kỳ (50%) -->
                                    <td class="text-center">
                                        <input type="number" 
                                               step="0.1" 
                                               min="0" 
                                               max="10" 
                                               name="DanhSachDiem[@i].DiemCuoiKy" 
                                               value="@item.DiemCuoiKy.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)" 
                                               class="form-control form-control-sm text-center fw-semibold diem-input input-ck" 
                                               data-index="@i" 
                                               placeholder="0.0" />
                                    </td>

                                    <!-- Điểm tổng kết tự động -->
                                    <td class="text-center">
                                        <span class="fw-bold fs-6 label-tongket @(item.DiemTongKet >= 8.0m ? "text-success" : (item.DiemTongKet >= 5.0m ? "text-primary" : "text-danger"))" 
                                              id="tongket_@i">
                                            @item.DiemTongKet.ToString("0.00")
                                        </span>
                                    </td>

                                    <!-- Xếp loại -->
                                    <td class="text-center">
                                        <span class="badge bg-light text-dark border px-2 py-1 label-xeploai" id="xeploai_@i">
                                            @TranslateXepLoai(item.XepLoai)
                                        </span>
                                    </td>

                                    <!-- Kết quả -->
                                    <td class="text-center">
                                        <span class="badge @(isDat ? "bg-success" : (item.KetQua == "KhongDat" ? "bg-danger" : "bg-secondary")) px-2.5 py-1 rounded-pill label-ketqua" 
                                              id="ketqua_@i">
                                            @(isDat ? "ĐẠT" : (item.KetQua == "KhongDat" ? "KHÔNG ĐẠT" : "Chưa có"))
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <div class="mb-2"><i class="bi bi-people fs-1 text-secondary opacity-50"></i></div>
                                    <div class="fw-semibold">Khóa học này chưa có học viên nào hoàn thành đăng ký</div>
                                    <small class="text-muted">Chỉ các đơn đăng ký ở trạng thái 'Hoàn thành' mới được lập danh sách nhập điểm.</small>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="p-3 bg-light border-top d-flex flex-wrap justify-content-between align-items-center gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3 py-1.5 fw-semibold">
                    <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách
                </a>
                <div class="d-flex gap-2">
                    <button type="reset" class="btn btn-light border btn-sm rounded-pill px-3 py-1.5 text-secondary">
                        <i class="bi bi-arrow-counterclockwise me-1"></i>Khôi phục giá trị cũ
                    </button>
                    <button type="submit" class="btn btn-success btn-sm shadow-sm fw-semibold rounded-pill px-4 py-1.5">
                        <i class="bi bi-floppy2-fill me-1"></i>Lưu toàn bộ bảng điểm
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@functions {
    public static string TranslateXepLoai(string? xl)
    {
        return xl switch
        {
            "XuatSac" => "Xuất sắc",
            "Gioi" => "Giỏi",
            "Kha" => "Khá",
            "TrungBinh" => "Trung bình",
            "Yeu" => "Yếu",
            _ => xl ?? "Chưa xếp loại"
        };
    }
}

@section Scripts {
    <script src="~/js/bangdiem.js" asp-append-version="true"></script>
}
