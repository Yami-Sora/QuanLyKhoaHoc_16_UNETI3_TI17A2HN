@*
    Họ và tên: Nguyễn Văn Mạnh
    Mã sinh viên: 23103100096
    Nội dung thực hiện: Module 2 - Giao diện Chi tiết Thông tin Khóa học
*@

@model HeThongQuanLyKhoaHocVaDangKy_3_UNETI3_TIN17A2HN.Models.KhoaHoc
@{
    var userRole = Context.Session.GetString("VaiTro");
    var isAdmin = userRole == "Admin";
    var isStaffOrAdmin = isAdmin || userRole == "NhanVien";
    var isLoggedIn = Context.Session.GetInt32("MaTaiKhoan") != null;

    Layout = isStaffOrAdmin ? "~/Views/Shared/_LayoutAdmin.cshtml" : "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Chi tiết khóa học - " + Model.TenKhoaHoc;
    var dangKyCount = Model.DangKyKhoaHocs?.Count(dk => dk.TrangThai != "BiHuy") ?? 0;
    var conCho = (Model.SoLuongToiDa - dangKyCount) > 0;
    var khaDung = Model.TrangThai == "DangMo" && conCho && Model.NgayBatDau.Date >= DateTime.Today;
}

<div class="container py-4">
    <!-- Header trang -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    @if (isStaffOrAdmin)
                    {
                        <li class="breadcrumb-item"><a asp-controller="QuanTri" asp-action="Dashboard" class="text-decoration-none" style="color: var(--uneti-primary);">Bảng điều khiển</a></li>
                        <li class="breadcrumb-item"><a asp-action="QuanLy" class="text-decoration-none" style="color: var(--uneti-primary);">Quản lý khóa học</a></li>
                    }
                    else
                    {
                        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-primary">Trang chủ</a></li>
                        <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-primary">Danh mục khóa học</a></li>
                    }
                    <li class="breadcrumb-item active" aria-current="page">Chi tiết khóa học #KH0@Model.MaKhoaHoc</li>
                </ol>
            </nav>
            <h3 class="fw-bold mb-1 text-dark">
                <i class="bi bi-info-circle-fill me-2" style="color: var(--uneti-primary);"></i>THÔNG TIN CHI TIẾT KHÓA HỌC
            </h3>
            <p class="text-muted mb-0 small">Hồ sơ thông số kỹ thuật, tiến độ giảng dạy và giảng viên phụ trách khóa học</p>
        </div>
        <div class="mt-2 mt-md-0 d-flex gap-2">
            @if (isStaffOrAdmin)
            {
                <a asp-action="Edit" asp-route-id="@Model.MaKhoaHoc" class="btn uneti-btn-primary shadow-sm text-decoration-none">
                    <i class="bi bi-pencil me-1"></i>Chỉnh sửa khóa học
                </a>
                <a asp-action="QuanLy" class="btn uneti-btn-outline shadow-sm text-decoration-none">
                    <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách
                </a>
            }
            else
            {
                <a asp-action="Index" class="btn uneti-btn-outline shadow-sm text-decoration-none">
                    <i class="bi bi-arrow-left me-1"></i>Quay lại danh mục
                </a>
            }
        </div>
    </div>

    <div class="row g-4">
        <!-- CỘT TRÁI: THÔNG TIN TỔNG QUAN -->
        <div class="col-lg-8">
            <div class="uneti-card p-4 shadow-sm mb-4">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <span class="badge bg-light text-secondary border px-2 py-1 fw-semibold mb-2" style="font-size: 12px;">MÃ KHÓA HỌC: #KH0@Model.MaKhoaHoc</span>
                        <h4 class="fw-bold text-dark mb-1">@Model.TenKhoaHoc</h4>
                    </div>
                    @{
                        var (badgeClass, icon, label) = Model.TrangThai switch
                        {
                            "SapMo" => ("uneti-badge-warning", "bi-clock", "Sắp mở"),
                            "DangMo" => ("uneti-badge-success", "bi-door-open", "Đang mở đăng ký"),
                            "DangHoc" => ("uneti-badge-primary", "bi-play-circle", "Đang giảng dạy"),
                            "DaKetThuc" => ("uneti-badge-secondary", "bi-check-circle", "Đã kết thúc"),
                            "BiHuy" => ("uneti-badge-danger", "bi-x-circle", "Đã hủy"),
                            _ => ("uneti-badge-secondary", "bi-question-circle", Model.TrangThai)
                        };
                    }
                    <span class="@badgeClass fs-6 px-3 py-1.5">
                        <i class="bi @icon me-1"></i>@label
                    </span>
                </div>

                <!-- BẢNG THÔNG TIN CHI TIẾT -->
                <div class="row g-3 py-3 border-top border-bottom my-3">
                    <div class="col-sm-6">
                        <span class="text-muted small d-block">Môn học đào tạo:</span>
                        <strong class="text-dark fs-6">
                            <i class="bi bi-journal-text me-1 text-primary"></i>
                            @(Model.MonHoc?.TenMonHoc ?? "N/A")
                        </strong>
                        @if (Model.MonHoc != null)
                        {
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle ms-1" style="font-size: 11px;">@Model.MonHoc.SoTinChi Tín chỉ</span>
                        }
                    </div>

                    <div class="col-sm-6">
                        <span class="text-muted small d-block">Giảng viên phụ trách:</span>
                        <strong class="text-dark fs-6">
                            <i class="bi bi-person-badge me-1 text-primary"></i>
                            @(Model.GiangVien?.HoTen ?? "N/A")
                        </strong>
                        @if (Model.GiangVien != null && !string.IsNullOrEmpty(Model.GiangVien.HocVi))
                        {
                            <small class="text-muted d-block" style="font-size: 12px;">Học vị: @Model.GiangVien.HocVi - CM: @Model.GiangVien.ChuyenMon</small>
                        }
                    </div>

                    <div class="col-sm-6">
                        <span class="text-muted small d-block">Thời gian khóa học:</span>
                        <strong class="text-dark">
                            <i class="bi bi-calendar-event me-1 text-primary"></i>
                            @Model.NgayBatDau.ToString("dd/MM/yyyy") → @Model.NgayKetThuc.ToString("dd/MM/yyyy")
                        </strong>
                    </div>

                    <div class="col-sm-6">
                        <span class="text-muted small d-block">Hình thức đào tạo:</span>
                        <strong class="text-dark">
                            <i class="bi bi-building me-1 text-primary"></i>
                            @Model.HinhThuc
                        </strong>
                    </div>
                </div>

                <!-- MÔ TẢ KHÓA HỌC -->
                <div class="mt-3">
                    <h6 class="fw-bold text-dark mb-2"><i class="bi bi-file-earmark-text me-2 text-primary"></i>Mô tả & Lịch học chi tiết</h6>
                    <p class="text-secondary small mb-0 p-3 bg-light rounded border" style="line-height: 1.6;">
                        @(string.IsNullOrEmpty(Model.MoTa) ? "Chưa có mô tả chi tiết cho khóa học này." : Model.MoTa)
                    </p>
                </div>
            </div>

            @if (isStaffOrAdmin)
            {
                <!-- BẢNG DANH SÁCH HỌC VIÊN ĐÃ ĐĂNG KÝ (DÀNH CHO QUẢN TRỊ VIÊN & NHÂN VIÊN) -->
                <div class="uneti-card shadow-sm overflow-hidden mb-4">
                    <div class="p-3 bg-white border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <div class="d-flex align-items-center gap-2">
                            <span class="uneti-icon-box-38 bg-primary-subtle text-primary rounded-3 d-inline-flex align-items-center justify-content-center">
                                <i class="bi bi-people-fill fs-5"></i>
                            </span>
                            <div>
                                <h6 class="fw-bold text-dark mb-0">DANH SÁCH HỌC VIÊN ĐÃ ĐĂNG KÝ KHÓA HỌC</h6>
                                <small class="text-muted">Theo dõi danh sách ghi danh, tiến độ nộp học phí và liên hệ học vụ</small>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2.5 py-1.5">
                                <i class="bi bi-person-check-fill me-1"></i>@dangKyCount học viên hợp lệ
                            </span>
                            @if (Model.DangKyKhoaHocs != null && Model.DangKyKhoaHocs.Any(dk => dk.TrangThai == "BiHuy"))
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1.5">
                                    @Model.DangKyKhoaHocs.Count(dk => dk.TrangThai == "BiHuy") đã hủy
                                </span>
                            }
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light border-bottom">
                                <tr class="small text-secondary text-uppercase fw-semibold" style="letter-spacing: 0.03em;">
                                    <th class="ps-3" style="width: 60px;">Mã ĐK</th>
                                    <th>Học viên</th>
                                    <th>Thông tin liên hệ</th>
                                    <th>Ngày đăng ký</th>
                                    <th class="text-center">Trạng thái</th>
                                    <th class="text-end">Đã nộp</th>
                                    <th class="text-end">Còn lại</th>
                                    <th class="text-end pe-3" style="width: 100px;">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.DangKyKhoaHocs != null && Model.DangKyKhoaHocs.Any())
                                {
                                    foreach (var dk in Model.DangKyKhoaHocs.OrderByDescending(d => d.NgayDangKy))
                                    {
                                        var hv = dk.HocVien;
                                        <tr>
                                            <td class="ps-3 fw-bold text-muted small">#@dk.MaDangKy</td>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="text-white rounded-circle fw-bold flex-shrink-0 shadow-sm d-inline-flex align-items-center justify-content-center"
                                                         style="background: linear-gradient(135deg, #1d4ed8, #3b82f6); font-size: 13px; width: 36px; height: 36px;">
                                                        @(string.IsNullOrEmpty(hv?.HoTen) ? "H" : hv.HoTen.Substring(0, 1).ToUpper())
                                                    </div>
                                                    <div>
                                                        @if (hv != null)
                                                        {
                                                            <a asp-controller="HocVien" asp-action="Details" asp-route-id="@hv.MaHocVien" class="fw-bold text-dark text-decoration-none d-block lh-sm">
                                                                @hv.HoTen
                                                            </a>
                                                            <small class="text-muted uneti-fs-xs">#HV@(hv.MaHocVien.ToString("D3")) &bull; @(hv.GioiTinh ?? "Nam")</small>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted small">Chưa rõ thông tin</span>
                                                        }
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                @if (hv != null)
                                                {
                                                    <div class="small">
                                                        <a href="tel:@hv.SoDienThoai" class="text-decoration-none text-dark d-block">
                                                            <i class="bi bi-telephone me-1 text-primary"></i>@hv.SoDienThoai
                                                        </a>
                                                        <a href="mailto:@hv.Email" class="text-decoration-none text-muted uneti-fs-xs text-truncate d-block" style="max-width: 180px;">
                                                            <i class="bi bi-envelope me-1"></i>@hv.Email
                                                        </a>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small">N/A</span>
                                                }
                                            </td>
                                            <td class="small text-secondary">
                                                @dk.NgayDangKy.ToString("dd/MM/yyyy")
                                            </td>
                                            <td class="text-center">
                                                @switch (dk.TrangThai)
                                                {
                                                    case "ChoXuLy":
                                                        <span class="uneti-badge-warning px-2.5 py-1 small">Chờ xử lý</span>
                                                        break;
                                                    case "DangXuLy":
                                                        <span class="uneti-badge-primary px-2.5 py-1 small">Đang xử lý</span>
                                                        break;
                                                    case "HoanThanh":
                                                        <span class="uneti-badge-success px-2.5 py-1 small">Hoàn thành</span>
                                                        break;
                                                    case "BiHuy":
                                                        <span class="uneti-badge-danger px-2.5 py-1 small">Đã hủy</span>
                                                        break;
                                                    default:
                                                        <span class="badge bg-secondary">@dk.TrangThai</span>
                                                        break;
                                                }
                                            </td>
                                            <td class="text-end fw-semibold text-success small">
                                                @dk.SoTienDaDong.ToString("N0") đ
                                            </td>
                                            <td class="text-end fw-semibold @(dk.TrangThai != "BiHuy" && dk.SoTienConLai > 0 ? "text-danger" : "text-muted") small">
                                                @(dk.TrangThai == "BiHuy" ? "0 đ" : dk.SoTienConLai.ToString("N0") + " đ")
                                            </td>
                                            <td class="text-end pe-3">
                                                <div class="d-flex justify-content-end gap-1">
                                                    <a asp-controller="TiepNhanDangKy" asp-action="Details" asp-route-id="@dk.MaDangKy" class="btn btn-sm btn-outline-primary" title="Xem chi tiết đơn đăng ký">
                                                        <i class="bi bi-file-earmark-text"></i>
                                                    </a>
                                                    @if (hv != null)
                                                    {
                                                        <a asp-controller="HocVien" asp-action="Details" asp-route-id="@hv.MaHocVien" class="btn btn-sm btn-outline-secondary" title="Xem hồ sơ học viên">
                                                            <i class="bi bi-person-badge"></i>
                                                        </a>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="8" class="text-center py-4 text-muted">
                                            <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                                            <span>Chưa có học viên nào đăng ký khóa học này.</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>

        <!-- CỘT PHẢI: THỐNG KÊ SĨ SỐ, HỌC PHÍ & TÁC VỤ QUẢN TRỊ -->
        <div class="col-lg-4">
            <!-- Thẻ Sĩ số học viên -->
            <div class="uneti-card p-3.5 shadow-sm mb-3">
                <h6 class="fw-bold text-dark mb-3 pb-2 border-bottom">
                    <i class="bi bi-people-fill me-2 text-primary"></i>Tình trạng đăng ký học viên
                </h6>

                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small">Số lượng học viên đã đăng ký:</span>
                    <strong class="fs-5 text-dark">@dangKyCount / @Model.SoLuongToiDa</strong>
                </div>

                @{
                    var percent = Model.SoLuongToiDa > 0 ? (dangKyCount * 100 / Model.SoLuongToiDa) : 0;
                    var progressColor = percent >= 100 ? "bg-danger" : (percent >= 75 ? "bg-warning" : "bg-success");
                }
                <div class="progress mb-2" style="height: 10px; border-radius: 6px;">
                    <div class="progress-bar @progressColor" role="progressbar" style="width: @percent%" aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100"></div>
                </div>

                <div class="d-flex justify-content-between small text-muted">
                    <span>Tỷ lệ lấp đầy: <strong>@percent%</strong></span>
                    <span>Còn trống: <strong>@(Math.Max(0, Model.SoLuongToiDa - dangKyCount))</strong> chỗ</span>
                </div>
            </div>

            <!-- Thẻ Học phí -->
            <div class="uneti-card p-3.5 shadow-sm mb-3">
                <h6 class="fw-bold text-dark mb-3 pb-2 border-bottom">
                    <i class="bi bi-cash-stack me-2 text-primary"></i>Định mức học phí khóa học
                </h6>

                <div class="text-center py-2">
                    <span class="text-muted small d-block mb-1">Học phí trọn gói khóa học</span>
                    <h3 class="fw-bold" style="color: var(--uneti-primary);">@Model.HocPhi.ToString("N0") đ</h3>
                    @if (Model.MonHoc != null && Model.MonHoc.SoTinChi > 0)
                    {
                        <span class="badge bg-light text-muted border">~@((Model.HocPhi / Model.MonHoc.SoTinChi).ToString("N0")) đ/tín chỉ</span>
                    }
                </div>
            </div>

            <!-- MỤC 6.7: TRẠNG THÁI KHẢ DỤNG GIAO DỊCH -->
            <div class="uneti-card p-3.5 shadow-sm mb-3">
                <h6 class="fw-bold text-dark mb-3 pb-2 border-bottom">
                    <i class="bi bi-shield-check me-2 text-primary"></i>Khả dụng giao dịch
                </h6>
                @if (khaDung)
                {
                    <div class="alert alert-success border-0 py-2.5 px-3 mb-0 rounded-3 small">
                        <i class="bi bi-check-circle-fill me-1 fs-5 align-middle"></i>
                        <span class="align-middle fw-semibold">Khóa học ĐỦ ĐIỀU KIỆN tiếp nhận học viên</span>
                    </div>
                }
                else
                {
                    <div class="alert alert-danger border-0 py-2.5 px-3 mb-0 rounded-3 small">
                        <i class="bi bi-exclamation-octagon-fill me-1 fs-5 align-middle"></i>
                        <span class="align-middle fw-semibold">Khóa học KHÔNG KHẢ DỤNG giao dịch</span>
                        <div class="mt-1 uneti-fs-xs">
                            @if (Model.TrangThai != "DangMo") { <div>&bull; Trạng thái không phải 'Đang mở đăng ký'</div> }
                            @if (!conCho) { <div>&bull; Khóa học đã đủ sĩ số tối đa</div> }
                            @if (Model.NgayBatDau.Date < DateTime.Today) { <div>&bull; Đã quá hạn ngày bắt đầu khóa học</div> }
                        </div>
                    </div>
                }

                @if (!isStaffOrAdmin)
                {
                    if (khaDung)
                    {
                        if (isLoggedIn && userRole == "HocVien")
                        {
                            <a asp-controller="DangKyKhoaHoc" asp-action="DangKy" asp-route-maKhoaHoc="@Model.MaKhoaHoc" class="btn uneti-btn-primary w-100 fw-semibold py-2 mt-3">
                                <i class="bi bi-pencil-square me-1"></i>Đăng ký khóa học này
                            </a>
                        }
                        else if (!isLoggedIn)
                        {
                            <a asp-controller="TaiKhoan" asp-action="Login" asp-route-returnUrl="@Url.Action("Details", "KhoaHoc", new { id = Model.MaKhoaHoc })" class="btn uneti-btn-primary w-100 fw-semibold py-2 mt-3">
                                <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập để đăng ký
                            </a>
                        }
                    }
                    else
                    {
                        <button type="button" class="btn btn-secondary w-100 py-2 mt-3 opacity-50" disabled>
                            <i class="bi bi-slash-circle me-1"></i>Đã đóng giao dịch đăng ký
                        </button>
                    }
                }
            </div>

            <!-- Tác vụ nhanh (Dành cho Quản trị viên / Nhân viên) -->
            @if (isStaffOrAdmin)
            {
                <div class="uneti-card p-3.5 shadow-sm mb-3">
                    <h6 class="fw-bold text-dark mb-3 pb-2 border-bottom">
                        <i class="bi bi-gear me-2 text-primary"></i>Tác vụ quản trị
                    </h6>
                    <div class="d-grid gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.MaKhoaHoc" class="btn uneti-btn-primary fw-semibold">
                            <i class="bi bi-pencil me-1"></i>Chỉnh sửa thông tin
                        </a>
                        <a asp-controller="TiepNhanDangKy" asp-action="Create" asp-route-maKhoaHoc="@Model.MaKhoaHoc" class="btn btn-success fw-semibold">
                            <i class="bi bi-person-plus-fill me-1"></i>Ghi danh học viên tại quầy
                        </a>
                        @if (isAdmin)
                        {
                            <a asp-action="Delete" asp-route-id="@Model.MaKhoaHoc" class="btn btn-outline-danger fw-semibold">
                                <i class="bi bi-trash me-1"></i>Xóa khóa học
                            </a>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>
