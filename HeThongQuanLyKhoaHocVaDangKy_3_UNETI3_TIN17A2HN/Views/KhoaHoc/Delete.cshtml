@*
    Họ và tên: Nguyễn Văn Mạnh
    Mã sinh viên: 23103100096
    Nội dung thực hiện: Module 2 - Xóa khóa học
*@

@model HeThongQuanLyKhoaHocVaDangKy_3_UNETI3_TIN17A2HN.Models.KhoaHoc
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Xác nhận xóa khóa học - " + Model.TenKhoaHoc;
    bool hasDangKy = ViewBag.HasDangKy ?? (Model.DangKyKhoaHocs?.Any() ?? false);
    int soLuongDangKy = Model.DangKyKhoaHocs?.Count(dk => dk.TrangThai != "BiHuy") ?? 0;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="uneti-card overflow-hidden shadow-sm">
                <div class="card-header bg-danger text-white py-3 px-4">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>XÁC NHẬN XÓA KHÓA HỌC
                    </h5>
                </div>

                <div class="card-body p-4">
                    @if (hasDangKy)
                    {
                        <!-- 6.2. Cảnh báo bảo vệ toàn vẹn dữ liệu -->
                        <div class="alert alert-warning border-warning d-flex align-items-start p-3 mb-4 rounded-3" role="alert">
                            <i class="bi bi-shield-exclamation text-warning fs-2 me-3 mt-1 flex-shrink-0"></i>
                            <div>
                                <h6 class="fw-bold text-dark mb-1">KHÔNG THỂ XÓA KHÓA HỌC NÀY!</h6>
                                <p class="small text-muted mb-2">
                                    Khóa học <strong>"@Model.TenKhoaHoc"</strong> hiện đã phát sinh lịch sử đăng ký của học viên trong cơ sở dữ liệu. 
                                    Theo quy định nghiệp vụ Đề tài 16 (Mục 6.2 - Không xóa đối tượng đã phát sinh lịch sử nếu làm mất tính toàn vẹn dữ liệu), hành động xóa này bị hệ thống chặn hoàn toàn.
                                </p>
                                <span class="badge bg-danger">Giải pháp thay thế:</span>
                                <span class="small text-dark fw-semibold ms-1">Vui lòng chuyển trạng thái khóa học sang <strong>"Đã hủy"</strong> để dừng tiếp nhận học viên mà vẫn bảo toàn lịch sử giao dịch!</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-danger p-3 mb-4 text-center rounded-3">
                            <i class="bi bi-trash-fill fs-2 d-block mb-1"></i>
                            <h6 class="fw-bold mb-0">Bạn có chắc chắn muốn xóa vĩnh viễn khóa học này khỏi hệ thống?</h6>
                            <small class="text-muted">Khóa học này chưa có học viên nào đăng ký, thao tác xóa có thể thực hiện an toàn mà không làm mất tính toàn vẹn.</small>
                        </div>
                    }

                    <!-- Thông tin chi tiết khóa học cần xóa -->
                    <div class="bg-light p-3 rounded-3 mb-4 border">
                        <dl class="row mb-0 small">
                            <dt class="col-sm-4 text-muted">Mã khóa học:</dt>
                            <dd class="col-sm-8 fw-bold text-dark">#KH0@(Model.MaKhoaHoc)</dd>

                            <dt class="col-sm-4 text-muted">Tên khóa học:</dt>
                            <dd class="col-sm-8 fw-bold text-primary">@Model.TenKhoaHoc</dd>

                            <dt class="col-sm-4 text-muted">Môn học liên kết:</dt>
                            <dd class="col-sm-8 text-dark">@(Model.MonHoc?.TenMonHoc ?? "N/A")</dd>

                            <dt class="col-sm-4 text-muted">Giảng viên phụ trách:</dt>
                            <dd class="col-sm-8 text-dark">@(Model.GiangVien?.HoTen ?? "N/A")</dd>

                            <dt class="col-sm-4 text-muted">Thời gian tổ chức:</dt>
                            <dd class="col-sm-8 text-dark">@Model.NgayBatDau.ToString("dd/MM/yyyy") &rarr; @Model.NgayKetThuc.ToString("dd/MM/yyyy")</dd>

                            <dt class="col-sm-4 text-muted">Học phí & Sĩ số:</dt>
                            <dd class="col-sm-8 text-dark">@Model.HocPhi.ToString("N0") đ (Tối đa @Model.SoLuongToiDa học viên)</dd>

                            <dt class="col-sm-4 text-muted">Trạng thái hiện tại:</dt>
                            <dd class="col-sm-8">
                                <span class="badge bg-secondary">
                                    @HeThongQuanLyKhoaHocVaDangKy_3_UNETI3_TIN17A2HN.Controllers.KhoaHocController.GetStatusLabel(Model.TrangThai)
                                </span>
                            </dd>
                        </dl>
                    </div>

                    <!-- Cụm nút hành động -->
                    <form asp-action="Delete" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.MaKhoaHoc" />

                        <div class="d-flex justify-content-between pt-3 border-top">
                            <a asp-action="QuanLy" class="btn uneti-btn-outline text-decoration-none">
                                <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách
                            </a>

                            @if (!hasDangKy)
                            {
                                <button type="submit" class="btn btn-danger fw-bold px-4 rounded-3 shadow-sm">
                                    <i class="bi bi-trash me-1"></i>Xác nhận Xóa
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-secondary px-4 rounded-3" disabled title="Bị khóa do có học viên đăng ký">
                                    <i class="bi bi-slash-circle me-1"></i>Không thể xóa
                                </button>
                            }
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
