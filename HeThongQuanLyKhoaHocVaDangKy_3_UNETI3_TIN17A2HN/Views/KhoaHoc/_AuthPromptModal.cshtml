@*
    Họ và tên: Nguyễn Văn Mạnh
    Mã sinh viên: 23103100096
    Nội dung: Module 2 - Modal thông báo & xác nhận đăng nhập/đăng ký khi học viên chưa đăng nhập ấn nút đăng ký khóa học
*@

<!-- Modal Thông báo & Xác nhận Điều hướng Đăng nhập / Đăng ký -->
<div class="modal fade" id="authPromptModal" tabindex="-1" aria-labelledby="authPromptModalLabel" aria-hidden="true" style="backdrop-filter: blur(4px);">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden" style="background: #ffffff;">
            <!-- Header Modal -->
            <div class="modal-header border-0 py-3 px-4 text-white" style="background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);">
                <div class="d-flex align-items-center gap-2.5">
                    <div class="rounded-circle bg-white text-primary d-flex align-items-center justify-content-center shadow-xs" style="width: 38px; height: 38px; min-width: 38px;">
                        <i class="bi bi-shield-lock-fill fs-5"></i>
                    </div>
                    <div>
                        <h6 class="modal-title fw-bold mb-0 text-white" id="authPromptModalLabel" style="font-size: 16px;">YÊU CẦU TÀI KHOẢN HỌC VIÊN</h6>
                        <small class="text-white-50" style="font-size: 12px;">Hệ thống Đào tạo & Quản lý Khóa học UNETI</small>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>

            <!-- Body Modal -->
            <div class="modal-body p-4">
                <div class="text-center mb-3">
                    <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary-subtle text-primary mb-2 shadow-xs" style="width: 64px; height: 64px;">
                        <i class="bi bi-mortarboard-fill fs-2"></i>
                    </span>
                    <h5 class="fw-bold text-dark mb-1">Vui lòng đăng nhập để tiếp tục</h5>
                    <p class="text-secondary small mb-0">
                        Bạn cần có tài khoản học viên để đăng ký tham gia và theo dõi tiến độ học tập.
                    </p>
                </div>

                <!-- Hộp thông tin khóa học đang chọn -->
                <div class="rounded-3 p-3 mb-3 border bg-light">
                    <div class="d-flex align-items-center gap-1.5 text-secondary small mb-1 fw-semibold">
                        <i class="bi bi-journal-check text-primary"></i>
                        <span>Khóa học bạn đang đăng ký:</span>
                    </div>
                    <div class="fw-bold text-primary fs-6 mb-1" id="modalKhoaHocName">Tên khóa học</div>
                    <div class="d-flex justify-content-between align-items-center small text-muted pt-1 border-top border-secondary-subtle">
                        <span>Học phí khóa học:</span>
                        <strong class="text-danger fw-bold fs-6"><span id="modalKhoaHocFee">0</span> đ</strong>
                    </div>
                </div>

                <!-- Gợi ý điều hướng -->
                <div class="d-flex flex-column gap-2.5">
                    <a href="#" id="modalBtnLogin" class="btn btn-primary py-2.5 rounded-3 fw-bold d-flex align-items-center justify-content-center gap-2 shadow-sm text-decoration-none">
                        <i class="bi bi-box-arrow-in-right fs-5"></i>
                        <span>Đã có tài khoản &bull; Đăng nhập ngay</span>
                    </a>

                    <a asp-controller="TaiKhoan" asp-action="Register" class="btn btn-outline-success py-2.5 rounded-3 fw-bold d-flex align-items-center justify-content-center gap-2 text-decoration-none">
                        <i class="bi bi-person-plus-fill fs-5"></i>
                        <span>Chưa có tài khoản &bull; Đăng ký học viên mới</span>
                    </a>
                </div>
            </div>

            <!-- Footer Modal -->
            <div class="modal-footer border-top-0 pt-0 pb-3 px-4 justify-content-center">
                <button type="button" class="btn btn-link text-secondary text-decoration-none small py-1" data-bs-dismiss="modal">
                    <i class="bi bi-arrow-left me-1"></i>Để sau, tôi muốn xem thêm khóa học khác
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        // Sử dụng event delegation để bắt click kể cả khi trang load lại partial qua AJAX
        document.addEventListener('click', function (e) {
            const btn = e.target.closest('.js-require-login-btn');
            if (!btn) return;

            e.preventDefault();

            const maKhoaHoc = btn.getAttribute('data-khoahoc-id') || '';
            const tenKhoaHoc = btn.getAttribute('data-khoahoc-name') || 'Khóa học';
            const hocPhi = btn.getAttribute('data-khoahoc-fee') || '0';

            const nameElem = document.getElementById('modalKhoaHocName');
            if (nameElem) nameElem.textContent = tenKhoaHoc;

            const feeElem = document.getElementById('modalKhoaHocFee');
            if (feeElem) feeElem.textContent = hocPhi;

            const btnLogin = document.getElementById('modalBtnLogin');
            if (btnLogin) {
                // Return URL sau khi đăng nhập thành công sẽ dẫn thẳng vào trang đăng ký khóa học này
                const targetUrl = '/DangKyKhoaHoc/DangKy?maKhoaHoc=' + encodeURIComponent(maKhoaHoc);
                btnLogin.href = '/TaiKhoan/Login?returnUrl=' + encodeURIComponent(targetUrl);
            }

            const modalEl = document.getElementById('authPromptModal');
            if (modalEl && window.bootstrap) {
                const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                modal.show();
            }
        });
    })();
</script>
