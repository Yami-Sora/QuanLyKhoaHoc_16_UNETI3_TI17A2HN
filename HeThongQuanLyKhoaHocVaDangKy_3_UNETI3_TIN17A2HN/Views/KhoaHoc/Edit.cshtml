@*
    Họ và tên: Nguyễn Văn Mạnh
    Mã sinh viên: 23103100096
    Nội dung thực hiện: Module 2 - Cập nhật khóa học
*@

@model HeThongQuanLyKhoaHocVaDangKy_3_UNETI3_TIN17A2HN.Models.KhoaHoc
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Chỉnh sửa khóa học - " + Model.TenKhoaHoc;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-9">
            <div class="uneti-card overflow-hidden shadow-sm">
                <div class="card-header py-3 px-4 text-white" style="background-color: var(--uneti-primary);">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-pencil-square me-2"></i>CHỈNH SỬA KHÓA HỌC #KH0@(Model.MaKhoaHoc)
                    </h5>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Edit" method="post" id="editKhoaHocForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="MaKhoaHoc" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                        <!-- 1. Thông tin chung khóa học -->
                        <div class="mb-4">
                            <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">
                                <i class="bi bi-info-circle text-primary me-2"></i>1. Thông tin chung khóa học
                            </h6>

                            <div class="row g-3">
                                <div class="col-12">
                                    <label asp-for="TenKhoaHoc" class="form-label fw-semibold small text-secondary">
                                        Tên khóa học <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="TenKhoaHoc" class="form-control" autofocus />
                                    <span asp-validation-for="TenKhoaHoc" class="text-danger small"></span>
                                </div>

                                <!-- Lấy dữ liệu dropdown từ cơ sở dữ liệu -->
                                <div class="col-md-6">
                                    <label asp-for="MaMonHoc" class="form-label fw-semibold small text-secondary">
                                        Môn học đào tạo <span class="text-danger">*</span>
                                    </label>
                                    <select asp-for="MaMonHoc" class="form-select" asp-items="ViewBag.MaMonHoc">
                                        <option value="">-- Chọn môn học --</option>
                                    </select>
                                    <span asp-validation-for="MaMonHoc" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="MaGiangVien" class="form-label fw-semibold small text-secondary">
                                        Giảng viên phụ trách <span class="text-danger">*</span>
                                    </label>
                                    <select asp-for="MaGiangVien" class="form-select" asp-items="ViewBag.MaGiangVien">
                                        <option value="">-- Chọn giảng viên --</option>
                                    </select>
                                    <span asp-validation-for="MaGiangVien" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <!-- 2. Thời gian tổ chức và sĩ số -->
                        <div class="mb-4">
                            <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">
                                <i class="bi bi-calendar-range text-primary me-2"></i>2. Thời gian tổ chức &amp; Sĩ số học viên
                            </h6>

                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label asp-for="NgayBatDau" class="form-label fw-semibold small text-secondary">
                                        Ngày khai giảng / Bắt đầu <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="NgayBatDau" type="date" class="form-control" value="@Model.NgayBatDau.ToString("yyyy-MM-dd")" />
                                    <span asp-validation-for="NgayBatDau" class="text-danger small"></span>
                                </div>

                                <div class="col-md-4">
                                    <label asp-for="NgayKetThuc" class="form-label fw-semibold small text-secondary">
                                        Ngày kết thúc dự kiến <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="NgayKetThuc" type="date" class="form-control" value="@Model.NgayKetThuc.ToString("yyyy-MM-dd")" />
                                    <span asp-validation-for="NgayKetThuc" class="text-danger small"></span>
                                </div>

                                <div class="col-md-4">
                                    <label asp-for="SoLuongToiDa" class="form-label fw-semibold small text-secondary">
                                        Sĩ số học viên tối đa <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="SoLuongToiDa" type="number" min="1" max="500" class="form-control" />
                                    <span asp-validation-for="SoLuongToiDa" class="text-danger small"></span>
                                    <small class="text-muted d-block mt-1 uneti-fs-xs">Số lượng tối đa từ 1 đến 500 học viên</small>
                                </div>
                            </div>
                        </div>

                        <!-- 3. Học phí, hình thức và trạng thái -->
                        <div class="mb-4">
                            <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">
                                <i class="bi bi-cash-coin text-primary me-2"></i>3. Định mức học phí &amp; Cấu hình lớp học
                            </h6>

                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label asp-for="HocPhi" class="form-label fw-semibold small text-secondary">
                                        Học phí khóa học (VNĐ) <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-group">
                                        <input asp-for="HocPhi" type="number" step="50000" min="0" class="form-control fw-bold text-primary" />
                                        <span class="input-group-text bg-white text-muted">đ</span>
                                    </div>
                                    <span asp-validation-for="HocPhi" class="text-danger small"></span>
                                    <small class="text-muted d-block mt-1 uneti-fs-xs">Học phí phải &ge; 0 đ theo quy định</small>
                                </div>

                                <div class="col-md-4">
                                    <label asp-for="HinhThuc" class="form-label fw-semibold small text-secondary">
                                        Hình thức giảng dạy <span class="text-danger">*</span>
                                    </label>
                                    <select asp-for="HinhThuc" class="form-select">
                                        <option value="Trực tiếp">Trực tiếp (Tại lớp)</option>
                                        <option value="Trực tuyến">Trực tuyến (Online)</option>
                                        <option value="Kết hợp">Kết hợp (Hybrid)</option>
                                    </select>
                                    <span asp-validation-for="HinhThuc" class="text-danger small"></span>
                                </div>

                                <div class="col-md-4">
                                    <label asp-for="TrangThai" class="form-label fw-semibold small text-secondary">
                                        Trạng thái vòng đời <span class="text-danger">*</span>
                                    </label>
                                    <select asp-for="TrangThai" class="form-select">
                                        <option value="DangMo">Đang mở đăng ký</option>
                                        <option value="SapMo">Sắp mở</option>
                                        <option value="DangHoc">Đang giảng dạy</option>
                                        <option value="DaKetThuc">Đã kết thúc</option>
                                        <option value="BiHuy">Đã hủy</option>
                                    </select>
                                    <span asp-validation-for="TrangThai" class="text-danger small"></span>
                                </div>

                                <div class="col-12">
                                    <label asp-for="MoTa" class="form-label fw-semibold small text-secondary">
                                        Mô tả chi tiết &amp; Lịch học trong tuần
                                    </label>
                                    <textarea asp-for="MoTa" class="form-control" rows="3"></textarea>
                                    <span asp-validation-for="MoTa" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Cụm nút hành động -->
                        <div class="d-flex justify-content-between pt-3 border-top">
                            <a asp-action="QuanLy" class="btn uneti-btn-outline text-decoration-none">
                                <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách
                            </a>
                            <button type="submit" class="btn uneti-btn-primary px-4 shadow-sm">
                                <i class="bi bi-check2-circle me-1"></i>Lưu thay đổi
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
